118: export function createTravelController(
119:   initial: SceneId,
120:   deps: TravelDeps,
121: ): TravelController {
122:   let current: SceneId = initial;
123:   let generation = 0;
124:   let timers: ReturnType<typeof setTimeout>[] = [];
125:   let pendingResolve: (() => void) | null = null;
126:   let disposed = false;
127:   // Lanefield arrives late: main.tsx starts the world on idle, after
128:   // App mounts. setLanefield attaches it; travelTo reads this variable,
129:   // not deps.lanefield, so a late world still morphs lanes.
130:   let lanefield: Lanefield | null = deps.lanefield;
131: 
132:   function later(ms: number, gen: number, fn: () => void): void {
133:     const id = setTimeout(() => {
134:       if (gen !== generation || disposed) return;
135:       fn();
136:     }, ms);
137:     timers.push(id);
138:   }
139: 
140:   function cancelPending(): void {
141:     for (const id of timers) clearTimeout(id);
142:     timers = [];
143:     if (pendingResolve) {
144:       const resolve = pendingResolve;
145:       pendingResolve = null;
146:       resolve();
147:     }
148:   }
149: 
150:   function travelTo(target: SceneId): Promise<void> {
151:     if (disposed) return Promise.resolve();
152:     if (target === current && timers.length === 0 && !pendingResolve) {
153:       return Promise.resolve();
154:     }
155:     // Interruptible (S03 section 4): cancel DOM timers, keep the current
156:     // lane weights and camera pose as the new start (the engine tweens
157:     // from its current state), travel to the new target fresh. No queue.
158:     cancelPending();
159:     generation += 1;
160:     const gen = generation;
161: 
162:     const reduced = deps.isReducedMotion();
163:     const noWorld = lanefield === null;
164:     const useReducedTiming = reduced || noWorld;
165: 
166:     const oldEl = deps.dom.readout();
167:     const busyEl = deps.dom.busy();
168:     const keymapEl = deps.dom.keymap();
169:     const active = document.activeElement as HTMLElement | null;
170:     const focusWasInside =
171:       (oldEl !== null && active !== null && oldEl.contains(active)) ||
172:       (keymapEl !== null && active !== null && keymapEl.contains(active));
173: 
174:     const outgoing = current;
175:     current = target;
176: 
177:     // t = 0: keymap target turns accent, old readout starts fading,
178:     // aria-busy on the readout region, outgoing controller pauses,
179:     // world travel starts.
180:     setKeymapAccent(deps.dom, target);
181:     if (busyEl) busyEl.setAttribute('aria-busy', 'true');
182:     if (oldEl) {
183:       oldEl.style.transition = `opacity var(--jp-duration-fast) var(--jp-ease-standard)`;
184:       oldEl.style.opacity = '0';
185:     }
186:     deps.controllers?.get(outgoing)?.pause();
187:     const worldPromise = lanefield
188:       ? lanefield.travelTo(SCENE_LAYOUT[target], {
189:           instant: useReducedTiming,
190:           originPx: useReducedTiming ? null : keyOrigin(deps.dom, target),
191:         })
192:       : Promise.resolve();
193:     worldPromise.catch(() => {});
194: 
195:     const dom = deps.dom;
196:     const hiddenAt = useReducedTiming
197:       ? T.chrome.travelDom.reducedRegimeSwitchAtMs
198:       : T.chrome.travelDom.readoutHiddenAtMs;
199:     const regimeAt = useReducedTiming
200:       ? T.chrome.travelDom.reducedRegimeSwitchAtMs
201:       : T.chrome.travelDom.regimeSwitchAtMs;
202:     // P-MORPH-1: the incoming title enters at Reveal start
203:     // (motion.morph.reveal[0] of travel), not at the old readout
204:     // delay, and focus moves at the same point (S03 morph rule,
205:     // superseding the old 700ms focus row). Reduced motion keeps
206:     // its 150ms switch point for both.
207:     const revealStartMs = T.motion.ms.travel * T.motion.morph.reveal[0];
208:     const inAt = useReducedTiming
209:       ? T.chrome.travelDom.reducedRegimeSwitchAtMs
210:       : revealStartMs;
211:     const resolveAt = useReducedTiming
212:       ? T.chrome.travelDom.reducedRegimeSwitchAtMs + T.motion.ms.fast
213:       : T.motion.ms.travel;
214: 
215:     return new Promise<void>((resolve) => {
216:       pendingResolve = resolve;
217:       // Focus move, shared by the Reveal timer: only if focus was
218:       // inside the old readout or on the keymap at t = 0, and never
219:       // while a sheet focus lock holds focus (active element inside
220:       // a dialog). The readout swap at the hidden point precedes
221:       // Reveal, so the new heading exists when this runs.
222:       const moveFocus = (): void => {
223:         if (gen !== generation || disposed) return;
224:         if (!focusWasInside) return;
225:         const active = document.activeElement as HTMLElement | null;
226:         if (active?.closest?.('[role="dialog"]')) return;
227:         const h1 = dom.readout()?.querySelector('h1');
228:         if (h1) {
229:           (h1 as HTMLElement).tabIndex = -1;
230:           (h1 as HTMLElement).focus({ preventScroll: true });
231:         }
232:       };
233:       const finish = (): void => {
234:         if (gen !== generation || disposed) return;
235:         if (pendingResolve) {
236:           pendingResolve = null;
237:         }
238:         if (busyEl) busyEl.setAttribute('aria-busy', 'false');
239:         // The polite announcement region announces the new H1
240:         // (C-SR-TRAVEL: the new scene's H1 string). Read it from the
241:         // rendered readout so the announcement always matches what is
242:         // on screen.
243:         const announceEl = dom.announce();
244:         if (announceEl) {
245:           const h1Text = dom.readout()?.querySelector('h1')?.textContent;
246:           announceEl.textContent = h1Text ?? SCENE_H1[target];
247:         }
248:         deps.controllers?.get(target)?.resume();
249:         resolve();
250:       };
251: 
252:       // Hidden point: old readout leaves the accessibility tree and the
253:       // app swaps readout content (via onSwap) while nothing is visible.
254:       later(hiddenAt, gen, () => {
255:         const el = dom.readout();
256:         if (el) concealKeepLayout(el);
257:         // onSwap commits synchronously (App wraps it in flushSync), so
258:         // the incoming readout is laid out and the hero has placed
259:         // itself and registered its anchor before this callback returns.
260:         deps.onSwap?.(target);
261:         const next = dom.readout();
262:         if (next) {
263:           next.style.transition = 'none';
264:           next.style.opacity = '0';
265:           if (!useReducedTiming) {
266:             next.style.transform = `translateY(${READOUT_ENTER_SHIFT_PX}px)`;
267:           } else {
268:             next.style.transform = '';
269:           }
270:         }
271:       });
272: 
273:       // Regime switch point: DOM text colors flip while the readout is
274:       // hidden, so no text is ever visible below contrast.
275:       later(regimeAt, gen, () => {
276:         applyRegime(target);
277:       });
278: 
279:       // Readout entrance: opacity 0 to 1, and translateY 8px to 0 on the
280:       // full timing (no translate on reduced motion, opacity only).
281:       // Focus moves at Reveal start (P-MORPH-1, S03 morph rule), from
282:       // inside this callback after the reveal: a focus call while the
283:       // section is still inert is a no-op, so the focus move must run
284:       // after reveal(), not on a parallel timer at the same millisecond.
285:       later(inAt, gen, () => {
286:         const el = dom.readout();
287:         if (!el) return;
288:         reveal(el);
289:         if (useReducedTiming) {
290:           el.style.transition = `opacity var(--jp-duration-fast) var(--jp-ease-standard)`;
291:         } else {
292:           el.style.transition = `opacity var(--jp-duration-medium) var(--jp-ease-signature), transform var(--jp-duration-medium) var(--jp-ease-signature)`;
293:         }
294:         el.style.opacity = '1';
295:         el.style.transform = '';
296:         moveFocus();
297:       });
298: 
299:       later(resolveAt, gen, finish);
300:     });
301:   }
302: 
303:   return {
304:     get current() {
305:       return current;
306:     },
307:     travelTo,
308:     setLanefield(next: Lanefield | null): void {
309:       lanefield = next;
310:     },
311:     dispose(): void {
312:       disposed = true;
313:       cancelPending();
314:     },
315:   };
316: }
