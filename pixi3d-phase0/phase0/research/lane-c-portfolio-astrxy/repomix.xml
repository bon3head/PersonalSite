  1: // LeafLink scene tests (S06 section 9). T-LL-1 to T-LL-7.
  2: // Real-engine tests build their own lanefield (separate from App's)
  3: // so App's canvas and hotkeys never interfere with taps or weights.
  4: import { test, expect, type Page } from '@playwright/test';
  5: 
  6: const DEV = 'http://localhost:5173';
  7: 
  8: // The dev server is shared with sibling workers; when the run that
  9: // started it exits, it kills the server and every connected page's
 10: // vite client reloads on reconnect, wiping test state. Close the HMR
 11: // socket so a test page never reloads mid-test. Call before goto.
 12: async function blockHmr(page: Page): Promise<void> {
 13:   await page.routeWebSocket(
 14:     (url) => url.hostname === 'localhost',
 15:     (ws) => ws.close(),
 16:   );
 17: }
