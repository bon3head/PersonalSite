234: async function walkByKeyboard(page: Page, name: string): Promise<void> {
235:   // Pointer clicks cannot reach twins that project off-screen on a
236:   // phone (measured: Trail 2 at x 627, Trail 3 at x -96 on 390 wide;
237:   // only Trail 1 is on-screen). Keyboard walking is the first-class
238:   // path (T-SQ-5): Tab until the target twin holds focus, then
239:   // Enter. Enter is pressed only when the target itself is focused,
240:   // so a keymap item or link can never be activated by mistake.
241:   for (let i = 0; i < 30; i++) {
242:     const focused = await page.evaluate(
243:       () => document.activeElement?.getAttribute('aria-label'),
244:     );
245:     if (focused === name) break;
246:     await page.keyboard.press('Tab');
247:   }
248:   const focused = await page.evaluate(
249:     () => document.activeElement?.getAttribute('aria-label'),
250:   );
251:   if (focused !== name) {
252:     throw new Error(`keyboard walk: never focused ${name}, last focused ${focused}`);
253:   }
254:   await page.keyboard.press('Enter');
255: }
