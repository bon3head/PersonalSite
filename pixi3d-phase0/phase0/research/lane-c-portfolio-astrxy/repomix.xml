  1: // Polish round 2 pure checks (DESIGN 1.2.0): entropy determinism and
  2: // neutrality, morph anchor resolver behavior, bow endpoints, and the
  3: // camera band under every seeded bow. Node only, no browser.
  4: import { test, expect } from '@playwright/test';
  5: import { T } from '../../src/tokens.generated';
  6: import { createMorphController, type MorphAnchor } from '../../src/motion/morph-controller';
  7: import {
  8:   drawAt,
  9:   morphEntropy,
 10:   resetEntropy,
 11:   setEntropyEnabled,
 12:   NEUTRAL_ENTROPY,
 13: } from '../../src/motion/entropy';
 14: import type { LayoutId } from '../../src/world/types';
 15: 
 16: const TRAVEL_MS = T.motion.ms.travel;
 17: const ROUTES: LayoutId[] = ['server', 'leaflink', 'sidequests', 'scatter'];
 18: 
 19: function scriptRun(seed: number, enabled: boolean): number[] {
 20:   resetEntropy(seed);
 21:   setEntropyEnabled(enabled);
 22:   const out: number[] = [];
 23:   // A fixed input script: 24 navigations cycling every destination.
 24:   for (let i = 0; i < 24; i++) {
 25:     const e = morphEntropy(ROUTES[i % ROUTES.length]);
 26:     out.push(e.bow, e.swirl, e.pullScale);
 27:   }
 28:   setEntropyEnabled(true);
 29:   return out;
 30: }
 31: 
 32: test('T-ENT-1: same seed reproduces the same motion parameters', () => {
 33:   expect(scriptRun(123456789, true)).toEqual(scriptRun(123456789, true));
 34: });
 35: 
 36: test('T-ENT-2: different seeds vary the motion parameters', () => {
 37:   const a = scriptRun(1, true);
 38:   const b = scriptRun(2, true);
 39:   let differing = 0;
 40:   for (let i = 0; i < a.length; i++) if (Math.abs(a[i] - b[i]) > 1e-6) differing++;
 41:   // Server entries are rigid by token (bow 0, swirl 0), so only the
 42:   // pull scale varies there; every other destination varies all three.
 43:   expect(differing).toBeGreaterThan(a.length / 2);
 44: });
 45: 
 46: test('T-ENT-3: reduced motion is neutral and seed independent', () => {
 47:   const a = scriptRun(7, false);
 48:   const b = scriptRun(99999, false);
 49:   expect(a).toEqual(b);
 50:   for (let i = 0; i < a.length; i += 3) {
 51:     expect(a[i]).toBe(NEUTRAL_ENTROPY.bow);
 52:     expect(a[i + 1]).toBe(NEUTRAL_ENTROPY.swirl);
 53:     expect(a[i + 2]).toBeCloseTo(NEUTRAL_ENTROPY.pullScale, 12);
 54:   }
 55: });
 56: 
 57: test('T-ENT-4: draws stay in range for 2000 seeds; server stays rigid', () => {
 58:   for (let s = 0; s < 2000; s++) {
 59:     resetEntropy(s * 2654435761);
 60:     for (const r of ROUTES) {
 61:       const e = morphEntropy(r);
 62:       const range = T.entropy.scene[r];
 63:       expect(Math.abs(e.bow)).toBeLessThanOrEqual(range.bowWorld + 1e-12);
 64:       expect(Math.abs(e.swirl)).toBeLessThanOrEqual(range.swirl + 1e-12);
 65:       expect(e.pullScale).toBeGreaterThanOrEqual(T.entropy.pullScale[0]);
 66:       expect(e.pullScale).toBeLessThanOrEqual(T.entropy.pullScale[1]);
 67:       if (r === 'server') {
 68:         expect(e.bow).toBe(0);
 69:         expect(e.swirl).toBe(0);
 70:       }
 71:     }
 72:     const u = drawAt(s, 'morph-bow', s);
 73:     expect(u).toBeGreaterThanOrEqual(0);
 74:     expect(u).toBeLessThan(1);
 75:   }
 76: });
 77: 
 78: test('T-ENT-5: bow is zero at both ends of every morph for any seed', () => {
 79:   for (let s = 0; s < 200; s++) {
 80:     resetEntropy(s);
 81:     for (const from of ROUTES) {
 82:       for (const to of ROUTES) {
 83:         if (from === to) continue;
 84:         const c = createMorphController(from);
 85:         c.navigate(to, 0, undefined, { entropy: morphEntropy(to) });
 86:         expect(c.sample(0).bowFactor).toBe(0);
 87:         expect(Math.abs(c.sample(TRAVEL_MS).bowFactor)).toBeLessThan(1e-12);
 88:         expect(c.sample(TRAVEL_MS).ringStrength).toBe(0);
 89:       }
 90:     }
 91:   }
 92: });
 93: 
 94: test('T-ANCHOR-1: an unresolved anchor draws no ring, then grows from zero', () => {
 95:   let anchor: MorphAnchor | null = null;
 96:   const c = createMorphController('server', { anchorFor: () => anchor });
 97:   c.navigate('leaflink', 0);
 98:   // Before the anchor exists (the readout swap has not happened yet),
 99:   // the ring is zero even inside the Gather window.
100:   const early = c.sample(0.3 * TRAVEL_MS);
101:   expect(early.anchorReady).toBe(false);
102:   expect(early.ringStrength).toBe(0);
103:   expect(early.silhouetteStrength).toBe(0);
104:   // The anchor resolves at 0.3: the ring starts at zero on that frame
105:   // and grows on later frames, centered on the resolved anchor.
106:   anchor = { center: [4, -2], ringRadius: 3, silhouetteRadius: 5 };
107:   const first = c.sample(0.3 * TRAVEL_MS);
108:   expect(first.anchorReady).toBe(true);
109:   expect(first.ringStrength).toBe(0);
110:   const later = c.sample(0.5 * TRAVEL_MS);
111:   expect(later.ringStrength).toBeGreaterThan(0);
112:   expect(later.ringCenter).toEqual([4, -2]);
113:   expect(later.ringRadius).toBe(3);
114:   expect(later.silhouetteRadius).toBe(5);
115: });
116: 
117: test('T-ANCHOR-2: the ring departs from the origin and lands on the anchor', () => {
118:   const anchor: MorphAnchor = { center: [0, 0], ringRadius: 4, silhouetteRadius: 4 };
119:   const c = createMorphController('server', {
120:     anchorFor: () => anchor,
121:     groundAt: () => [10, 6],
122:   });
123:   c.navigate('sidequests', 0, undefined, { originPx: [100, 600] });
124:   const g0 = T.motion.morph.gather[0];
125:   const startGather = c.sample(g0 * TRAVEL_MS);
126:   expect(startGather.ringCenter[0]).toBeCloseTo(10, 6);
127:   expect(startGather.ringCenter[1]).toBeCloseTo(6, 6);
128:   const endGather = c.sample(T.motion.morph.gather[1] * TRAVEL_MS);
129:   expect(endGather.ringCenter[0]).toBeCloseTo(0, 6);
130:   expect(endGather.ringCenter[1]).toBeCloseTo(0, 6);
131: });
132: 
133: test('T-LF-7b: swirled deflection stays C1 and zero outside the ring', async () => {
134:   const { deflectPoint } = await import('../../src/world/deflection');
135:   const r = 5;
136:   const s = 2;
137:   for (const swirl of [-0.9, -0.35, 0, 0.35, 0.9]) {
138:     // Zero outside and at the boundary, for any swirl.
139:     expect(deflectPoint(r, 0, 0, 0, r, s, swirl)).toEqual([r, 0]);
140:     expect(deflectPoint(9, 1, 0, 0, r, s, swirl)).toEqual([9, 1]);
141:     // Displacement magnitude approaches zero continuously at the
142:     // boundary (C0) with a vanishing slope (C1): sample just inside.
143:     const eps = 1e-3;
144:     const [x1, z1] = deflectPoint(r - eps, 0, 0, 0, r, s, swirl);
145:     const disp = Math.hypot(x1 - (r - eps), z1);
146:     expect(disp).toBeLessThan(1e-4);
147:     // The tangential share is exactly swirl times the radial share.
148:     const [x2, z2] = deflectPoint(2, 0, 0, 0, r, s, swirl);
149:     const radial = x2 - 2;
150:     expect(z2).toBeCloseTo(radial * swirl, 12);
151:   }
152: });
