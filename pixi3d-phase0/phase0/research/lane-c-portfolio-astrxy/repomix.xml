 1: // Performance governor (S02 governor chapter) and frame statistics.
 2: // The only quality lever is resolution: lane count and classes never change.
 3: // Also owns the ring of recent frame times used by frameStats and ?perf dumps.
 4: import { T } from '../tokens.generated';
 5: 
 6: const RING_SIZE = 600; // lit-ok: perf dump frame count
 7: 
 8: function percentile(sorted: number[], q: number): number {
 9:   if (sorted.length === 0) return 0;
10:   const idx = Math.min(sorted.length - 1, Math.floor(q * sorted.length));
11:   return sorted[idx];
12: }
13: 
14: export class Governor {
15:   private windowSamples: number[] = [];
16:   private windowStartMs: number;
17:   private ring = new Float64Array(RING_SIZE);
18:   private ringCount = 0;
19:   private ringHead = 0;
20:   private totalFrames = 0;
21:   private goodWindows = 0;
22:   private scale = 1;
23:   private base = 1;
24:   private floor = 1;
25: 
26:   constructor() {
27:     this.windowStartMs = performance.now();
28:   }
29: 
30:   // base: min(devicePixelRatio, cap). floor: absolute DPR floor.
31:   setBase(base: number, floor: number): void {
32:     this.base = base;
33:     this.floor = floor;
34:     this.scale = Math.min(this.scale, 1);
35:     if (this.base > 0 && this.scale < this.floor / this.base) {
36:       this.scale = this.floor / this.base;
37:     }
38:   }
39: 
40:   scaleFactor(): number {
41:     return this.scale;
42:   }
43: 
44:   effectiveDpr(): number {
45:     return Math.max(this.floor, this.base * this.scale);
46:   }
47: 
48:   sample(dtMs: number, nowMs: number): void {
49:     this.windowSamples.push(dtMs);
50:     this.ring[this.ringHead] = dtMs;
51:     this.ringHead = (this.ringHead + 1) % RING_SIZE;
52:     if (this.ringCount < RING_SIZE) this.ringCount++;
53:     this.totalFrames++;
54:     if (nowMs - this.windowStartMs < T.world.governor.sampleWindowMs) return;
55:     const sorted = [...this.windowSamples].sort((a, b) => a - b);
56:     const p90 = percentile(sorted, 0.9); // lit-ok: p90 quantile
57:     this.windowSamples.length = 0;
58:     this.windowStartMs = nowMs;
59:     const g = T.world.governor;
60:     if (p90 > g.stepDownAboveMs) {
61:       this.goodWindows = 0;
62:       const minScale = this.base > 0 ? this.floor / this.base : 1;
63:       this.scale = Math.max(this.scale - g.dprStep, minScale);
64:     } else if (p90 < g.stepUpBelowMs) {
65:       this.goodWindows++;
66:       if (this.goodWindows * g.sampleWindowMs >= g.stepUpAfterMs) {
67:         this.scale = Math.min(1, this.scale + g.dprStep);
68:         this.goodWindows = 0;
69:       }
70:     } else {
71:       this.goodWindows = 0;
72:     }
73:   }
74: 
75:   stats(): { p50: number; p90: number; p95: number; count: number } {
76:     const valid = Array.from(this.ring.slice(0, this.ringCount)).sort((a, b) => a - b);
77:     return {
78:       p50: percentile(valid, 0.5),
79:       p90: percentile(valid, 0.9), // lit-ok: p90 quantile
80:       p95: percentile(valid, 0.95), // lit-ok: p95 quantile
81:       count: this.totalFrames,
82:     };
83:   }
84: 
85:   // Last ring entries in chronological order, for ?perf=1&dump=1.
86:   recentFrames(): number[] {
87:     const out: number[] = [];
88:     for (let i = 0; i < this.ringCount; i++) {
89:       out.push(this.ring[(this.ringHead - this.ringCount + i + RING_SIZE) % RING_SIZE]);
90:     }
91:     return out;
92:   }
93: 
94:   ringFull(): boolean {
95:     return this.ringCount >= RING_SIZE;
96:   }
97: }
</file>

<file path="src/world/notfound.ts">
 1: // Notfound scene controller (S08). The not-found scene has no active
 2: // world behavior of its own: everything the Motion section requires
 3: // is owned by the engine and driven by the scatter layout weights,
 4: // so pause and resume are intentional no-ops. The reasons, with
 5: // token sources:
 6: // - Camera: poseFor('scatter') in camera.ts gives the Visual identity
 7: //   section pose (fine and coarse entries, no shift) from
 8: //   T.world.camera.scatter. Travel to the scatter layout moves the
 9: //   camera; nothing here repositions it.
10: // - Idle yaw: CameraRig.update blends idle yaw by layout weights
11: //   (camera.ts), so at one-hot scatter the yaw is exactly
12: //   T.world.camera.idleYawDeg.scatter over
13: //   T.world.camera.idleYawPeriodSec.scatter, and it fades to zero
14: //   as weights leave scatter. No per-frame hook is needed here.
15: // - Reduced motion: the rig skips yaw, drift and parallax when the
16: //   reduced flag is set, so the scene is static. No branch here.
17: // - Entry: travel to scatter (expo-out, T.motion.ms.travel) is the
18: //   travel controller's job via SCENE_LAYOUT.notfound; direct load
19: //   starts in place once main.tsx starts the world at the URL
20: //   scene's layout (coordinator fix, see BUILD-STATE).
21: // - Picking, pins, trails, activity: none. The world is decoration;
22: //   S08 kills any joke, illustration, or dead end, and the keymap
23: //   (chrome-owned) is the only way back, via ArrowRight or 1.
24: // The controller exists so the travel controller's controllers map
25: // has a notfound entry with the same pause/resume shape as every
26: // other scene, and so the no-op is a documented decision rather
27: // than a missing piece.
28: import type { SceneController } from '../travel';
29: 
30: export function createNotfoundController(): SceneController {
31:   return {
32:     pause(): void {
33:       // Nothing to stop: yaw is weight-driven and fades with the
34:       // layout weights; there is no activity, animation, or
35:       // subscription owned by this scene.
36:     },
37:     resume(): void {
38:       // Nothing to start: yaw resumes with the weights as soon as
39:       // the scatter layout is active again.
40:     },
41:   };
42: }
</file>

<file path="src/world/tween.ts">
 1: // Tween, spring, damp. Verbatim from S02 (tween section).
 2: // Trailing // lit-ok: comments are lint compliance only (tools/lint-tokens.mjs
 3: // requires them for numeric literals in src/world); they do not alter the code.
 4: import { T } from '../tokens.generated';
 5: 
 6: // Cubic bezier solver (same method as WebKit UnitBezier). Returns y for x in [0,1].
 7: export function cubicBezier(x1: number, y1: number, x2: number, y2: number) {
 8:   const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx; // lit-ok: bezier coefficients
 9:   const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by; // lit-ok: bezier coefficients
10:   const sx = (t: number) => ((ax * t + bx) * t + cx) * t;
11:   const sy = (t: number) => ((ay * t + by) * t + cy) * t;
12:   const dsx = (t: number) => (3 * ax * t + 2 * bx) * t + cx; // lit-ok: bezier derivative
13:   return (x: number) => {
14:     if (x <= 0) return 0; if (x >= 1) return 1;
15:     let t = x;
16:     for (let i = 0; i < 8; i++) { const e = sx(t) - x; if (Math.abs(e) < 1e-6) return sy(t); const d = dsx(t); if (Math.abs(d) < 1e-6) break; t -= e / d; } // lit-ok: Newton iterations and epsilon
17:     let lo = 0, hi = 1; t = x;
18:     while (hi - lo > 1e-6) { const v = sx(t); if (v < x) lo = t; else hi = t; t = (lo + hi) / 2; } // lit-ok: bisection epsilon
19:     return sy(t);
20:   };
21: }
22: export const easeSignature = cubicBezier(...T.motion.easeSignature); // expo-out
23: export const easePlain = cubicBezier(...T.motion.easePlainBezier); // CSS 'ease' as a curve, for WebGL-side values
24: 
25: // Underdamped spring step response, 0 -> 1. zeta < 1.
26: export function spring(zeta: number, freqHz: number) {
27:   const w = 2 * Math.PI * freqHz, wd = w * Math.sqrt(1 - zeta * zeta), k = zeta / Math.sqrt(1 - zeta * zeta);
28:   return (tSec: number) => 1 - Math.exp(-zeta * w * tSec) * (Math.cos(wd * tSec) + k * Math.sin(wd * tSec));
29: }
30: 
31: // Frame-rate independent exponential smoothing toward target.
32: export function damp(current: number, target: number, halfLifeMs: number, dtMs: number) {
33:   return target + (current - target) * Math.pow(2, -dtMs / halfLifeMs);
34: }
</file>

<file path="src/world/worker.ts">
 1: // Layout generation (S02 worker chapter). Runs in a Web Worker: generates all
 2: // four layouts into one transferable Float32Array and posts it with side data.
 3: // Real generators (Wave 2): server, leaflink, sidequests, scatter from
 4: // src/world/layouts/. Each creates its own mulberry32 stream per S02.
 5: import { T } from '../tokens.generated';
 6: import { generate as genServer } from './layouts/server';
 7: import { generate as genLeaflink } from './layouts/leaflink';
 8: import { generate as genSidequests } from './layouts/sidequests';
 9: import { generate as genScatter } from './layouts/scatter';
10: 
11: // mulberry32, verbatim (S02 worker chapter). Kept exported for tests;
12: // the layout generators each define it locally to avoid an import cycle.
13: export function rng(seed: number) {
14:   let a = seed >>> 0;
15:   return () => {
16:     a = (a + 0x6D2B79F5) >>> 0; // lit-ok: mulberry32 increment
17:     let t = a;
18:     t = Math.imul(t ^ (t >>> 15), t | 1); // lit-ok: mulberry32 scramble
19:     t ^= t + Math.imul(t ^ (t >>> 7), t | 61); // lit-ok: mulberry32 scramble
20:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296; // lit-ok: mulberry32 output scale
21:   };
22: }
23: 
24: const FLOATS_PER_TEXEL = 4; // lit-ok: RGBA channels
25: 
26: function generateAll(seed: number): {
27:   layouts: Float32Array;
28:   side: Record<string, unknown>;
29: } {
30:   const tex = T.world.layoutTexture;
31:   const out = new Float32Array(tex.width * tex.height * FLOATS_PER_TEXEL);
32:   const side: Record<string, unknown> = {};
33:   // Layout indices per S02: server, leaflink, sidequests, scatter.
34:   // Each generator writes exactly laneCount * pointsPerLane texels into
35:   // its own slice (verified by its B5 card tests) and returns side data.
36:   genServer(seed, out, 0);
37:   side.leaflink = genLeaflink(seed, out, 1);
38:   side.sidequests = genSidequests(seed, out, 2);
39:   side.scatter = genScatter(seed, out, 3); // lit-ok: S02 layout index scatter
40:   if (out.length !== tex.width * tex.height * FLOATS_PER_TEXEL) {
41:     throw new Error(`layout buffer length ${out.length} does not match texture size`);
42:   }
43:   return { layouts: out, side };
44: }
45: 
46: const scope = self as unknown as {
47:   postMessage: (message: unknown, transfer?: Transferable[]) => void;
48:   onmessage: ((e: MessageEvent) => void) | null;
49: };
50: 
51: scope.onmessage = (e: MessageEvent) => {
52:   const seed = (e.data as { seed: number }).seed;
53:   try {
54:     const { layouts, side } = generateAll(seed);
55:     scope.postMessage({ layouts, side }, [layouts.buffer]);
56:   } catch (err) {
57:     scope.postMessage({ error: err instanceof Error ? err.message : String(err) });
58:   }
59: };
</file>

