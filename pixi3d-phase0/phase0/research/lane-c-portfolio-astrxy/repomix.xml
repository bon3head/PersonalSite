 638:   // --- Polish round: screen anchors, focus pan, pulse, glitter. ---
 639:   function groundAt(x: number, y: number): [number, number] | null {
 640:     return rig.screenToGround(x, y, cssW, cssH);
 641:   }
 642: 
 643:   // Ground-project a hero anchor through the current camera. Called
 644:   // only after the final camera write of the frame (applyRing) or at
 645:   // navigate time, so the ring lands under the logo on screen.
 646:   function resolveAnchor(layout: LayoutId): MorphAnchor | null {
 647:     const rec = anchors.get(layout);
 648:     if (!rec || rec.w !== cssW || rec.h !== cssH) return null;
 649:     const c = groundAt(rec.a.x, rec.a.y);
 650:     const r = groundAt(rec.a.x + rec.a.ringRadiusPx, rec.a.y);
 651:     const sr = groundAt(rec.a.x + rec.a.silhouetteRadiusPx, rec.a.y);
 652:     if (!c || !r || !sr) return null;
 653:     return {
 654:       center: c,
 655:       ringRadius: Math.hypot(r[0] - c[0], r[1] - c[1]),
 656:       silhouetteRadius: Math.hypot(sr[0] - c[0], sr[1] - c[1]),
 657:     };
 658:   }
 659: 
 660:   function updatePan(dtMs: number): void {
 661:     let tx = 0;
 662:     let tz = 0;
 663:     if (focus && !reduced) {
 664:       const g = groundAt(focus.screenPx[0], focus.screenPx[1]);
 665:       if (g) {
 666:         // The ground under a fixed screen point moves by exactly the
 667:         // camera translation, so the target pan is one subtraction.
 668:         tx = pan[0] + focus.ground[0] - g[0];
 669:         tz = pan[1] + focus.ground[1] - g[1];
 670:         const len = Math.hypot(tx, tz);
 671:         const cap = T.focus.maxPanWorld;
 672:         if (len > cap) {
 673:           tx *= cap / len;
 674:           tz *= cap / len;
 675:         }
 676:       } else {
 677:         tx = pan[0];
 678:         tz = pan[1];
 679:       }
 680:     }
 681:     pan[0] = reduced ? tx : damp(pan[0], tx, T.focus.halfLifeMs, dtMs);
 682:     pan[1] = reduced ? tz : damp(pan[1], tz, T.focus.halfLifeMs, dtMs);
 683:   }
 684: 
 685:   function setRingFields(
 686:     center: [number, number],
 687:     radius: number,
 688:     strength: number,
 689:     silCenter: [number, number],
 690:     silRadius: number,
 691:     silStrength: number,
 692:     swirl: number,
 693:   ): void {
 694:     paramsCurrent.ringCenter = center;
 695:     paramsCurrent.ringRadius = radius;
 696:     paramsCurrent.ringStrength = strength;
 697:     paramsCurrent.silhouetteCenter = silCenter;
 698:     paramsCurrent.silhouetteRadius = silRadius;
 699:     paramsCurrent.silhouetteStrength = silStrength;
 700:     ringSwirl = swirl;
 701:   }
 702: 
 703:   // Single owner of the ring and silhouette fields, after the final
 704:   // camera write: the morph envelope while traveling, otherwise the
 705:   // glitter hold or a pulse at the current layout's anchor, otherwise
 706:   // zero strength (the rest invariant).
 707:   function applyRing(t: number, dtMs: number): void {
 708:     const s = morph.sample(t * SEC_TO_MS);
 709:     morphDebug.from = s.from;
 710:     morphDebug.to = s.to;
 711:     morphDebug.sample = s;
 712:     morphDebug.degraded = s.degraded;
 713:     if (!s.done) {
 714:       setRingFields(
 715:         [...s.ringCenter], s.ringRadius, s.ringStrength,
 716:         [...s.silhouetteCenter], s.silhouetteRadius, s.silhouetteStrength,
 717:         s.ringSwirl,
 718:       );
 719:       return;
 720:     }
 721:     // Glitter hold: the ring follows the finger, swirled.
 722:     // Rise damps toward the cap; release is a finite signature ramp
 723:     // over one travel duration, so the scene is exactly re-formed (and
 724:     // the rest invariant holds again) at a known time, with no
 725:     // exponential tail and no epsilon snap.
 726:     if (glitter.target > 0) {
 727:       glitter.releaseAt = -1;
 728:       glitter.value = damp(glitter.value, T.glitter.maxWeight, T.motion.ms.fast, dtMs);
 729:     } else if (glitter.value > 0) {
 730:       if (glitter.releaseAt < 0) {
 731:         glitter.releaseAt = t;
 732:         glitter.releaseFrom = glitter.value;
 733:       }
 734:       const q = ((t - glitter.releaseAt) * SEC_TO_MS) / T.motion.ms.travel;
 735:       glitter.value = q >= 1 ? 0 : glitter.releaseFrom * (1 - easeSignature(q));
 736:     }
 737:     if (glitter.value > 0) {
 738:       const c = groundAt(glitter.centerPx[0], glitter.centerPx[1]);
 739:       const r = groundAt(glitter.centerPx[0] + T.glitter.ringRadiusPx, glitter.centerPx[1]);
 740:       if (c && r) {
 741:         const radius = Math.hypot(r[0] - c[0], r[1] - c[1]);
 742:         const k = glitter.value / T.glitter.maxWeight;
 743:         setRingFields(c, radius, radius * 0.5 * k, c, radius, 0, glitter.swirl);
 744:         return;
 745:       }
 746:     }
 747:     const a = resolveAnchor(current);
 748:     if (pulseState && a) {
 749:       const age = t - pulseState.startSec;
 750:       const out = T.motion.ms.fast * MS_TO_SEC;
 751:       const settle = T.motion.ms.travel * MS_TO_SEC;
 752:       if (age >= out + settle) {
 753:         pulseState = null;
 754:       } else if (age >= 0) {
 755:         const env = age < out ? easeSignature(age / out) : 1 - easePlain((age - out) / settle);
 756:         const q = trackEase(Math.min(1, age / (out + settle * 0.5)));
 757:         const o = pulseState.originPx ? groundAt(pulseState.originPx[0], pulseState.originPx[1]) : null;
 758:         const from = o ?? a.center;
 759:         const center: [number, number] = [
 760:           from[0] + (a.center[0] - from[0]) * q,
 761:           from[1] + (a.center[1] - from[1]) * q,
 762:         ];
 763:         const k = env * pulseState.scale;
 764:         setRingFields(
 765:           center, a.ringRadius, a.ringRadius * 0.5 * k,
 766:           [...a.center], a.silhouetteRadius, T.morph.silhouettePull * 0.5 * k,
 767:           pulseState.swirl,
 768:         );
 769:         return;
 770:       }
 771:     }
 772:     setRingFields(a ? [...a.center] : [0, 0], a ? a.ringRadius : 0, 0, a ? [...a.center] : [0, 0], a ? a.silhouetteRadius : 0, 0, 0);
 773:   }
