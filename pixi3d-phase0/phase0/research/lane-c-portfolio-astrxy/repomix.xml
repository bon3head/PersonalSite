  1: // Server scene controller (S05, DESIGN 6.15). Owns the in-scene stack // lit-ok: spec section reference
  2: // words, formed from lanes: every character of a word rides the tip of
  3: // its own lane, which bends out of the horn to carry it and draws it
  4: // back as the word fades. Words spawn on wordCadence, drift from the
  5: // focus toward the viewer, cool signal to text2, and fade after
  6: // wordFadeFrom; the lane's bend and tint follow the word's opacity, so a
  7: // lane is exactly at rest when its word ends and never snaps.
  8: // Camera idle yaw and pointer parallax reside in the lanefield rig (S02
  9: // camera section), not here; lane pulses reside in the fire() shader.
 10: // The controller exposes pause/resume for travel (S03 SceneController)
 11: // and debug accessors for the S05 word tests.
 12: import * as THREE from 'three';
 13: // @ts-ignore: troika ships types under dist/types but no package.json
 14: // types field, so TS cannot find them (same untyped-module pattern as
 15: // B4's laneTheme import).
 16: import { Text } from 'troika-three-text';
 17: import { T } from '../tokens.generated';
 18: import type { Lanefield } from './types';
 19: import type { SceneController } from '../travel';
 20: import { easePlain } from './tween';
 21: import { currentVariant } from './camera';
 22: 
 23: export interface WordLaneDebug {
 24:   word: string;
 25:   char: string;
 26:   slot: number;
 27:   lane: number;
 28:   glyph: [number, number, number];
 29:   restTip: [number, number, number];
 30:   texel: [number, number, number, number];
 31:   opacity: number;
 32: }
 33: 
 34: export interface ServerController extends SceneController {
 35:   setReducedMotion(on: boolean): void;
 36:   // Guestbook open (S05 guestbook row): words fade out and none spawn.
 37:   setHidden(on: boolean): void;
 38:   dispose(): void;
 39:   /** Strings currently visible (animated actives plus reduced statics). */
 40:   activeWords(): string[];
 41:   /** Full spawn history, in order (collected over the test window). */
 42:   spawnedWords(): string[];
 43:   isPaused(): boolean;
 44:   /** Every lit character with its lane (T-SRV-7). */ // lit-ok: spec section reference
 45:   wordLanes(): WordLaneDebug[];
 46: }
 47: 
 48: interface Glyph {
 49:   mesh: Text;
 50:   ch: string;
 51:   lane: number;
 52:   // Position in the word, counting spaces, so the advance stays true.
 53:   index: number;
 54:   rest: [number, number, number];
 55: }
 56: 
 57: interface ActiveWord {
 58:   slot: number;
 59:   text: string;
 60:   startSec: number;
 61:   ySign: number;
 62:   // Life fraction, frozen while a pause or hide fade runs.
 63:   t: number;
 64:   glyphs: Glyph[];
 65:   opacity: number;
 66: }
 67: 
 68: const S = T.world.server;
 69: const WORDS: readonly string[] = S.words;
 70: const DURATION_SEC = T.motion.ms.word / 1000; // lit-ok: ms to seconds
 71: const CADENCE_SEC = T.motion.ms.wordCadence / 1000; // lit-ok: ms to seconds
 72: const FAST_SEC = T.motion.ms.fast / 1000; // lit-ok: ms to seconds
 73: const FONT = '/fonts/commit-mono-latin-400-normal.woff';
 74: const GLYPHS_PER_SLOT = Math.max(...WORDS.map((w) => w.replace(/ /g, '').length));
 75: 
 76: type Rgb = [number, number, number];
 77: 
 78: // Raw sRGB components (0 to 1) from a token hex, matching the lane
 79: // shader's color space (ShaderMaterial output is not color-managed).
 80: function hexToRgb(hex: string): Rgb {
 81:   return [
 82:     parseInt(hex.slice(1, 3), 16) / 255, // lit-ok: hex channel parse
 83:     parseInt(hex.slice(3, 5), 16) / 255, // lit-ok: hex channel parse
 84:     parseInt(hex.slice(5, 7), 16) / 255, // lit-ok: hex channel parse
 85:   ];
 86: }
 87: 
 88: // Blend: spawn at lane signal, not near-white hot, so words sit in the
 89: // field instead of flashing (DESIGN 1.3.0 server spray blend). // lit-ok: spec section reference
 90: const HOT = hexToRgb(T.color.signal);
 91: const SIGNAL = hexToRgb(T.color.signal);
 92: const TEXT2 = hexToRgb(T.color.void.text2);
 93: 
 94: function mixRgb(a: Rgb, b: Rgb, f: number, out: Rgb): Rgb {
 95:   out[0] = a[0] + (b[0] - a[0]) * f;
 96:   out[1] = a[1] + (b[1] - a[1]) * f;
 97:   out[2] = a[2] + (b[2] - a[2]) * f; // lit-ok: blue channel
 98:   return out;
 99: }
100: 
101: function colorAt(t: number, out: Rgb): Rgb {
102:   const stops = S.wordColorStops;
103:   // Stops are fixed by DESIGN (0, mid, 1); no degenerate guard needed.
104:   if (t <= stops[1]) return mixRgb(HOT, SIGNAL, (t - stops[0]) / (stops[1] - stops[0]), out);
105:   return mixRgb(SIGNAL, TEXT2, (t - stops[1]) / (stops[2] - stops[1]), out);
106: }
107: 
108: function opacityAt(t: number): number {
109:   if (t <= S.wordFadeFrom) return 1;
110:   const f = (t - S.wordFadeFrom) / (1 - S.wordFadeFrom);
111:   return 1 - easePlain(f);
112: }
113: 
114: function positionAt(t: number, ySign: number, out: THREE.Vector3): THREE.Vector3 {
115:   const d = S.wordDrift;
116:   const f = S.focus;
117:   return out.set(
118:     f[0] + d[0] * t,
119:     f[1] + d[1] * ySign * t,
120:     f[2] + S.wordSpawnOffsetZ + d[2] * t,
121:   );
122: }
123: 
124: function makeGlyph(): Text {
125:   const mesh = new Text();
126:   mesh.font = FONT;
127:   mesh.fontSize = S.wordSize;
128:   mesh.textAnchor = 'center';
129:   mesh.anchorX = 'center';
130:   mesh.anchorY = 'middle';
131:   mesh.visible = false;
132:   return mesh;
133: }
134: 
135: export function createServerController(
136:   field: Lanefield,
137:   opts?: { reducedMotion?: boolean },
138: ): ServerController {
139:   const f = field as Partial<Lanefield>;
140:   const lanes = f.words && f.guestbook ? { words: f.words, gb: f.guestbook } : null;
141:   const laneCount = T.world.laneCount;
142: 
143:   // One glyph mesh per character per pool slot.
144:   const pool: Text[][] = [];
145:   for (let s = 0; s < S.wordPool; s++) {
146:     const row: Text[] = [];
147:     for (let i = 0; i < GLYPHS_PER_SLOT; i++) {
148:       const mesh = makeGlyph();
149:       field.scene.add(mesh);
150:       row.push(mesh);
151:     }
152:     pool.push(row);
153:   }
154: 
155:   // Commit Mono advance and line box, measured from the loaded font.
156:   let advance = 0;
157:   let boxY: [number, number] = [0, 0];
158:   const measure = makeGlyph();
159:   measure.text = '0';
160: 
161:   let paused = false;
162:   let hidden = false;
163:   let reduced = opts?.reducedMotion ?? false;
164:   let disposed = false;
165:   let nextWord = 0;
166:   let spawnCount = 0;
167:   let accSec = CADENCE_SEC;
168:   let fadeStartSec: number | null = null;
169:   const actives: ActiveWord[] = [];
170:   const spawned: string[] = [];
171:   const tmpRgb: Rgb = [0, 0, 0];
172:   const tmpColor = new THREE.Color();
173:   const tmpPos = new THREE.Vector3();
174:   const tmpPoint = new THREE.Vector3();
175:   const camRight = new THREE.Vector3();
176:   const camUp = new THREE.Vector3();
177:   const tips = new Float32Array(laneCount * 3); // lit-ok: xyz per lane
178:   const tip: [number, number, number] = [0, 0, 0];
179:   // Reused every frame by writeLanes (no per-frame allocation).
180:   const scratchIds: number[] = [];
181:   const scratchSlots: number[] = [];
182:   const scratchOffsets = new Float32Array(S.wordPool * GLYPHS_PER_SLOT * 3); // lit-ok: xyz per lane
183: 
184:   function freeSlot(): number {
185:     for (let s = 0; s < S.wordPool; s++) {
186:       if (!actives.some((w) => w.slot === s)) return s;
187:     }
188:     return -1;
189:   }
190: 
191:   function cameraAxes(): void {
192:     camRight.set(1, 0, 0).applyQuaternion(field.camera.quaternion);
193:     camUp.set(0, 1, 0).applyQuaternion(field.camera.quaternion);
194:   }
195: 
196:   // Phones (S05 phone row): keep the billboarded word box inside the
197:   // viewport inset by the gutter, sliding the drift point along the
198:   // camera's right and up axes by the overflow. Fine (desktop) words are
199:   // not clamped.
200:   const corner = new THREE.Vector3();
201:   function clampToView(chars: number, pos: THREE.Vector3): void {
202:     if (currentVariant() !== 'coarse') return;
203:     if (!f.worldToScreen || !f.viewportCss || advance <= 0) return;
204:     const half = (chars * advance) / 2;
205:     const bounds = [-half, boxY[0], half, boxY[1]];
206:     const [vw, vh] = f.viewportCss();
207:     const m = T.space.gutterPx.base;
208:     let x0 = Infinity;
209:     let x1 = -Infinity;
210:     let y0 = Infinity;
211:     let y1 = -Infinity;
212:     for (const bx of [bounds[0], bounds[2]]) {
213:       for (const by of [bounds[1], bounds[3]]) {
214:         corner.copy(pos).addScaledVector(camRight, bx).addScaledVector(camUp, by);
215:         const [sx, sy] = f.worldToScreen([corner.x, corner.y, corner.z]);
216:         x0 = Math.min(x0, sx);
217:         x1 = Math.max(x1, sx);
218:         y0 = Math.min(y0, sy);
219:         y1 = Math.max(y1, sy);
220:       }
221:     }
222:     const wPx = Math.max(1, x1 - x0);
223:     const hPx = Math.max(1, y1 - y0);
224:     const pxPerWorldX = wPx / Math.max(1e-6, bounds[2] - bounds[0]); // lit-ok: zero-width guard
225:     const pxPerWorldY = hPx / Math.max(1e-6, bounds[3] - bounds[1]); // lit-ok: zero-height guard
226:     let dx = 0;
227:     let dy = 0;
228:     if (wPx > vw - 2 * m) dx = vw / 2 - (x0 + x1) / 2;
229:     else if (x0 < m) dx = m - x0;
230:     else if (x1 > vw - m) dx = vw - m - x1;
231:     if (hPx > vh - 2 * m) dy = vh / 2 - (y0 + y1) / 2;
232:     else if (y0 < m) dy = m - y0;
233:     else if (y1 > vh - m) dy = vh - m - y1;
234:     if (dx !== 0) pos.addScaledVector(camRight, dx / pxPerWorldX);
235:     if (dy !== 0) pos.addScaledVector(camUp, -dy / pxPerWorldY);
236:   }
237: 
238:   // Drift point of a word at life t, clamped on phones.
239:   function wordPoint(w: ActiveWord, t: number, out: THREE.Vector3): THREE.Vector3 {
240:     positionAt(t, w.ySign, out);
241:     clampToView(w.text.length, out);
242:     return out;
243:   }
244: 
245:   // Character point: the drift point plus the advance along camera right.
246:   function charPoint(w: ActiveWord, g: Glyph, center: THREE.Vector3, out: THREE.Vector3): THREE.Vector3 {
247:     const k = g.index - (w.text.length - 1) / 2;
248:     return out.copy(center).addScaledVector(camRight, k * advance);
