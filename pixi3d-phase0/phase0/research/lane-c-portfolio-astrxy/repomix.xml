212:       const x = Math.max(0, Math.floor((r.left - pad) * dpr));
213:       const y = Math.max(0, Math.floor((r.top - pad) * dpr));
214:       const w = Math.min(
215:         Math.floor(window.innerWidth * dpr) - x,
