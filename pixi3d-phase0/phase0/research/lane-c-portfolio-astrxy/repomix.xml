<file path="src/world/sidequests.ts">
  1: // SideQuests scene controller (S07): markers, trails, camera lean.
  2: // Owns two draw calls: one InstancedMesh for the three marker heads,
  3: // one for the three poles. The plan lanes themselves are the lanefield's.
  4: // Side data (markers, trails) is regenerated here from the pure layout
  5: // module with the same seed: the lanefield worker posts side data but
  6: // the lanefield instance does not expose it, and regeneration is
  7: // deterministic, so this copy is identical to the worker's.
  8: import * as THREE from 'three';
  9: import { T } from '../tokens.generated';
 10: import { generate, type SideQuestsSideData } from './layouts/sidequests';
 11: import { poseFor } from './camera';
 12: import { emitStage } from '../motion/stage';
 13: import { spring, damp, easePlain, easeSignature } from './tween';
 14: import type { Lanefield } from './types';
 15: import type { SceneController } from '../travel';
 16: 
 17: // Spring for marker position only (S07 motion rules, K-SQ-2: overshoot
 18: // never on color, opacity, or camera). Color uses easePlain, camera
 19: // uses damp.
 20: const SPRING_ZETA = 0.7; // lit-ok: S07 section 4 marker spring damping ratio
 21: const SPRING_FREQ = 3.2; // lit-ok: S07 section 4 marker spring frequency Hz
 22: const INSTANT_RATE = 1000000; // lit-ok: S07 section 4 reduced-motion "very large" uPerSec
 23: const CLAIM_EPSILON = 0.01; // lit-ok: camera follow convergence epsilon, world units
 24: 
 25: export interface SideQuestsController extends SceneController {
 26:   readonly markerCount: number;
 27:   walk(index: number): void;
 28:   setHover(index: number | null): void;
 29:   claimed(index: number): boolean;
 30:   walking(index: number): boolean;
 31:   trailLength(index: number): number;
 32:   headRestY(index: number): number;
 33:   headY(index: number): number;
 34:   headBobY(index: number): number;
 35:   headScreen(index: number): [number, number];
 36:   // Polish round: marker head at rest (no bob, hover, rise, or claim
 37:   // drop), for placement against the resting projection.
 38:   restHead(index: number): [number, number, number];
 39:   onStateChange(cb: () => void): () => void;
 40:   dispose(): void;
 41: }
 42: 
 43: interface TrailActivity {
 44:   lanes: Int32Array;
 45:   starts: Float32Array;
 46:   fades: Float32Array;
 47:   uper: Float32Array;
 48: }
 49: 
 50: interface MarkerState {
 51:   x: number;
 52:   z: number;
 53:   claimed: boolean;
 54:   walking: boolean;
 55:   walkStart: number;
 56:   walkLength: number;
 57:   claimStart: number;
 58:   riseStart: number;
 59:   hoverFrom: number;
 60:   hoverStart: number;
 61:   hoverTarget: number;
 62:   hoverLift: number;
 63:   claimAnimStart: number;
 64:   aClaim: number;
 65:   activity: TrailActivity | null;
 66: }
 67: 
 68: export function createSideQuestsController(
 69:   lanefield: Lanefield,
 70:   opts: {
 71:     seed?: number;
 72:     reducedMotion?: () => boolean;
 73:   },
 74: ): SideQuestsController {
 75:   const seed = opts.seed ?? T.world.seed;
 76:   const reducedMotion = opts.reducedMotion ?? ((): boolean => false);
 77:   const marker = T.world.sidequests.marker;
 78:   const trailRate = T.world.sidequests.trailDrawUnitsPerSec;
 79:   const follow = T.world.sidequests.cameraFollow;
 80: 
 81:   // Regenerate side data deterministically (same seed as the worker).
 82:   const tex = T.world.layoutTexture;
 83:   const scratch = new Float32Array(
 84:     tex.width * tex.height * 4, // lit-ok: RGBA texel component count
 85:   );
 86:   const side: SideQuestsSideData = generate(seed, scratch, 2); // lit-ok: S02 layout index sidequests
 87:   const layoutCount = T.world.layouts.length;
 88:   const pointsPerLane = T.world.pointsPerLane;
 89: 
 90:   // Texel index for lane L, sidequests layout, point k (S02 layout chapter).
 91:   function lanePoint(lane: number, k: number): [number, number, number] {
 92:     const base =
 93:       (lane * (layoutCount * pointsPerLane) +
 94:         2 * pointsPerLane + // lit-ok: S02 layout index sidequests
 95:         k) *
 96:       4; // lit-ok: RGBA texel component count
 97:     return [scratch[base], scratch[base + 1], scratch[base + 2]];
 98:   }
 99: 
100:   // Point at arc distance d along trail i, from the lane points.
101:   function trailPointAt(i: number, d: number): [number, number, number] {
102:     const trail = side.trails[i];
103:     let lane = trail.laneIds.length - 1;
104:     for (let j = 0; j < trail.laneIds.length; j++) {
105:       if (d < trail.arcStarts[j] + trail.arcLengths[j]) {
106:         lane = j;
107:         break;
108:       }
109:     }
110:     const laneId = trail.laneIds[lane];
111:     const local = Math.min(
112:       Math.max(d - trail.arcStarts[lane], 0),
113:       trail.arcLengths[lane],
114:     );
115:     const frac = trail.arcLengths[lane] > 0 ? local / trail.arcLengths[lane] : 0;
116:     const f = frac * (pointsPerLane - 1);
117:     const k0 = Math.min(Math.floor(f), pointsPerLane - 2);
118:     const k1 = k0 + 1;
119:     const t = f - k0;
120:     const p0 = lanePoint(laneId, k0);
121:     const p1 = lanePoint(laneId, k1);
122:     return [
123:       p0[0] + (p1[0] - p0[0]) * t,
124:       p0[1] + (p1[1] - p0[1]) * t,
125:       p0[2] + (p1[2] - p0[2]) * t,
126:     ];
127:   }
128: 
129:   const restY = marker.poleHeight + marker.radius * marker.squashY;
130: 
131:   const markers: MarkerState[] = side.markers.map(([x, z], i) => {
132:     // Walk length is the arc distance to the end of the last dash
133:     // (polish round). The dash starts include the gaps (layout:
134:     // s += dash + gap), so the old sum of dash lengths alone was the
135:     // dash share of the arc (dash over dash plus gap), and the marker
136:     // claimed while the light was still that far short of it.
137:     const tr = side.trails[i];
138:     const last = tr.arcStarts.length - 1;
139:     const walkLength = last >= 0 ? tr.arcStarts[last] + tr.arcLengths[last] : 0;
140:     return {
141:       x,
142:       z,
143:       claimed: false,
144:       walking: false,
145:       walkStart: 0,
146:       walkLength,
147:       claimStart: -1,
148:       riseStart: -1,
149:       hoverFrom: 0,
150:       hoverStart: 0,
151:       hoverTarget: 0,
152:       hoverLift: 0,
153:       claimAnimStart: -1,
154:       aClaim: 0,
155:       activity: null,
156:     };
157:   });
158: 
159:   // Head geometry: octahedron, squashed y, flat two-tone vertex colors
160:   // (chalk upper faces, chalk 2 lower faces, by face centroid y).
161:   const headGeoRaw = new THREE.OctahedronGeometry(marker.radius, 0);
162:   const headGeo = headGeoRaw.index ? headGeoRaw.toNonIndexed() : headGeoRaw;
163:   headGeo.scale(1, marker.squashY, 1);
164:   const posAttr = headGeo.getAttribute('position') as THREE.BufferAttribute;
165:   const colors = new Float32Array(posAttr.count * 3); // lit-ok: RGB channels
166:   const chalk = new THREE.Color(T.color.chalk);
167:   const chalk2 = new THREE.Color(T.color.chalk2);
168:   for (let f = 0; f < posAttr.count; f += 3) { // lit-ok: vertices per triangle face
169:     const cy =
170:       (posAttr.getY(f) + posAttr.getY(f + 1) + posAttr.getY(f + 2)) / 3; // lit-ok: face centroid mean
171:     const c = cy > 0 ? chalk : chalk2;
172:     for (let v = 0; v < 3; v++) { // lit-ok: vertices per triangle face
173:       colors[(f + v) * 3] = c.r;
174:       colors[(f + v) * 3 + 1] = c.g;
175:       colors[(f + v) * 3 + 2] = c.b;
176:     }
177:   }
178:   headGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3)); // lit-ok: RGB channels
179:   const claimAttr = new THREE.InstancedBufferAttribute(
180:     new Float32Array(markers.length),
181:     1,
182:   );
183:   headGeo.setAttribute('aClaim', claimAttr);
184: 
185:   const headMat = new THREE.MeshBasicMaterial({ vertexColors: true });
186:   headMat.onBeforeCompile = (shader): void => {
187:     shader.vertexShader =
188:       'attribute float aClaim;\nvarying float vClaim;\n' +
189:       shader.vertexShader.replace(
190:         '#include <begin_vertex>',
191:         '#include <begin_vertex>\nvClaim = aClaim;',
192:       );
193:     shader.fragmentShader =
194:       'varying float vClaim;\nuniform vec3 uSignal;\nuniform vec3 uSignalDim;\n' +
195:       shader.fragmentShader.replace(
196:         '#include <color_fragment>',
197:         `#include <color_fragment>
198:         vec3 claimedCol = vColor.r > 0.9 ? uSignal : uSignalDim; // lit-ok: chalk/chalk2 red threshold
199:         diffuseColor.rgb = mix(diffuseColor.rgb, claimedCol, vClaim);`,
200:       );
201:     shader.uniforms.uSignal = { value: new THREE.Color(T.color.signal) };
202:     shader.uniforms.uSignalDim = { value: new THREE.Color(T.color.signalDim) };
203:   };
204:   headMat.customProgramCacheKey = (): string => 'sq-head';
205: 
206:   const heads = new THREE.InstancedMesh(headGeo, headMat, markers.length);
207:   const poleGeo = new THREE.CylinderGeometry(
208:     marker.poleRadius,
209:     marker.poleRadius,
210:     marker.poleHeight,
211:     6, // lit-ok: S07 section 3.3 pole radial segments
212:   );
213:   const poles = new THREE.InstancedMesh(
214:     poleGeo,
215:     new THREE.MeshBasicMaterial({ color: T.color.chalk2 }),
216:     markers.length,
217:   );
218:   const dummy = new THREE.Object3D();
219:   for (let i = 0; i < markers.length; i++) {
220:     dummy.position.set(markers[i].x, marker.poleHeight / 2, markers[i].z);
221:     dummy.updateMatrix();
222:     poles.setMatrixAt(i, dummy.matrix);
223:     dummy.position.set(markers[i].x, 0, markers[i].z);
224:     dummy.updateMatrix();
225:     heads.setMatrixAt(i, dummy.matrix);
226:   }
227:   heads.instanceMatrix.needsUpdate = true;
228:   poles.instanceMatrix.needsUpdate = true;
229:   heads.visible = false;
230:   poles.visible = false;
231:   lanefield.scene.add(heads);
232:   lanefield.scene.add(poles);
233: 
234:   // Per-frame head y (without bob separation for the test hook).
235:   const headYs: number[] = markers.map(() => 0);
236:   const headBobs: number[] = markers.map(() => 0);
237:   let suspended = true;
238:   let sinking = false;
239:   let sinkStart = 0;
240:   const followPoint = new THREE.Vector3();
241:   let followApplied = false;
242:   const stateListeners = new Set<() => void>();
243:   const notify = (): void => {
244:     for (const cb of stateListeners) cb();
245:   };
246: 
247:   // The lean base includes the camera focus pan (polish round): the
248:   // rig translates position and target together, so the lean must look
249:   // at the panned target or it would rotate the panned camera back.
250:   function baseTarget(): [number, number, number] {
251:     const pose = poseFor('sidequests');
252:     const off = lanefield.focusOffset();
253:     return [pose.target[0] + off[0], pose.target[1], pose.target[2] + off[1]];
254:   }
255:   // Release the camera pan once the claim settles (stage grammar).
256:   let releaseAt: number | null = null;
257: 
258:   function springAt(start: number, t: number): number {
259:     if (t < start) return 0;
260:     return spring(SPRING_ZETA, SPRING_FREQ)(t - start);
261:   }
262: 
263:   function walk(i: number): void {
264:     const m = markers[i];
265:     if (m.walking) return;
266:     const now = lanefield.now();
267:     const trail = side.trails[i];
268:     const lanes = new Int32Array(trail.laneIds);
269:     const starts = new Float32Array(trail.laneIds.length);
270:     const fades = new Float32Array(trail.laneIds.length);
271:     const uper = new Float32Array(trail.laneIds.length);
272:     if (reducedMotion()) {
273:       for (let j = 0; j < trail.laneIds.length; j++) {
274:         starts[j] = now;
275:         uper[j] = INSTANT_RATE;
276:       }
277:     } else {
278:       for (let j = 0; j < trail.laneIds.length; j++) {
279:         starts[j] = now + trail.arcStarts[j] / trailRate;
280:         uper[j] = trailRate / trail.arcLengths[j];
281:       }
282:     }
283:     if (m.claimed) {
284:       // Re-walk: clear all kind-2 activity, re-light every other active
285:       // trail from its stored arrays (absolute start times resume the
286:       // draw), then light this trail fresh.
287:       lanefield.clearActivity(2);
288:       for (let j = 0; j < markers.length; j++) {
289:         if (j !== i && markers[j].activity) {
290:           const a = markers[j].activity as TrailActivity;
291:           lanefield.setActivity(a.lanes, a.starts, a.fades, 2, a.uper);
292:         }
293:       }
294:     }
295:     lanefield.setActivity(lanes, starts, fades, 2, uper);
296:     m.activity = { lanes, starts, fades, uper };
297:     m.walking = true;
298:     m.walkStart = now;
299:     // The lean starts from where the camera already looks (the base
300:     // target, pan included) and damps toward the drawing point. The old
301:     // start at the trailhead itself snapped the view to the trailhead on the // lit-ok: comment
302:     // first walk frame (device-run-2 trace: pitch from rest to the band // lit-ok: comment
303:     // edge in one frame) before damping back.
304:     if (!followApplied) {
305:       const b0 = baseTarget();
306:       followPoint.set(b0[0], b0[1], b0[2]);
307:     }
308:     releaseAt = null;
309:     emitStage({ type: 'subject', layout: 'sidequests', ground: [m.x, m.z] });
310:     if (reducedMotion()) {
311:       m.walking = false;
312:       m.claimed = true;
313:       m.aClaim = 1;
314:       claimAttr.setX(i, 1);
315:       claimAttr.needsUpdate = true;
316:       notify();
317:       emitStage({ type: 'land', layout: 'sidequests', ground: [m.x, m.z] });
318:       emitStage({ type: 'release', layout: 'sidequests' });
319:     }
320:   }
321: 
322:   function doClaim(i: number, t: number): void {
323:     const m = markers[i];
324:     m.walking = false;
325:     m.claimed = true;
326:     m.claimStart = t;
327:     m.claimAnimStart = t;
328:     notify();
329:     // The quest lands in the mark: the pulse departs from this marker.
330:     emitStage({ type: 'land', layout: 'sidequests', ground: [m.x, m.z] });
331:     releaseAt = t + T.motion.ms.travel / 1000; // lit-ok: ms to seconds
332:   }
333: 
334:   const offFrame = lanefield.onFrame((t, dt) => {
335:     const dtMs = dt * 1000; // lit-ok: seconds to milliseconds
336:     if (releaseAt !== null && t >= releaseAt) {
337:       releaseAt = null;
338:       emitStage({ type: 'release', layout: 'sidequests' });
339:     }
340:     const reduced = reducedMotion();
341:     let anyWalking = false;
342:     let walkingTrail = -1;
343:     for (let i = 0; i < markers.length; i++) {
344:       const m = markers[i];
345:       if (m.walking && t >= m.walkStart + m.walkLength / trailRate) {
346:         doClaim(i, t);
347:       }
348:       if (m.walking) {
349:         anyWalking = true;
350:         walkingTrail = i;
351:       }
352:       // Claim color transition over fast ms with plain ease; instant
353:       // when reduced. Not a spring (K-SQ-2).
354:       if (m.claimAnimStart >= 0 && m.aClaim < 1) {
355:         if (reduced) {
356:           m.aClaim = 1;
357:         } else {
358:           const p = Math.min(
359:             (t - m.claimAnimStart) / (T.motion.ms.fast / 1000), // lit-ok: ms to seconds
360:             1,
361:           );
362:           m.aClaim = easePlain(p);
363:         }
364:         claimAttr.setX(i, m.aClaim);
365:         claimAttr.needsUpdate = true;
366:       }
367:       // Hover lift by spring toward its target; ignored when reduced.
368:       if (!reduced && (m.hoverTarget !== m.hoverLift || m.hoverStart > 0)) {
369:         const s = springAt(m.hoverStart, t);
370:         m.hoverLift = m.hoverTarget + (m.hoverFrom - m.hoverTarget) * (1 - s);
371:         if (s >= 1) {
372:           m.hoverLift = m.hoverTarget;
373:           m.hoverStart = 0;
374:         }
375:       } else if (reduced) {
376:         m.hoverLift = 0;
377:       }
378:       // Head y composition.
379:       let y: number;
380:       if (suspended) {
381:         y = 0;
382:       } else if (sinking) {
383:         const p = Math.min((t - sinkStart) / (T.motion.ms.travel / 1000), 1); // lit-ok: ms to seconds
384:         const bob = reduced
385:           ? 0
386:           : marker.bobAmp *
387:             Math.sin(
388:               (2 * Math.PI * t) / marker.bobPeriodSec + marker.bobPhases[i],
389:             );
390:         y = (restY + bob + m.hoverLift) * (1 - easeSignature(p));
391:         if (p >= 1) {
392:           suspended = true;
393:           sinking = false;
394:           heads.visible = false;
395:           poles.visible = false;
396:           y = 0;
397:         }
398:       } else if (m.riseStart >= 0 && t < m.riseStart) {
399:         y = 0;
400:       } else if (m.riseStart >= 0) {
401:         const bob = reduced
402:           ? 0
403:           : marker.bobAmp *
404:             Math.sin(
405:               (2 * Math.PI * t) / marker.bobPeriodSec + marker.bobPhases[i],
406:             );
407:         y = restY * springAt(m.riseStart, t) + bob + m.hoverLift;
408:       } else {
409:         const bob = reduced
410:           ? 0
411:           : marker.bobAmp *
412:             Math.sin(
413:               (2 * Math.PI * t) / marker.bobPeriodSec + marker.bobPhases[i],
414:             );
415:         y = restY + bob + m.hoverLift;
416:       }
417:       // Claim drop: from rest + claimDrop down to rest by spring, one
418:       // overshoot below rest (S07 motion rules). Added on top of bob and
419:       // hover so the test can subtract bob for the spring numbers test.
420:       if (m.claimStart >= 0 && !reduced) {
421:         y += marker.claimDrop * (1 - springAt(m.claimStart, t));
422:         if (t - m.claimStart > 1) {
423:           m.claimStart = -1;
424:         }
425:       }
426:       headYs[i] = y;
427:       headBobs[i] = reduced
428:         ? 0
429:         : marker.bobAmp *
430:           Math.sin(
431:             (2 * Math.PI * t) / marker.bobPeriodSec + marker.bobPhases[i],
432:           );
433:       dummy.position.set(m.x, y, m.z);
434:       dummy.updateMatrix();
435:       heads.setMatrixAt(i, dummy.matrix);
436:     }
437:     heads.instanceMatrix.needsUpdate = true;
438: 
439:     // Camera lean: target damps (half-life from DESIGN) toward a point
440:     // a quarter of the way from the base target to the current drawing point
441:     // while drawing, then back to the base pose. Applied after the rig
442:     // (onFrame runs after rig.update, before render), so it survives to
443:     // the frame; when converged the rig resumes full control.
444:     const base = baseTarget();
445:     let lean: [number, number, number] | null = null;
446:     // Coarse tracking (polish round): while a stage focus is active the
447:     // camera pan follows the drawing point, so the lean yields to it
448:     // (a lean would rotate the view away from what the pan brings in).
449:     const tracking = lanefield.focusActive();
450:     if (!reduced && anyWalking && walkingTrail >= 0 && !tracking) {
451:       const m = markers[walkingTrail];
452:       const d = Math.min(
453:         Math.max((t - m.walkStart) * trailRate, 0),
454:         m.walkLength,
455:       );
456:       const pt = trailPointAt(walkingTrail, d);
457:       lean = [
458:         base[0] + follow.weight * (pt[0] - base[0]),
459:         base[1] + follow.weight * (pt[1] - base[1]),
460:         base[2] + follow.weight * (pt[2] - base[2]),
461:       ];
462:     } else if (followApplied) {
463:       lean = base;
464:     }
465:     if (lean) {
466:       followPoint.x = damp(followPoint.x, lean[0], follow.halfLifeMs, dtMs);
467:       followPoint.y = damp(followPoint.y, lean[1], follow.halfLifeMs, dtMs);
468:       followPoint.z = damp(followPoint.z, lean[2], follow.halfLifeMs, dtMs);
469:       const dx = followPoint.x - base[0];
470:       const dy = followPoint.y - base[1];
471:       const dz = followPoint.z - base[2];
472:       if (
473:         !anyWalking &&
474:         Math.sqrt(dx * dx + dy * dy + dz * dz) < CLAIM_EPSILON
475:       ) {
476:         followApplied = false;
477:       } else {
478:         lanefield.camera.lookAt(followPoint.x, followPoint.y, followPoint.z);
479:         lanefield.camera.updateMatrixWorld();
480:         followApplied = true;
481:       }
482:     }
483:   });
