262:   function nearestFree(p: THREE.Vector3, taken: ReadonlySet<number>): number {
263:     if (!lanes) return -1;
264:     let best = -1;
265:     let bestD = Infinity;
266:     for (let l = 0; l < laneCount; l++) {
267:       if (taken.has(l) || lanes.words.held(l)) continue;
268:       const dx = tips[l * 3] - p.x;
269:       const dy = tips[l * 3 + 1] - p.y;
270:       const dz = tips[l * 3 + 2] - p.z; // lit-ok: z component
271:       const d = dx * dx + dy * dy + dz * dz;
272:       if (d < bestD) {
273:         bestD = d;
274:         best = l;
275:       }
276:     }
277:     return best;
278:   }
279: 
280:   function takenLanes(): Set<number> {
281:     const taken = new Set<number>();
282:     for (const w of actives) for (const g of w.glyphs) if (g.lane >= 0) taken.add(g.lane);
283:     return taken;
284:   }
