  1: import { useHotkeys } from '@astryxdesign/core';
  2: import type { Hotkey } from '@astryxdesign/core';
  3: import { C } from './copy';
  4: import { T } from './tokens.generated';
  5: import type { LayoutId, Regime } from './world/types';
  6: 
  7: // S03 section 2: routes. Scene order for adjacency keys: server (1),
  8: // leaflink (2), sidequests (3). The 404 scene is outside the order.
  9: export type SceneId = 'server' | 'leaflink' | 'sidequests' | 'notfound';
 10: export type SheetId = 'whoami' | 'contact' | 'guestbook' | null;
 11: 
 12: export const SCENE_ORDER: SceneId[] = ['server', 'leaflink', 'sidequests'];
 13: 
 14: export const SCENE_PATH: Record<SceneId, string> = {
 15:   server: '/',
 16:   leaflink: '/leaflink',
 17:   sidequests: '/sidequests',
 18:   notfound: '/404',
 19: };
 20: 
 21: export const SCENE_LAYOUT: Record<SceneId, LayoutId> = {
 22:   server: 'server',
 23:   leaflink: 'leaflink',
 24:   sidequests: 'sidequests',
 25:   notfound: 'scatter',
 26: };
 27: 
 28: export const SCENE_REGIME: Record<SceneId, Regime> = {
 29:   server: 'void',
 30:   leaflink: 'paper',
 31:   sidequests: 'field',
 32:   notfound: 'void',
 33: };
 34: 
 35: // DESIGN section 3.2 prose: void and field are color-scheme dark, paper
 36: // is color-scheme light, so Astryx light-dark() tokens resolve correctly.
 37: export const REGIME_COLOR_SCHEME: Record<Regime, 'dark' | 'light'> = {
 38:   void: 'dark',
 39:   paper: 'light',
 40:   field: 'dark',
 41: };
 42: 
 43: export const SCENE_TITLE: Record<SceneId, string> = {
 44:   server: C['C-TITLE-SERVER'],
 45:   leaflink: C['C-TITLE-LEAFLINK'],
 46:   sidequests: C['C-TITLE-SIDEQUESTS'],
 47:   notfound: C['C-TITLE-404'],
 48: };
 49: 
 50: export const SCENE_H1: Record<SceneId, string> = {
 51:   server: C['C-SRV-H1'],
 52:   leaflink: C['C-LL-H1'],
 53:   sidequests: C['C-SQ-H1'],
 54:   notfound: C['C-404-H1'],
 55: };
 56: 
 57: // S03 section 2: trailing slashes normalize to no slash, uppercase
 58: // normalizes to lowercase. Unknown paths are the 404 scene.
 59: export function parsePath(pathname: string): SceneId {
 60:   let p = pathname.toLowerCase();
 61:   if (p.length > 1 && p.endsWith('/')) p = p.slice(0, -1);
 62:   switch (p) {
 63:     case '/':
 64:       return 'server';
 65:     case '/leaflink':
 66:       return 'leaflink';
 67:     case '/sidequests':
 68:       return 'sidequests';
 69:     default:
 70:       return 'notfound';
 71:   }
 72: }
 73: 
 74: export function sceneToPath(scene: SceneId): string {
 75:   return SCENE_PATH[scene];
 76: }
 77: 
 78: // S03 section 2: sheets are not routes. #whoami and #contact open the
 79: // matching sheet over the current scene.
 80: export function parseHash(hash: string): SheetId {
 81:   if (hash === '#whoami') return 'whoami';
 82:   if (hash === '#contact') return 'contact';
 83:   if (hash === T.guestbook.hash) return 'guestbook';
 84:   return null;
 85: }
 86: 
 87: export function sheetToHash(sheet: SheetId): string {
 88:   if (sheet === 'whoami') return '#whoami';
 89:   if (sheet === 'contact') return '#contact';
 90:   if (sheet === 'guestbook') return T.guestbook.hash;
 91:   return '';
 92: }
 93: 
 94: // S03 section 6: ArrowLeft / ArrowRight move in scene order, wrapping.
 95: // From 404, ArrowRight goes to server; ArrowLeft wraps to the end of the
 96: // order (sidequests), the symmetric completion of the wrapping rule.
 97: export function stepScene(current: SceneId, dir: 1 | -1): SceneId {
 98:   if (current === 'notfound') {
 99:     return dir === 1 ? 'server' : 'sidequests';
100:   }
101:   const idx = SCENE_ORDER.indexOf(current);
102:   const next = (idx + dir + SCENE_ORDER.length) % SCENE_ORDER.length;
103:   return SCENE_ORDER[next];
104: }
105: 
106: export interface RouterState {
107:   scene: SceneId;
108:   sheet: SheetId;
109: }
110: 
111: export interface RouterCallbacks {
112:   onSceneChange: (scene: SceneId, source: 'go' | 'pop') => void;
113:   onSheetChange: (sheet: SheetId) => void;
114: }
115: 
116: export interface Router {
117:   readonly state: RouterState;
118:   go: (scene: SceneId) => void;
119:   setSheet: (sheet: SheetId) => void;
120:   dispose: () => void;
121: }
122: 
123: function currentUrl(scene: SceneId, sheet: SheetId): string {
124:   return sceneToPath(scene) + sheetToHash(sheet);
125: }
126: 
127: // S03 section 3: go() pushes state then runs travel (via onSceneChange).
128: // popstate runs travel without pushing. setSheet uses replaceState, so
129: // closing a sheet does not cost a back press.
130: export function createRouter(
131:   initial: RouterState,
132:   callbacks: RouterCallbacks,
133: ): Router {
134:   const state: RouterState = { ...initial };
135: 
136:   function onPopState(): void {
137:     const scene = parsePath(window.location.pathname);
138:     const sheet = parseHash(window.location.hash);
139:     const sceneChanged = scene !== state.scene;
140:     const sheetChanged = sheet !== state.sheet;
141:     state.scene = scene;
142:     state.sheet = sheet;
143:     if (sceneChanged) callbacks.onSceneChange(scene, 'pop');
144:     if (sheetChanged) callbacks.onSheetChange(sheet);
145:   }
146: 
147:   window.addEventListener('popstate', onPopState);
148: 
149:   function onDocumentClick(event: MouseEvent): void {
150:     if (event.button !== 0) return;
151:     if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
152:     const anchor = (event.target as HTMLElement | null)?.closest?.('a[data-route]');
153:     if (!anchor) return;
154:     const href = anchor.getAttribute('href');
155:     if (!href) return;
156:     let url: URL;
157:     try {
158:       url = new URL(href, window.location.href);
159:     } catch {
160:       return;
161:     }
162:     if (url.origin !== window.location.origin) return;
163:     if (anchor.getAttribute('target') && anchor.getAttribute('target') !== '_self') return;
164:     event.preventDefault();
165:     go(parsePath(url.pathname));
166:   }
167: 
168:   document.addEventListener('click', onDocumentClick);
169: 
170:   function go(scene: SceneId): void {
171:     if (scene === state.scene) return;
172:     state.scene = scene;
173:     window.history.pushState({ scene }, '', currentUrl(scene, state.sheet));
174:     callbacks.onSceneChange(scene, 'go');
175:   }
176: 
177:   function setSheet(sheet: SheetId): void {
178:     if (sheet === state.sheet) return;
179:     state.sheet = sheet;
180:     window.history.replaceState(
181:       { scene: state.scene },
182:       '',
183:       currentUrl(state.scene, sheet),
184:     );
185:     callbacks.onSheetChange(sheet);
186:   }
187: 
188:   return {
189:     state,
190:     go,
191:     setSheet,
192:     dispose(): void {
193:       window.removeEventListener('popstate', onPopState);
194:       document.removeEventListener('click', onDocumentClick);
195:     },
196:   };
197: }
198: 
199: // S03 section 6: keyboard bindings. Registered once with Astryx
200: // useHotkeys (S04 owns the visual Keymap). Bindings are disabled while
201: // a sheet is open, except the sheet's own key (isDisabled on the
202: // entries). Escape is NOT handled here: BottomSheet handles it itself,
203: // do not double-handle. Never active inside inputs: useHotkeys defaults
204: // allowInInputs to false, which is the guard.
205: export interface TravelHotkeysProps {
206:   go: (scene: SceneId) => void;
207:   step: (dir: 1 | -1) => void;
208:   toggleSheet: (sheet: Exclude<SheetId, null>) => void;
209:   sheet: SheetId;
210: }
211: 
212: function noModifier(event: KeyboardEvent): boolean {
213:   return !event.metaKey && !event.ctrlKey && !event.altKey;
214: }
215: 
216: export function buildTravelHotkeyEntries(props: TravelHotkeysProps): Hotkey[] {
217:   const sheetOpen = props.sheet !== null;
218:   return [
219:     {
220:       keys: '1',
221:       onPress: (e) => {
222:         if (noModifier(e)) props.go('server');
223:       },
224:       isDisabled: sheetOpen,
225:     },
226:     {
227:       keys: '2',
228:       onPress: (e) => {
229:         if (noModifier(e)) props.go('leaflink');
230:       },
231:       isDisabled: sheetOpen,
232:     },
233:     {
234:       keys: '3',
235:       onPress: (e) => {
236:         if (noModifier(e)) props.go('sidequests');
237:       },
238:       isDisabled: sheetOpen,
239:     },
240:     {
241:       keys: 'left',
242:       onPress: (e) => {
243:         if (noModifier(e)) props.step(-1);
244:       },
245:       isDisabled: sheetOpen,
246:     },
247:     {
248:       keys: 'right',
249:       onPress: (e) => {
250:         if (noModifier(e)) props.step(1);
251:       },
252:       isDisabled: sheetOpen,
253:     },
254:     {
255:       keys: 'w',
256:       onPress: (e) => {
257:         if (noModifier(e)) props.toggleSheet('whoami');
258:       },
259:       isDisabled: props.sheet === 'contact' || props.sheet === 'guestbook',
260:     },
261:     {
262:       keys: 'c',
263:       onPress: (e) => {
264:         if (noModifier(e)) props.toggleSheet('contact');
265:       },
266:       isDisabled: props.sheet === 'whoami' || props.sheet === 'guestbook',
267:     },
268:   ];
269: }
270: 
271: // No JSX: this component only registers hotkeys and renders nothing, so
272: // it lives in a .ts file. B4 mounts it inside App in wave 2.
273: export function TravelHotkeys(props: TravelHotkeysProps): null {
274:   useHotkeys(buildTravelHotkeyEntries(props));
275:   return null;
276: }
</file>

<file path="tests/feedback-round/asset.spec.ts">
  1: // T-ASSET-1 to T-ASSET-4 (feedback round W3, P-ASSET-2).
  2: // These run against files on disk plus the manifest; they need no
  3: // browser. T-ASSET-5 lives in asset-prefetch.spec.ts (P-ASSET-3).
  4: //
  5: // Fringe rule (T-ASSET-4): an edge pixel is an opaque or
  6: // semi-opaque pixel with a fully transparent 4-neighbour. It fails
  7: // when all three channels are at least 240 (near white). A second
  8: // count covers semi-transparent near-white pixels anywhere, since
  9: // those would also read as a white halo on the navy field.
 10: import { test, expect } from '@playwright/test';
 11: import { createHash } from 'node:crypto';
 12: import { execFileSync } from 'node:child_process';
 13: import { existsSync, readFileSync } from 'node:fs';
 14: import { join } from 'node:path';
 15: 
 16: const ROOT = process.cwd();
 17: const BRAND = join(ROOT, 'public', 'brand');
 18: const MANIFEST = join(BRAND, 'manifest.json');
 19: const SOURCES = join(ROOT, 'assets-src', 'brand', 'SOURCES.json');
 20: 
 21: const GIF_MAX_BYTES = 900000;
 22: const GIF_MAX_DECODED = 48000000;
 23: 
 24: function sha256(path: string): string {
 25:   return createHash('sha256').update(readFileSync(path)).digest('hex');
 26: }
 27: 
 28: function pyOut(script: string, args: string[]): string {
 29:   return execFileSync('python3', ['-c', script, ...args], {
 30:     encoding: 'utf8',
 31:     timeout: 300000,
 32:   });
 33: }
 34: 
 35: function loadManifest(): any {
 36:   expect(existsSync(MANIFEST), 'manifest.json must exist').toBe(true);
 37:   return JSON.parse(readFileSync(MANIFEST, 'utf8'));
 38: }
 39: 
 40: function loadSources(): any {
 41:   return JSON.parse(readFileSync(SOURCES, 'utf8'));
 42: }
 43: 
 44: test('T-ASSET-1: manifest matches the files and SOURCES.json', async () => {
 45:   const manifest = loadManifest();
 46:   const sources = loadSources();
 47:   const byFile = new Map<string, any>();
 48:   for (const s of sources.sources) byFile.set(s.file, s);
 49:   const shipped: any[] = [
 50:     manifest.heroes.sidequests.gif,
 51:     manifest.heroes.sidequests.frame0,
 52:     manifest.heroes.leaflink.png,
 53:   ];
 54:   expect(shipped.length).toBe(3);
 55:   for (const entry of shipped) {
 56:     const p = join(BRAND, entry.file);
 57:     expect(existsSync(p), `${entry.file} must exist in public/brand`).toBe(true);
 58:     expect(sha256(p)).toBe(entry.sha256);
 59:     expect(entry.bytes).toBe(readFileSync(p).length);
 60:     expect(entry.sourceSha256).toBe(entry.sha256);
 61:   }
 62:   // The shipped source files must match the SOURCES.json pins.
 63:   expect(manifest.heroes.sidequests.gif.sourceSha256).toBe(
 64:     byFile.get('sidequests.gif').sha256,
 65:   );
 66:   expect(manifest.heroes.leaflink.png.sourceSha256).toBe(
 67:     byFile.get('logo.png').sha256,
 68:   );
 69:   // The manifest must name the shipped LeafLink mark and the decision.
 70:   expect(manifest.leaflinkHeroDecision.mark).toBe('logo.png');
 71:   // Nothing excluded may appear as a shipped file.
 72:   const names = shipped.map((e) => e.file);
 73:   expect(names.join(' ')).not.toContain('alpha');
 74:   expect(names.join(' ')).not.toContain('leaves');
 75:   expect(names.join(' ')).not.toContain('circuit');
 76:   expect(names.join(' ')).not.toContain('gears');
 77: });
 78: 
 79: test('T-ASSET-2: shipped GIF and PNG files are under budget', async () => {
 80:   const manifest = loadManifest();
 81:   const shipped: any[] = [
 82:     manifest.heroes.sidequests.gif,
 83:     manifest.heroes.sidequests.frame0,
 84:     manifest.heroes.leaflink.png,
 85:   ];
 86:   for (const entry of shipped) {
 87:     expect(entry.bytes).toBeLessThanOrEqual(GIF_MAX_BYTES);
 88:     const decoded = entry.width * entry.height * 4 * entry.frames;
 89:     expect(decoded).toBeLessThanOrEqual(GIF_MAX_DECODED);
 90:     expect(entry.decodedBytes).toBe(decoded);
 91:   }
 92:   // Spot values from the W0 measurements, re-verified here.
 93:   expect(manifest.heroes.sidequests.gif.bytes).toBe(42591);
 94:   expect(manifest.heroes.sidequests.gif.decodedBytes).toBe(16527360);
 95:   expect(manifest.heroes.leaflink.png.bytes).toBe(174622);
 96: });
 97: 
 98: test('T-ASSET-3: GIF frame 0 equals the PNG pixel for pixel', async () => {
 99:   const manifest = loadManifest();
100:   const gif = join(BRAND, manifest.heroes.sidequests.gif.file);
101:   const png = join(BRAND, manifest.heroes.sidequests.frame0.file);
102:   const script = `
103: import sys, json
104: import numpy as np
105: from PIL import Image
106: gif_path, png_path = sys.argv[1], sys.argv[2]
107: g = Image.open(gif_path)
108: g.seek(0)
109: ga = np.asarray(g.convert("RGBA"), dtype=np.int16)
110: pa = np.asarray(Image.open(png_path).convert("RGBA"), dtype=np.int16)
111: assert ga.shape == pa.shape, f"shape {ga.shape} vs {pa.shape}"
112: diff = int(np.abs(ga - pa).max()) if ga.size else 0
113: # Composite both on the navy field ground and compare that too: the
114: # user-visible result must also be identical, not just the RGBA planes.
115: navy = np.array([16, 41, 78], dtype=np.float64)
116: def composite(a):
117:     alpha = a[:, :, 3:4] / 255.0
118:     return a[:, :, :3] * alpha + navy * (1.0 - alpha)
119: cdiff = float(np.abs(composite(ga.astype(np.float64)) - composite(pa.astype(np.float64))).max())
120: print(json.dumps({"maxRgbaDiff": diff, "maxNavyCompositeDiff": cdiff}))
121: `;
122:   const out = JSON.parse(pyOut(script, [gif, png]));
123:   expect(out.maxRgbaDiff).toBe(0);
124:   expect(out.maxNavyCompositeDiff).toBe(0);
125: });
126: 
127: test('T-ASSET-4: no near-white edge pixels on the navy field', async () => {
128:   const manifest = loadManifest();
129:   const shipped: any[] = [
130:     manifest.heroes.sidequests.gif,
131:     manifest.heroes.sidequests.frame0,
132:     manifest.heroes.leaflink.png,
133:   ];
134:   const script = `
135: import sys, json
136: import numpy as np
137: from PIL import Image
138: def scan(path):
139:     im = Image.open(path)
140:     n = getattr(im, "n_frames", 1)
141:     edge = 0
142:     near_white_edge = 0
143:     semi_near_white = 0
144:     for i in range(n):
145:         im.seek(i)
146:         a = np.asarray(im.convert("RGBA"), dtype=np.int16)
147:         alpha = a[:, :, 3]
148:         opaque = alpha > 0
149:         trans = alpha == 0
150:         neigh = np.zeros_like(trans)
151:         neigh[1:, :] |= trans[:-1, :]
152:         neigh[:-1, :] |= trans[1:, :]
153:         neigh[:, 1:] |= trans[:, :-1]
154:         neigh[:, :-1] |= trans[:, 1:]
155:         edge_px = opaque & neigh
156:         edge += int(edge_px.sum())
157:         near = edge_px & (a[:, :, 0] >= 240) & (a[:, :, 1] >= 240) & (a[:, :, 2] >= 240)
158:         near_white_edge += int(near.sum())
159:         semi = (alpha > 0) & (alpha < 255) & (a[:, :, 0] >= 240) & (a[:, :, 1] >= 240) & (a[:, :, 2] >= 240)
160:         semi_near_white += int(semi.sum())
161:     return {"edgePx": edge, "nearWhiteEdgePx": near_white_edge, "semiNearWhitePx": semi_near_white}
162: print(json.dumps({p: scan(p) for p in sys.argv[1:]}))
163: `;
164:   const paths = shipped.map((e) => join(BRAND, e.file));
165:   const out = JSON.parse(pyOut(script, paths));
166:   for (const p of paths) {
167:     expect(out[p].nearWhiteEdgePx, `${p} near-white edge pixels`).toBe(0);
168:     expect(out[p].semiNearWhitePx, `${p} semi near-white pixels`).toBe(0);
169:     expect(out[p].edgePx).toBeGreaterThan(0);
170:   }
171: });
</file>

<file path="tests/feedback-round/camera.spec.ts">
  1: // W7 camera suite (P-QA-1): T-SQ-CAM-1, T-SQ-CAM-2, T-SQ-CAM-3,
  2: // plus fine walk lean sampling, the hero-band walk test (W6 open
  3: // item b), and a pageshow (persisted) attempt. Runs on Chromium and
  4: // on WebKit; the browser comes from the Playwright project, and the
  5: // per-browser evidence file is reports/w7-cam-<browser>.json.
  6: //
  7: // Sampling method (same as W0): an in-page requestAnimationFrame
  8: // loop reads window.__lanefield.camera, the rendered-camera
  9: // diagnostic getter, so every sampled frame is a rendered frame.
 10: // Pitch band is DESIGN tokens world.sidequests.camera.pitchMin -75
 11: // and pitchMax -5. Pitch only; yaw gets no band. A sample fails on
 12: // the first frame outside the band, or with laneCount not 6144.
 13: //
 14: // Draw calls, stated precisely: renderer.info.render.calls is a
 15: // TOTAL, and the real app scene carries route marker meshes on top
 16: // of the lane field (server adds one mesh, leaflink adds pin, halo,
 17: // and ripple meshes, sidequests adds head and pole meshes), so the
 18: // total is route-dependent and is recorded per trigger as data,
 19: // never asserted as 1 here. The one-lane-draw invariant itself is
 20: // T-LF-6 in the harness (field only, no controllers), which the
 21: // full regression runs; this file asserts laneCount 6144 on every
 22: // sampled real-app frame.
 23: //
 24: // SwiftShader note: engine frames take seconds, so a 700ms travel
 25: // resolves in one engine frame. Morph tests therefore assert every
 26: // sampled rendered frame and report the morph progress values
 27: // actually observed, rather than claiming dense mid-travel sampling
 28: // the sandbox cannot produce.
 29: import { test, expect, type Page, type Browser } from '@playwright/test';
 30: import { readFileSync, writeFileSync } from 'node:fs';
 31: import { join, dirname } from 'node:path';
 32: import { fileURLToPath } from 'node:url';
 33: 
 34: test.setTimeout(600000);
 35: 
 36: const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
 37: const DEV = 'http://localhost:5173';
 38: const HARNESS = `${DEV}/tests/world-harness.html`;
 39: const SQHARNESS = `${DEV}/tests/scenes/sidequests-harness.html`;
 40: const MIN = -75;
 41: const MAX = -5;
 42: 
 43: type Rect = [number, number, number, number];
 44: interface Sample {
 45:   pitch: number;
 46:   yaw: number;
 47:   laneCount: number;
 48:   calls: number;
 49:   morphP: number | null;
 50: }
 51: interface CamResult {
 52:   test: string;
 53:   browser: string;
 54:   verdict: string;
 55:   samples: number;
 56:   minPitch: number | null;
 57:   maxPitch: number | null;
 58:   firstOutside: Sample | null;
 59:   extra: Record<string, unknown>;
 60: }
 61: const RESULTS: CamResult[] = [];
 62: let PROJECT_NAME = 'chromium';
 63: 
 64: function projectOf(browser: Browser): string {
 65:   return browser.browserType().name();
 66: }
 67: 
 68: function record(r: CamResult): void {
 69:   RESULTS.push(r);
 70:   console.log(`CAM-RESULT ${JSON.stringify(r)}`);
 71: }
 72: 
 73: // A test that throws before its record() call still leaves evidence:
 74: // afterEach adds a failure record so the JSON file never silently
 75: // drops a test.
 76: test.afterEach(async ({}, testInfo) => {
 77:   PROJECT_NAME = testInfo.project.name || PROJECT_NAME;
 78:   if (testInfo.status !== 'passed' && !RESULTS.some((r) => r.test === testInfo.title)) {
 79:     RESULTS.push({
 80:       test: testInfo.title,
 81:       browser: PROJECT_NAME,
 82:       verdict: `fail:${testInfo.status}`,
 83:       samples: 0,
 84:       minPitch: null,
 85:       maxPitch: null,
 86:       firstOutside: null,
 87:       extra: { error: String(testInfo.error?.message ?? 'unknown').slice(0, 500) },
 88:     });
 89:   }
 90: });
 91: 
 92: test.afterAll(() => {
 93:   const browser = RESULTS.length > 0 ? RESULTS[0].browser : PROJECT_NAME;
 94:   const out = join(ROOT, `reports/w7-cam-${browser}.json`);
 95:   // Merge, never overwrite blind: the worker module state can reset
 96:   // mid-run (observed: afterAll fired twice in one run), so a later
 97:   // write must keep earlier results and replace same-name entries
 98:   // with the newer record. A full run therefore converges to the
 99:   // complete set even across a reset.
100:   let merged: CamResult[] = [];
101:   try {
102:     const prev = JSON.parse(readFileSync(out, 'utf8')) as { results?: CamResult[] };
103:     if (Array.isArray(prev.results)) merged = prev.results;
104:   } catch {
105:     merged = [];
106:   }
107:   for (const r of RESULTS) {
108:     const i = merged.findIndex((m) => m.test === r.test);
109:     if (i >= 0) merged[i] = r;
110:     else merged.push(r);
111:   }
112:   writeFileSync(out, JSON.stringify({ browser, results: merged }, null, 2));
113:   console.log(`CAM-RESULTS written to ${out} (${merged.length} results)`);
