 54: // S03 section 4, regime switch row: html data-regime, color-scheme,
 55: // meta theme-color (regime ground from T), and document title all flip
 56: // together at the switch point, while the readout is hidden.
 57: export function applyRegime(scene: SceneId): void {
 58:   const regime = SCENE_REGIME[scene];
 59:   const html = document.documentElement;
 60:   html.dataset.regime = regime;
 61:   html.style.colorScheme = REGIME_COLOR_SCHEME[regime];
 62:   const meta = document.querySelector('meta[name="theme-color"]');
 63:   if (meta) meta.setAttribute('content', T.color[regime].ground);
 64:   document.title = SCENE_TITLE[scene];
 65: }
 66: 
 67: // Polish round (DESIGN 6.7): the readout is hidden for the swap with
 68: // visibility plus inert plus aria-hidden instead of the hidden
 69: // attribute. The hidden attribute is display none, which removed the
 70: // readout from layout for the whole swap window, so the hero (placed
 71: // against the readout rect at the swap) saw no readout and parked at
 72: // the viewport center, then jumped once the readout came back
 73: // (device-run-2 item 1). With these three, the readout keeps its box,
 74: // stays out of the accessibility tree and focus order, and paints
 75: // nothing.
 76: function concealKeepLayout(el: HTMLElement): void {
 77:   el.style.visibility = 'hidden';
 78:   el.inert = true;
 79:   el.setAttribute('aria-hidden', 'true');
 80: }
 81: 
 82: function reveal(el: HTMLElement): void {
 83:   el.style.visibility = '';
 84:   el.inert = false;
 85:   el.removeAttribute('aria-hidden');
 86: }
