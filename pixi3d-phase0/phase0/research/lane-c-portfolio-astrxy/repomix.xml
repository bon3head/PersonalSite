137: // ---- Controller: field to project envelope, loom at Reveal.
138: test('T-MORPH-ENV: gather peaks, reveal looms, ends hand off to rest', () => {
139:   const c = createMorphController('server');
140:   c.navigate('leaflink', 0);
141:   const start = c.sample(0);
142:   expect(start.ringFactor).toBe(0);
143:   expect(start.silhouetteStrength).toBe(0);
144:   expect(start.ringCenter).toEqual(descriptorForLayout('leaflink').anchor);
145:   const mid = c.sample(0.45 * TRAVEL_MS);
146:   expect(mid.gather).toBeGreaterThan(0);
147:   expect(mid.ringStrength).toBeGreaterThan(0);
148:   expect(mid.silhouetteStrength).toBeGreaterThan(0);
149:   expect(mid.silhouetteStrength).toBeLessThanOrEqual(T.morph.silhouettePull);
