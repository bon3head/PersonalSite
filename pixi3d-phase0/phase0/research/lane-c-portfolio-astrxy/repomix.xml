<file path="src/hero/heroGeometry.ts">
  1: // P-HERO-1 and P-HERO-3 pure geometry: displayed size, placement,
  2: // and passive motion. No DOM, no WebGL, so the same code serves the
  3: // component and the tests.
  4: //
  5: // Displayed size (the W3 open decision, decided here): the size the
  6: // resize-to-displayed-times-3-DPR rule would resize to if an asset
  7: // ever went over budget. It is derived from the tokens, never guessed:
  8: // width is the smallest of hero.sizePx, the width the brand area cap
  9: // allows at this viewport for this mark aspect ratio, and the
 10: // viewport width minus both gutters. Height follows the intrinsic
 11: // aspect ratio. The area cap is a hard gate: where it allows less
 12: // than hero.minSizePx (viewports smaller than the tested phones),
 13: // the cap wins and the hero shrinks below minSizePx rather than
 14: // breaking the cap or overflowing the viewport. On the three tested
 15: // phones both hold: LeafLink cap widths are 173, 198, and 219 px,
 16: // all above minSizePx 160, and SideQuests is capped by sizePx 280
 17: // on every phone.
 18: //
 19: // Placement: a grid search over top-left positions, scored by the
 20: // smallest clearance to any blocker (name clear zone, readout,
 21: // keymap, marker tap targets, viewport edges), capped, minus a
 22: // small pull toward the viewport center. The search runs on the
 23: // measured DOM rects, so it holds on every viewport the readout
 24: // occupies, including the narrow 375 px phone where the
 25: // LeafLink readout leaves only the band above it and the
 26: // SideQuests readout leaves only the band below it. Blockers are
 27: // expanded by the motion margin before the search, so the beat
 28: // scale and the wander drift can never push the moving rect into
 29: // a blocker: the rest rect already clears every blocker by at
 30: // least the motion margin, and the motion amplitude is smaller
 31: // than that margin (see heroMotion below).
 32: import { T } from '../tokens.generated';
 33: 
 34: export type HeroProject = 'leaflink' | 'sidequests';
 35: 
 36: export interface Rect {
 37:   left: number;
 38:   top: number;
 39:   right: number;
 40:   bottom: number;
 41: }
 42: 
 43: export interface PlacedRect extends Rect {
 44:   width: number;
 45:   height: number;
 46: }
 47: 
 48: export function rectsIntersect(a: Rect, b: Rect): boolean {
 49:   return a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
 50: }
 51: 
 52: export function expandRect(r: Rect, margin: number): Rect {
 53:   return {
 54:     left: r.left - margin,
 55:     top: r.top - margin,
 56:     right: r.right + margin,
 57:     bottom: r.bottom + margin,
 58:   };
 59: }
 60: 
 61: function gutterFor(vw: number): number {
 62:   const g = T.space.gutterPx;
 63:   if (vw >= 1280) return g.from1280;
 64:   if (vw >= 640) return g.from640;
 65:   return g.base;
 66: }
 67: 
 68: // Displayed size from tokens plus viewport plus intrinsic aspect.
 69: // scaleHeadroom is the peak passive scale of the project (LeafLink
 70: // beatScale, 1 for SideQuests): the area cap must hold at the beat
 71: // peak too, not only at rest, so the area width is divided by the
 72: // headroom before the min, which keeps peak area at or under the
 73: // cap. At 375 px wide the LeafLink width is 170 px after headroom,
 74: // still above minSizePx 160.
 75: export function heroDisplayedSize(
 76:   vw: number,
 77:   vh: number,
 78:   intrinsicW: number,
 79:   intrinsicH: number,
 80:   scaleHeadroom = 1,
 81: ): { width: number; height: number; areaRatio: number; cappedByArea: boolean } {
 82:   const aspectHOverW = intrinsicH / intrinsicW;
 83:   const capArea = T.brand.areaCap * vw * vh;
 84:   const maxWByArea = Math.sqrt(capArea / aspectHOverW) / scaleHeadroom;
 85:   const maxWByViewport = vw - 2 * gutterFor(vw);
 86:   const width = Math.min(T.hero.sizePx, maxWByArea, maxWByViewport);
 87:   const height = width * aspectHOverW;
 88:   return {
 89:     width,
 90:     height,
 91:     areaRatio: (width * height) / (vw * vh),
 92:     cappedByArea: maxWByArea < T.hero.sizePx,
 93:   };
 94: }
 95: 
 96: // Motion margin per project: the largest excursion the passive
 97: // motion can add to the rest rect, plus slack. LeafLink beat scale
 98: // expands a 280 px mark by (beatScale - 1) / 2 on each side, about
 99: // 2.1 px; SideQuests wander drift is 8 px across and 6 px down
100: // (heroMotion), so its margin is 12 px.
101: export function heroMotionMargin(project: HeroProject): number {
102:   return project === 'sidequests' ? 12 : 8;
103: }
104: 
105: // Grid search for the best top-left. Step 8 px keeps the search
106: // under 20k candidates even at desktop size. Blockers are expanded
107: // by the motion margin by the caller (see placeHero), so a feasible
108: // candidate keeps its moving rect clear of every blocker.
109: export function placeHero(
110:   vw: number,
111:   vh: number,
112:   w: number,
113:   h: number,
114:   blockers: Rect[],
115:   motionMargin: number,
116: ): PlacedRect {
117:   const expanded = blockers.map((b) => expandRect(b, motionMargin));
118:   const cx = vw / 2;
119:   const cy = vh / 2;
120:   let best: PlacedRect | null = null;
121:   let bestScore = -Infinity;
122:   const step = 8;
123:   for (let top = 0; top + h <= vh; top += step) {
124:     for (let left = 0; left + w <= vw; left += step) {
125:       const rect: PlacedRect = { left, top, right: left + w, bottom: top + h, width: w, height: h };
126:       let feasible = true;
127:       let minGap = Infinity;
128:       for (const b of expanded) {
129:         if (rectsIntersect(rect, b)) {
130:           feasible = false;
131:           break;
132:         }
133:         // Separation gap on the separating axis (rects do not
134:         // overlap, so at least one axis separates them).
135:         const gapX = Math.max(b.left - rect.right, rect.left - b.right, 0);
136:         const gapY = Math.max(b.top - rect.bottom, rect.top - b.bottom, 0);
137:         const gap = Math.max(gapX, gapY);
138:         if (gap < minGap) minGap = gap;
139:       }
140:       if (!feasible) continue;
141:       // Viewport edge clearance counts the same way.
142:       const edgeGap = Math.min(rect.left, rect.top, vw - rect.right, vh - rect.bottom);
143:       if (edgeGap < minGap) minGap = edgeGap;
144:       const cappedGap = Math.min(minGap, 64);
145:       const distCenter = Math.hypot(rect.left + w / 2 - cx, rect.top + h / 2 - cy);
146:       const score = cappedGap - 0.04 * distCenter;
147:       if (score > bestScore) {
148:         bestScore = score;
149:         best = rect;
150:       }
151:     }
152:   }
153:   if (best) return best;
154:   // No fully clear position exists (should not happen on the tested
155:   // viewports): fall back to centered, so the hero still renders
156:   // instead of vanishing.
157:   return {
158:     left: Math.max(0, (vw - w) / 2),
159:     top: Math.max(0, (vh - h) / 2),
160:     right: Math.min(vw, (vw + w) / 2),
161:     bottom: Math.min(vh, (vh + h) / 2),
162:     width: w,
163:     height: h,
164:   };
165: }
166: 
167: // Distance from a point to the nearest blocker edge (0 inside one).
168: // The hero clamps its ring radius to this, so the bulge never reaches
169: // the readout, the name zone, or the keymap.
170: export function clearanceFrom(x: number, y: number, blockers: Rect[]): number {
171:   let best = Infinity;
172:   for (const b of blockers) {
173:     const dx = Math.max(b.left - x, 0, x - b.right);
174:     const dy = Math.max(b.top - y, 0, y - b.bottom);
175:     const d = Math.hypot(dx, dy);
176:     if (d < best) best = d;
177:   }
178:   return best;
179: }
180: 
181: // Stage focus spots (DESIGN 6.12, polish round): the screen points
182: // the coarse camera pan may bring the subject to. Not the mark center:
183: // the claimed marker would then land under the mark, and the mark (a
184: // tap target) would cover the marker's tap target (T-HERO-BAND-WALK).
185: // One spot above and one below the mark, each kept only if it fits
186: // clear of the readout, name zone, and keymap. The caller picks the
187: // spot on the subject's own side, so the pan is short (inside
188: // focus.maxPanWorld) and never drags the subject across the mark.
189: export function focusSpotsFor(
190:   mark: Rect,
191:   vw: number,
192:   vh: number,
193:   blockers: Rect[],
194:   project: HeroProject,
195: ): Array<[number, number]> {
196:   const half = T.size.coarseMinTargetPx / 2;
197:   // Marker center to mark edge: the marker's own half target, one more
198:   // half target of separation (the damped pan can leave the subject
199:   // short of the spot while it settles), the ring pad, and the mark's
200:   // motion margin (it drifts by that much).
201:   const gap = 2 * half + T.hero.ringPadPx + heroMotionMargin(project);
202:   const cx = (mark.left + mark.right) / 2;
203:   const out: Array<[number, number]> = [];
204:   for (const y of [mark.top - gap, mark.bottom + gap]) {
205:     if (y - half < 0 || y + half > vh || cx - half < 0 || cx + half > vw) continue;
206:     if (clearanceFrom(cx, y, blockers) >= half) out.push([cx, y]);
207:   }
208:   return out;
209: }
210: 
211: // True when moving a coarse target in a straight line from `from` to
212: // `to` would pass over the mark (expanded by the motion margin and the
213: // target's half size). A pan moves the whole plan in a straight line,
214: // so such a pan would sweep the subject under the mark.
215: export function pathCrossesMark(
216:   from: [number, number],
217:   to: [number, number],
218:   mark: Rect,
219:   project: HeroProject,
220: ): boolean {
221:   const pad = T.size.coarseMinTargetPx / 2 + heroMotionMargin(project);
222:   const steps = 32; // lit-ok: segment samples, at most a few px apart on a phone
223:   for (let i = 0; i <= steps; i++) {
224:     const k = i / steps;
225:     const x = from[0] + (to[0] - from[0]) * k;
226:     const y = from[1] + (to[1] - from[1]) * k;
227:     if (x > mark.left - pad && x < mark.right + pad && y > mark.top - pad && y < mark.bottom + pad) return true;
228:   }
229:   return false;
230: }
231: 
232: // The spot nearest the subject's current screen position.
233: export function nearestSpot(
234:   spots: Array<[number, number]>,
235:   at: [number, number],
236: ): [number, number] | null {
237:   let best: [number, number] | null = null;
238:   let d = Infinity;
239:   for (const s of spots) {
240:     const k = Math.hypot(s[0] - at[0], s[1] - at[1]);
241:     if (k < d) {
242:       d = k;
243:       best = s;
244:     }
245:   }
246:   return best;
247: }
248: 
249: // Passive motion (DESIGN sections 6.3 and 6.8), pure functions of time
250: // so tests can pin them exactly.
251: //
252: // LeafLink beat (polish round): event driven, never periodic. DESIGN
253: // 6.3 says the LeafLink heartbeat is "event-driven at irregular
254: // intervals ... never periodic"; the shipped beat was a fixed-period
255: // sine at the interval midpoint, which contradicted it. A beat is now
256: // one smooth bump of duration motion.ms.medium, started by a stage
257: // event (a match landing), peak 1 + amplitude. Overlapping beats take
258: // the larger value, so a burst of matches reads as one strong beat.
259: export function heroBeatEnvelope(msSinceBeat: number, amplitude: number): number {
260:   const d = T.motion.ms.medium;
261:   if (msSinceBeat < 0 || msSinceBeat >= d) return 1;
262:   return 1 + amplitude * Math.sin((Math.PI * msSinceBeat) / d);
263: }
264: 
265: // SideQuests wander: drift along a slow path at the marker bob period,
266: // settling with the existing spring shape (a sine pair, no overshoot
267: // on the hero itself; the spring belongs to the markers).
268: 
269: export function heroWanderOffsetAt(tMs: number): { dx: number; dy: number } {
270:   const periodMs = T.world.sidequests.marker.bobPeriodSec * 1000;
271:   const phase = (2 * Math.PI * tMs) / periodMs;
272:   return { dx: 8 * Math.sin(phase), dy: 6 * Math.cos(phase) };
273: }
</file>

<file path="src/lib/brandPrefetch.ts">
 1: // P-ASSET-3: prefetch brand assets only after the first lane-field
 2: // frame plus idle. Nothing brand related is requested before that
 3: // point, and no preload link for brand assets exists anywhere on
 4: // the server route. This guards the server route first painted
 5: // field frame: brand bytes must never delay it.
 6: //
 7: // Sequence: main.tsx starts the lane field on idle; the field
 8: // dispatches lanefield-ready with the field instance; the first
 9: // onFrame callback marks the first painted field frame; an idle
10: // callback (with a timeout fallback) then fetches the brand
11: // manifest and warms the browser cache for the hero files with
12: // plain image loads. The hero component itself (W6) reads the
13: // same manifest for its markup; this module only warms the cache.
14: //
15: // Under reduced motion only PNG files are prefetched, since the
16: // animated GIF is never shown in that mode.
17: import { loadBrandManifest } from './brandManifest';
18: 
19: type FrameSource = {
20:   onFrame: (cb: () => void) => () => void;
21: };
22: 
23: type BrandWindow = Window & {
24:   __brandPrefetchStarted?: boolean;
25:   __brandPrefetched?: string[];
26:   requestIdleCallback?: (
27:     cb: () => void,
28:     opts?: { timeout: number },
29:   ) => number;
30: };
31: 
32: const PREFETCH_IDLE_TIMEOUT = 2000;
33: 
34: async function prefetch(): Promise<void> {
35:   const w = window as BrandWindow;
36:   if (w.__brandPrefetched) return;
37:   try {
38:     // Shared cache (polish round): the hero reads the same parsed
39:     // manifest synchronously at the readout swap.
40:     const manifest = await loadBrandManifest();
41:     if (!manifest) return;
42:     const files = Array.isArray(manifest.prefetch) ? manifest.prefetch : [];
43:     const reduced = document.documentElement.classList.contains(
44:       'reduced-motion',
45:     );
46:     const wanted = reduced
47:       ? files.filter((f) => f.endsWith('.png'))
48:       : files;
49:     const done: string[] = [];
50:     for (const file of wanted) {
51:       const img = new Image();
52:       img.decoding = 'async';
53:       img.src = `/brand/${file}`;
54:       done.push(file);
55:     }
56:     w.__brandPrefetched = done;
57:   } catch {
58:     // Prefetch must never break the page; a failed warm cache just
59:     // means the hero loads on demand in W6.
60:   }
61: }
62: 
63: function schedulePrefetch(): void {
64:   const w = window as BrandWindow;
65:   if (typeof w.requestIdleCallback === 'function') {
66:     w.requestIdleCallback(
67:       () => {
68:         void prefetch();
69:       },
70:       { timeout: PREFETCH_IDLE_TIMEOUT },
71:     );
72:   } else {
73:     window.setTimeout(() => {
74:       void prefetch();
75:     }, PREFETCH_IDLE_TIMEOUT);
76:   }
77: }
78: 
79: export function initBrandPrefetch(): void {
80:   if (typeof window === 'undefined') return;
81:   const w = window as BrandWindow;
82:   if (w.__brandPrefetchStarted) return;
83:   w.__brandPrefetchStarted = true;
84:   window.addEventListener(
85:     'lanefield-ready',
86:     (ev: Event) => {
87:       const detail = (ev as CustomEvent).detail as FrameSource | null;
88:       if (!detail || typeof detail.onFrame !== 'function') return;
89:       const off = detail.onFrame(() => {
90:         off();
91:         schedulePrefetch();
92:       });
93:     },
94:     { once: true },
95:   );
96: }
</file>

<file path="src/lib/guestbookStore.ts">
 1: // Guestbook storage (DESIGN 6.14). Decided by Justin, 2026-11-10:
 2: // browser-local only. This module keeps signatures in this browser
 3: // and the sheet says so (C-GB-LOCAL).
 4: //
 5: // storeSignature is the single hook. A shared store, if ever wanted,
 6: // replaces its body in its own change; the sheet only awaits it.
 7: import { T } from '../tokens.generated';
 8: import { safeStorage } from './safeStorage';
 9: 
10: export interface Signature {
11:   name: string;
12:   line: string;
13:   seed: number;
14:   at: string;
15: }
16: 
17: export interface StoreResult {
18:   ok: boolean;
19:   where: 'browser';
20: }
21: 
22: // Printable text only, trimmed, clamped to the token lengths.
23: function clean(text: string, max: number): string {
24:   return Array.from(text.replace(/[\u0000-\u001f\u007f]/g, '').trim()).slice(0, max).join('');
25: }
26: 
27: export function readSignatures(): Signature[] {
28:   const raw = safeStorage.get(T.guestbook.storageKey);
29:   if (!raw) return [];
30:   try {
31:     const list = JSON.parse(raw) as unknown;
32:     if (!Array.isArray(list)) return [];
33:     return list.filter(
34:       (x): x is Signature =>
35:         !!x && typeof x.name === 'string' && typeof x.line === 'string' && typeof x.seed === 'number' && typeof x.at === 'string',
36:     );
37:   } catch {
38:     return [];
39:   }
40: }
41: 
42: export function makeSignature(name: string, line: string, seed: number): Signature {
43:   return {
44:     name: clean(name, T.guestbook.nameMaxChars),
45:     line: clean(line, T.guestbook.lineMaxChars),
46:     seed: seed >>> 0,
47:     at: new Date().toISOString(),
48:   };
49: }
50: 
51: // The storage hook. Browser-local today: newest first, at most
52: // guestbook.ledgerMax kept, nothing leaves the device.
53: export async function storeSignature(sig: Signature): Promise<StoreResult> {
54:   const list = [sig, ...readSignatures()].slice(0, T.guestbook.ledgerMax);
55:   const ok = safeStorage.set(T.guestbook.storageKey, JSON.stringify(list));
56:   return { ok, where: 'browser' };
57: }
</file>

<file path="src/motion/entropy.ts">
  1: // Seeded entropy for motion variety (polish item 5, DESIGN section 6.11).
  2: //
  3: // One 32-bit session seed drives every random motion choice. The seed
  4: // comes from the URL (?seed=<uint32>, token entropy.seedParam) when
  5: // present, so any run can be replayed exactly; otherwise one value is
  6: // drawn from crypto.getRandomValues at first use. Nothing in src uses
  7: // Math.random for motion.
  8: //
  9: // Draws are counter-based: draw(channel, n) is a pure hash of (seed,
 10: // channel, n), so a value depends only on the seed and how many draws
 11: // that channel has made, never on frame timing or call interleaving
 12: // across channels. Same seed plus same input sequence gives the same
 13: // motion; a different seed varies it.
 14: //
 15: // Reduced motion disables entropy: unit() returns 0.5 and signed()
 16: // returns 0, so every motion parameter takes its neutral value and the
 17: // result is identical for every seed.
 18: //
 19: // The layout seed (T.world.seed) is separate and never changes: lane
 20: // geometry, the LeafLink sim sequence, and the layout hash stay fixed.
 21: // Entropy only moves motion parameters (camera bow, ring swirl,
 22: // silhouette pull scale, pulse swirl, glitter swirl).
 23: import { T } from '../tokens.generated';
 24: import type { LayoutId } from '../world/types';
 25: 
 26: export type EntropyChannel =
 27:   | 'morph-bow'
 28:   | 'morph-swirl'
 29:   | 'morph-pull'
 30:   | 'pulse-swirl'
 31:   | 'glitter-swirl'
 32:   | 'guestbook-open'
 33:   | 'guestbook-sign';
 34: 
 35: const CHANNEL_ID: Record<EntropyChannel, number> = {
 36:   'morph-bow': 1,
 37:   'morph-swirl': 2,
 38:   'morph-pull': 3,
 39:   'pulse-swirl': 4,
 40:   'glitter-swirl': 5,
 41:   'guestbook-open': 6,
 42:   'guestbook-sign': 7,
 43: };
 44: 
 45: export interface MorphEntropy {
 46:   // Signed lateral camera offset at the arc peak, world units.
 47:   bow: number;
 48:   // Signed tangential share of the ring push (0 is a pure radial push).
 49:   swirl: number;
 50:   // Multiplier on morph.silhouettePull.
 51:   pullScale: number;
 52: }
 53: 
 54: export const NEUTRAL_ENTROPY: MorphEntropy = { bow: 0, swirl: 0, pullScale: 1 };
 55: 
 56: let seed: number | null = null;
 57: let seedFromUrl = false;
 58: let enabled = true;
 59: const counters = new Map<EntropyChannel, number>();
 60: 
 61: // splitmix32 finalizer over (seed, channel, index). Pure and total.
 62: export function hash32(s: number, channel: number, index: number): number {
 63:   let z = (s ^ Math.imul(channel, 0x9e3779b9) ^ Math.imul(index + 1, 0x85ebca6b)) >>> 0;
 64:   z = Math.imul(z ^ (z >>> 16), 0x21f0aaad) >>> 0;
 65:   z = Math.imul(z ^ (z >>> 15), 0x735a2d97) >>> 0;
 66:   return (z ^ (z >>> 15)) >>> 0;
 67: }
 68: 
 69: // Guestbook (DESIGN 6.14): a fresh 32-bit seed per open and per sign.
 70: // Source: crypto.getRandomValues, one new value per call. With ?seed in
 71: // the URL the value is hash32(sessionSeed, channel, n) instead, so a
 72: // seeded run replays exactly. Never Math.random.
 73: export function freshSeed(channel: 'guestbook-open' | 'guestbook-sign'): number {
 74:   entropySeed();
 75:   const n = counters.get(channel) ?? 0;
 76:   counters.set(channel, n + 1);
 77:   publish();
 78:   if (!seedFromUrl && typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function') {
 79:     return crypto.getRandomValues(new Uint32Array(1))[0] >>> 0;
 80:   }
 81:   return hash32(entropySeed(), CHANNEL_ID[channel], n);
 82: }
 83: 
 84: // Pure draw in [0, 1) for a given seed, channel, and index.
 85: export function drawAt(s: number, channel: EntropyChannel, index: number): number {
 86:   return hash32(s, CHANNEL_ID[channel], index) / 4294967296;
 87: }
 88: 
 89: function initialSeed(): number {
 90:   if (typeof window !== 'undefined') {
 91:     const q = new URLSearchParams(window.location.search).get(T.entropy.seedParam);
 92:     if (q !== null && /^\d{1,10}$/.test(q)) {
 93:       seedFromUrl = true;
 94:       return Number(q) >>> 0;
 95:     }
 96:     if (typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function') {
 97:       return crypto.getRandomValues(new Uint32Array(1))[0] >>> 0;
 98:     }
 99:   }
100:   return T.world.seed >>> 0;
101: }
102: 
103: export function entropySeed(): number {
104:   if (seed === null) seed = initialSeed();
105:   return seed;
106: }
107: 
108: // Test and replay hook: set the seed and restart every channel.
109: export function resetEntropy(next?: number): void {
110:   seed = next === undefined ? initialSeed() : next >>> 0;
111:   counters.clear();
112:   publish();
113: }
114: 
115: export function setEntropyEnabled(on: boolean): void {
116:   enabled = on;
117:   publish();
118: }
119: 
120: export function entropyEnabled(): boolean {
121:   return enabled;
122: }
123: 
124: // Next draw on a channel, in [0, 1). 0.5 when entropy is disabled.
125: export function unit(channel: EntropyChannel): number {
126:   const n = counters.get(channel) ?? 0;
127:   counters.set(channel, n + 1);
128:   publish();
129:   if (!enabled) return 0.5;
130:   return drawAt(entropySeed(), channel, n);
131: }
132: 
133: // Next draw on a channel, in [-1, 1). 0 when entropy is disabled.
134: export function signed(channel: EntropyChannel): number {
135:   return unit(channel) * 2 - 1;
136: }
137: 
138: function sceneRanges(layout: LayoutId): { bowWorld: number; swirl: number } {
139:   return T.entropy.scene[layout];
140: }
141: 
142: // Per-morph parameters, keyed by the destination layout so each page
143: // keeps its signature: server arrives rigid (Lockstep, both ranges 0),
144: // LeafLink moderate, SideQuests and the scatter layout widest.
145: export function morphEntropy(to: LayoutId): MorphEntropy {
146:   const r = sceneRanges(to);
147:   // "+ 0" folds a negative zero (signed draw times a zero range) to 0.
148:   const bow = signed('morph-bow') * r.bowWorld + 0;
149:   const swirl = signed('morph-swirl') * r.swirl + 0;
150:   const [lo, hi] = T.entropy.pullScale;
151:   const pullScale = lo + (hi - lo) * unit('morph-pull');
152:   return { bow, swirl, pullScale };
153: }
154: 
155: function publish(): void {
156:   if (typeof window === 'undefined') return;
157:   (window as unknown as { __entropy?: unknown }).__entropy = {
158:     seed: seed ?? null,
159:     enabled,
160:     counters: Object.fromEntries(counters),
161:   };
162: }
</file>

