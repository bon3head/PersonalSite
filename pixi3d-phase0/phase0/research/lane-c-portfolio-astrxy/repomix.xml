338:       const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
339:       const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
340:       const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
341:       const l3 = Math.cbrt(l);
342:       const m3 = Math.cbrt(m);
343:       const s3 = Math.cbrt(s);
344:       const a = l3 * 1.9779984951 - m3 * 2.428592205 + s3 * 0.4505937099;
345:       const bb = l3 * 0.0259040371 + m3 * 0.7827717662 - s3 * 0.808675766;
346:       const chroma = Math.sqrt(a * a + bb * bb);
347:       total++;
348:       if (chroma > 0.04) over++;
349:     }
350:     return over / total;
351:   }, png.toString('base64'));
352:   console.log('T-LL-7 hue fraction (chroma > 0.04):', frac);
