255:         ctx.drawImage(img, 0, 0);
256:         const data = ctx.getImageData(0, 0, cv.width, cv.height).data;
257:         const toLin = (c: number): number => {
258:           const s = c / 255;
259:           return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
260:         };
261:         let over = 0;
262:         let total = 0;
263:         for (let y = 0; y < cv.height; y++) {
264:           for (let x = 0; x < cv.width; x++) {
265:             if (x >= hero[0] && x < hero[2] && y >= hero[1] && y < hero[3]) continue;
