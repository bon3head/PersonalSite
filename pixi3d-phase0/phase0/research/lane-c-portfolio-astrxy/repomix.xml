 174: function makePinMaterial(
 175:   useKind: number,
 176:   shape: number,
 177:   inner: number,
 178: ): THREE.ShaderMaterial {
 179:   const ink = hexToLinear(T.color.ink);
 180:   const tint = hexToLinear(T.color.inkTint);
 181:   return new THREE.ShaderMaterial({
 182:     glslVersion: THREE.GLSL3,
 183:     transparent: true,
 184:     depthTest: false,
 185:     depthWrite: false,
 186:     blending: THREE.CustomBlending,
 187:     blendSrc: THREE.OneFactor,
 188:     blendDst: THREE.OneMinusSrcAlphaFactor,
 189:     vertexShader: VERT,
 190:     fragmentShader: FRAG,
 191:     uniforms: {
 192:       uViewport: { value: new THREE.Vector2(1, 1) },
 193:       uRadiusPx: { value: P.radiusPx.fine },
 194:       uColor: { value: new THREE.Vector3(ink[0], ink[1], ink[2]) },
 195:       uTint: { value: new THREE.Vector3(tint[0], tint[1], tint[2]) },
 196:       uUseKind: { value: useKind },
 197:       uShape: { value: shape },
 198:       uInner: { value: inner },
 199:     },
 200:   });
 201: }
