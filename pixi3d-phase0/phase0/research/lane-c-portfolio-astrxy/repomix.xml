  1: // Route morph state machine (P-MORPH-1, DESIGN section 6.7, S03).
  2: // State is snapshot, target, and start time. navigate() snapshots the
  3: // current interpolated frame state, discards the old target, and
  4: // retargets from that snapshot, so a second input mid-flight never
  5: // jumps: at the retarget instant the sample equals the snapshot
  6: // exactly, and it then moves toward the new target. No queue, no
  7: // per-lane start stagger: every lane reads the same sample.
  8: //
  9: // Phases inside travel, from tokens motion.morph: Release, Gather,
 10: // Reveal. Anchor travel between project anchors uses curve.track.
 11: // Loom uses morph.loomFrom, recede uses morph.recedeTo, the
 12: // project-to-project ring breath uses morph.ringBreath, silhouette
 13: // pull uses morph.silhouettePull. Direction follows keymap order
 14: // server (1), leaflink (2), sidequests (3); the 404 layout sits
 15: // outside the order, so its direction is 0 and it still uses the
 16: // same morph grammar.
 17: //
 18: // Ring factor shape, documented because three cases differ:
 19: // - field to project: gather times one minus reveal, zero at both ends.
 20: // - project to project: a breath that dips to ringBreath at the
 21: //   Gather middle and regrows to full at the Gather end, then hands
 22: //   off over the last quarter of travel, ending at zero like every
 23: //   other case (the rest state carries ring strength zero).
 24: // - project to field: one minus the collapse window.
 25: // The silhouette strength follows the same envelope, scaled by the
 26: // pull token, so the pull and the ring never disagree about phase.
 27: //
 28: // Polish round (DESIGN 1.2.0, section 6.7): three inputs make the
 29: // morph land flush on the page instead of on fixed world anchors.
 30: // - anchorFor(layout) resolves a hero anchor for this frame. The
 31: //   lanefield passes a resolver that ground-projects the placed hero
 32: //   center through the current camera, so the ring and silhouette sit
 33: //   under the logo on screen in every frame. A resolver that returns
 34: //   null means the anchor is not known yet: the ring stays at zero for
 35: //   that target, so a ring never renders at an unplaced position. The
 36: //   Gather window then starts at the first frame the anchor exists
 37: //   (never earlier than motion.morph.gather[0]), so the ring grows from
 38: //   zero instead of jumping. With no resolver (the pure tests), the
 39: //   hero descriptor anchors are used exactly as before.
 40: // - origin: navigate may pass a ground point the ring departs from
 41: //   (the pressed keymap item, ground-projected per frame through
 42: //   groundAt). Field to project morphs move the ring center from the
 43: //   origin to the anchor on curve.track over Gather.
 44: // - entropy: navigate may pass a seeded MorphEntropy (bow, swirl,
 45: //   pull scale). The sample carries bowFactor (sin of pi times the
 46: //   signature-eased progress, zero at both ends) and ringSwirl; the
 47: //   silhouette pull target scales by pullScale. Neutral entropy gives
 48: //   the pre-polish envelope exactly.
 49: // Hero loom uses motion.morph.loom and recede uses motion.morph.recede
 50: // (tokens), so the outgoing mark is gone before the readout swap and
 51: // the incoming mark looms in while the camera settles, before the text.
 52: //
 53: // Degrade path (DESIGN section 6.10, token perf.degradeFrames): while
 54: // a morph is in flight, observeFrame counts consecutive frames over
 55: // the perf.p95Ms budget. At degradeFrames consecutive over-budget
 56: // frames the controller latches degraded for the session: the
 57: // silhouette target term becomes zero, so the pull decays with the
 58: // morph envelope to zero by morph end and stays zero on later
 59: // morphs. Lanes, gradient, and ring are untouched, and the morph
 60: // state machine keeps running. The latch is reported on the debug
 61: // hook and in the console once, which is the dev HUD log for this
 62: // path; the frame budgets themselves are not changed.
 63: import { T } from '../tokens.generated';
 64: import { cubicBezier, easeSignature } from '../world/tween';
 65: import { descriptorForLayout, type HeroDescriptor } from './hero-descriptors';
 66: import { NEUTRAL_ENTROPY, type MorphEntropy } from './entropy';
 67: import type { LayoutId } from '../world/types';
 68: 
 69: // Keymap order (S03 section 6): server 1, leaflink 2, sidequests 3.
 70: // The whoami sheet is W, a sheet over the current scene, not a route,
 71: // so it has no layout here and no morph.
 72: const KEYMAP_ORDER: Partial<Record<LayoutId, number>> = {
 73:   server: 0,
 74:   leaflink: 1,
 75:   sidequests: 2,
 76: };
 77: 
 78: // DESIGN section 6.7 window that is a prose constant, not a token:
 79: // the ring collapse window for travel to a field route. The recede
 80: // and loom windows are tokens (motion.morph.recede, motion.morph.loom).
 81: const COLLAPSE_WINDOW: [number, number] = [0.2, 0.8];
 82: 
 83: export interface MorphAnchor {
 84:   center: [number, number];
 85:   ringRadius: number;
 86:   silhouetteRadius: number;
 87: }
 88: 
 89: export interface MorphOptions {
