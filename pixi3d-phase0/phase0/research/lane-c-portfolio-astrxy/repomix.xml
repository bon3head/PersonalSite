311:         mesh.text = ch;
312:         mesh.sync(() => renderStill());
313:       }
314:       w.glyphs.push(g);
315:     }
316:     actives.push(w);
317:     return w;
318:   }
319: 
320:   function renderStill(): void {
321:     if (disposed) return;
322:     if (reduced || fadeStartSec === null) f.guestbook?.render();
323:   }
