 43: // ---- T-LF-7: deflection ring derivative continuity (unit test).
 44: test('T-LF-7: ring deflection is C1 across the boundary', () => {
 45:   const r = 6;
 46:   const s = 3;
 47:   expect(ringFalloff(0, r)).toBe(1);
 48:   expect(ringFalloff(r, r)).toBe(0);
 49:   expect(ringFalloff(r + 1, r)).toBe(0);
 50:   expect(ringFalloff(-1, r)).toBe(1);
 51:   // Analytic derivative at the boundary from inside is zero, matching
 52:   // the zero derivative outside.
 53:   expect(Math.abs(ringFalloffDerivative(r, r))).toBe(0);
 54:   expect(Math.abs(ringFalloffDerivative(r + 0.5, r))).toBe(0);
 55:   // Numeric derivative just inside the boundary also tends to zero.
 56:   const eps = 1e-4;
 57:   const numeric = (ringFalloff(r, r) - ringFalloff(r - eps, r)) / eps;
 58:   expect(Math.abs(numeric)).toBeLessThan(1e-3);
 59:   // Deflection pushes radially outward inside, leaves outside alone.
 60:   const [x, z] = deflectPoint(3, 0, 0, 0, r, s);
 61:   expect(x).toBeGreaterThan(3);
 62:   expect(z).toBe(0);
 63:   expect(deflectPoint(9, 0, 0, 0, r, s)).toEqual([9, 0]);
 64:   expect(deflectPoint(r, 0, 0, 0, r, s)).toEqual([r, 0]);
 65:   // The shipped vertex shader mirrors the same falloff formula.
 66:   const vert = readFileSync(join(ROOT, 'src', 'world', 'shaders', 'lane.vert.glsl'), 'utf8');
 67:   expect(vert).toContain('1.0 - x * x');
 68:   expect(vert).toContain('uRingCenter');
 69:   expect(vert).toContain('uRingRadius');
 70:   expect(vert).toContain('uRingStrength');
