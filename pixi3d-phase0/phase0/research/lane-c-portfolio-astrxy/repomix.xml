447:   function placeGlyph(l: Letter, p: [number, number, number], r: number, step: number): void {
448:     const span = l.span;
449:     if (!span || !field) return;
450:     const a = field.worldToScreen(p);
451:     const b = field.worldToScreen([p[0] + right[0] * glyphWorld, p[1], p[2] + right[1] * glyphWorld]);
452:     const [lo, hi] = g.mark.glyphPx;
453:     const size = Math.max(lo, Math.min(hi, Math.hypot(b[0] - a[0], b[1] - a[1])));
454:     const k = (size / hi) * Math.max(r, 0);
455:     let ch = l.char;
456:     if (signSeed !== null && !reduced()) {
457:       const t = nowMs();
458:       if (t < l.resolveAt) ch = NOISE_GLYPHS[hash32(signSeed, P.scramble, step * 64 + l.index) % NOISE_GLYPHS.length];
459:     }
460:     if (span.textContent !== ch) span.textContent = ch;
461:     span.style.transform = `translate3d(${a[0].toFixed(1)}px, ${a[1].toFixed(1)}px, 0) translate(-50%, -100%) scale(${k.toFixed(4)})`;
462:   }
463: 
464:   function publish(t: number): void {
465:     const dbg: GuestbookDebug = {
466:       phase,
467:       openSeed,
468:       signSeed,
469:       signs: [...signs],
470:       dolly: dolly.value(t),
471:       yawDeg: yaw.value(t) / DEG,
472:       bands: [bands[0].value(t), bands[1].value(t), bands[2].value(t)],
473:       letters: letters.filter((l) => !l.dying).map((l) => ({ char: l.char, lane: l.lane, h: l.h.value(t), x: l.x.value(t), z: l.z.value(t) })),
474:       well: field ? [...well] : null,
475:       dim: dim.value(t),
476:       dimBox: lastDimBox,
477:     };
478:     (window as unknown as { __guestbook?: GuestbookDebug }).__guestbook = dbg;
479:   }
480: 
481:   // Reduced motion: no loop runs, so render once per change.
482:   function kick(): void {
483:     if (!gb) {
484:       publish(nowMs());
485:       return;
486:     }
487:     if (reduced()) gb.render();
488:   }
489: 
490:   function subscribe(): void {
491:     if (!field || unsubscribe) return;
492:     unsubscribe = field.onFrame(() => frame());
493:   }
494: 
495:   function openFresh(t: number): void {
496:     openSeed = freshSeed('guestbook-open');
497:     signSeed = null;
498:     lastReadout = '';
499:     measureWell();
500:     const yawTo = s(openSeed, P.yaw) * g.camera.yawDeg * DEG;
501:     const riseTo = s(openSeed, P.rise) * g.camera.riseFrac;
502:     dolly.go(t, g.camera.dollyIn, dur(T.motion.ms.travel), easeMain);
503:     shiftMix.go(t, 1, dur(T.motion.ms.travel), easeMain);
504:     yaw.go(t, yawTo, dur(T.motion.ms.travel), easeMain);
505:     rise.go(t, riseTo, dur(T.motion.ms.travel), easeMain);
506:     bands.forEach((b, i) => b.go(t, 1, dur(T.motion.ms.travel), easeMain, dur(i * g.ms.bandStagger)));
507:     shiftX.go(t, 0, dur(T.motion.ms.travel), easeMain);
508:     shiftZ.go(t, 0, dur(T.motion.ms.travel), easeMain);
509:     scale.go(t, 1, dur(T.motion.ms.travel), easeMain);
510:     noise.go(t, reduced() ? 0 : dist * g.mark.noiseFrac, dur(T.motion.ms.travel), easeMain);
511:     dim.go(t, 1, dur(g.ms.panel), easeMain);
512:   }
513: 
514:   return {
515:     open(): void {
516:       if (phase !== 'closed' && phase !== 'closing') return;
517:       if (phase === 'closing') {
518:         closeResolve?.();
519:         closeResolve = null;
520:       }
521:       phase = 'open';
522:       subscribe();
523:       openFresh(nowMs());
524:       const pending = text;
525:       text = '';
526:       if (pending) setText(pending);
527:       kick();
528:     },
529:     setText,
530:     reframe(): void {
531:       if (phase === 'closed' || phase === 'closing') return;
532:       if (phase !== 'open') {
533:         kick();
534:         return;
535:       }
536:       const n = Array.from(text).length;
537:       updateFrame(nowMs(), false);
538:       fitSpacing(n);
539:       if (reduced()) reframeStill(n);
540:       relayout(nowMs());
541:       kick();
542:     },
543:     lock(): Promise<number> {
544:       if (phase !== 'open') return Promise.resolve(signSeed ?? 0);
545:       const t = nowMs();
546:       signSeed = freshSeed('guestbook-sign');
547:       signs.push(signSeed);
548:       const seed = signSeed;
549:       lockStart = t;
550:       phase = 'locking';
551:       const alive = letters.filter((l) => !l.dying);
552:       const n = Math.max(1, alive.length);
553:       alive.forEach((l, i) => {
554:         l.h.go(t, heightFor(seed, i), dur(g.ms.lockIn), easeSoft);
555:         l.resolveAt = t + (g.ms.lockIn * (i + 1)) / n;
556:       });
557:       noise.go(t, 0, dur(g.ms.lockIn), easeSoft);
558:       if (!reduced()) dolly.go(t, g.camera.dollyIn + g.camera.pushIn, g.ms.lockIn, easeSoft);
559:       // Pull back to wide after the hold, and settle the mark.
560:       const back = dur(g.ms.lockIn + g.ms.hold);
561:       const pull = dur(T.motion.ms.wordCadence);
562:       const angle = u(seed, P.settleAngle) * Math.PI * 2;
563:       const [r0, r1] = g.mark.settleRadiusFrac;
564:       const radius = dist * g.part.radiusFrac * lerp(r0, r1, u(seed, P.settleRadius));
565:       const [k0, k1] = g.mark.settleScale;
566:       if (!reduced()) {
567:         dolly.go(t, g.camera.pullBack, pull, easeSoft, back);
568:         yaw.go(t, yaw.to + s(seed, P.drift) * g.camera.driftYawDeg * DEG, pull, easeSoft, back);
569:       }
570:       shiftX.go(t, Math.cos(angle) * radius, pull, easeSoft, back);
571:       shiftZ.go(t, Math.sin(angle) * radius, pull, easeSoft, back);
572:       scale.go(t, lerp(k0, k1, u(seed, P.settleScale)), pull, easeSoft, back);
573:       bands.forEach((b) => b.go(t, g.part.residual, pull, easeSoft, back));
574:       kick();
575:       const total = back + pull;
576:       return new Promise((resolve) => {
577:         const finish = (): void => {
578:           if (phase === 'locking') phase = 'settled';
579:           kick();
580:           resolve(seed);
581:         };
582:         if (total <= 0) finish();
583:         else setTimeout(finish, total);
584:       });
585:     },
586:     again(): void {
587:       const t = nowMs();
588:       for (const l of letters) {
589:         l.dying = true;
590:         l.rise.go(t, 0, dur(g.ms.letterOut), easeMain);
591:       }
592:       text = '';
593:       phase = 'open';
594:       openFresh(t);
595:       kick();
596:     },
597:     close(): Promise<void> {
598:       if (phase === 'closed') return Promise.resolve();
599:       const t = nowMs();
600:       phase = 'closing';
601:       const d = dur(T.motion.ms.travel);
602:       for (const tw of [dolly, yaw, rise, shiftX, shiftZ, noise, shiftMix, dim, ...bands]) tw.go(t, 0, d, easeMain);
603:       for (const l of letters) {
604:         l.dying = true;
605:         l.rise.go(t, 0, d, easeMain);
606:       }
607:       closeAt = t + d;
608:       return new Promise((resolve) => {
609:         closeResolve = resolve;
610:         if (!field || d <= 0) {
611:           // Render the zero state once, then clear.
612:           kick();
613:           finishClose();
614:         }
615:       });
616:     },
617:     onReadout(cb: (hex: string) => void): void {
618:       readoutCb = cb;
619:     },
620:     dispose(): void {
621:       finishClose();
622:       readoutCb = null;
623:     },
624:   };
625: 
626:   function finishClose(): void {
627:     phase = 'closed';
628:     unsubscribe?.();
629:     unsubscribe = null;
630:     for (const l of letters) l.span?.remove();
631:     letters = [];
632:     text = '';
633:     if (gb) {
634:       gb.setCamera(null);
635:       gb.setPart(null);
636:       gb.setDim(null, 0);
637:       lastDimBox = null;
638:       gb.writeLanes([], new Float32Array(0));
639:       gb.render();
640:     }
641:     publish(nowMs());
642:     const r = closeResolve;
643:     closeResolve = null;
644:     r?.();
645:   }
646: }
