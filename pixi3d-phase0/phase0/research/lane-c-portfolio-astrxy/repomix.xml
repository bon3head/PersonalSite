344:   // Stage listener (header item 4). One owner for focus and the mark.
345:   useEffect(() => {
346:     if (!lanefield) return;
347:     const layout = project;
348:     const off = onStage((e) => {
349:       if (e.layout !== layout) return;
350:       const st = stageRef.current;
351:       const nowMs = performance.now();
352:       const p = placementRef.current;
353:       // Next to the mark, never under it: on subject, the spot on the
354:       // subject's own side (focusSpotsFor); the mark center only when
355:       // no side fits. The pan holds the destination marker at that spot
356:       // for the whole walk (following the drawing head instead swept the
357:       // marker across the mark mid-walk, T-HERO-BAND-WALK).
358:       // Only spots whose straight pan never sweeps the subject under
359:       // the mark count; with none, there is no pan for this subject.
360:       if (e.type === 'subject') {
361:         const at = lanefield.worldToScreen([e.ground[0], 0, e.ground[1]]);
362:         const rect = p ? { left: p.left, top: p.top, right: p.left + p.width, bottom: p.top + p.height } : null;
363:         const clear = rect ? focusSpotsRef.current.filter((sp) => !pathCrossesMark(at, sp, rect, project)) : [];
364:         focusSpotRef.current = nearestSpot(clear, at);
365:       }
366:       const center: [number, number] | null = focusSpotRef.current;
367:       const dur = T.motion.ms.medium;
368:       if (e.type === 'subject') {
369:         if (center && coarse) lanefield.setFocus({ ground: e.ground, screenPx: center });
370:         if (reduced) return;
371:         // Device run 3 (DESIGN 1.3.0, 6.12 exception): LeafLink does not
372:         // recede, so the logo stays visible on dot taps and dots sit
373:         // behind it. SideQuests recede unchanged.
374:         if (project !== 'leaflink') {
375:           st.opacity = { from: rampAt(st.opacity, nowMs), to: 0, startMs: nowMs, durMs: dur };
376:           st.scale = { from: rampAt(st.scale, nowMs), to: T.morph.recedeTo, startMs: nowMs, durMs: dur };
377:         }
378:       } else if (e.type === 'land') {
379:         const origin = lanefield.worldToScreen([e.ground[0], 0, e.ground[1]]);
380:         lanefield.pulse({ originPx: origin });
381:         if (reduced) return;
382:         st.opacity = { from: rampAt(st.opacity, nowMs), to: 1, startMs: nowMs, durMs: dur };
383:         st.scale = { from: rampAt(st.scale, nowMs), to: 1, startMs: nowMs, durMs: dur };
384:         st.beats.push({ startMs: nowMs + T.motion.ms.fast, amp: T.hero.landBeatScale - 1 });
385:       } else if (e.type === 'beat') {
386:         if (reduced) return;
387:         st.beats.push({ startMs: nowMs, amp: T.hero.beatScale - 1 });
388:       } else if (e.type === 'release') {
389:         lanefield.setFocus(null);
390:       }
391:     });
392:     return () => {
393:       off();
394:       lanefield.setFocus(null);
395:     };
396:   }, [lanefield, project, reduced, coarse]);
397: 
398:   // One rAF loop writes opacity and transform directly (no React state
399:   // per frame): morph loom or recede, stage ramp, beats, wander, tilt.
400:   // Reduced motion never starts it: opacity 1, identity transform.
401:   useEffect(() => {
402:     const el = wrapRef.current;
403:     if (reduced) {
404:       if (el) {
405:         el.style.transform = '';
406:         el.style.opacity = '';
407:       }
408:       return;
409:     }
410:     let raf = 0;
411:     let stopped = false;
412:     const frame = (nowMs: number): void => {
413:       if (stopped) return;
414:       const node = wrapRef.current;
415:       if (node) {
416:         let morphO = 1;
417:         let morphS = 1;
418:         const s = lanefield?.morphSample() ?? null;
419:         if (s && !s.done) {
420:           if (s.to === project) {
421:             morphO = s.heroOpacityIn;
422:             morphS = s.heroScaleIn;
423:           } else if (s.from === project) {
424:             morphO = s.heroOpacityOut;
425:             morphS = s.heroScaleOut;
426:           }
427:         }
428:         const st = stageRef.current;
429:         let beat = 1;
430:         st.beats = st.beats.filter((b) => nowMs - b.startMs < T.motion.ms.medium);
431:         for (const b of st.beats) beat = Math.max(beat, heroBeatEnvelope(nowMs - b.startMs, b.amp));
432:         let dx = 0;
433:         let dy = 0;
434:         if (project === 'sidequests') {
435:           const w = heroWanderOffsetAt(nowMs);
436:           dx = w.dx;
437:           dy = w.dy;
438:         }
439:         const scale = morphS * rampAt(st.scale, nowMs) * beat;
440:         const { rx, ry } = tiltRef.current;
441:         node.style.opacity = (morphO * rampAt(st.opacity, nowMs)).toFixed(4);
442:         node.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${scale.toFixed(4)}) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
443:       }
444:       raf = requestAnimationFrame(frame);
445:     };
446:     raf = requestAnimationFrame(frame);
447:     return () => {
448:       stopped = true;
449:       cancelAnimationFrame(raf);
450:     };
451:   }, [reduced, project, lanefield]);
452: 
453:   const onPointerMove = (e: React.PointerEvent): void => {
454:     if (reduced) return;
455:     const el = wrapRef.current;
456:     if (!el) return;
457:     const r = el.getBoundingClientRect();
458:     if (r.width === 0) return;
459:     const nx = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * T.hero.tiltMaxDeg;
460:     const ny = ((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * T.hero.tiltMaxDeg;
461:     const clamp = (v: number): number => Math.max(-T.hero.tiltMaxDeg, Math.min(T.hero.tiltMaxDeg, v));
462:     tiltRef.current = { rx: clamp(-ny), ry: clamp(nx) };
463:   };
464: 
465:   const onPointerDown = (e: React.PointerEvent): void => {
466:     downRef.current = { x: e.clientX, y: e.clientY, t: performance.now() };
467:   };
468: 
469:   // A tap is the page verb, with a small pulse from the tap point as
470:   // immediate feedback (under 250ms, DESIGN 6.5 law 1).
471:   const onPointerUp = (e: React.PointerEvent): void => {
472:     const down = downRef.current;
473:     downRef.current = null;
474:     if (!down) return;
475:     const moved = Math.hypot(e.clientX - down.x, e.clientY - down.y);
476:     if (moved >= T.world.leaflink.tapMaxMovePx) return;
477:     if (performance.now() - down.t >= T.world.leaflink.tapMaxMs) return;
478:     if (!reduced) lanefield?.pulse({ originPx: [e.clientX, e.clientY], strengthScale: 0.5 });
479:     verbRef.current?.();
480:   };
481: 
482:   const onPointerLeave = (): void => {
483:     tiltRef.current = { rx: 0, ry: 0 };
484:   };
485: 
486:   const style: CSSProperties = placement
487:     ? {
488:         left: placement.left,
489:         top: placement.top,
490:         width: placement.width,
491:         height: placement.height,
492:       }
493:     : { visibility: 'hidden' };
494: 
495:   const pngSrc = entry ? `/brand/${entry.png.file}` : '';
496:   const imgSrc = stage === 'gif' && gifUrl ? gifUrl : pngSrc;
497:   const imgW = placement ? Math.round(placement.width) : undefined;
498:   const imgH = placement ? Math.round(placement.height) : undefined;
499: 
500:   return (
501:     <div
502:       ref={wrapRef}
503:       className="jp-hero"
504:       data-brand-mark={project}
505:       style={style}
506:       onPointerMove={onPointerMove}
507:       onPointerDown={onPointerDown}
508:       onPointerUp={onPointerUp}
509:       onPointerLeave={onPointerLeave}
510:     >
511:       {stage === 'text' ? (
512:         <div className="jp-hero-text" role="img" aria-label={entry?.alt ?? PROJECT_NAME[project]}>
513:           {PROJECT_NAME[project]}
514:         </div>
515:       ) : stage === 'loading' || !entry ? null : (
516:         <picture>
517:           <source media="(prefers-reduced-motion: reduce)" srcSet={pngSrc} />
518:           <img
519:             src={imgSrc}
520:             alt={entry.alt}
521:             width={imgW}
522:             height={imgH}
523:             decoding="async"
524:             draggable={false}
525:           />
526:         </picture>
527:       )}
528:     </div>
529:   );
530: }
