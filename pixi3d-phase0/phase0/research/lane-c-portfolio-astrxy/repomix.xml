  1: // Device run 4 regression: the hero mark stays visible when a popup
  2: // sheet opens and after it closes. Previously App rendered BrandHero
  3: // only with no sheet open, so opening whoami or contact unmounted
  4: // the mark. The fix keeps the mark mounted regardless of sheet state;
  5: // the sheet overlays, but the mark is never hidden, faded, or
  6: // unmounted. Kept permanently: do not delete this spec.
  7: // Browser timing note, same as the W4 suite: SwiftShader frames take
  8: // seconds, so this spec asserts settled invariants (mounted, opacity,
  9: // non-empty box), never a mid-travel wall-clock pixel sample.
 10: import { test, expect, type Page } from '@playwright/test';
 11: 
 12: test.setTimeout(300000);
 13: 
 14: const DEV = 'http://localhost:5173';
 15: 
 16: interface MarkState {
 17:   count: number;
 18:   opacity: number;
 19:   visibility: string;
 20:   box: number;
 21:   connected: boolean;
 22: }
 23: 
 24: async function waitHero(page: Page): Promise<void> {
 25:   await page.waitForFunction(() => {
 26:     const el = document.querySelector('[data-brand-mark]') as HTMLElement | null;
 27:     if (!el || !el.style.left) return false;
 28:     if (getComputedStyle(el).visibility === 'hidden') return false;
 29:     const img = el.querySelector('img');
 30:     const text = el.querySelector('.jp-hero-text');
 31:     if (img) return img.naturalWidth > 0;
 32:     return text !== null;
 33:   }, null, { timeout: 60000, polling: 100 });
 34: }
 35: 
 36: async function markState(page: Page): Promise<MarkState> {
 37:   return page.evaluate(() => {
 38:     const el = document.querySelector('[data-brand-mark]') as HTMLElement | null;
 39:     if (!el) {
 40:       return { count: 0, opacity: 0, visibility: 'hidden', box: 0, connected: false };
 41:     }
 42:     const r = el.getBoundingClientRect();
 43:     const cs = getComputedStyle(el);
 44:     return {
 45:       count: 1,
 46:       opacity: parseFloat(cs.opacity),
 47:       visibility: cs.visibility,
 48:       box: (r.right - r.left) * (r.bottom - r.top),
 49:       connected: document.contains(el),
 50:     };
 51:   });
 52: }
 53: 
 54: function expectVisible(s: MarkState, where: string): void {
 55:   expect(s.count, `${where} count`).toBe(1);
 56:   expect(s.connected, `${where} connected`).toBe(true);
 57:   expect(s.visibility, `${where} visibility`).not.toBe('hidden');
 58:   expect(s.opacity, `${where} opacity`).toBeGreaterThanOrEqual(0.99);
 59:   expect(s.box, `${where} box`).toBeGreaterThan(0);
 60: }
 61: 
 62: async function openSheet(page: Page, key: string): Promise<void> {
 63:   await page.keyboard.press(key);
 64:   await page.waitForSelector('dialog[open]', { timeout: 10000 });
 65:   await page.waitForTimeout(500);
 66: }
 67: 
 68: async function closeSheet(page: Page, key: string): Promise<void> {
 69:   await page.keyboard.press(key);
 70:   await page.waitForFunction(
 71:     () => document.querySelector('dialog[open]') === null,
 72:     null,
 73:     { timeout: 10000, polling: 100 },
 74:   );
 75:   await page.waitForTimeout(500);
 76: }
 77: 
 78: // ---- T-HERO-SHEET (browser): mark visible with any sheet open and
 79: // after it closes, on both project routes; server never has a mark.
