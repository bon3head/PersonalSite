251:   // Every lane's resting tip at the current weights, for nearest picks.
252:   function snapshotTips(): void {
253:     if (!lanes) return;
254:     for (let l = 0; l < laneCount; l++) {
255:       lanes.gb.laneTip(l, tip);
256:       tips[l * 3] = tip[0];
257:       tips[l * 3 + 1] = tip[1];
258:       tips[l * 3 + 2] = tip[2]; // lit-ok: z component
259:     }
260:   }
