 242: export function createLeaflinkController(
 243:   lanefield: Lanefield,
 244:   opts: LeaflinkControllerOpts = {},
 245: ): LeaflinkController {
 246:   const seed = opts.seed ?? T.world.seed;
 247:   const reduced = opts.reducedMotion ?? false;
 248:   const rand = rng(seed + 7); // lit-ok: S06 controller stream
 249: 
 250:   // Graph: injected, or generated once from the layout generator.
 251:   let side: LeaflinkSideData;
 252:   if (opts.sideData) {
 253:     side = opts.sideData;
 254:   } else {
 255:     const scratch = new Float32Array(
 256:       LANE_COUNT * POINTS * LAYOUT_COUNT * 4, // lit-ok: RGBA texels
 257:     );
 258:     side = generate(seed, scratch, 1);
 259:   }
 260:   const nodeCount = side.nodes.length / 2; // lit-ok: xz pairs
 261:   const nodeX = (v: number): number => side.nodes[v * 2]; // lit-ok: xz pairs
 262:   const nodeZ = (v: number): number => side.nodes[v * 2 + 1]; // lit-ok: xz pairs
 263: 
 264:   // Edge lookup by endpoint pair (graph is simple: at most one edge).
 265:   const edgeByPair = new Map<string, number>();
 266:   for (let e = 0; e < side.edges.length; e++) {
 267:     const a = side.edges[e].a;
 268:     const b = side.edges[e].b;
 269:     edgeByPair.set(`${Math.min(a, b)},${Math.max(a, b)}`, e);
 270:   }
 271: 
 272:   // --- Clock (pauses freeze it; routes and pins freeze with it). ---
 273:   const t0 = lanefield.now();
 274:   let pausedTotal = 0;
 275:   let pausedAt: number | null = null;
 276:   let paused = false;
 277:   const simNow = (): number => {
 278:     const now = lanefield.now();
 279:     const held = pausedAt !== null ? now - pausedAt : 0;
 280:     return now - pausedTotal - held;
 281:   };
 282:   const rel = (t: number): number => t - t0;
 283: 
 284:   // --- State. ---
 285:   const pins: Pin[] = [];
 286:   const matches: Match[] = [];
 287:   const ripples: Ripple[] = [];
 288:   const events: LeaflinkSpawnEvent[] = [];
 289:   let pinId = 0;
 290:   let matchId = 0;
 291:   let nextEventAt = t0 + P.firstEventAfterMs / 1000; // lit-ok: ms to sec
 292:   let disposed = false;
 293: 
 294:   // --- Meshes (pins 1, halos 1, ripples 1 draw call). ---
 295:   const pinMesh = makeInstancedMesh(
 296:     makePinMaterial(1, 0, P.ringInner),
 297:     MAX_INSTANCES,
 298:     true,
 299:   );
 300:   const haloMesh = makeInstancedMesh(
 301:     makePinMaterial(0, 2, 0),
 302:     MAX_INSTANCES,
 303:     false,
 304:   );
 305:   const rippleMesh = makeInstancedMesh(
 306:     makePinMaterial(0, 3, P.rippleInner), // lit-ok: annulus shape
 307:     MAX_INSTANCES,
 308:     false,
 309:   );
 310:   pinMesh.mesh.renderOrder = 2; // lit-ok: after lanes and ripples
 311:   haloMesh.mesh.renderOrder = -1; // lit-ok: before lanes
 312:   rippleMesh.mesh.renderOrder = 1; // lit-ok: after lanes, before pins
 313:   lanefield.scene.add(pinMesh.mesh);
 314:   lanefield.scene.add(haloMesh.mesh);
 315:   lanefield.scene.add(rippleMesh.mesh);
 316: 
 317:   const isCoarse = (): boolean =>
 318:     window.innerWidth < T.breakpoints.coarseOrNarrowBelowPx ||
 319:     (window.matchMedia('(pointer: coarse)').matches &&
 320:       window.innerWidth < T.breakpoints.desktopFromPx);
 321: 
 322:   // --- Graph search. ---
 323:   // Hop-limited BFS: nodes within maxHops of start, with distances.
 324:   function bfsDistances(start: number, maxHops: number): Map<number, number> {
 325:     const dist = new Map<number, number>();
 326:     dist.set(start, 0);
 327:     const queue = [start];
 328:     while (queue.length > 0) {
 329:       const u = queue.shift() as number;
 330:       const du = dist.get(u) as number;
 331:       if (du >= maxHops) continue;
 332:       for (const e of side.adjacency[u]) {
 333:         const edge = side.edges[e];
 334:         const v = edge.a === u ? edge.b : edge.a;
 335:         if (!dist.has(v)) {
 336:           dist.set(v, du + 1);
 337:           queue.push(v);
 338:         }
 339:       }
 340:     }
 341:     return dist;
 342:   }
 343: 
 344:   // Dijkstra over (node, hops) states, pruned past maxHops. Stops at
 345:   // the first popped state that holds an open opposite-kind pin: pops
 346:   // are in distance order, so that pin is the nearest by edge length.
 347:   function nearestOpenPin(
 348:     from: number,
 349:     kind: LeaflinkPinKind,
 350:     maxHops: number,
 351:   ): { pin: Pin; path: number[] } | null {
 352:     const openByNode = new Map<number, Pin>();
 353:     for (const p of pins) {
 354:       if (p.state === 'open' && p.kind === kind) openByNode.set(p.node, p);
 355:     }
 356:     if (openByNode.size === 0) return null;
 357:     // Fast path for an effectively unbounded hop limit (the visitor
 358:     // search, maxHops = nodeCount): a shortest path by positive edge
 359:     // length never repeats a node, so it uses at most nodeCount - 1
 360:     // hops, and node-only Dijkstra returns the same nearest pin as
 361:     // the (node, hops) search below. The (node, hops) state space is
 362:     // nodeCount times larger and, on WebKit, stalls the visitor match
 363:     // past the tap gate (route at about one and a half seconds from
 364:     // drop in isolation). Hop-limited callers keep the search below.
 365:     if (maxHops >= nodeCount) {
 366:       const distF = new Float64Array(nodeCount).fill(Infinity);
 367:       const prevF = new Int32Array(nodeCount).fill(-1);
 368:       const heapF: Array<[number, number]> = [];
 369:       const pushF = (d: number, v: number): void => {
 370:         heapF.push([d, v]);
 371:         let i = heapF.length - 1;
 372:         while (i > 0) {
 373:           const parent = (i - 1) >> 1; // lit-ok: heap parent
 374:           if (heapF[parent][0] <= heapF[i][0]) break;
 375:           const tmp = heapF[parent];
 376:           heapF[parent] = heapF[i];
 377:           heapF[i] = tmp;
 378:           i = parent;
 379:         }
 380:       };
 381:       const popF = (): [number, number] | null => {
 382:         if (heapF.length === 0) return null;
 383:         const top = heapF[0];
 384:         const last = heapF.pop() as [number, number];
 385:         if (heapF.length > 0) {
 386:           heapF[0] = last;
 387:           let i = 0;
 388:           for (;;) {
 389:             const left = i * 2 + 1; // lit-ok: heap child
 390:             const right = left + 1; // lit-ok: heap child
 391:             let smallest = i;
 392:             if (left < heapF.length && heapF[left][0] < heapF[smallest][0]) {
 393:               smallest = left;
 394:             }
 395:             if (right < heapF.length && heapF[right][0] < heapF[smallest][0]) {
 396:               smallest = right;
 397:             }
 398:             if (smallest === i) break;
 399:             const tmp = heapF[smallest];
 400:             heapF[smallest] = heapF[i];
 401:             heapF[i] = tmp;
 402:             i = smallest;
 403:           }
 404:         }
 405:         return top;
 406:       };
 407:       distF[from] = 0;
 408:       pushF(0, from);
 409:       while (heapF.length > 0) {
 410:         const item = popF();
 411:         if (!item) break;
 412:         const [d, u] = item;
 413:         if (d > distF[u]) continue;
 414:         if (u !== from) {
 415:           const hit = openByNode.get(u);
 416:           if (hit) {
 417:             const path: number[] = [];
 418:             let v = u;
 419:             while (v !== -1) {
 420:               path.push(v);
 421:               v = prevF[v];
 422:             }
 423:             path.reverse();
 424:             return { pin: hit, path };
 425:           }
 426:         }
 427:         for (const e of side.adjacency[u]) {
 428:           const edge = side.edges[e];
 429:           const v = edge.a === u ? edge.b : edge.a;
 430:           const nd = d + edge.length;
 431:           if (nd < distF[v]) {
 432:             distF[v] = nd;
 433:             prevF[v] = u;
 434:             pushF(nd, v);
 435:           }
 436:         }
 437:       }
 438:       return null;
 439:     }
 440:     const H = maxHops + 1;
 441:     const dist = new Float64Array(nodeCount * H).fill(Infinity);
 442:     const prev = new Int32Array(nodeCount * H).fill(-1);
 443:     const prevH = new Int8Array(nodeCount * H).fill(-1);
 444:     // Binary heap of [d, node, hops], smallest distance first.
 445:     const heap: Array<[number, number, number]> = [];
 446:     const push = (d: number, v: number, h: number): void => {
 447:       heap.push([d, v, h]);
 448:       let i = heap.length - 1;
 449:       while (i > 0) {
 450:         const parent = (i - 1) >> 1; // lit-ok: heap parent
 451:         if (heap[parent][0] <= heap[i][0]) break;
 452:         const tmp = heap[parent];
 453:         heap[parent] = heap[i];
 454:         heap[i] = tmp;
 455:         i = parent;
 456:       }
 457:     };
 458:     const pop = (): [number, number, number] | null => {
 459:       if (heap.length === 0) return null;
 460:       const top = heap[0];
 461:       const last = heap.pop() as [number, number, number];
 462:       if (heap.length > 0) {
 463:         heap[0] = last;
 464:         let i = 0;
 465:         for (;;) {
 466:           const left = i * 2 + 1; // lit-ok: heap child
 467:           const right = left + 1; // lit-ok: heap child
 468:           let smallest = i;
 469:           if (left < heap.length && heap[left][0] < heap[smallest][0]) {
 470:             smallest = left;
 471:           }
 472:           if (right < heap.length && heap[right][0] < heap[smallest][0]) {
 473:             smallest = right;
 474:           }
 475:           if (smallest === i) break;
 476:           const tmp = heap[smallest];
 477:           heap[smallest] = heap[i];
 478:           heap[i] = tmp;
 479:           i = smallest;
 480:         }
 481:       }
 482:       return top;
 483:     };
 484:     dist[from * H] = 0;
 485:     push(0, from, 0);
 486:     while (heap.length > 0) {
 487:       const item = pop();
 488:       if (!item) break;
 489:       const [d, u, h] = item;
 490:       if (d > dist[u * H + h]) continue;
 491:       if (u !== from) {
 492:         const hit = openByNode.get(u);
 493:         if (hit) {
 494:           const path: number[] = [];
 495:           let v = u;
 496:           let hh = h;
 497:           while (v !== -1) {
 498:             path.push(v);
 499:             const pv = prev[v * H + hh];
 500:             const ph = prevH[v * H + hh];
 501:             v = pv;
 502:             hh = ph;
 503:           }
 504:           path.reverse();
 505:           return { pin: hit, path };
 506:         }
 507:       }
 508:       if (h >= maxHops) continue;
 509:       for (const e of side.adjacency[u]) {
 510:         const edge = side.edges[e];
 511:         const v = edge.a === u ? edge.b : edge.a;
 512:         const nd = d + edge.length;
 513:         const nh = h + 1;
 514:         if (nd < dist[v * H + nh]) {
 515:           dist[v * H + nh] = nd;
 516:           prev[v * H + nh] = u;
 517:           prevH[v * H + nh] = h;
 518:           push(nd, v, nh);
 519:         }
 520:       }
 521:     }
 522:     return null;
 523:   }
 524: 
 525:   function nearestNode(x: number, z: number): number {
 526:     let best = 0;
 527:     let bestD = Infinity;
 528:     for (let v = 0; v < nodeCount; v++) {
 529:       const dx = nodeX(v) - x;
 530:       const dz = nodeZ(v) - z;
 531:       const d = dx * dx + dz * dz;
 532:       if (d < bestD) {
 533:         bestD = d;
 534:         best = v;
 535:       }
 536:     }
 537:     return best;
 538:   }
 539: 
 540:   // --- Routes. ---
 541:   function buildRoute(
 542:     path: number[],
 543:     tNow: number,
 544:   ): {
 545:     lanes: Int32Array;
 546:     starts: Float32Array;
 547:     fadeAts: Float32Array;
 548:     uPerSecs: Float32Array;
 549:     totalLength: number;
 550:     tEnd: number;
 551:   } {
 552:     const laneIds: number[] = [];
 553:     const starts: number[] = [];
 554:     const uPerSecs: number[] = [];
 555:     let arc = 0;
 556:     let total = 0;
 557:     const edgeLens: number[] = [];
 558:     for (let i = 0; i + 1 < path.length; i++) {
 559:       const u = path[i];
 560:       const v = path[i + 1];
 561:       const e = edgeByPair.get(
 562:         `${Math.min(u, v)},${Math.max(u, v)}`,
 563:       ) as number;
 564:       edgeLens.push(side.edges[e].length);
 565:       total += side.edges[e].length;
 566:     }
 567:     for (let i = 0; i + 1 < path.length; i++) {
 568:       const u = path[i];
 569:       const v = path[i + 1];
 570:       const e = edgeByPair.get(
 571:         `${Math.min(u, v)},${Math.max(u, v)}`,
 572:       ) as number;
 573:       const edge = side.edges[e];
 574:       const k = edge.laneCount;
 575:       const laneLen = edge.length / k;
 576:       const forward = edge.a === u && edge.b === v;
 577:       for (let s = 0; s < k; s++) {
 578:         const lane = forward ? edge.laneStart + s : edge.laneStart + (k - 1 - s); // lit-ok: reverse lane order
 579:         const frac = forward ? s / k : (k - 1 - s) / k; // lit-ok: reverse lane offset
 580:         laneIds.push(lane);
 581:         starts.push(tNow + (arc + frac * edge.length) / ROUTE_SPEED);
 582:         uPerSecs.push(
 583:           (forward ? ROUTE_SPEED : -ROUTE_SPEED) / laneLen, // lit-ok: signed rate
 584:         );
 585:       }
 586:       arc += edge.length;
 587:     }
 588:     const tEnd = tNow + total / ROUTE_SPEED;
 589:     const fadeAt = tEnd + P.holdMs / 1000; // lit-ok: ms to sec
 590:     return {
 591:       lanes: new Int32Array(laneIds),
 592:       starts: new Float32Array(starts),
 593:       fadeAts: new Float32Array(laneIds.map(() => fadeAt)),
 594:       uPerSecs: new Float32Array(uPerSecs),
 595:       totalLength: total,
 596:       tEnd,
 597:     };
 598:   }
 599: 
 600:   function activeMatchCount(): number {
 601:     return matches.filter((m) => m.state !== 'fading').length;
 602:   }
 603: 
 604:   function fadeMatchNow(m: Match, tNow: number): void {
 605:     // Oldest match gives up its lanes immediately (cap path).
 606:     const fadeAts = new Float32Array(m.lanes.length).fill(tNow);
 607:     lanefield.setActivity(m.lanes, m.starts, fadeAts, 1, m.uPerSecs);
 608:     m.state = 'fading';
 609:     m.req.state = 'fading';
 610:     m.off.state = 'fading';
 611:     m.req.fadingAt = tNow;
 612:     m.off.fadingAt = tNow;
 613:   }
 614: 
 615:   function createMatch(
 616:     req: Pin,
 617:     off: Pin,
 618:     path: number[],
 619:     tNow: number,
 620:     visitor = false,
 621:   ): void {
 622:     const route = buildRoute(path, tNow);
 623:     lanefield.setActivity(route.lanes, route.starts, route.fadeAts, 1, route.uPerSecs);
 624:     matches.push({
 625:       id: matchId++,
 626:       req,
 627:       off,
 628:       lanes: route.lanes,
 629:       starts: route.starts,
 630:       fadeAts: route.fadeAts,
 631:       uPerSecs: route.uPerSecs,
 632:       tEnd: route.tEnd,
 633:       state: 'routing',
 634:       visitor,
 635:     });
 636:     req.state = 'matched';
 637:     off.state = 'matched';
 638:     if (visitor) {
 639:       // Subject: the camera pans the route into the hero's clear spot.
 640:       emitStage({
 641:         type: 'subject',
 642:         layout: 'leaflink',
 643:         ground: [
 644:           (nodeX(req.node) + nodeX(off.node)) / 2,
 645:           (nodeZ(req.node) + nodeZ(off.node)) / 2,
 646:         ],
 647:       });
 648:     }
 649:   }
 650: 
 651:   function tryMatch(pin: Pin, tNow: number, hopLimit: number): void {
 652:     if (pin.state !== 'open') return;
 653:     if (activeMatchCount() >= P.maxMatches) return;
 654:     const want: LeaflinkPinKind = pin.kind === 'request' ? 'offer' : 'request';
 655:     const found = nearestOpenPin(pin.node, want, hopLimit);
 656:     if (!found) return;
 657:     const other = found.pin;
 658:     const req = pin.kind === 'request' ? pin : other;
 659:     const off = pin.kind === 'offer' ? pin : other;
 660:     createMatch(req, off, found.path, tNow);
 661:   }
 662: 
 663:   function tryMatchVisitor(pin: Pin, tNow: number): void {
 664:     if (pin.state !== 'open') return;
 665:     if (activeMatchCount() >= P.maxMatches) {
 666:       // Oldest match fades immediately to make room (S06 tap section).
 667:       const oldest = matches
 668:         .filter((m) => m.state !== 'fading')
 669:         .sort((a, b) => a.tEnd - b.tEnd)[0];
 670:       if (oldest) fadeMatchNow(oldest, tNow);
 671:     }
 672:     if (activeMatchCount() >= P.maxMatches) return;
 673:     const found = nearestOpenPin(pin.node, 'request', nodeCount);
 674:     if (!found) return;
 675:     createMatch(found.pin, pin, found.path, tNow, true);
 676:   }
 677: 
 678:   // --- Spawns. ---
 679:   function pickSpawnNode(): number | null {
 680:     for (let attempt = 0; attempt < 64; attempt++) { // lit-ok: spawn retry cap
 681:       const node = Math.floor(rand() * nodeCount);
 682:       const near = bfsDistances(node, 1);
 683:       let blocked = false;
 684:       for (const p of pins) {
 685:         if (near.has(p.node)) {
 686:           blocked = true;
 687:           break;
 688:         }
 689:       }
 690:       if (!blocked) return node;
 691:     }
 692:     return null;
 693:   }
 694: 
 695:   function placePin(
 696:     kind: LeaflinkPinKind,
 697:     node: number,
 698:     tNow: number,
 699:     visitor: boolean,
 700:   ): Pin {
 701:     const pin: Pin = {
 702:       id: pinId++,
 703:       node,
 704:       kind,
 705:       state: 'landing',
 706:       visitor,
 707:       bornAt: tNow,
 708:       landedAt: tNow + T.motion.ms.mediumMin / 1000, // lit-ok: ms to sec
 709:       fadingAt: 0,
 710:       haloBornAt: 0,
 711:     };
 712:     pins.push(pin);
 713:     ripples.push({ node, bornAt: tNow });
 714:     return pin;
 715:   }
 716: 
 717:   function doSpawn(tScheduled: number): void {
 718:     if (pins.length >= P.maxPins) return;
 719:     const kind: LeaflinkPinKind =
 720:       rand() < P.requestFraction ? 'request' : 'offer'; // lit-ok: kind draw
 721:     const node = pickSpawnNode();
 722:     if (node === null) return;
 723:     placePin(kind, node, tScheduled, false);
 724:     events.push({ kind, node, time: rel(tScheduled) });
 725:   }
 726: 
 727:   function scheduleNext(after: number): void {
 728:     const lo = INTERVAL_MS[0];
 729:     const hi = INTERVAL_MS[1];
 730:     nextEventAt = after + (lo + rand() * (hi - lo)) / 1000; // lit-ok: ms to sec
 731:   }
 732: 
 733:   function spawnVisitorRequestNear(offerNode: number, tNow: number): void {
 734:     const dist = bfsDistances(offerNode, P.visitorRequestHops[1]);
 735:     const band: number[] = [];
 736:     for (const [v, d] of dist) {
 737:       if (d >= P.visitorRequestHops[0] && d <= P.visitorRequestHops[1]) {
 738:         band.push(v);
 739:       }
 740:     }
 741:     let node: number | null = null;
 742:     if (band.length > 0) {
 743:       node = band[Math.floor(rand() * band.length)];
 744:     } else {
 745:       const full = bfsDistances(offerNode, nodeCount);
 746:       const far: number[] = [];
 747:       for (const [v, d] of full) {
 748:         if (d >= P.visitorRequestHops[0]) far.push(v);
 749:       }
 750:       if (far.length > 0) node = far[Math.floor(rand() * far.length)];
 751:     }
 752:     if (node === null) return;
 753:     if (pins.length >= P.maxPins) return;
 754:     placePin('request', node, tNow, false);
 755:   }
 756: 
 757:   // --- Core sim step (interval + test hook). ---
 758:   function processDue(): void {
 759:     if (disposed || paused || reduced) return;
 760:     const now = simNow();
 761:     while (nextEventAt <= now) {
 762:       const at = nextEventAt;
 763:       scheduleNext(at);
 764:       doSpawn(at);
 765:     }
 766:     // Landings first, so simultaneous landings can match each other.
 767:     // Visitor attempts run before sim attempts: a spawned request must
 768:     // match the visitor offer it was spawned for, not another open offer.
 769:     const newly: Pin[] = [];
 770:     for (const p of pins) {
 771:       if (p.state === 'landing' && p.landedAt <= now) {
 772:         p.state = 'open';
 773:         newly.push(p);
 774:       }
 775:     }
 776:     for (const p of newly) {
 777:       if (p.visitor) tryMatchVisitor(p, now);
 778:     }
 779:     for (const p of newly) {
 780:       if (!p.visitor) tryMatch(p, now, P.matchMaxHops);
 781:     }
 782:     // Match lifecycle.
 783:     for (let i = matches.length - 1; i >= 0; i--) {
 784:       const m = matches[i];
 785:       if (m.state === 'routing' && m.tEnd <= now) {
 786:         m.state = 'halo';
 787:         m.req.state = 'halo';
 788:         m.off.state = 'halo';
 789:         m.req.haloBornAt = m.tEnd;
 790:         m.off.haloBornAt = m.tEnd;
