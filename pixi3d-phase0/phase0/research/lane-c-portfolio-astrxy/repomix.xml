<file path="tools/prerender.mjs">
  1: #!/usr/bin/env node
  2: // S03 section 7: prerender. After `vite build`, fill the per-route
  3: // readout into dist/index.html's #root, set <title>, <meta
  4: // name=description>, <html data-regime> and style="color-scheme", and
  5: // write dist/index.html (server), dist/leaflink/index.html,
  6: // dist/sidequests/index.html, dist/404.html.
  7: //
  8: // Wave 1 note: the React app is still the B0 minimal App (server H1
  9: // only); B4 owns the full chrome and the route-aware readout. This tool
 10: // therefore injects the S04-structured placeholder readout per route.
 11: // When B4 lands, the injected readout must match the client render
 12: // exactly so hydrateRoot (not createRoot) produces zero mismatches;
 13: // the structure below already mirrors S04 section 3 so that swap is
 14: // mechanical.
 15: //
 16: // Usage: node tools/prerender.mjs [distDir] (default: dist).
 17: // Requires the SSR bundle first: vite build --ssr src/entry-server.tsx
 18: // --outDir dist-server (run by npm run build before this tool).
 19: import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
 20: import { dirname, join } from 'node:path';
 21: import { fileURLToPath } from 'node:url';
 22: 
 23: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 24: const distDir = join(root, process.argv[2] ?? 'dist');
 25: 
 26: // Full App SSR render per route (B4: App accepts initialScene/
 27: // initialSheet SSR-safe). This is what hydrateRoot expects on the
 28: // client; a placeholder readout mismatches and throws React 418.
 29: const { renderRoute } = await import(join(root, 'dist-server', 'entry-server.js'));
 30: 
 31: // Route table: S03 section 2. Titles and H1s come from S09 via the
 32: // generated copy module, read here as JSON-free constants because this
 33: // tool runs on the built output, not the TS source. The strings below
 34: // are verified against src/copy.ts by the prerender test; if copy
 35: // changes, the test fails and this file is updated with it.
 36: const ROUTES = [
 37:   {
 38:     out: 'index.html',
 39:     regime: 'void',
 40:     colorScheme: 'dark',
 41:     title: 'Justin Poli',
 42:     h1: 'Justin Poli',
 43:     readoutClass: 'server',
 44:     h1Id: 'h-server',
 45:     scene: 'server',
 46:     sheet: null,
 47:   },
 48:   {
 49:     out: join('leaflink', 'index.html'),
 50:     regime: 'paper',
 51:     colorScheme: 'light',
 52:     title: 'LeafLink, Justin Poli',
 53:     h1: 'LeafLink',
 54:     readoutClass: 'leaflink',
 55:     h1Id: 'h-leaflink',
 56:     scene: 'leaflink',
 57:     sheet: null,
 58:   },
 59:   {
 60:     out: join('sidequests', 'index.html'),
 61:     regime: 'field',
 62:     colorScheme: 'dark',
 63:     title: 'SideQuests, Justin Poli',
 64:     h1: 'SideQuests',
 65:     readoutClass: 'sidequests',
 66:     h1Id: 'h-sidequests',
 67:     scene: 'sidequests',
 68:     sheet: null,
 69:   },
 70:   {
 71:     out: '404.html',
 72:     regime: 'void',
 73:     colorScheme: 'dark',
 74:     title: 'Not found, Justin Poli',
 75:     h1: 'Nothing at this address.',
 76:     readoutClass: 'notfound',
 77:     h1Id: 'h-notfound',
 78:     scene: 'notfound',
 79:     sheet: null,
 80:   },
 81: ];
 82: 
 83: const META_DESC =
 84:   'Justin Poli. Computer science senior at SUNY New Paltz, graduating December 2027. Runs his own LLM inference server at home.';
 85: 
 86: // Ground colors per regime, from T.color (DESIGN section 3.2). Kept in
 87: // sync with src/tokens.generated.ts by the prerender test.
 88: const REGIME_GROUND = {
 89:   void: '#0A0C0F',
 90:   paper: '#F3F0EA',
 91:   field: '#10294E',
 92: };
 93: 
 94: function readoutHtml(route) {
 95:   return renderRoute(route.scene, route.sheet);
 96: }
 97: 
 98: function render(base, route) {
 99:   let html = base;
100:   // <html data-regime> and style="color-scheme".
101:   html = html.replace(
102:     /<html([^>]*)>/,
103:     (_m, attrs) => {
104:       let next = attrs.replace(/data-regime="[^"]*"/, '');
105:       next = next.replace(/style="[^"]*"/, '');
106:       return `<html${next} data-regime="${route.regime}" style="color-scheme: ${route.colorScheme}">`;
107:     },
108:   );
109:   // <title>.
110:   html = html.replace(/<title>[^<]*<\/title>/, `<title>${route.title}</title>`);
111:   // <meta name=description> (same on all routes, S09 C-META-DESC).
112:   html = html.replace(
113:     /<meta name="description" content="[^"]*" \/>/,
114:     `<meta name="description" content="${META_DESC}" />`,
115:   );
116:   // <meta name=theme-color> (regime ground).
117:   html = html.replace(
118:     /<meta name="theme-color" content="[^"]*" \/>/,
119:     `<meta name="theme-color" content="${REGIME_GROUND[route.regime]}" />`,
120:   );
121:   // #root content.
122:   html = html.replace(
123:     /<div id="root">[\s\S]*?<\/div>/,
124:     `<div id="root">${readoutHtml(route)}</div>`,
125:   );
126:   return html;
127: }
128: 
129: const base = readFileSync(join(distDir, 'index.html'), 'utf8');
130: for (const route of ROUTES) {
131:   const outPath = join(distDir, route.out);
132:   mkdirSync(dirname(outPath), { recursive: true });
133:   writeFileSync(outPath, render(base, route));
134:   console.log(`prerender: wrote ${route.out}`);
135: }
