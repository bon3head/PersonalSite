<file path="tools/agent-map.mjs">
  1: #!/usr/bin/env node
  2: // Agent map: the repo's own dependency graph and blast radius, with no
  3: // third-party install. It is the in-repo fallback for code-review-graph
  4: // `impact` and graphify `affected` (see agents/CODE-MAP.md), so any agent,
  5: // local or cloud, can see what a change touches and which discipline,
  6: // specs and gates that pulls in.
  7: //
  8: // Usage (from the repo root):
  9: //   node tools/agent-map.mjs build                 write agents/map/deps.json
 10: //   node tools/agent-map.mjs impact <file...>      blast radius of these files
 11: //   node tools/agent-map.mjs impact --changed [base]  files changed vs base (default astryx-polish-r2)
 12: //   node tools/agent-map.mjs seat <file...>        disciplines, specs, gates, tests for these files
 13: //   node tools/agent-map.mjs include <file...>     --include list for a repomix pack of this task
 14: //   options: --depth N (default 3), --json
 15: //
 16: // Edges are static imports: `import ... from 'x'`, `export ... from 'x'`,
 17: // `import('x')`, and `import 'x'`, resolved for relative specifiers only
 18: // (bare package imports are recorded as external, not followed). Generated
 19: // files are nodes like any other, so a DESIGN.md token change shows up
 20: // through src/tokens.generated.ts.
 21: import { readdirSync, readFileSync, writeFileSync, mkdirSync, existsSync, statSync } from 'node:fs';
 22: import { dirname, join, relative, resolve, sep } from 'node:path';
 23: import { fileURLToPath } from 'node:url';
 24: import { execFileSync } from 'node:child_process';
 25: 
 26: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 27: const SCAN = ['src', 'tools', 'tests', 'themes/lane/laneTheme.mjs', 'vite.config.ts', 'playwright.config.ts', 'qa/polish-2'];
 28: const EXT = /\.(ts|tsx|mjs|js|cjs)$/;
 29: const RESOLVE_EXT = ['', '.ts', '.tsx', '.mjs', '.js', '/index.ts', '/index.tsx'];
 30: 
 31: const toPosix = (p) => p.split(sep).join('/');
 32: 
 33: function* walk(p) {
 34:   const abs = join(root, p);
 35:   if (!existsSync(abs)) return;
 36:   if (statSync(abs).isFile()) { if (EXT.test(p)) yield toPosix(p); return; }
 37:   for (const e of readdirSync(abs, { withFileTypes: true })) {
 38:     if (e.name === 'node_modules' || e.name.startsWith('.')) continue;
 39:     const child = toPosix(join(p, e.name));
 40:     if (e.isDirectory()) yield* walk(child);
 41:     else if (EXT.test(e.name)) yield child;
 42:   }
 43: }
 44: 
 45: const IMPORT_RE = /(?:import|export)\s[^'"`;]*?from\s*['"]([^'"]+)['"]|import\s*\(\s*['"]([^'"]+)['"]\s*\)|import\s+['"]([^'"]+)['"]/g;
 46: 
 47: function resolveSpec(fromFile, spec) {
 48:   const clean = spec.split('?')[0];
 49:   if (!clean.startsWith('.')) return { external: clean };
 50:   const base = toPosix(relative(root, resolve(root, dirname(fromFile), clean)));
 51:   for (const ext of RESOLVE_EXT) {
 52:     const cand = base + ext;
 53:     if (existsSync(join(root, cand)) && statSync(join(root, cand)).isFile()) return { file: cand };
 54:   }
 55:   // .js specifiers that point at .ts sources
 56:   const swapped = base.replace(/\.js$/, '.ts');
 57:   if (existsSync(join(root, swapped))) return { file: swapped };
 58:   return { missing: base };
 59: }
 60: 
 61: function build() {
 62:   const nodes = new Set();
 63:   const edges = [];
 64:   const external = {};
 65:   for (const scan of SCAN) {
 66:     for (const file of walk(scan)) {
 67:       nodes.add(file);
 68:       const text = readFileSync(join(root, file), 'utf8');
 69:       for (const m of text.matchAll(IMPORT_RE)) {
 70:         const spec = m[1] || m[2] || m[3];
 71:         const r = resolveSpec(file, spec);
 72:         if (r.file) { nodes.add(r.file); edges.push([file, r.file]); }
 73:         else if (r.external) (external[file] ||= new Set()).add(r.external);
 74:       }
 75:     }
 76:   }
 77:   const ext = Object.fromEntries(Object.entries(external).map(([k, v]) => [k, [...v].sort()]));
 78:   return { nodes: [...nodes].sort(), edges: edges.sort((a, b) => (a[0] + a[1]).localeCompare(b[0] + b[1])), external: ext };
 79: }
 80: 
 81: // Source edges that imports cannot see, in the same [dependent, dependency]
 82: // orientation as import edges: generators read DESIGN.md and S09, so the
 83: // generated files depend on them (tools/extract-tokens.mjs, extract-copy.mjs).
 84: const SOURCE_EDGES = [
 85:   ['src/tokens.generated.ts', 'spec/astryx/DESIGN.md'],
 86:   ['src/styles/tokens.generated.css', 'spec/astryx/DESIGN.md'],
 87:   ['themes/lane/tokens.generated.json', 'spec/astryx/DESIGN.md'],
 88:   ['src/copy.ts', 'spec/astryx/specs/S09-copy-deck.md'],
 89:   ['themes/lane/laneTheme.mjs', 'themes/lane/tokens.generated.json'],
 90: ];
 91: 
 92: function loadOwnership() {
 93:   return JSON.parse(readFileSync(join(root, 'agents/ownership.json'), 'utf8'));
 94: }
 95: 
 96: function globToRe(glob) {
 97:   let re = '';
 98:   for (let i = 0; i < glob.length; i++) {
 99:     const c = glob[i];
100:     if (c === '*' && glob[i + 1] === '*') { re += '.*'; i++; if (glob[i + 1] === '/') i++; }
101:     else if (c === '*') re += '[^/]*';
102:     else if ('.+()^$|{}[]\\'.includes(c)) re += '\\' + c;
103:     else re += c;
104:   }
105:   return new RegExp('^' + re + '$');
106: }
107: 
108: function seatsFor(files, own) {
109:   const hits = [];
110:   for (const f of files) {
111:     for (const rule of own.rules) {
112:       if (rule.paths.some((g) => globToRe(g).test(f))) hits.push({ file: f, ...rule });
113:     }
114:   }
115:   return hits;
116: }
117: 
118: function impact(graph, files, depth) {
119:   const rev = new Map();
120:   for (const [a, b] of [...graph.edges, ...SOURCE_EDGES]) {
121:     if (!rev.has(b)) rev.set(b, new Set());
122:     rev.get(b).add(a);
123:   }
124:   const seen = new Map(files.map((f) => [f, 0]));
125:   let frontier = [...files];
126:   for (let d = 1; d <= depth && frontier.length; d++) {
127:     const next = [];
128:     for (const f of frontier) for (const dep of rev.get(f) || []) {
129:       if (!seen.has(dep)) { seen.set(dep, d); next.push(dep); }
130:     }
131:     frontier = next;
132:   }
133:   return [...seen.entries()].sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]));
134: }
135: 
136: function changedFiles(base) {
137:   const out = execFileSync('git', ['diff', '--name-only', `${base}...HEAD`], { cwd: root, encoding: 'utf8' });
138:   const wt = execFileSync('git', ['diff', '--name-only', 'HEAD'], { cwd: root, encoding: 'utf8' });
139:   const untracked = execFileSync('git', ['ls-files', '--others', '--exclude-standard'], { cwd: root, encoding: 'utf8' });
140:   return [...new Set((out + wt + untracked).split('\n').filter(Boolean))];
141: }
142: 
143: const args = process.argv.slice(2);
144: const cmd = args.shift();
145: const flag = (name, dflt) => { const i = args.indexOf(name); if (i < 0) return dflt; const v = args[i + 1]; args.splice(i, 2); return v; };
146: const asJson = args.includes('--json'); if (asJson) args.splice(args.indexOf('--json'), 1);
147: const depth = Number(flag('--depth', '3'));
148: 
149: if (cmd === 'build') {
150:   const g = build();
151:   mkdirSync(join(root, 'agents/map'), { recursive: true });
152:   writeFileSync(join(root, 'agents/map/deps.json'), JSON.stringify({ generatedBy: 'node tools/agent-map.mjs build', sourceEdges: SOURCE_EDGES, ...g }, null, 1) + '\n');
153:   console.log(`agents/map/deps.json: ${g.nodes.length} nodes, ${g.edges.length} import edges, ${SOURCE_EDGES.length} source edges`);
154: } else if (cmd === 'impact' || cmd === 'seat' || cmd === 'include') {
155:   let files = args;
156:   if (args[0] === '--changed') files = changedFiles(args[1] || 'astryx-polish-r2');
157:   if (!files.length) { console.error('agent-map: no files given'); process.exit(1); }
158:   files = files.map((f) => toPosix(f).replace(/^\.\//, ''));
159:   const own = loadOwnership();
160:   const graph = build();
161:   const touched = cmd !== 'seat' ? impact(graph, files, depth) : files.map((f) => [f, 0]);
162:   const uniq = (xs) => [...new Set(xs)];
163:   const primarySeats = seatsFor(files, own);
164:   const radiusSeats = seatsFor(touched.map(([f]) => f), own);
165:   const primary = {
166:     disciplines: uniq(primarySeats.map((s) => s.discipline)),
167:     specs: uniq(primarySeats.flatMap((s) => s.specs)),
168:     notes: uniq(primarySeats.map((s) => s.notes).filter(Boolean)),
169:     needsJustin: uniq(primarySeats.filter((s) => s.needsJustin).map((s) => s.id)),
170:   };
171:   const radius = {
172:     disciplines: uniq(radiusSeats.map((s) => s.discipline)),
173:     gates: uniq(radiusSeats.flatMap((s) => s.gates)),
174:     tests: uniq(radiusSeats.flatMap((s) => s.tests || [])),
175:   };
176:   const unmapped = touched.map(([f]) => f).filter((f) => !radiusSeats.some((s) => s.file === f));
177:   const result = { input: files, depth: cmd === 'impact' ? depth : 0, touched: touched.map(([file, hop]) => ({ file, hop })), primary, radius, unmapped };
178:   if (cmd === 'include') {
179:     // Comma-separated list for `repomix --include`: the touched files plus
180:     // every spec path the primary seat names that exists in the repo.
181:     const specPaths = primary.specs.map((t) => t.split(' ')[0]).filter((t) => existsSync(join(root, t)));
182:     const always = ['AGENTS.md', 'spec/astryx/DESIGN.md', 'spec/astryx/specs/S09-copy-deck.md'];
183:     console.log(uniq([...always, ...specPaths, ...touched.map(([f]) => f)]).join(','));
184:   } else if (asJson) console.log(JSON.stringify(result, null, 1));
185:   else {
186:     console.log(`touched (${touched.length}):`);
187:     for (const [f, h] of touched) console.log(`  hop ${h}  ${f}`);
188:     console.log('primary (the files you change decide the specialization):');
189:     console.log(`  disciplines: ${primary.disciplines.join('; ') || 'none'}`);
190:     console.log(`  read specs:  ${primary.specs.join('; ') || 'none'}`);
191:     for (const n of primary.notes) console.log(`  rule:        ${n}`);
192:     if (primary.needsJustin.length) console.log(`  needs Justin: ${primary.needsJustin.join(', ')}`);
193:     console.log('blast radius (what the judge checks and which gates rerun):');
194:     console.log(`  disciplines: ${radius.disciplines.join('; ') || 'none'}`);
195:     console.log(`  gates:       ${radius.gates.join('; ') || 'none'}`);
196:     console.log(`  tests:       ${radius.tests.join('; ') || 'none'}`);
197:     if (unmapped.length) console.log(`unmapped (add a rule to agents/ownership.json): ${unmapped.join(', ')}`);
198:   }
199: } else {
200:   console.error('usage: node tools/agent-map.mjs build | include <files...> | impact <files...|--changed [base]> [--depth N] [--json] | seat <files...> [--json]');
201:   process.exit(1);
202: }
</file>

<file path="tools/brand-inspect.py">
  1: #!/usr/bin/env python3
  2: """Brand asset inspection for tools/build-brand-assets.mjs.
  3: 
  4: Reads one GIF or PNG and prints a JSON inspection record:
  5: format, dimensions, frame count, per-frame delays, loop duration,
  6: transparency index, frame 0 transparent pixel count, palette
  7: fingerprint, fringe counts, decoded bytes, and byte size.
  8: 
  9: Fingerprint rules:
 10: - GIF: the union of the global color table and every frame local
 11:   color table, parsed from the file bytes (no LZW decode needed).
 12:   The visible fingerprint drops the transparency-index entry, since
 13:   that entry never renders as a color.
 14: - PNG: the sorted set of RGB values of pixels with alpha above 0.
 15: 
 16: Fringe rule: an edge pixel is an opaque or semi-opaque pixel with
 17: a fully transparent 4-neighbour. Near white means every channel is
 18: at least 240. Semi near-white pixels (alpha between 1 and 254 with
 19: all channels at least 240) are counted separately, since they also
 20: read as a white halo on a dark field.
 21: 
 22: With --extract-frame0 <out.png>, frame 0 is written as RGBA PNG.
 23: 
 24: Exit codes: 0 ok, 2 unusable input (unknown format, bad header).
 25: """
 26: import hashlib
 27: import json
 28: import sys
 29: 
 30: import numpy as np
 31: from PIL import Image
 32: 
 33: 
 34: def gif_palette_tables(data):
 35:     """Return (global entries, per-frame local entries) as RGB tuples."""
 36:     if data[:6] not in (b"GIF87a", b"GIF89a"):
 37:         raise ValueError("not a GIF")
 38:     packed = data[10]
 39:     pos = 13
 40:     pal = set()
 41:     if packed & 0x80:
 42:         size = 2 ** ((packed & 0x07) + 1)
 43:         for i in range(size):
 44:             pal.add(tuple(data[pos + i * 3:pos + i * 3 + 3]))
 45:         pos += size * 3
 46:     while pos < len(data):
 47:         block = data[pos]
 48:         if block == 0x3B:
 49:             break
 50:         if block == 0x21:
 51:             pos += 2
 52:             while True:
 53:                 size = data[pos]
 54:                 pos += 1
 55:                 if size == 0:
 56:                     break
 57:                 pos += size
 58:         elif block == 0x2C:
 59:             local_packed = data[pos + 9]
 60:             pos += 10
 61:             if local_packed & 0x80:
 62:                 size = 2 ** ((local_packed & 0x07) + 1)
 63:                 for i in range(size):
 64:                     pal.add(tuple(data[pos + i * 3:pos + i * 3 + 3]))
 65:                 pos += size * 3
 66:             pos += 1
 67:             while True:
 68:                 size = data[pos]
 69:                 pos += 1
 70:                 if size == 0:
 71:                     break
 72:                 pos += size
 73:         else:
 74:             raise ValueError("unknown GIF block 0x%02x at %d" % (block, pos))
 75:     return pal
 76: 
 77: 
 78: def hex_color(rgb):
 79:     return "#%02X%02X%02X" % rgb
 80: 
 81: 
 82: def main():
 83:     args = sys.argv[1:]
 84:     if not args:
 85:         print("usage: brand-inspect.py <input> [--extract-frame0 <out.png>]",
 86:               file=sys.stderr)
 87:         return 2
 88:     path = args[0]
 89:     frame0_out = None
 90:     if "--extract-frame0" in args:
 91:         frame0_out = args[args.index("--extract-frame0") + 1]
 92:     raw = open(path, "rb").read()
 93:     im = Image.open(path)
 94:     fmt = im.format
 95:     width, height = im.size
 96:     n_frames = getattr(im, "n_frames", 1)
 97:     delays = []
 98:     edge_px = 0
 99:     near_white_edge = 0
100:     semi_near_white = 0
101:     frame0_transparent = None
102:     transparency_index = im.info.get("transparency")
103:     for i in range(n_frames):
104:         im.seek(i)
105:         delays.append(im.info.get("duration") or 0)
106:         rgba = np.asarray(im.convert("RGBA"), dtype=np.int16)
107:         alpha = rgba[:, :, 3]
108:         if i == 0:
109:             frame0_transparent = int((alpha == 0).sum())
110:             if frame0_out:
111:                 im.seek(0)
112:                 im.convert("RGBA").save(frame0_out, format="PNG")
113:         opaque = alpha > 0
114:         trans = alpha == 0
115:         neigh = np.zeros_like(trans)
116:         neigh[1:, :] |= trans[:-1, :]
117:         neigh[:-1, :] |= trans[1:, :]
118:         neigh[:, 1:] |= trans[:, :-1]
119:         neigh[:, :-1] |= trans[:, 1:]
120:         edge = opaque & neigh
121:         edge_px += int(edge.sum())
122:         near = (edge & (rgba[:, :, 0] >= 240)
123:                 & (rgba[:, :, 1] >= 240) & (rgba[:, :, 2] >= 240))
124:         near_white_edge += int(near.sum())
125:         semi = ((alpha > 0) & (alpha < 255)
126:                 & (rgba[:, :, 0] >= 240)
127:                 & (rgba[:, :, 1] >= 240) & (rgba[:, :, 2] >= 240))
128:         semi_near_white += int(semi.sum())
129:     if fmt == "GIF":
130:         palette = gif_palette_tables(raw)
131:         fingerprint = sorted(hex_color(c) for c in palette)
132:         fingerprint_visible = fingerprint
133:         # The RGB carried by transparent pixels in frame 0, recorded
134:         # so a later hue gate can tell the transparent entry apart
135:         # from rendered colors without dropping it from the union.
136:         transparent_rgb = None
137:         if isinstance(transparency_index, int):
138:             im.seek(0)
139:             rgba0 = np.asarray(im.convert("RGBA"))
140:             mask = rgba0[:, :, 3] == 0
141:             if mask.any():
142:                 transparent_rgb = hex_color(
143:                     tuple(int(v) for v in rgba0[mask][0][:3]))
144:         has_alpha = frame0_transparent is not None and frame0_transparent > 0
145:     elif fmt == "PNG":
146:         rgba = np.asarray(Image.open(path).convert("RGBA"))
147:         mask = rgba[:, :, 3] > 0
148:         colors = set(map(tuple, rgba[mask][:, :3].tolist())) if mask.any() else set()
149:         fingerprint = sorted(hex_color(c) for c in colors)
150:         fingerprint_visible = fingerprint
151:         transparent_rgb = None
152:         has_alpha = bool((rgba[:, :, 3] < 255).any())
153:     else:
154:         print("unsupported format: %s" % fmt, file=sys.stderr)
155:         return 2
156:     fingerprint_text = "\n".join(fingerprint_visible).encode()
157:     record = {
158:         "format": fmt,
159:         "width": width,
160:         "height": height,
161:         "frames": n_frames,
162:         "delaysMs": delays,
163:         "loopMs": sum(delays),
164:         "transparencyIndex": transparency_index,
165:         "frame0TransparentPx": frame0_transparent,
166:         "hasAlpha": has_alpha,
167:         "fingerprint": fingerprint_visible,
168:         "fingerprintCount": len(fingerprint_visible),
169:         "fingerprintAllCount": len(fingerprint),
170:         "transparentRgb": transparent_rgb,
171:         "fingerprintSha256": hashlib.sha256(fingerprint_text).hexdigest(),
172:         "fringeEdgePx": edge_px,
173:         "fringeNearWhiteEdgePx": near_white_edge,
174:         "fringeSemiNearWhitePx": semi_near_white,
175:         "decodedBytes": width * height * 4 * n_frames,
176:         "bytes": len(raw),
177:         "sha256": hashlib.sha256(raw).hexdigest(),
178:     }
179:     print(json.dumps(record))
180:     return 0
181: 
182: 
183: if __name__ == "__main__":
184:     sys.exit(main())
</file>

<file path="tools/build-brand-assets.mjs">
  1: #!/usr/bin/env node
  2: // P-ASSET-2: brand asset pipeline (feedback round W3).
  3: //
  4: // Reads assets-src/brand/SOURCES.json, verifies every input sha256
  5: // against the pinned value, inspects each GIF and PNG through
  6: // tools/brand-inspect.py (frames, delays, dimensions, transparency,
  7: // palette fingerprint, fringe, budgets), extracts GIF frame 0 to PNG,
  8: // and writes content-hashed files plus manifest.json to public/brand.
  9: //
 10: // Shipping rules:
 11: // - Shipped heroes only: sidequests.gif plus its frame 0 PNG, and
 12: //   the LeafLink hero mark logo.png (W3 decision, recorded in the
 13: //   manifest and the inventory). Verified but not shipped files
 14: //   (leaves.gif, circuit.gif, gears.gif) are inspected and recorded
 15: //   in the manifest with counts, never written to public/brand and
 16: //   never prefetched. sidequests-alpha.gif is never shipped.
 17: // - Budgets come from the DESIGN.md token block (brand.gifMaxBytes,
 18: //   brand.gifMaxDecoded). A file over budget first gets a lossless
 19: //   gifsicle -O3 pass from the workspace-local install; if it is
 20: //   still over budget the build FAILS here. Resizing to displayed
 21: //   size times 3 DPR is a W6 decision (displayed size is not known
 22: //   in W3), so it is not guessed here.
 23: // - Fringe: any near-white edge pixel or semi-transparent
 24: //   near-white pixel FAILS the build. No asset in this round is
 25: //   matted against white (fringe counts are zero), so no rematte
 26: //   step runs; a future matted asset stops the build for a human
 27: //   decision instead of silently changing the art.
 28: // - This script never downloads anything and never uses a token.
 29: //   Inputs are the already-pulled files under feedback-2026-10-31.
 30: //   Codeberg re-verification against pinned commits is a separate
 31: //   manual receipt (connector helper), recorded in SOURCES.json.
 32: import { createHash } from 'node:crypto';
 33: import { execFileSync, spawnSync } from 'node:child_process';
 34: import {
 35:   existsSync,
 36:   mkdirSync,
 37:   readFileSync,
 38:   readdirSync,
 39:   rmSync,
 40:   writeFileSync,
 41:   copyFileSync,
 42: } from 'node:fs';
 43: import { dirname, join, basename } from 'node:path';
 44: import { fileURLToPath } from 'node:url';
 45: 
 46: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 47: const home = process.env.HOME || '';
 48: const brandTools = join(home, 'workspace', 'tools', 'brand-tools');
 49: const gifsicleBin = join(brandTools, 'usr', 'bin', 'gifsicle');
 50: 
 51: function fail(message) {
 52:   console.error(`build-brand-assets: FAIL: ${message}`);
 53:   process.exit(1);
 54: }
 55: 
 56: function sha256File(path) {
 57:   return createHash('sha256').update(readFileSync(path)).digest('hex');
 58: }
 59: 
 60: function hashPrefix(sha) {
 61:   return sha.slice(0, 16);
 62: }
 63: 
 64: function readDesignBrandTokens() {
 65:   const design = readFileSync(join(root, 'spec', 'astryx', 'DESIGN.md'), 'utf8');
 66:   const m = design.match(/```json design-tokens\n([\s\S]*?)\n```/);
 67:   if (!m) fail('no design-tokens block in spec/astryx/DESIGN.md');
 68:   let tokens;
 69:   try {
 70:     tokens = JSON.parse(m[1]);
 71:   } catch (e) {
 72:     fail(`design-tokens block is not valid JSON: ${e.message}`);
 73:   }
 74:   return tokens.brand;
 75: }
 76: 
 77: function inspect(inputPath, frame0Out) {
 78:   const args = [join(root, 'tools', 'brand-inspect.py'), inputPath];
 79:   if (frame0Out) args.push('--extract-frame0', frame0Out);
 80:   let out;
 81:   try {
 82:     out = execFileSync('python3', args, { encoding: 'utf8', timeout: 300000 });
 83:   } catch (e) {
 84:     fail(`brand-inspect.py failed for ${inputPath}: ${e.message}`);
 85:   }
 86:   return JSON.parse(out);
 87: }
 88: 
 89: function tryGifsicleO3(inputPath, tmpOut) {
 90:   if (!existsSync(gifsicleBin)) return false;
 91:   const r = spawnSync(gifsicleBin, ['-O3', inputPath, '-o', tmpOut], {
 92:     encoding: 'utf8',
 93:   });
 94:   return r.status === 0 && existsSync(tmpOut);
 95: }
 96: 
 97: const budgets = readDesignBrandTokens();
 98: const sourcesDoc = JSON.parse(
 99:   readFileSync(join(root, 'assets-src', 'brand', 'SOURCES.json'), 'utf8'),
100: );
101: const pulledDir = join(root, 'feedback-2026-10-31', 'assets');
102: const brandDir = join(root, 'public', 'brand');
103: const tmpDir = join(root, 'public', 'brand.tmp');
104: mkdirSync(brandDir, { recursive: true });
105: mkdirSync(tmpDir, { recursive: true });
106: 
107: const SHIPPED = new Set(['sidequests.gif', 'logo.png']);
108: const inspected = {};
109: const shippedFiles = {};
110: 
111: for (const src of sourcesDoc.sources) {
112:   const inputPath = join(pulledDir, src.file);
113:   if (!existsSync(inputPath)) fail(`missing pulled input ${inputPath}`);
114:   const localSha = sha256File(inputPath);
115:   if (localSha !== src.sha256) {
116:     fail(`${src.file} sha256 mismatch: local ${localSha} vs SOURCES ${src.sha256}`);
117:   }
118:   const isShipped = SHIPPED.has(src.file);
119:   const frame0Tmp = isShipped && src.file.endsWith('.gif')
120:     ? join(tmpDir, `${src.file}.frame0.png`)
121:     : null;
122:   let info = inspect(inputPath, frame0Tmp);
123:   if (info.sha256 !== src.sha256) fail(`${src.file} inspect sha mismatch`);
124:   if (info.bytes !== src.bytes) fail(`${src.file} byte size mismatch`);
125:   // Budget gate, with one lossless retry for GIFs.
126:   let overBytes = info.bytes > budgets.gifMaxBytes;
127:   let overDecoded = info.decodedBytes > budgets.gifMaxDecoded;
128:   let optimized = false;
129:   if ((overBytes || overDecoded) && src.file.endsWith('.gif')) {
130:     const optTmp = join(tmpDir, `${src.file}.opt.gif`);
131:     if (tryGifsicleO3(inputPath, optTmp)) {
132:       const optInfo = inspect(optTmp, null);
133:       if (optInfo.bytes <= budgets.gifMaxBytes
134:         && optInfo.decodedBytes <= budgets.gifMaxDecoded) {
135:         info = optInfo;
136:         optimized = true;
137:         copyFileSync(optTmp, join(tmpDir, `${src.file}.ship`));
138:         overBytes = false;
139:         overDecoded = false;
140:       }
141:     }
142:   }
143:   if (overBytes || overDecoded) {
144:     fail(
145:       `${src.file} over budget after lossless gifsicle -O3: ` +
146:       `${info.bytes} bytes (max ${budgets.gifMaxBytes}), ` +
147:       `${info.decodedBytes} decoded (max ${budgets.gifMaxDecoded}). ` +
148:       'Resize to displayed size times 3 DPR needs the W6 displayed ' +
149:       'size, so the build stops here instead of guessing it.',
150:     );
151:   }
152:   // Fringe gate.
153:   if (info.fringeNearWhiteEdgePx > 0 || info.fringeSemiNearWhitePx > 0) {
154:     fail(
155:       `${src.file} fringe violation: ${info.fringeNearWhiteEdgePx} ` +
156:       `near-white edge pixels, ${info.fringeSemiNearWhitePx} ` +
157:       'semi-transparent near-white pixels. T-ASSET-4 must pass or ' +
158:       'W3 stops; no rematte is applied automatically.',
159:     );
160:   }
161:   inspected[src.file] = { source: src, info, optimized };
162:   if (!isShipped) continue;
163:   // If optimization replaced the GIF, its frame 0 PNG must come
164:   // from the optimized bytes, not the original input.
165:   if (optimized && frame0Tmp) {
166:     inspect(join(tmpDir, `${src.file}.ship`), frame0Tmp);
167:   }
168:   // Write the shipped file under a content hash name.
169:   const shipSrc = optimized
170:     ? join(tmpDir, `${src.file}.ship`)
171:     : inputPath;
172:   const shipSha = sha256File(shipSrc);
173:   const stem = basename(src.file).replace(/\.(gif|png)$/, '');
174:   const ext = src.file.endsWith('.gif') ? 'gif' : 'png';
175:   const outName = `${stem}.${hashPrefix(shipSha)}.${ext}`;
176:   copyFileSync(shipSrc, join(brandDir, outName));
177:   const record = {
178:     file: outName,
179:     sourceRepo: src.repo,
180:     sourcePath: src.path,
181:     sourceCommit: src.last_commit_sha,
182:     sourceSha256: src.sha256,
183:     sha256: shipSha,
184:     bytes: info.bytes,
185:     width: info.width,
186:     height: info.height,
187:     format: info.format,
188:     frames: info.frames,
189:     delaysMs: info.delaysMs,
190:     loopMs: info.loopMs,
191:     decodedBytes: info.decodedBytes,
192:     hasAlpha: info.hasAlpha,
193:     transparencyIndex: info.transparencyIndex,
194:     transparentRgb: info.transparentRgb,
195:     frame0TransparentPx: info.frame0TransparentPx,
196:     fingerprint: info.fingerprint,
197:     fingerprintCount: info.fingerprintCount,
198:     fingerprintSha256: info.fingerprintSha256,
199:     fringeEdgePx: info.fringeEdgePx,
200:     fringeNearWhiteEdgePx: info.fringeNearWhiteEdgePx,
201:     fringeSemiNearWhitePx: info.fringeSemiNearWhitePx,
202:     optimizedWithGifsicleO3: optimized,
203:     alt: src.alt,
204:     role: src.role,
205:   };
206:   shippedFiles[src.file] = record;
207:   // GIF heroes also ship their frame 0 PNG.
208:   if (frame0Tmp) {
209:     const pngSha = sha256File(frame0Tmp);
210:     const pngName = `${stem}.frame0.${hashPrefix(pngSha)}.png`;
211:     copyFileSync(frame0Tmp, join(brandDir, pngName));
212:     const pngInfo = inspect(join(brandDir, pngName), null);
213:     shippedFiles[`${src.file}.frame0`] = {
214:       file: pngName,
215:       sourceRepo: src.repo,
216:       sourcePath: src.path,
217:       sourceCommit: src.last_commit_sha,
218:       sourceSha256: pngSha,
219:       sha256: pngSha,
220:       bytes: pngInfo.bytes,
221:       width: pngInfo.width,
222:       height: pngInfo.height,
223:       format: pngInfo.format,
224:       frames: 1,
225:       delaysMs: [],
226:       loopMs: 0,
227:       decodedBytes: pngInfo.decodedBytes,
228:       hasAlpha: pngInfo.hasAlpha,
229:       transparencyIndex: null,
230:       transparentRgb: pngInfo.transparentRgb,
231:       frame0TransparentPx: pngInfo.frame0TransparentPx,
232:       fingerprint: pngInfo.fingerprint,
233:       fingerprintCount: pngInfo.fingerprintCount,
234:       fingerprintSha256: pngInfo.fingerprintSha256,
235:       fringeEdgePx: pngInfo.fringeEdgePx,
236:       fringeNearWhiteEdgePx: pngInfo.fringeNearWhiteEdgePx,
237:       fringeSemiNearWhitePx: pngInfo.fringeSemiNearWhitePx,
238:       optimizedWithGifsicleO3: false,
239:       alt: src.alt,
240:       role: `${src.role} frame 0`,
241:       derivedFrom: record.file,
242:     };
243:   }
244: }
245: 
246: const sidequests = shippedFiles['sidequests.gif'];
247: const sidequestsFrame0 = shippedFiles['sidequests.gif.frame0'];
248: const leaflink = shippedFiles['logo.png'];
249: if (!sidequests || !sidequestsFrame0 || !leaflink) {
250:   fail('missing shipped hero record for sidequests or leaflink');
251: }
252: 
253: const verifiedNotShipped = [];
254: for (const src of sourcesDoc.sources) {
255:   if (SHIPPED.has(src.file)) continue;
256:   const { info } = inspected[src.file];
257:   verifiedNotShipped.push({
258:     file: src.file,
259:     sourceRepo: src.repo,
260:     sourcePath: src.path,
261:     sourceCommit: src.last_commit_sha,
262:     sha256: src.sha256,
263:     bytes: info.bytes,
264:     width: info.width,
265:     height: info.height,
266:     format: info.format,
267:     frames: info.frames,
268:     delaysMs: info.delaysMs,
269:     loopMs: info.loopMs,
270:     decodedBytes: info.decodedBytes,
271:     hasAlpha: info.hasAlpha,
272:     fingerprintCount: info.fingerprintCount,
273:     fingerprintSha256: info.fingerprintSha256,
274:     fringeEdgePx: info.fringeEdgePx,
275:     fringeNearWhiteEdgePx: info.fringeNearWhiteEdgePx,
276:     fringeSemiNearWhitePx: info.fringeSemiNearWhitePx,
277:     alt: src.alt,
278:     role: src.role,
279:     shipped: false,
280:     reasonNotShipped: src.reason_not_shipped || 'verified, not a hero in this round',
281:   });
282: }
283: 
284: const manifest = {
285:   version: 1,
286:   generatedBy: 'tools/build-brand-assets.mjs',
287:   budgets: {
288:     gifMaxBytes: budgets.gifMaxBytes,
289:     gifMaxDecoded: budgets.gifMaxDecoded,
290:     decodeTimeoutMs: budgets.decodeTimeoutMs,
291:     fingerprintDeltaE: budgets.fingerprintDeltaE,
292:     areaCap: budgets.areaCap,
293:   },
294:   heroes: {
295:     sidequests: { gif: sidequests, frame0: sidequestsFrame0 },
296:     leaflink: { png: leaflink, gif: null },
297:   },
298:   // Prefetch list for P-ASSET-3, in load order: the PNG that renders
299:   // first, then the animated GIF, then the LeafLink static mark.
300:   prefetch: [
301:     sidequestsFrame0.file,
302:     sidequests.file,
303:     leaflink.file,
304:   ],
305:   leaflinkHeroDecision: {
306:     mark: 'logo.png',
307:     reason:
308:       'feedback-10 matches logo.png at dHash distance 0, proving it ' +
309:       'is the recognized LeafLink logo lockup (two green leaves ' +
310:       'forming a smile). leaves.gif frame 0 is a single green maple ' +
311:       'leaf with no feedback match and is not the logo lockup, so ' +
312:       'shipping it as the mark would misrepresent the brand. ' +
313:       'logo.png is also the reduced-motion PNG and the F1 fallback ' +
314:       'source, so one file serves hero, reduced motion, and fallback.',
315:     animatedCandidateNotShipped: 'leaves.gif',
316:   },
317:   verifiedNotShipped,
318:   excluded: [
319:     {
320:       file: 'sidequests-alpha.gif',
321:       reason: 'DO NOT USE: frame 0 adds the word alpha below the logo.',
322:     },
323:     {
324:       file: 'feedback-05.jpg',
325:       reason: 'Unknown, excluded: closest dHash distance 108, no pulled asset match.',
326:     },
327:     {
328:       file: 'feedback-07.jpg',
329:       reason: 'Unknown, excluded: closest dHash distance 104, no pulled asset match.',
330:     },
331:   ],
332:   tools: {
333:     gifsicle: existsSync(gifsicleBin) ? gifsicleBin : null,
334:     imagemagickPrefix: join(brandTools, 'usr'),
335:     imagemagickNote:
336:       'Workspace-local extraction, not installed in /usr. ' +
337:       'Binaries are convert-im6.q16 and identify-im6.q16; they need ' +
338:       'LD_LIBRARY_PATH, MAGICK_CONFIGURE_PATH, and ' +
339:       'MAGICK_CODER_MODULE_PATH pointed at the prefix. ' +
340:       'Neither tool was needed for the shipped bytes: budgets pass ' +
341:       'without optimization and fringe counts are zero.',
342:   },
343: };
344: writeFileSync(
345:   join(brandDir, 'manifest.json'),
346:   `${JSON.stringify(manifest, null, 2)}\n`,
347: );
348: // Drop stale shipped files from earlier runs, then clean the temp dir.
349: for (const name of readdirSync(brandDir)) {
350:   const keep = new Set([
351:     sidequests.file,
352:     sidequestsFrame0.file,
353:     leaflink.file,
354:     'manifest.json',
355:   ]);
356:   if (!keep.has(name)) rmSync(join(brandDir, name), { force: true });
357: }
358: rmSync(tmpDir, { recursive: true, force: true });
359: console.log('build-brand-assets: wrote public/brand/manifest.json');
360: console.log(`build-brand-assets: sidequests gif ${sidequests.file} (${sidequests.bytes} bytes, ${sidequests.decodedBytes} decoded)`);
361: console.log(`build-brand-assets: sidequests frame0 ${sidequestsFrame0.file} (${sidequestsFrame0.bytes} bytes)`);
362: console.log(`build-brand-assets: leaflink png ${leaflink.file} (${leaflink.bytes} bytes)`);
363: console.log('build-brand-assets: fringe near-white edge pixels 0 on every shipped file');
