191:     expect(Math.abs((box as { height: number }).height - 44)).toBeLessThanOrEqual(1);
192:   }
193:   const twin1 = page.getByRole('button', { name: 'Trail 1' });
194:   await clickTwin(page, 'Trail 1');
195:   // On the next rAF the trail's first lane has start <= now().
196:   await page.evaluate(() => new Promise((r) => requestAnimationFrame(r)));
197:   const activity = await page.evaluate(() => {
198:     const t = window.__sqtest;
199:     const calls = t.setActivityCalls;
200:     const trail0 = t.side.trails[0];
201:     const call = calls.find(
202:       (c: { lanes: ArrayLike<number> }) => c.lanes[0] === trail0.laneIds[0],
203:     );
204:     if (!call) return null;
205:     return {
206:       kind: call.kind,
207:       lanes: Array.from(call.lanes as ArrayLike<number>),
208:       starts: Array.from(call.starts as ArrayLike<number>),
209:       uper: Array.from(call.uper as ArrayLike<number>),
210:       now: t.field.now(),
211:       arcStarts: trail0.arcStarts,
212:       arcLengths: trail0.arcLengths,
213:       laneIds: trail0.laneIds,
