 563:   // P-LF-4b mask load, polish round: both masks load once, right after
 564:   // the first rendered frame (brand bytes never precede it), into a
 565:   // cache keyed by kind. The uniform picks the cached texture for the
 566:   // current mask kind every frame, so a first visit never swaps the
 567:   // mask in mid-morph. Each mask is the brand PNG letterboxed into a
 568:   // small square canvas (aspect preserved, contour band texel wide).
 569:   // Any failure leaves the placeholder bound, so lanes render unchanged.
 570:   const maskCache = new Map<SilhouetteMaskKind, THREE.Texture>();
 571:   let masksRequested = false;
 572:   async function loadMaskTexture(file: string): Promise<THREE.Texture | null> {
 573:     const img = new Image();
 574:     img.src = `/brand/${file}`;
 575:     await img.decode();
 576:     const canvas = document.createElement('canvas');
 577:     canvas.width = SILHOUETTE_MASK_SIZE;
 578:     canvas.height = SILHOUETTE_MASK_SIZE;
 579:     const ctx = canvas.getContext('2d');
 580:     if (!ctx) return null;
 581:     const scale = Math.min(
 582:       SILHOUETTE_MASK_SIZE / img.naturalWidth,
 583:       SILHOUETTE_MASK_SIZE / img.naturalHeight,
 584:     );
 585:     const w = img.naturalWidth * scale;
 586:     const h = img.naturalHeight * scale;
 587:     ctx.clearRect(0, 0, SILHOUETTE_MASK_SIZE, SILHOUETTE_MASK_SIZE);
 588:     ctx.drawImage(img, (SILHOUETTE_MASK_SIZE - w) / 2, (SILHOUETTE_MASK_SIZE - h) / 2, w, h);
 589:     const tex = new THREE.CanvasTexture(canvas);
 590:     tex.magFilter = THREE.LinearFilter;
 591:     tex.minFilter = THREE.LinearFilter;
 592:     tex.generateMipmaps = false;
 593:     tex.flipY = false;
 594:     tex.colorSpace = THREE.NoColorSpace;
 595:     tex.needsUpdate = true;
 596:     // Upload now, so first use costs no frame. The upload does not
 597:     // bind the texture; binding happens only in syncMask, which is
 598:     // guarded during a morph.
 599:     renderer.initTexture(tex);
 600:     return tex;
 601:   }
 602:   async function preloadMasks(): Promise<void> {
 603:     const manifest = await loadBrandManifest();
 604:     if (!manifest || disposed) return;
 605:     const files: Array<[SilhouetteMaskKind, string | undefined]> = [
 606:       ['sidequests', manifest.heroes?.sidequests?.frame0?.file],
 607:       ['leaflink', manifest.heroes?.leaflink?.png?.file],
 608:     ];
 609:     for (const [kind, file] of files) {
 610:       if (!file) continue;
 611:       try {
 612:         const tex = await loadMaskTexture(file);
 613:         if (!tex) continue;
 614:         if (disposed) {
 615:           tex.dispose();
 616:           return;
 617:         }
 618:         maskCache.set(kind, tex);
 619:       } catch {
 620:         // Mask failure is not a field failure; the placeholder stays.
 621:       }
 622:     }
 623:   }
 624:   function syncMask(): void {
 625:     // DESIGN 6.7, no categorical snaps: a preload finishing mid-morph // lit-ok: section reference
 626:     // must not replace the bound mask until the morph ends. The mask
 627:     // kind flips at the morph midpoint, so an unguarded adoption would
 628:     // snap the contour during Gather. At rest, adoption runs before
 629:     // the uniform copy, so the adopted texture renders on the same
 630:     // first at-rest frame.
 631:     if (travel) return;
 632:     const kind = paramsCurrent.silhouetteMask;
 633:     const tex = kind === 'none' ? undefined : maskCache.get(kind);
 634:     maskTexture = tex ?? placeholderTex;
 635:     maskLoadedKind = tex ? kind : 'none';
 636:   }
