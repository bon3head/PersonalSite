 88: // Screen center of the target's keymap item: the morph ring departs
 89: // from the key the visitor pressed (item 5: the bulge morphs out of
 90: // another element on the page).
 91: function keyOrigin(dom: TravelDom, target: SceneId): [number, number] | null {
 92:   const item = dom.keymapItem(target);
 93:   if (!item) return null;
 94:   const r = item.getBoundingClientRect();
 95:   if (r.width === 0 && r.height === 0) return null;
 96:   return [r.left + r.width / 2, r.top + r.height / 2];
 97: }
