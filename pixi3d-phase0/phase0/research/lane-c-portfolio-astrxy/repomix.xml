<file path="src/lib/copyText.ts">
 1: export async function copyText(text: string): Promise<boolean> {
 2:   try {
 3:     await navigator.clipboard.writeText(text);
 4:     return true;
 5:   } catch {
 6:     // non-secure contexts, older browsers, denied permission
 7:     const ta = document.createElement('textarea');
 8:     ta.value = text;
 9:     ta.style.position = 'fixed';
10:     ta.style.opacity = '0';
11:     document.body.appendChild(ta);
12:     ta.select();
13:     let ok = false;
14:     try {
15:       ok = document.execCommand('copy');
16:     } catch {
17:       /* ignore */
18:     }
19:     ta.remove();
20:     return ok;
21:   }
22: }
</file>

<file path="src/lib/reducedMotion.ts">
 1: // Reduced-motion preference (S00). SSR-safe: window is touched only
 2: // when running in a browser; on the server every function no-ops and
 3: // prefersReducedMotion returns false.
 4: let motionMQ: MediaQueryList | null = null;
 5: 
 6: function getMQ(): MediaQueryList | null {
 7:   if (motionMQ) return motionMQ;
 8:   if (typeof window === 'undefined') return null;
 9:   motionMQ = window.matchMedia('(prefers-reduced-motion: reduce)');
10:   return motionMQ;
11: }
12: 
13: export function applyMotionPref(): void {
14:   const mq = getMQ();
15:   if (!mq) return;
16:   document.documentElement.classList.toggle('reduced-motion', mq.matches);
17:   // JS animation code reads the same class / motionMQ.matches before starting
18: }
19: 
20: export function initMotionPref(): void {
21:   const mq = getMQ();
22:   if (!mq) return;
23:   mq.addEventListener('change', applyMotionPref);
24:   applyMotionPref();
25: }
26: 
27: export function prefersReducedMotion(): boolean {
28:   return getMQ()?.matches ?? false;
29: }
</file>

