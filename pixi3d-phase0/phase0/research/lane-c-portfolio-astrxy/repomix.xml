 948:   // --- Reduced motion: static map, first pins and matches at once. ---
 949:   function buildReducedState(): void {
 950:     const tNow = simNow();
 951:     // Spawn pins from the seeded sequence until the reduced cap.
 952:     while (pins.length < P.reducedPins) {
 953:       const kind: LeaflinkPinKind =
 954:         rand() < P.requestFraction ? 'request' : 'offer'; // lit-ok: kind draw
 955:       const node = pickSpawnNode();
 956:       if (node === null) break;
 957:       const pin = placePin(kind, node, tNow, false);
 958:       pin.state = 'open';
 959:     }
 960:     // Complete matches in spawn order until the reduced cap.
 961:     let done = 0;
 962:     for (const p of [...pins]) {
 963:       if (done >= P.reducedMatches) break;
 964:       if (p.state !== 'open') continue;
 965:       const want: LeaflinkPinKind = p.kind === 'request' ? 'offer' : 'request';
 966:       const found = nearestOpenPin(p.node, want, P.matchMaxHops);
 967:       if (!found) continue;
 968:       const other = found.pin;
 969:       const req = p.kind === 'request' ? p : other;
 970:       const off = p.kind === 'offer' ? p : other;
 971:       const route = buildRoute(found.path, tNow - 10); // lit-ok: fully drawn start
 972:       lanefield.setActivity(
 973:         route.lanes,
 974:         route.starts,
 975:         new Float32Array(route.lanes.length).fill(tNow + 3600), // lit-ok: far fade
 976:         1,
 977:         route.uPerSecs,
 978:       );
 979:       matches.push({
 980:         id: matchId++,
 981:         req,
 982:         off,
 983:         lanes: route.lanes,
 984:         starts: route.starts,
 985:         fadeAts: new Float32Array(route.lanes.length).fill(tNow + 3600), // lit-ok: far fade
 986:         uPerSecs: route.uPerSecs,
 987:         tEnd: tNow - 10, // lit-ok: already done
 988:         state: 'halo',
 989:         visitor: false,
 990:       });
 991:       req.state = 'halo';
 992:       off.state = 'halo';
 993:       req.haloBornAt = tNow - 10; // lit-ok: halo already full
 994:       off.haloBornAt = tNow - 10; // lit-ok: halo already full
 995:       done++;
 996:     }
 997:     ripples.length = 0;
 998:   }
 999: 
1000:   // --- Visitor entry points. ---
1001:   function evictForVisitor(tNow: number): boolean {
1002:     if (pins.length < P.maxPins) return true;
1003:     const victim = pins.find((p) => p.state === 'open' && !p.visitor);
1004:     if (!victim) return false;
1005:     victim.state = 'fading';
1006:     victim.fadingAt = tNow;
1007:     return true;
1008:   }
1009: 
1010:   function dropOfferAtNode(node: number): void {
1011:     if (disposed || paused) return;
1012:     const tNow = simNow();
1013:     if (!evictForVisitor(tNow)) return;
1014:     if (reduced) {
1015:       const pin = placePin('offer', node, tNow, true);
1016:       pin.state = 'open';
1017:       const found = nearestOpenPin(node, 'request', nodeCount);
1018:       if (found) {
1019:         const route = buildRoute(found.path, tNow - 10); // lit-ok: fully drawn start
1020:         lanefield.setActivity(
1021:           route.lanes,
1022:           route.starts,
1023:           new Float32Array(route.lanes.length).fill(tNow + 3600), // lit-ok: far fade
1024:           1,
1025:           route.uPerSecs,
1026:         );
1027:         matches.push({
1028:           id: matchId++,
1029:           req: found.pin,
1030:           off: pin,
1031:           lanes: route.lanes,
1032:           starts: route.starts,
1033:           fadeAts: new Float32Array(route.lanes.length).fill(tNow + 3600), // lit-ok: far fade
1034:           uPerSecs: route.uPerSecs,
1035:           tEnd: tNow - 10, // lit-ok: already done
1036:           state: 'halo',
1037:           visitor: true,
1038:         });
1039:         found.pin.state = 'halo';
1040:         found.pin.haloBornAt = tNow - 10; // lit-ok: halo already full
1041:         pin.state = 'halo';
1042:         pin.haloBornAt = tNow - 10; // lit-ok: halo already full
1043:       }
1044:       ripples.length = 0;
1045:       updateInstances();
1046:       return;
1047:     }
1048:     const hasOpenRequest = pins.some(
1049:       (p) => p.state === 'open' && p.kind === 'request',
1050:     );
1051:     if (!hasOpenRequest) spawnVisitorRequestNear(node, tNow);
1052:     placePin('offer', node, tNow, true);
1053:   }
1054: 
1055:   function dropOfferAtCenter(): void {
1056:     dropOfferAtNode(nearestNode(0, 0));
1057:   }
1058: 
1059:   function dropOfferAtGround(x: number, z: number): void {
1060:     dropOfferAtNode(nearestNode(x, z));
1061:   }
1062: 
1063:   // --- Pointer tap (S06 tap section). ---
1064:   let downAt: number | null = null;
1065:   let downX = 0;
1066:   let downY = 0;
1067:   const onPointerDown = (event: PointerEvent): void => {
1068:     downAt = performance.now();
1069:     downX = event.clientX;
1070:     downY = event.clientY;
1071:   };
1072:   const onPointerUp = (event: PointerEvent): void => {
1073:     if (downAt === null) return;
1074:     const dt = performance.now() - downAt;
1075:     const dx = event.clientX - downX;
1076:     const dy = event.clientY - downY;
1077:     downAt = null;
1078:     if (dt >= T.world.leaflink.tapMaxMs) return;
1079:     if (Math.hypot(dx, dy) >= T.world.leaflink.tapMaxMovePx) return;
1080:     const ground = lanefield.screenToGround(event.clientX, event.clientY);
1081:     if (!ground) return;
1082:     dropOfferAtGround(ground[0], ground[1]);
1083:   };
1084:   const target = opts.target ?? null;
1085:   if (target) {
1086:     target.addEventListener('pointerdown', onPointerDown);
1087:     target.addEventListener('pointerup', onPointerUp);
1088:   }
1089: 
1090:   // --- Lifecycle. ---
1091:   const offFrame = lanefield.onFrame(() => {
1092:     if (disposed || paused) return;
1093:     updateInstances();
1094:   });
1095:   let timer: ReturnType<typeof setInterval> | null = null;
1096:   if (!reduced) {
1097:     timer = setInterval(() => {
1098:       if (disposed || paused) return;
1099:       processDue();
1100:       updateInstances();
1101:     }, 20); // lit-ok: sim tick
1102:   }
1103: 
1104:   if (reduced) {
1105:     buildReducedState();
1106:     updateInstances();
1107:   } else {
1108:     updateInstances();
1109:   }
1110: 
1111:   function pause(): void {
1112:     if (paused || disposed) return;
1113:     paused = true;
1114:     pausedAt = lanefield.now();
1115:     // Hide the meshes and clear route activity, so morphing
1116:     // back to server restores the main blue lane motion instead of leaving
1117:     // LeafLink dots on screen. The frame callback returns early while
1118:     // paused, so updateInstances never zeroes counts on its own.
1119:     pinMesh.mesh.visible = false;
1120:     haloMesh.mesh.visible = false;
1121:     rippleMesh.mesh.visible = false;
1122:     lanefield.clearActivity(1);
1123:   }
1124: 
1125:   function resume(): void {
1126:     if (!paused || disposed) return;
1127:     paused = false;
1128:     pinMesh.mesh.visible = true;
1129:     haloMesh.mesh.visible = true;
1130:     rippleMesh.mesh.visible = true;
1131:     if (pausedAt !== null) {
1132:       pausedTotal += lanefield.now() - pausedAt;
1133:       pausedAt = null;
1134:     }
1135:     // Something lands soon after return (S06 motion table).
1136:     if (nextEventAt <= simNow()) {
1137:       nextEventAt = simNow() + P.firstEventAfterMs / 1000; // lit-ok: ms to sec
1138:     }
1139:   }
1140: 
1141:   function dispose(): void {
1142:     if (disposed) return;
1143:     disposed = true;
1144:     if (timer !== null) clearInterval(timer);
1145:     offFrame();
1146:     if (target) {
1147:       target.removeEventListener('pointerdown', onPointerDown);
1148:       target.removeEventListener('pointerup', onPointerUp);
1149:     }
1150:     lanefield.scene.remove(pinMesh.mesh);
1151:     lanefield.scene.remove(haloMesh.mesh);
1152:     lanefield.scene.remove(rippleMesh.mesh);
1153:     pinMesh.geo.dispose();
1154:     haloMesh.geo.dispose();
1155:     rippleMesh.geo.dispose();
1156:     (pinMesh.mesh.material as THREE.ShaderMaterial).dispose();
1157:     (haloMesh.mesh.material as THREE.ShaderMaterial).dispose();
1158:     (rippleMesh.mesh.material as THREE.ShaderMaterial).dispose();
1159:     lanefield.clearActivity(1);
1160:   }
1161: 
1162:   return {
1163:     pause,
1164:     resume,
1165:     dispose,
1166:     dropOfferAtNode,
1167:     dropOfferAtCenter,
1168:     dropOfferAtGround,
1169:     processDue,
1170:     snapshotPins: () =>
1171:       pins.map((p) => ({
1172:         node: p.node,
1173:         kind: p.kind,
1174:         state: p.state,
1175:         visitor: p.visitor,
1176:       })),
1177:     snapshotEvents: () => [...events],
1178:     matchCount: () => matches.length,
1179:   };
1180: }
