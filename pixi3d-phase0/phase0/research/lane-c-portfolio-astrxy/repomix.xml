286:   // Claim a slot, glyphs and lanes for one word at life t.
287:   function placeWord(text: string, ySign: number, t: number): ActiveWord | null {
288:     const slot = freeSlot();
289:     if (slot < 0) return null;
290:     const w: ActiveWord = { slot, text, startSec: field.now() - t * DURATION_SEC, ySign, t, glyphs: [], opacity: 0 };
291:     cameraAxes();
292:     snapshotTips();
293:     const taken = takenLanes();
294:     // Lanes are picked against the spawn point at the focus, so each
295:     // letter leaves the horn from the lane nearest its place in the word.
296:     wordPoint(w, 0, tmpPos);
297:     let n = 0;
298:     for (let i = 0; i < text.length; i++) {
299:       const ch = text[i];
300:       if (ch === ' ') continue;
301:       const mesh = pool[slot][n];
302:       n += 1;
303:       const g: Glyph = { mesh, ch, lane: -1, index: i, rest: [0, 0, 0] };
304:       charPoint(w, g, tmpPos, tmpPoint);
305:       g.lane = nearestFree(tmpPoint, taken);
306:       if (g.lane >= 0) {
