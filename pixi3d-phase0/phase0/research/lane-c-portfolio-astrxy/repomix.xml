 15: // ---- T-SRV-1: geometry matches the formula (B5a proved the generator;
 16: // this re-verifies the controller's input through the same entry point).
 17: test('T-SRV-1: server layout hand values', () => {
 18:   const buf = new Float32Array(
 19:     T.world.layoutTexture.width * T.world.layoutTexture.height * 4,
 20:   );
 21:   generate(T.world.seed, buf, 0);
 22:   const point = (lane: number, k: number): [number, number, number] => {
 23:     const stride = T.world.pointsPerLane * T.world.layouts.length;
 24:     const base = (lane * stride + 0 * T.world.pointsPerLane + k) * 4;
 25:     return [buf[base], buf[base + 1], buf[base + 2]];
 26:   };
 27:   const close = (a: number, b: number) => {
 28:     expect(Math.abs(a - b)).toBeLessThan(1e-4);
 29:   };
 30:   const [x0, y0, z0] = point(0, 0);
 31:   close(x0, -3.565);
 32:   close(y0, -2.315);
 33:   close(z0, -24);
 34:   const [x6, y6, z6] = point(0, 6);
 35:   close(x6, -1.7825);
 36:   close(y6, -1.1575);
 37:   close(z6, 0.4);
