 907:           Math.max((now - p.fadingAt) / (P.fadeMs / 1000), 0), // lit-ok: ms to sec
 908:           1,
 909:         );
 910:         opacity = 1 - easePlain(t);
 911:       }
 912:       haloMesh.scale.setX(h, scale);
 913:       haloMesh.opacity.setX(h, opacity);
 914:       h++;
 915:     }
 916:     haloMesh.geo.instanceCount = h;
 917:     haloMesh.center.needsUpdate = true;
 918:     haloMesh.scale.needsUpdate = true;
 919:     haloMesh.opacity.needsUpdate = true;
 920:     // Ripples (900ms, pruned here).
 921:     let r = 0;
 922:     for (let i = ripples.length - 1; i >= 0; i--) {
 923:       const rip = ripples[i];
 924:       const age = now - rip.bornAt;
 925:       if (age > T.motion.ms.ripple / 1000) { // lit-ok: ms to sec
 926:         ripples.splice(i, 1);
 927:         continue;
 928:       }
 929:     }
 930:     for (const rip of ripples) {
 931:       if (r >= MAX_INSTANCES) break;
 932:       const t = Math.min(
 933:         Math.max((now - rip.bornAt) / (T.motion.ms.ripple / 1000), 0), // lit-ok: ms to sec
 934:         1,
 935:       );
 936:       const e = easePlain(t);
 937:       rippleMesh.center.setXYZ(r, nodeX(rip.node), 0.01, nodeZ(rip.node)); // lit-ok: ripple plane height
