192: function descriptorAnchor(layout: LayoutId): MorphAnchor {
193:   const d = descriptorForLayout(layout);
194:   return {
195:     center: [...d.anchor],
196:     ringRadius: d.ringRadius,
197:     silhouetteRadius: d.silhouetteRadius,
198:   };
