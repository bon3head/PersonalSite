 775:   function doFrame(t: number, dt: number, sampleGovernor: boolean): void {
 776:     updateTravel(t);
 777:     // Adoption before the uniform copy, so a texture adopted on the
 778:     // travel-completion frame renders on that same first at-rest
 779:     // frame, not the following one. Previously syncMask ran after
 780:     // render, delaying the adopted texture by one frame.
 781:     syncMask();
 782:     // P-MORPH-1 degrade observation: only frames inside a morph
 783:     // count, and the controller itself gates on its own sample, so
 784:     // a completed morph stops counting without extra state here.
 785:     if (travel) morph.observeFrame(dt * SEC_TO_MS, performance.now());
 786:     updatePan(dt * SEC_TO_MS);
 787:     camOffset[0] = pan[0] + bow.dir[0] * bow.now;
 788:     camOffset[1] = pan[1] + bow.dir[1] * bow.now;
 789:     let camBase = basePose;
 790:     if (gbCam) {
 791:       // Yaw both points about the vertical through the well, then
 792:       // translate along the ray to the well (the well keeps its screen
 793:       // position), then rise. Orientation changes by the yaw only.
 794:       const c = gbCam.center;
 795:       gbVec.set(basePose.pos[0] - c[0], basePose.pos[1] - c[1], basePose.pos[2] - c[2]);
 796:       const dist = gbVec.length();
 797:       gbVec.applyAxisAngle(GB_UP, gbCam.yawRad);
 798:       gbVec2.set(basePose.target[0] - c[0], basePose.target[1] - c[1], basePose.target[2] - c[2]);
 799:       gbVec2.applyAxisAngle(GB_UP, gbCam.yawRad);
 800:       const lift = gbCam.rise * dist;
 801:       gbPose.pos[0] = c[0] + gbVec.x * (1 - gbCam.dolly);
 802:       gbPose.pos[1] = c[1] + gbVec.y * (1 - gbCam.dolly) + lift;
 803:       gbPose.pos[2] = c[2] + gbVec.z * (1 - gbCam.dolly);
 804:       gbPose.target[0] = c[0] + gbVec2.x - gbVec.x * gbCam.dolly;
 805:       gbPose.target[1] = c[1] + gbVec2.y - gbVec.y * gbCam.dolly + lift;
 806:       gbPose.target[2] = c[2] + gbVec2.z - gbVec.z * gbCam.dolly;
 807:       gbPose.fov = basePose.fov;
 808:       gbPose.shift[0] = basePose.shift[0] + (gbCam.shift[0] - basePose.shift[0]) * gbCam.shiftMix;
 809:       gbPose.shift[1] = basePose.shift[1] + (gbCam.shift[1] - basePose.shift[1]) * gbCam.shiftMix;
 810:       camBase = gbPose;
 811:     }
 812:     rig.update(camBase, t, weights, pointer, dt * SEC_TO_MS, reduced, finePointer, camOffset);
 813:     for (const cb of callbacks) cb(t, dt);
 814:     // ITEM 6 clamp, the single and last camera write guard: after rig // lit-ok:
 815:     // interpolation, walk lean (a callback above), and parallax have
 816:     // combined, and before render. Active whenever the SideQuests
 817:     // layout has any weight, which covers morph transit and the walk.
 818:     // Other layouts keep their own poses untouched.
 819:     if (weights[layoutIndex('sidequests')] > 0) clampSideQuestsPitch(camera);
 820:     // Ring, silhouette, pulse, and glitter after the final camera write.
 821:     applyRing(t, dt * SEC_TO_MS);
 822:     // GLITTERBOX: the drawn weights blend toward the scatter layout;
 823:     // the travel weights (and every test reading them) are untouched.
 824:     for (let i = 0; i < LAYOUT_ORDER.length; i++) {
 825:       drawWeights[i] = weights[i] * (1 - glitter.value) + (i === scatterIndex ? glitter.value : 0);
 826:     }
 827:     (uniforms.uTime.value as number) = t;
 828:     (uniforms.uW.value as THREE.Vector4).set(drawWeights[0], drawWeights[1], drawWeights[2], drawWeights[3]);
 829:     (uniforms.uFrozen.value as number) = reduced ? 1 : 0;
 830:     // W4 param uniforms, from the interpolated current params.
 831:     (uniforms.uGradLead.value as THREE.Vector3).set(...paramsCurrent.leadOklab);
 832:     (uniforms.uGradTail.value as THREE.Vector3).set(...paramsCurrent.tailOklab);
 833:     (uniforms.uSignalOklab.value as THREE.Vector3).set(...paramsCurrent.signalOklab);
 834:     (uniforms.uGradTailLength.value as number) = paramsCurrent.tailLength;
 835:     (uniforms.uLightMode.value as number) = lightModeIndex(travel ? paramsTo.lightMode : paramsCurrent.lightMode);
 836:     (uniforms.uLightModeFrom.value as number) = travel ? lightModeFrom : lightModeIndex(paramsCurrent.lightMode);
 837:     (uniforms.uLightMix.value as number) = travel ? lightMix : 1;
 838:     (uniforms.uRingSwirl.value as number) = ringSwirl;
 839:     (uniforms.uLightRadius.value as number) = paramsCurrent.lightRadius;
 840:     (uniforms.uLightGain.value as number) = paramsCurrent.lightGain;
 841:     (uniforms.uRingCenter.value as THREE.Vector2).set(...paramsCurrent.ringCenter);
 842:     (uniforms.uRingRadius.value as number) = paramsCurrent.ringRadius;
 843:     (uniforms.uRingStrength.value as number) = paramsCurrent.ringStrength;
 844:     (uniforms.uSilhouetteMask.value as THREE.Texture) = maskTexture;
 845:     (uniforms.uSilhouetteCenter.value as THREE.Vector2).set(...paramsCurrent.silhouetteCenter);
 846:     (uniforms.uSilhouetteRadius.value as number) = paramsCurrent.silhouetteRadius;
 847:     (uniforms.uSilhouetteStrength.value as number) = paramsCurrent.silhouetteStrength;
 848:     const paperW = groundWeights[layoutIndex('leaflink')];
 849:     (uniforms.uGbColor.value as THREE.Vector3).copy(gbHot).lerp(gbInk, paperW);
 850:     updateClearColor();
 851:     if (sampleGovernor) {
 852:       governor.sample(dt * SEC_TO_MS, performance.now());
 853:       if (governor.effectiveDpr() !== currentDpr) applyDpr();
 854:     }
 855:     if (lanesOnly) hideNonLaneChildren();
 856:     renderer.render(scene, camera);
 857:     framesRendered += 1;
 858:     // Mask preload starts right after the first rendered frame, here
 859:     // rather than in syncMask, because syncMask now runs before
 860:     // render. Gating it on the frame count inside syncMask delayed
 861:     // it to a later frame, and on a static page with no further
 862:     // frame it might never start. Every page renders at least once
 863:     // at setup, so this trigger always fires on the first frame,
 864:     // bounding the preload delay to that frame.
 865:     if (!masksRequested && framesRendered >= 1) {
 866:       masksRequested = true;
 867:       void preloadMasks();
 868:     }
 869:     debugHandle.updateHud();
 870:   }
