164: async function loadHarness(page: Page, query = ''): Promise<void> {
165:   await page.goto(`${HARNESS}${query}`);
166:   const ok = await page.evaluate(() => window.__sqtestReady);
167:   expect(ok).toBe(true);
168:   // Markers rise with the spring after resume (stagger 80ms); settle
169:   // before asserting geometry or clicking.
170:   await page.waitForTimeout(1500);
