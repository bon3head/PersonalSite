 94: // ---- Pixel helpers: decode a Playwright screenshot inside the page
 95: // (canvas 2D) and return aggregates, so full-page RGBA never crosses
 96: // the protocol. OKLab math per the Oklab spec; delta E is Euclidean
 97: // distance in OKLab.
 98: interface PixelStats {
 99:   maxDelta: number;
100:   overChroma: number;
101:   total: number;
102: }
103: 
104: async function analyzeShot(
105:   page: import('@playwright/test').Page,
106:   shot: Buffer,
107:   region: { x: number; y: number; w: number; h: number } | null,
108:   mode: 'delta' | 'chroma',
109: ): Promise<PixelStats> {
110:   const b64 = shot.toString('base64');
111:   return page.evaluate(
112:     async ({ b64, region, mode, ground }) => {
113:       const srgbToLinear = (c: number): number => {
114:         const v = c / 255;
115:         return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
116:       };
117:       const toOklab = (r: number, g: number, b: number): [number, number, number] => {
118:         const R = srgbToLinear(r);
119:         const G = srgbToLinear(g);
120:         const B = srgbToLinear(b);
121:         const l = 0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B;
122:         const m = 0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B;
123:         const s = 0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B;
124:         const lc = Math.cbrt(l);
125:         const mc = Math.cbrt(m);
126:         const sc = Math.cbrt(s);
127:         return [
128:           0.2104542553 * lc + 0.7936177850 * mc - 0.0040720468 * sc,
129:           1.9779984951 * lc - 2.4285922050 * mc + 0.4505937099 * sc,
130:           0.0259040371 * lc + 0.7827717662 * mc - 0.8086757660 * sc,
131:         ];
132:       };
133:       const img = new Image();
134:       await new Promise<void>((res, rej) => {
135:         img.onload = () => res();
136:         img.onerror = () => rej(new Error('img load failed'));
137:         img.src = 'data:image/png;base64,' + b64;
138:       });
139:       const canvas = document.createElement('canvas');
140:       canvas.width = img.width;
141:       canvas.height = img.height;
142:       const ctx = canvas.getContext('2d', { willReadFrequently: true });
143:       if (!ctx) throw new Error('no 2d context');
144:       ctx.drawImage(img, 0, 0);
145:       const r = region ?? { x: 0, y: 0, w: img.width, h: img.height };
146:       const data = ctx.getImageData(r.x, r.y, r.w, r.h).data;
147:       const [gL, gA, gB] = toOklab(ground[0], ground[1], ground[2]);
148:       let maxDelta = 0;
149:       let overChroma = 0;
150:       let total = 0;
151:       for (let i = 0; i < data.length; i += 4) {
152:         const [L, A, B] = toOklab(data[i], data[i + 1], data[i + 2]);
153:         total += 1;
154:         if (mode === 'delta') {
155:           const d = Math.sqrt((L - gL) ** 2 + (A - gA) ** 2 + (B - gB) ** 2);
156:           if (d > maxDelta) maxDelta = d;
157:         } else {
158:           if (Math.sqrt(A * A + B * B) > 0.04) overChroma += 1;
159:         }
160:       }
161:       return { maxDelta, overChroma, total };
162:     },
163:     { b64, region, mode, ground: VOID_GROUND },
164:   );
165: }
