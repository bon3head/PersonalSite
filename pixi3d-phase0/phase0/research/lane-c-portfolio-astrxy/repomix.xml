 43:   float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z; // lit-ok: shader constant
 44:   l_ = l_ * l_ * l_; m_ = m_ * m_ * m_; s_ = s_ * s_ * s_; // lit-ok: shader constant
