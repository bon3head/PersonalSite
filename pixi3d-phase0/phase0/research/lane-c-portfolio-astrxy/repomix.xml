144: // Build a real lanefield + controller on the test page, travelling to
145: // leaflink. Returns a handle for activity records and pin snapshots.
146: // With noAppWorld, the page is expected at ?world=0 so App's idle
147: // world start returns null; this setup then drops the query (so its
148: // own createLanefield succeeds) after a tick for App's idle callback
149: // to have fired. One WebGL context instead of two: two concurrent
150: // SwiftShader contexts plus a React render OOM-closes the page.
151: async function realSetup(
152:   page: Page,
153:   opts?: { noAppWorld?: boolean },
154: ): Promise<void> {
155:   await page.evaluate(async (noAppWorld) => {
156:     if (noAppWorld) {
157:       await new Promise((r) => setTimeout(r, 500));
158:       history.replaceState(null, '', '/');
159:     }
160:     const lane = await import('/src/world/lanefield.ts');
161:     const ctrl = await import('/src/world/leaflink.ts');
162:     const { T } = await import('/src/tokens.generated.ts');
163:     const mount = document.createElement('div');
164:     mount.id = 'll-test-mount';
165:     document.body.appendChild(mount);
166:     const field = lane.createLanefield(mount, {
167:       seed: T.world.seed,
168:       reducedMotion: false,
169:       initial: 'leaflink',
170:     });
171:     if (!field) throw new Error('no WebGL2');
172:     await field.ready;
173:     const activity: Array<{ kind: number; at: number }> = [];
174:     const orig = field.setActivity.bind(field);
175:     (field as unknown as Record<string, unknown>).setActivity = (
176:       lanes: Int32Array,
177:       start: Float32Array,
178:       fade: Float32Array,
179:       kind: 1 | 2,
180:       u: Float32Array,
181:     ): void => {
182:       activity.push({ kind, at: performance.now() });
183:       orig(lanes, start, fade, kind, u);
184:     };
185:     const canvas = mount.querySelector('canvas') as HTMLCanvasElement;
186:     const c = ctrl.createLeaflinkController(field, { target: canvas });
187:     (window as unknown as Record<string, unknown>).__lltest = {
188:       field,
189:       controller: c,
190:       activity,
191:       canvas,
192:     };
193:   }, opts?.noAppWorld ?? false);
194: }
195: 
196: async function disposeReal(page: Page): Promise<void> {
197:   await page.evaluate(() => {
198:     const t = (window as unknown as Record<string, unknown>).__lltest as
199:       | {
200:           controller: { dispose: () => void };
201:           field: { dispose: () => void };
202:         }
203:       | undefined;
204:     t?.controller.dispose();
205:     t?.field.dispose();
206:     document.getElementById('ll-test-mount')?.remove();
207:   });
208: }
