 926:     getMemoryEstimate: () => {
 927:       const layoutBytes = texSpec.width * texSpec.height * TEXEL_FLOATS * TEXEL_FLOATS; // lit-ok: RGBA32F bytes
 928:       const activityBytes = 2 * actSpec.width * actSpec.height * TEXEL_FLOATS * TEXEL_FLOATS; // lit-ok: activity plus guestbook RGBA32F bytes
 929:       const instanceBytes = instanceCount * 2 * TEXEL_FLOATS + 12 * TEXEL_FLOATS + 6 * 2; // lit-ok: aSeg plus quad position plus index
