173: // Click a twin by its live center point. locator.click stalls on these
174: // buttons because they bob continuously (the position never stabilizes
175: // for the click's wait); a coordinate mouse click is the same trusted
176: // input without the stability wait. The box read itself resolves fine.
177: async function clickTwin(page: Page, name: string): Promise<void> {
178:   const box = await page.locator(`button[aria-label="${name}"]`).boundingBox();
179:   if (!box) throw new Error(`twin ${name} has no box`);
180:   await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);
181: }
