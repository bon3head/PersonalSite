358:   function frame(): void {
359:     if (!gb || !field) return;
360:     const t = nowMs();
361:     // Phone frame and contrast dim (DESIGN 6.14, 1.6.0).
362:     // Frame follows the free region only while writing: after lock-in the
363:     // settle and pull-back keep their own camera (lock-in unchanged).
364:     if (phase === 'open') updateFrame(t, false);
365:     if (panelSrc) {
366:       const b = panelSrc.panel.getBoundingClientRect();
367:       lastDimBox = [b.left, b.top, b.right, b.bottom];
368:       gb.setDim(lastDimBox, dim.value(t));
369:     }
370:     // Camera and part.
371:     if (!reduced()) {
372:       gb.setCamera({
373:         center: well,
374:         dolly: dolly.value(t),
375:         yawRad: yaw.value(t),
376:         rise: rise.value(t),
377:         shiftMix: shiftMix.value(t),
378:         shift: shiftTo,
379:       });
380:     } else {
381:       gb.setCamera(null);
382:     }
383:     const partRadius = dist * g.part.radiusFrac;
384:     gb.setPart({
385:       center: [well[0], well[2]],
386:       radius: partRadius,
387:       push: dist * g.part.pushFrac,
388:       depth: dist * g.part.depthFrac,
389:       seedUnit: u(openSeed, P.partSeed),
390:       bands: [bands[0].value(t), bands[1].value(t), bands[2].value(t)],
391:     });
