  1: // Polish round 2 browser acceptance (DESIGN 1.2.0). Every test drives
  2: // time with Playwright's fake clock (install before load, pauseAt after
  3: // it, then runFor in 16ms steps), so samples sit at known travel times
  4: // and a seeded run is reproducible frame for frame. Phone viewport 390x658
  5: // is the device-run-2 in-app browser. Dev server on 5173 (config
  6: // webServer, reused when running).
  7: import { test, expect, type Page, type BrowserContext, type Browser } from '@playwright/test';
  8: 
  9: test.setTimeout(600000);
 10: 
 11: const DEV = process.env.POLISH_DEV ?? 'http://localhost:5173';
 12: const PHONE = { width: 390, height: 658 };
 13: 
 14: type Sample = {
 15:   p: number | null;
 16:   done: boolean | null;
 17:   heroC: [number, number] | null;
 18:   heroO: number | null;
 19:   ringS: number;
 20:   silS: number;
 21:   ringPx: [number, number] | null;
 22:   readout: [number, number, number, number] | null;
 23:   pitch: number;
 24:   pan: [number, number];
 25:   glitter: { target: number; value: number };
 26:   bow: number | null;
 27:   swirl: number | null;
 28: };
 29: 
 30: async function open(browser: Browser, path: string, opts: { reduced?: boolean; viewport?: { width: number; height: number } } = {}): Promise<{ ctx: BrowserContext; page: Page }> {
 31:   const ctx = await browser.newContext({
 32:     viewport: opts.viewport ?? PHONE,
 33:     deviceScaleFactor: 1,
 34:     isMobile: true,
 35:     hasTouch: true,
 36:     reducedMotion: opts.reduced ? 'reduce' : 'no-preference',
 37:   });
 38:   const page = await ctx.newPage();
 39:   await page.clock.install({ time: new Date('2026-11-02T12:00:00Z') });
 40:   await page.goto(`${DEV}${path}`);
 41:   // install() alone lets page time keep flowing with wall time, so
 42:   // rAF steps vary (16 or 32ms) and two runs drift. Pausing makes
 43:   // runFor the only clock: frame-exact replay.
 44:   await page.clock.pauseAt(new Date('2026-11-02T12:01:00Z'));
 45:   let elapsed = 0;
 46:   for (let i = 0; i < 600; i++) {
 47:     await page.clock.runFor(50);
 48:     elapsed += 50;
 49:     const ok = await page.evaluate(() => {
 50:       const w = window as unknown as { __lanefield?: { ready: boolean }; __lanefieldReady?: unknown };
 51:       return Boolean(w.__lanefield?.ready && w.__lanefieldReady);
 52:     });
 53:     if (ok) break;
 54:   }
 55:   // Replay precondition: the brand manifest has arrived. It is real
 56:   // network I/O, so without this wait the frame at which the hero
 57:   // anchor first resolves (and Gather starts) depends on wall time.
 58:   for (let i = 0; i < 600; i++) {
 59:     // brandPrefetch sets this after the shared manifest fetch resolves
 60:     // (resource timing is no help in dev: the buffer fills with modules).
 61:     const has = await page.evaluate(() => Boolean((window as unknown as { __brandPrefetched?: unknown }).__brandPrefetched));
 62:     if (has) break;
 63:     await page.clock.runFor(50);
 64:     elapsed += 50;
 65:   }
 66:   for (let i = 0; i < 40; i++) await page.clock.runFor(50);
 67:   elapsed += 2000;
 68:   // Put the first input on the 16ms frame grid. How long the layout
 69:   // worker takes to get ready is wall time, so the number of 50ms
 70:   // waits varies; without this the morph start falls at a different
 71:   // phase between frames and every sample sits at a shifted p.
 72:   const pad = (16 - (elapsed % 16)) % 16;
 73:   if (pad > 0) await page.clock.runFor(pad);
 74:   return { ctx, page };
 75: }
 76: 
 77: function sample(page: Page): Promise<Sample> {
 78:   return page.evaluate(() => {
 79:     const w = window as unknown as {
 80:       __lanefieldReady: {
 81:         getParams: () => { ringStrength: number; silhouetteStrength: number; ringCenter: [number, number] };
 82:         worldToScreen: (p: [number, number, number]) => [number, number];
 83:         focusOffset: () => [number, number];
 84:       };
 85:       __lanefield: { camera: { pitchDeg: number } };
 86:       __morph: { sample: { p: number; done: boolean; bow: number; ringSwirl: number } | null; stage: () => { glitter: { target: number; value: number } } };
 87:     };
 88:     const f = w.__lanefieldReady;
 89:     const pr = f.getParams();
 90:     const hero = document.querySelector('[data-brand-mark]');
 91:     const hr = hero ? hero.getBoundingClientRect() : null;
 92:     const ro = document.querySelector('.jp-readout')?.getBoundingClientRect() ?? null;
 93:     const s = w.__morph.sample;
 94:     return {
 95:       p: s ? s.p : null,
 96:       done: s ? s.done : null,
 97:       heroC: hr && hr.width > 0 ? [hr.left + hr.width / 2, hr.top + hr.height / 2] : null,
 98:       heroO: hero ? Number(getComputedStyle(hero).opacity) : null,
 99:       ringS: pr.ringStrength,
100:       silS: pr.silhouetteStrength,
101:       ringPx: pr.ringStrength > 0 ? f.worldToScreen([pr.ringCenter[0], 0, pr.ringCenter[1]]) : null,
102:       readout: ro && ro.height > 0 ? [ro.left, ro.top, ro.right, ro.bottom] : null,
103:       pitch: w.__lanefield.camera.pitchDeg,
104:       pan: f.focusOffset(),
105:       glitter: w.__morph.stage().glitter,
106:       bow: s ? s.bow : null,
107:       swirl: s ? s.ringSwirl : null,
108:     } as Sample;
109:   });
110: }
111: 
112: async function run(page: Page, ms: number): Promise<Sample[]> {
113:   const out: Sample[] = [];
114:   for (let t = 16; t <= ms; t += 16) {
115:     await page.clock.runFor(16);
116:     out.push(await sample(page));
117:   }
118:   return out;
119: }
