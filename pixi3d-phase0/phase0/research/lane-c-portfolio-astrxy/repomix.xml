  1: #!/usr/bin/env node
  2: // GENERATED-INPUT reader: spec/astryx/DESIGN.md -> src/tokens.generated.ts,
  3: // themes/lane/tokens.generated.json, src/styles/tokens.generated.css.
  4: // Fails (exit 1) if the block is missing, is not valid JSON, or
  5: // world.laneCount !== world.server.sm.count * 128.
  6: import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
  7: import { dirname, join } from 'node:path';
  8: import { fileURLToPath } from 'node:url';
  9: 
 10: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 11: const designPath = join(root, 'spec/astryx/DESIGN.md');
 12: const src = readFileSync(designPath, 'utf8');
 13: 
 14: const m = src.match(/```json design-tokens\n([\s\S]*?)\n```/);
 15: if (!m) {
 16:   console.error('extract-tokens: no ```json design-tokens block found in spec/astryx/DESIGN.md');
 17:   process.exit(1);
 18: }
 19: let tokens;
 20: try {
 21:   tokens = JSON.parse(m[1]);
 22: } catch (e) {
 23:   console.error('extract-tokens: design-tokens block is not valid JSON:', e.message);
 24:   process.exit(1);
 25: }
 26: if (tokens.world.laneCount !== tokens.world.server.sm.count * 128) {
 27:   console.error(
 28:     `extract-tokens: world.laneCount (${tokens.world.laneCount}) !== world.server.sm.count * 128 (${tokens.world.server.sm.count * 128})`,
 29:   );
 30:   process.exit(1);
 31: }
 32: 
 33: // W4 build-time step: convert each scene gradient stop from its hex to
 34: // OKLab once, here, so the shader interpolates in OKLab and no runtime
 35: // code ever converts a token hex. Stop names resolve against the color
 36: // tokens; an unknown stop name fails the build.
 37: function hexToOklab(hex) {
 38:   const srgb = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
 39:   const lin = srgb.map((c) => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
 40:   const [r, g, b] = lin;
 41:   const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
 42:   const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
 43:   const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
 44:   const l3 = Math.cbrt(l);
 45:   const m3 = Math.cbrt(m);
 46:   const s3 = Math.cbrt(s);
 47:   return [
 48:     0.2104542553 * l3 + 0.7936177850 * m3 - 0.0040720468 * s3,
 49:     1.9779984951 * l3 - 2.4285922050 * m3 + 0.4505937099 * s3,
 50:     0.0259040371 * l3 + 0.7827717662 * m3 - 0.8086757660 * s3,
 51:   ];
 52: }
 53: const STOP_HEX = {
 54:   signal: tokens.color.signal,
 55:   signalDim: tokens.color.signalDim,
 56:   ink: tokens.color.ink,
 57:   field: tokens.color.field.ground,
 58:   chalk: tokens.color.chalk,
 59: };
 60: for (const [route, scene] of Object.entries(tokens.scene)) {
 61:   const grad = scene.gradient;
 62:   if (!grad) continue;
 63:   for (const key of ['leadStop', 'tailStop']) {
 64:     const hex = STOP_HEX[grad[key]];
 65:     if (!hex) {
 66:       console.error(`extract-tokens: unknown gradient stop "${grad[key]}" in scene.${route}`);
 67:       process.exit(1);
 68:     }
 69:   }
 70:   grad.leadOklab = hexToOklab(STOP_HEX[grad.leadStop]);
 71:   grad.tailOklab = hexToOklab(STOP_HEX[grad.tailStop]);
 72:   grad.signalOklab = hexToOklab(tokens.color.signal);
 73: }
 74: const version = tokens.version;
 75: 
 76: const tsHeader = `// GENERATED from spec/astryx/DESIGN.md v${version}. Do not edit.\n`;
 77: writeFileSync(
 78:   join(root, 'src/tokens.generated.ts'),
 79:   `${tsHeader}export const T = ${JSON.stringify(tokens, null, 2)} as const;\n`,
 80: );
 81: mkdirSync(join(root, 'themes/lane'), { recursive: true });
 82: writeFileSync(
 83:   join(root, 'themes/lane/tokens.generated.json'),
 84:   `${JSON.stringify(tokens, null, 2)}\n`,
 85: );
 86: 
 87: // CSS custom properties: regime colors as --jp-void-ground etc., type
 88: // display tokens, gutters, keymap heights, durations, easings.
 89: const lines = [`/* GENERATED from spec/astryx/DESIGN.md v${version}. Do not edit. */`, ':root {'];
 90: const push = (name, value) => lines.push(`  ${name}: ${value};`);
 91: for (const regime of ['void', 'paper', 'field']) {
 92:   const r = tokens.color[regime];
 93:   for (const [key, value] of Object.entries(r)) {
 94:     push(`--jp-${regime}-${key}`, value);
 95:   }
 96: }
 97: push('--jp-signal', tokens.color.signal);
 98: push('--jp-signal-dim', tokens.color.signalDim);
 99: push('--jp-signal-hot', tokens.color.signalHot);
100: push('--jp-ink', tokens.color.ink);
101: push('--jp-ink-tint', tokens.color.inkTint);
102: push('--jp-chalk', tokens.color.chalk);
103: push('--jp-chalk-2', tokens.color.chalk2);
104: push('--jp-error-dark', tokens.color.errorDark);
105: push('--jp-error-light', tokens.color.errorLight);
106: push('--jp-font-family', tokens.type.family);
107: push('--jp-text-display-0-size', tokens.type.display0.size);
108: push('--jp-text-display-0-weight', String(tokens.type.display0.weight));
109: push('--jp-text-display-0-leading', String(tokens.type.display0.leading));
110: push('--jp-text-display-0-tracking', tokens.type.display0.tracking);
111: push('--jp-text-display-1-size', tokens.type.display1.size);
112: push('--jp-text-display-1-weight', String(tokens.type.display1.weight));
113: push('--jp-text-display-1-leading', String(tokens.type.display1.leading));
114: push('--jp-text-display-1-tracking', tokens.type.display1.tracking);
115: push('--jp-text-key-size', tokens.type.key.size);
116: push('--jp-text-key-weight', String(tokens.type.key.weight));
117: push('--jp-gutter-base', `${tokens.space.gutterPx.base}px`);
118: push('--jp-gutter-640', `${tokens.space.gutterPx.from640}px`);
119: push('--jp-gutter-1280', `${tokens.space.gutterPx.from1280}px`);
120: push('--jp-keymap-h-coarse', `${tokens.space.keymapHeightPx.coarse}px`);
121: push('--jp-keymap-h-fine', `${tokens.space.keymapHeightPx.fine}px`);
122: push('--jp-readout-max-width', `${tokens.space.readoutMaxWidthPx}px`);
123: for (const [key, value] of Object.entries(tokens.motion.ms)) {
124:   push(`--jp-duration-${key}`, `${value}ms`);
125: }
126: push('--jp-ease-signature', `cubic-bezier(${tokens.motion.easeSignature.join(', ')})`);
127: push('--jp-ease-standard', tokens.motion.easePlain);
128: push('--jp-ease-gb-main', `cubic-bezier(${tokens.guestbook.easeMain.join(', ')})`);
129: push('--jp-ease-gb-soft', `cubic-bezier(${tokens.guestbook.easeSoft.join(', ')})`);
130: push('--jp-duration-gb-panel', `${tokens.guestbook.ms.panel}ms`);
131: push('--jp-gb-pill-radius', `${tokens.guestbook.pillRadiusPx}px`);
132: push('--jp-gb-panel-depth', `${tokens.guestbook.panelDepthPx}px`);
133: push('--jp-gb-perspective', `${tokens.guestbook.perspectivePx}px`);
134: push('--jp-gb-glyph-max', `${tokens.guestbook.mark.glyphPx[1]}px`);
135: push('--jp-gb-focus-rule', `${tokens.guestbook.focusRulePx}px`);
136: push('--jp-sheet-max-width', `${tokens.chrome.sheetMaxWidthPx}px`);
137: lines.push('}');
138: mkdirSync(join(root, 'src/styles'), { recursive: true });
139: writeFileSync(join(root, 'src/styles/tokens.generated.css'), `${lines.join('\n')}\n`);
140: console.log(`extract-tokens: wrote tokens from DESIGN.md v${version}`);
