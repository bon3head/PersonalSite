464:   const off = field.onFrame(onFrame);
465: 
466:   if (reduced) placeReducedStatics();
467: 
468:   return {
469:     pause(): void {
470:       if (paused || disposed) return;
471:       paused = true;
472:       // Reduced motion runs no loop to carry a fade: release now.
473:       if (reduced) {
474:         fadeStartSec = null;
475:         clearWords();
476:         f.guestbook?.render();
477:       } else if (actives.length > 0 && fadeStartSec === null) {
478:         fadeStartSec = field.now();
479:       }
480:     },
481:     resume(): void {
482:       if (disposed) return;
483:       paused = false;
484:       if (hidden) return;
485:       // A running fade finishes first (lanes never snap); the cadence
486:       // restarts once it releases the words.
487:       if (fadeStartSec !== null && !reduced) {
488:         accSec = CADENCE_SEC;
489:         return;
490:       }
491:       fadeStartSec = null;
492:       clearWords();
493:       if (reduced) {
494:         placeReducedStatics();
495:       } else {
496:         accSec = CADENCE_SEC;
497:       }
498:     },
499:     setHidden(on: boolean): void {
500:       if (hidden === on || disposed) return;
501:       hidden = on;
502:       if (on) {
503:         // Reduced motion runs no loop to carry a fade: clear and render now.
504:         if (reduced) {
505:           fadeStartSec = null;
506:           clearWords();
507:           f.guestbook?.render();
508:         } else if (actives.length > 0 && fadeStartSec === null) {
509:           fadeStartSec = field.now();
510:         }
511:         return;
512:       }
513:       if (paused) return;
514:       if (fadeStartSec !== null && !reduced) {
515:         accSec = CADENCE_SEC;
516:         return;
517:       }
518:       fadeStartSec = null;
519:       clearWords();
520:       if (reduced) placeReducedStatics();
521:       else accSec = CADENCE_SEC;
522:     },
523:     setReducedMotion(on: boolean): void {
524:       if (reduced === on || disposed) return;
525:       reduced = on;
526:       fadeStartSec = null;
527:       clearWords();
528:       if (on && !hidden && !paused) {
529:         placeReducedStatics();
530:       } else if (!paused) {
