  1: // W4 lane field tests: P-LF-1, P-LF-2, P-LF-3, P-LF-4a, and the ITEM 6
  2: // camera clamp check. The formal T-SQ-CAM-1/2/3 suite belongs to W7;
  3: // the clamp check here forces the flat pose in a harness and asserts
  4: // the rendered frame lands inside the band.
  5: //
  6: // Timing note: on SwiftShader a single frame takes 10 to 20 seconds,
  7: // so a 700ms travel jumps from start to finish in one frame. Browser
  8: // tests therefore assert endpoints and invariants, never a mid-travel
  9: // wall-clock sample; interpolation itself is covered by the Node unit
 10: // test below, which checks the exact functions the engine calls.
 11: import { test, expect } from '@playwright/test';
 12: import { readFileSync } from 'node:fs';
 13: import { join, dirname } from 'node:path';
 14: import { fileURLToPath } from 'node:url';
 15: import { ringFalloff, ringFalloffDerivative, deflectPoint } from '../../src/world/deflection';
 16: import {
 17:   paramsForLayout,
 18:   lerpParams,
 19:   ringEnvelope,
 20: } from '../../src/world/laneParams';
 21: import { T } from '../../src/tokens.generated';
 22: 
 23: test.setTimeout(300000);
 24: 
 25: const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
 26: const DEV = process.env.W4_DEV ?? 'http://localhost:5173';
 27: const HARNESS = `${DEV}/tests/world-harness.html`;
 28: 
 29: async function loadHarness(page: import('@playwright/test').Page, query = ''): Promise<void> {
 30:   await page.setViewportSize({ width: 1440, height: 900 });
 31:   await page.goto(`${HARNESS}${query}`);
 32:   const ok = await page.evaluate(() => window.__testReady);
 33:   expect(ok).toBe(true);
 34:   // Wait for two sampled loop frames, so at least one full frame has
 35:   // rendered through the new shaders before any pixel is read.
 36:   await page.waitForFunction(
 37:     () => window.__lanefield.frameStats().count >= 2,
 38:     null,
 39:     { timeout: 240000 },
 40:   );
 41: }
