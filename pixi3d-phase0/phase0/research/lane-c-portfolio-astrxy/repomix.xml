  1: // Toast host bridge (S04 section 7.3, DESIGN section 7): toasts
  2: // render in the top-most open layer. The Astryx toast viewport is a
  3: // manual popover shown at app mount, and a sheet dialog opened later
  4: // paints above it because BottomSheet never registers a modal
  5: // outlet, so the viewport is never rehosted. The outlet hook is
  6: // private to the Astryx package (not exported from its package
  7: // entry or its Layer entry), so this bridge performs the same
  8: // rehost from repo code: while a sheet is open, the viewport host
  9: // node moves inside that sheet dialog and its popover is shown
 10: // again, which puts it above the dialog in top-layer order and
 11: // inside the dialog, where it is not inert. When the sheet closes,
 12: // the host returns to its original parent. Focus is preserved
 13: // across the move when focus was inside the host.
 14: import { useEffect, useRef, type RefObject } from 'react';
 15: 
 16: interface HostRecord {
 17:   parent: Node;
 18:   next: Node | null;
 19: }
 20: 
 21: function findViewport(): HTMLElement | null {
 22:   const candidates = Array.from(
 23:     document.querySelectorAll('[popover="manual"]'),
 24:   ) as HTMLElement[];
 25:   const hosted = candidates.find((el) => {
 26:     const parent = el.parentElement;
 27:     return parent !== null && getComputedStyle(parent).display === 'contents';
 28:   });
 29:   return hosted ?? candidates[0] ?? null;
 30: }
 31: 
 32: function showViewport(viewport: HTMLElement): void {
 33:   let showing = false;
 34:   try {
 35:     showing = viewport.matches(':popover-open');
 36:   } catch {
 37:     showing = false;
 38:   }
 39:   if (showing) return;
 40:   try {
 41:     viewport.showPopover();
 42:   } catch {
 43:     // Already showing or not attached; the next move shows it again.
 44:   }
 45: }
 46: 
 47: function moveHost(
 48:   host: HTMLElement,
 49:   viewport: HTMLElement,
 50:   target: Node,
 51:   recordRef: RefObject<HostRecord | null>,
 52: ): void {
 53:   const active = document.activeElement as HTMLElement | null;
 54:   const hadFocus = active !== null && host.contains(active);
 55:   if (recordRef.current === null && host.parentNode !== null) {
 56:     recordRef.current = { parent: host.parentNode, next: host.nextSibling };
 57:   }
 58:   target.appendChild(host);
 59:   showViewport(viewport);
 60:   if (hadFocus && active !== null) {
 61:     active.focus({ preventScroll: true });
 62:   }
 63: }
 64: 
 65: function restoreHost(
 66:   host: HTMLElement,
 67:   viewport: HTMLElement,
 68:   record: HostRecord,
 69: ): void {
 70:   const active = document.activeElement as HTMLElement | null;
 71:   const hadFocus = active !== null && host.contains(active);
 72:   if (record.next !== null && record.next.parentNode === record.parent) {
 73:     record.parent.insertBefore(host, record.next);
 74:   } else {
 75:     record.parent.appendChild(host);
 76:   }
 77:   showViewport(viewport);
 78:   if (hadFocus && active !== null) {
 79:     active.focus({ preventScroll: true });
 80:   }
 81: }
 82: 
 83: export function useToastHostBridge(
 84:   isOpen: boolean,
 85:   contentRef: RefObject<HTMLElement | null>,
 86: ): void {
 87:   const recordRef = useRef<HostRecord | null>(null);
 88:   const dialogRef = useRef<HTMLDialogElement | null>(null);
 89: 
 90:   useEffect(() => {
 91:     if (!isOpen) {
 92:       const dialog = dialogRef.current;
 93:       const viewport = findViewport();
 94:       const host = viewport?.parentElement ?? null;
 95:       if (dialog === null || viewport === null || host === null) return;
 96:       const record = recordRef.current;
 97:       if (record === null) return;
 98:       if (host.parentNode !== dialog) {
 99:         recordRef.current = null;
100:         return;
101:       }
102:       if (!dialog.open || !dialog.isConnected) {
103:         restoreHost(host, viewport, record);
104:         recordRef.current = null;
105:         return;
106:       }
107:       // BottomSheet closes its dialog after its exit animation, so
108:       // restore on the close event rather than on the prop flip.
109:       const onClose = (): void => {
110:         restoreHost(host, viewport, record);
111:         recordRef.current = null;
112:       };
113:       dialog.addEventListener('close', onClose, { once: true });
114:       return () => dialog.removeEventListener('close', onClose);
115:     }
116: 
117:     const dialog = contentRef.current?.closest(
118:       'dialog',
119:     ) as HTMLDialogElement | null;
120:     if (dialog === null) return;
121:     dialogRef.current = dialog;
122:     const viewport = findViewport();
123:     const host = viewport?.parentElement ?? null;
124:     if (viewport === null || host === null) return;
125:     if (host.parentNode === dialog) {
126:       showViewport(viewport);
127:       return;
128:     }
129:     moveHost(host, viewport, dialog, recordRef);
130:     // If the dialog was not open yet when this effect ran, show the
131:     // popover again once the open attribute lands.
132:     const observer = new MutationObserver(() => {
133:       if (dialog.open) showViewport(viewport);
134:     });
135:     observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
136:     return () => observer.disconnect();
137:   }, [isOpen, contentRef]);
138: }
</file>

