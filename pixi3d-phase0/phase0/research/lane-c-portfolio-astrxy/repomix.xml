164: function snapshotFromSample(sample: MorphSample): MorphSnapshot {
165:   return {
166:     center: [...sample.ringCenter],
167:     silhouetteCenter: [...sample.silhouetteCenter],
168:     ringRadius: sample.ringRadius,
169:     ringStrength: sample.ringStrength,
170:     silhouetteRadius: sample.silhouetteRadius,
171:     silhouetteStrength: sample.silhouetteStrength,
172:   };
