  1: // T-S03-1 to T-S03-8 (S03 section 9) against the B0 stub engine.
  2: // The app under test is the Vite dev server plus a harness injected via
  3: // page.evaluate: the harness replaces #root with the S04 page structure,
  4: // wires src/router.ts + src/travel.ts against src/world/stub.ts, and
  5: // exposes window.__b3test. App.tsx is untouched (B4 owns it); the
  6: // harness is the wave-1 stand-in for the real chrome.
  7: //
  8: // Keyboard: the harness routes keys through the REAL
  9: // buildTravelHotkeyEntries from src/router.ts, using a native matcher
 10: // with useHotkeys semantics (first match wins, skip disabled, skip
 11: // inputs). The React TravelHotkeys wrapper is three lines around the
 12: // same entries; B4 mounts it in App in wave 2.
 13: import { expect, test, type Page } from '@playwright/test';
 14: 
 15: const DEV = 'http://localhost:5173';
 16: 
 17: const H1: Record<string, string> = {
 18:   server: 'Justin Poli',
 19:   leaflink: 'LeafLink',
 20:   sidequests: 'SideQuests',
 21:   notfound: 'Nothing at this address.',
 22: };
 23: const REGIME: Record<string, string> = {
 24:   server: 'void',
 25:   leaflink: 'paper',
 26:   sidequests: 'field',
 27:   notfound: 'void',
 28: };
 29: const TITLE: Record<string, string> = {
 30:   server: 'Justin Poli',
 31:   leaflink: 'LeafLink, Justin Poli',
 32:   sidequests: 'SideQuests, Justin Poli',
 33:   notfound: 'Not found, Justin Poli',
 34: };
 35: // Stub LAYOUT_ORDER: server, leaflink, sidequests, scatter.
 36: const WEIGHT_INDEX: Record<string, number> = {
 37:   server: 0,
 38:   leaflink: 1,
 39:   sidequests: 2,
 40:   notfound: 3,
 41: };
 42: 
 43: async function setupHarness(page: Page): Promise<void> {
 44:   await page.evaluate(async () => {
 45:     // Unmount the real App first: its router and hotkeys attach window
 46:     // listeners that survive a DOM replacement and would push duplicate
 47:     // history entries, breaking goBack (T-S03-3 root cause).
 48:     (window as unknown as { __unmountApp?: () => void }).__unmountApp?.();
 49: 
 50:     const routerMod = await import('/src/router.ts');
 51:     const travelMod = await import('/src/travel.ts');
 52:     const stubMod = await import('/src/world/stub.ts');
 53:     const { T } = await import('/src/tokens.generated.ts');
 54: 
 55:     // Block main.tsx's idle world start from racing us: it no-ops
 56:     // without #world, and the stub ignores its mount argument anyway.
 57:     document.getElementById('world')?.remove();
 58: 
 59:     const initialScene = routerMod.parsePath(window.location.pathname);
 60:     const initialSheet = routerMod.parseHash(window.location.hash);
 61: 
 62:     const root = document.getElementById('root');
 63:     if (!root) throw new Error('no #root');
 64:     root.innerHTML =
 65:       `<a class="jp-wordmark" href="/" data-route>Justin Poli</a>` +
 66:       `<main id="scene" aria-busy="false">` +
 67:       `<section class="jp-readout jp-readout--${initialScene}" aria-labelledby="h-${initialScene}">` +
 68:       `<h1 id="h-${initialScene}" tabindex="-1">${routerMod.SCENE_H1[initialScene]}</h1>` +
 69:       `</section></main>` +
 70:       `<nav class="jp-keymap" aria-label="Scenes and panels">` +
 71:       `<a href="/" data-route data-scene="server">Server</a>` +
 72:       `<a href="/leaflink" data-route data-scene="leaflink">LeafLink</a>` +
 73:       `<a href="/sidequests" data-route data-scene="sidequests">SideQuests</a>` +
 74:       `</nav>` +
 75:       `<div class="jp-live" aria-live="polite" aria-atomic="true"></div>`;
 76:     const style = document.createElement('style');
 77:     style.textContent =
 78:       `.jp-keymap a { color: rgb(230, 232, 234); }` +
 79:       `.jp-keymap a[aria-current="page"] { color: rgb(123, 181, 248); }` +
 80:       `.jp-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }`;
 81:     document.head.appendChild(style);
 82: 
 83:     // The stub draws nothing; it is the weights/pose source of truth.
 84:     const mount = document.createElement('div');
 85:     const lanefield = stubMod.createLanefield(mount, {
 86:       seed: T.world.seed,
 87:       reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)')
 88:         .matches,
 89:       initial: routerMod.SCENE_LAYOUT[initialScene],
 90:     });
 91:     if (!lanefield) throw new Error('stub returned null');
 92: 
 93:     const getReadout = () =>
 94:       document.querySelector<HTMLElement>('.jp-readout');
 95:     const getLive = () =>
 96:       document.querySelector<HTMLElement>('.jp-live');
 97:     const getBusy = () => document.querySelector<HTMLElement>('#scene');
 98:     const getKeymap = () =>
 99:       document.querySelector<HTMLElement>('.jp-keymap');
100:     const getKeymapItem = (scene: string) =>
101:       document.querySelector<HTMLElement>(
102:         `.jp-keymap [data-scene="${scene}"]`,
103:       );
104: 
105:     const travel = travelMod.createTravelController(initialScene, {
106:       lanefield,
107:       dom: {
108:         readout: getReadout,
109:         announce: getLive,
110:         busy: getBusy,
111:         keymap: getKeymap,
112:         keymapItem: getKeymapItem,
113:       },
114:       isReducedMotion: () =>
115:         window.matchMedia('(prefers-reduced-motion: reduce)').matches,
116:       onSwap: (scene: string) => {
117:         const section = getReadout();
118:         if (!section) return;
119:         section.className = `jp-readout jp-readout--${scene}`;
120:         section.setAttribute('aria-labelledby', `h-${scene}`);
121:         const h1 = section.querySelector('h1');
122:         if (h1) {
123:           h1.id = `h-${scene}`;
124:           h1.textContent = routerMod.SCENE_H1[scene as never];
125:         }
126:       },
127:     });
128: 
129:     let sheet: routerMod.SheetId = initialSheet;
130:     const router = routerMod.createRouter(
131:       { scene: initialScene, sheet },
132:       {
133:         onSceneChange: (scene: string) => {
134:           void travel.travelTo(scene as never);
135:         },
136:         onSheetChange: (next: routerMod.SheetId) => {
137:           sheet = next;
138:         },
139:       },
140:     );
141:     // Native matcher over the real entries, with useHotkeys semantics:
142:     // first match wins, disabled entries skipped, inputs skipped.
143:     const ARROWS: Record<string, string> = {
144:       ArrowLeft: 'left',
145:       ArrowRight: 'right',
146:     };
147:     window.addEventListener('keydown', (event) => {
148:       const target = event.target as HTMLElement | null;
149:       if (
150:         target &&
151:         (target.tagName === 'INPUT' ||
152:           target.tagName === 'TEXTAREA' ||
153:           target.tagName === 'SELECT' ||
154:           target.isContentEditable)
155:       ) {
156:         return;
157:       }
158:       const entries = routerMod.buildTravelHotkeyEntries({
159:         go: (s: string) => router.go(s as never),
160:         step: (dir: 1 | -1) => {
161:           router.go(routerMod.stepScene(router.state.scene, dir));
162:         },
163:         toggleSheet: (next: 'whoami' | 'contact') => {
164:           router.setSheet(router.state.sheet === next ? null : next);
165:         },
166:         sheet: router.state.sheet,
167:       });
168:       const keyName = ARROWS[event.key] ?? event.key.toLowerCase();
169:       for (const entry of entries) {
170:         if (entry.isDisabled) continue;
171:         if (entry.keys.toLowerCase() === keyName) {
172:           entry.onPress(event);
173:           break;
174:         }
175:       }
176:     });
177: 
178:     // Regime + title for the initial scene (no intro travel on load).
179:     travelMod.applyRegime(initialScene as never);
180:     const keymap = getKeymap();
181:     if (keymap && initialScene !== 'notfound') {
182:       getKeymapItem(initialScene)?.setAttribute('aria-current', 'page');
183:     }
184: 
185:     (window as unknown as Record<string, unknown>).__b3test = {
186:       router,
187:       travel,
188:     };
189:   });
190: }
