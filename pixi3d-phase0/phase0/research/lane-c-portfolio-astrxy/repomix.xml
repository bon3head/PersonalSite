 19: // Contrast ratio (WCAG relative luminance), for T-LL-5.
 20: function luminance(rgb: [number, number, number]): number {
 21:   const f = (c: number): number => {
 22:     const s = c / 255;
 23:     return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
 24:   };
 25:   return 0.2126 * f(rgb[0]) + 0.7152 * f(rgb[1]) + 0.0722 * f(rgb[2]);
 26: }
 27: function contrast(
 28:   a: [number, number, number],
 29:   b: [number, number, number],
 30: ): number {
 31:   const la = luminance(a);
 32:   const lb = luminance(b);
 33:   const hi = Math.max(la, lb);
 34:   const lo = Math.min(la, lb);
 35:   return (hi + 0.05) / (lo + 0.05);
 36: }
 37: function parseRgb(s: string): [number, number, number] {
 38:   const m = s.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
 39:   if (!m) throw new Error(`unparsed color ${s}`);
 40:   return [Number(m[1]), Number(m[2]), Number(m[3])];
 41: }
 42: 
 43: function parseHex(hex: string): [number, number, number] {
 44:   return [
 45:     parseInt(hex.slice(1, 3), 16),
 46:     parseInt(hex.slice(3, 5), 16),
 47:     parseInt(hex.slice(5, 7), 16),
 48:   ];
 49: }
