 839:   // --- Render attributes. ---
 840:   function updateInstances(): void {
 841:     const now = simNow();
 842:     // Viewport + radius follow the window (no resize listener needed).
 843:     const coarse = isCoarse();
 844:     const radius = coarse ? P.radiusPx.coarse : P.radiusPx.fine;
