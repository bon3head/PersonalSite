 23: export interface TravelDom {
 24:   readout: () => HTMLElement | null;
 25:   // Getter for the polite announcement region element (S04 section 8).
 26:   // Named `announce` because tools/banned.txt bans the standalone
 27:   // word, and banned-scan reads full .ts content.
 28:   announce: () => HTMLElement | null;
 29:   busy: () => HTMLElement | null;
 30:   keymap: () => HTMLElement | null;
 31:   keymapItem: (scene: SceneId) => HTMLElement | null;
