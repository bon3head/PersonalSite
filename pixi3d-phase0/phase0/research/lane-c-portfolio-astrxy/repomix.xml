  1: /**
  2:  * Astryx theme template — every `defineTheme` field, with a note on what it
  3:  * does and when to reach for it.
  4:  *
  5:  * Only `name` is required. Delete what you do not need: the values here are
  6:  * placeholders that reproduce the built-in defaults, so a field you leave
  7:  * untouched changes nothing.
  8:  *
  9:  * Each section names the CLI command that prints the authoritative reference
 10:  * for it. These comments are a map; the CLI is the territory — it reads the
 11:  * same source the components do.  `astryx docs` lists every topic.
 12:  *
 13:  * ═══════════════════════════════════════════════════════════════════════
 14:  * HOW A THEME IS CONSUMED
 15:  * ═══════════════════════════════════════════════════════════════════════
 16:  *
 17:  * 1. WRAP THE APP. A theme does nothing until it is provided.
 18:  *
 19:  *      import {Theme} from '@astryxdesign/core';
 20:  *      import {myTheme} from './theme';
 21:  *
 22:  *      <Theme theme={myTheme} mode="system">   // 'system' | 'light' | 'dark'
 23:  *        <App />
 24:  *      </Theme>
 25:  *
 26:  *    `system` follows the OS. Nest a second `<Theme>` to give one region its
 27:  *    own theme or mode — a dark sidebar inside a light page.
 28:  *
 29:  * 2. SHIP THE FONTS YOU NAME. Astryx sets the `--font-family-*` tokens; it
 30:  *    never loads a font file, so use whatever typeface the design needs and
 31:  *    load it yourself. Either add it to your app's <head>:
 32:  *
 33:  *      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 34:  *      <link rel="stylesheet"
 35:  *            href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" />
 36:  *
 37:  *    or self-host it in your global CSS:
 38:  *
 39:  *      @font-face {
 40:  *        font-family: 'Inter';
 41:  *        src: url('/fonts/Inter.woff2') format('woff2');
 42:  *        font-weight: 100 900;
 43:  *        font-display: swap;
 44:  *      }
 45:  *
 46:  *    Always give `fallbacks` as well. A named family with no file loads
 47:  *    nothing and warns about nothing — the fallback silently becomes your
 48:  *    theme.
 49:  *
 50:  * 3. BUILD IT FOR PRODUCTION.
 51:  *
 52:  *      astryx theme build src/theme.ts
 53:  *
 54:  *    writes `<name>.css` (tokens, component overrides and prose styles in
 55:  *    `@scope` rules), `<name>.js` (the theme with `__built: true` and
 56:  *    pre-resolved values), `<name>.d.ts`, and `<name>.variants.d.ts` when the
 57:  *    theme adds custom prop values. Import the module and the CSS together:
 58:  *
 59:  *      import {myThemeTheme} from './theme/my-theme';
 60:  *      import './theme/my-theme.css';
 61:  *
 62:  *    Unbuilt, `<Theme>` injects a <style> tag at hydration instead — fine for
 63:  *    dev and client-only apps, but under SSR the component overrides flash on
 64:  *    hydration. Build for Next.js and Remix. Run the build after every edit:
 65:  *    it also validates the theme and regenerates the types for custom
 66:  *    variants.
 67:  *
 68:  * 4. LOOK AT IT IN BOTH COLOUR MODES before you ship, including the states you
 69:  *    did not write. Full guide: `astryx docs theme`.
 70:  *
 71:  * SYNC: this template mirrors the theme system. When you change one of these,
 72:  * update it here — scripts/check-theme-template.test.mjs fails when they drift:
 73:  * - /packages/core/src/theme/defineTheme.ts     (the fields)
 74:  * - /packages/core/src/theme/tokens.stylex.ts   (the token families)
 75:  * - /packages/core/src/theme/expandColorScale.ts
 76:  * - /packages/core/src/theme/expandTypeScale.ts
 77:  * - /packages/core/src/theme/expandRadiusScale.ts
 78:  * - /packages/core/src/theme/expandMotionScale.ts
 79:  */
 80: 
 81: import {defineTheme} from '@astryxdesign/core/theme';
 82: // import {palette} from './palette.generated';
 83: // import {dracula} from '@astryxdesign/core/theme/syntax';
 84: // import {neutralTheme} from '@astryxdesign/theme-neutral';
 85: 
 86: export const myTheme = defineTheme({
 87:   /** Required. Becomes the `data-astryx-theme` attribute and the registry key. */
 88:   name: 'my-theme',
 89: 
 90:   /**
 91:    * Start from another theme instead of the defaults. Tokens are copied then
 92:    * overridden, `components` deep-merge, `icons` shallow-merge — but the scale
 93:    * configs below REPLACE the base's rather than merging, because they are
 94:    * inputs to a generator, not values.
 95:    *
 96:    * Reference: `astryx theme list` (themes you can install and extend).
 97:    */
 98:   // extends: neutralTheme,
 99: 
100:   // ───────────────────────────────────────────────────────────────────────
101:   // Scale configs — concise inputs for typography, radius, and motion.
102:   // The color scale remains supported for existing themes, but it is not the
103:   // recommended starting point for a new palette; see its note below.
104:   // ───────────────────────────────────────────────────────────────────────
105: 
106:   /**
107:    * Supported compatibility path for existing themes. This expands one accent
108:    * seed into the neutral ramp, surfaces, text, icons, borders, muted fills,
109:    * hover and pressed overlays — light and dark both. It is not an accent-only
110:    * edit.
111:    *
112:    * For a new complete palette, run:
113:    *
114:    *   astryx theme palette generate palette.config.json --out palette.generated.ts
115:    *
116:    * Review the generated candidate, then commit the palette module and receipt.
117:    * Uncomment the `palette` import above and reference its stops from semantic
118:    * tokens below. Regenerating an accepted palette then updates every mapped
119:    * token that keeps those references. Generation does not rewrite the theme.
120:    *
121:    *   accent        seed hex, or a [light, dark] pair to seed each scheme's
122:    *                 palette from its own colour; omit to keep the default
123:    *                 accent and re-tone only the neutrals
124:    *   neutralStyle  'warm' | 'cool' | 'neutral' — the temperature of the greys
125:    *   contrast      'standard' | 'high' — 'high' widens the text/surface tone
126:    *                 gap, for dense data UI or bright and clinical screens
127:    *
128:    * Whatever seed you pass, generated text holds >= 4.5:1 against its surface
129:    * and --color-border-emphasized >= 3:1. Two limits on that guarantee:
130:    *
131:    *   - It covers what this config generates. Write one side of a pair by hand
132:    *     in `tokens` below — an accent without its --color-on-accent, a surface
133:    *     without its text — and you own the contrast for that pair.
134:    *   - Status colours (success, warning, error) and the categorical data hues
135:    *     are not derived from the accent. They keep their defaults, which are
136:    *     tuned for the default surfaces; check them against yours.
137:    *
138:    * Either way the check is the same: resolve the pair in BOTH modes and
139:    * measure it. `useTheme()` and `resolveThemeTokens()` return the resolved
140:    * values, and the rendered DOM is the final word.
141:    *
142:    * Reference: `astryx docs color` for what each semantic role means,
143:    * `astryx docs tokens/tokens-color` for every colour token and its light/dark
144:    * default.
145:    */
146:   // color: {accent: '#0064E0', neutralStyle: 'cool', contrast: 'standard'},
147: 
148:   /**
149:    * Type scale and the three font roles.
150:    *   scale.base   body size in px; scale.ratio  step between sizes
151:    *                (1.125 tight/dense · 1.2 default · 1.333 dramatic)
152:    *   body / heading / code: {family, fallbacks, weight, weights}
153:    *   heading inherits family and fallbacks from body when omitted; `weights`
154:    *   sets per-level weight for headings 1–6.
155:    *
156:    * See §2 above — naming a family here does not load it.
157:    *
158:    * Reference: `astryx docs typography`.
159:    */
160:   typography: {
161:     scale: {base: 16, ratio: 1.2},
162:     body: {family: 'Inter', fallbacks: '-apple-system, system-ui, sans-serif'},
163:     heading: {weight: 'semibold', weights: {1: 'bold', 2: 'bold'}},
164:     code: {
165:       family: 'Geist Mono',
166:       fallbacks: '"SF Mono", ui-monospace, monospace',
167:     },
168:   },
169: 
170:   /**
171:    * Radius scale. `base` is the unit in px; `multiplier` scales every step
172:    * (0 = square and brutalist, 2 = very soft). --radius-none and --radius-full
173:    * are fixed and never scaled.
174:    *
175:    * Reference: `astryx docs shape`.
176:    */
177:   radius: {base: 4, multiplier: 1},
178: 
179:   /**
180:    * Duration scale in ms. Each of fast/medium/slow also gets a -min and -max
181:    * sibling computed with `ratio` (min = base × ratio, max = base ÷ ratio), so
182:    * a component can pick a longer or shorter variant of the same tempo.
183:    *   Snappy {fast: 100, medium: 250} · Default {fast: 175, medium: 410, slow: 975}
184:    *   Cinematic {fast: 200, medium: 500, slow: 1200}
185:    * `easing` overrides --ease-standard.
186:    *
187:    * Reference: `astryx docs motion`.
188:    */
189:   motion: {fast: 175, medium: 410, slow: 975, ratio: 0.75},
190: 
191:   // ───────────────────────────────────────────────────────────────────────
192:   // tokens — explicit overrides, which beat anything the scales generated.
193:   // A string applies to both colour modes; a [light, dark] tuple compiles to
194:   // CSS light-dark(). List only what you want to change.
195:   //
196:   // `astryx docs tokens/tokens-color` PRINTS THE WHOLE TABLE — every colour token
197:   // with its light and dark default (`astryx docs tokens` lists every category). Read it before hand-writing colours: most of what you
198:   // want already has a semantic name, and the defaults tell you what you are
199:   // moving away from.
200:   //
201:   // The families, so you know what exists:
202:   //   --color-*        accent, on-accent · background-{body,surface,card,popover,
203:   //                    muted,inverted} · text-* · icon-* · border,
204:   //                    border-emphasized · overlay{,-hover,-pressed} ·
205:   //                    success/warning/error (+ -muted, on-*) · skeleton, track,
206:   //                    shadow, tint-hover · categorical {blue,cyan,gray,green,
207:   //                    orange,pink,purple,red,teal,yellow} ×
208:   //                    {background,border,icon,text}
209:   //   --spacing-*      0 · 0-5 · 1 … 12
210:   //   --size-element-* sm · md · lg (control heights)
211:   //   --focus-outline-* width · style · color · offset
212:   //   --border-width   hairline thickness shared by bordered surfaces
213:   //   --radius-*       none · inner · element · container · page · chat · full
214:   //   --shadow-*       low/med/high + inset-{hover,selected,success,warning,error}
215:   //   --duration-*     {fast,medium,slow} × {-min, base, -max}
216:   //   --ease-standard
217:   //   --font-family-*  body · heading · code
218:   //   --font-size-*    4xs … 5xl
219:   //   --font-weight-*  normal · medium · semibold · bold
220:   //   --text-*         {heading-1…6, body, large, label, code, supporting,
221:   //                    display-1…3} × {-size, -weight, -leading}
222:   //   --color-syntax-* code highlighting · --color-data-* charts
223:   // ───────────────────────────────────────────────────────────────────────
224:   tokens: {
225:     // Keep generated roles connected to the accepted palette. Uncomment the
226:     // import above, then map each reviewed semantic role this way.
227:     // '--color-background-surface': [
228:     //   palette.neutral.light[100],
229:     //   palette.neutral.dark[15],
230:     // ],
231:     '--color-accent': ['#0064E0', '#2694FE'],
232:     // Changing an accent means owning its on-colour: this is the label that
233:     // sits on top of the fill above, in each mode.
234:     '--color-on-accent': ['#FFFFFF', '#FFFFFF'],
235:     '--color-background-body': ['#F1F4F7', '#111112'],
236:     '--focus-outline-color': 'var(--color-accent)',
237:     '--shadow-low': '0 1px 2px light-dark(#0000001A, #00000066)',
238:   },
239: 
240:   /** Optional theme-family-local roles accept any valid CSS custom-property name;
241:    *  prefixes do not establish ownership. */
242:   // localTokens: {},
243: 
244:   // ───────────────────────────────────────────────────────────────────────
245:   // components — per-component CSS, emitted inside
246:   // `@scope ([data-astryx-theme="my-theme"])`, so it only touches your theme.
247:   //
248:   // Keys are the component's stable class minus the `astryx-` prefix
249:   // (`astryx-button` → `button`, `astryx-side-nav-item` → `side-nav-item`),
250:   // including inner parts like `progress-bar-fill`.
251:   //
252:   // `astryx component <Name>` IS THE REFERENCE HERE. It prints that
253:   // component's theming targets, the visual props and states you can key on,
254:   // its public CSS variables with defaults, and which standard CSS properties
255:   // it expands. `astryx component --list` names every component, and
256:   // `astryx docs styling` covers the escape hatches outside a theme.
257:   //
258:   // Style-key forms:
259:   //   'base'                    every instance
260:   //   'variant:ghost'           one prop value (any visual prop, not just variant)
261:   //   'variant:ghost+size:sm'   intersection of two
262:   //   'checked'                 a state the component reflects
263:   //   ':hover' / ':focus-visible' / ':disabled' — nested inside any of the above
264:   //
265:   // Write ordinary CSS properties: `borderRadius` and `padding` expand into
266:   // the component's internal vars for you, concentric radius math included.
267:   // Set a public CSS var directly when no standard property reaches it — take
268:   // the name from `astryx component <Name>`, since a var no component defines
269:   // compiles to CSS that never applies. Never set a private `--_`-prefixed
270:   // var; the build rejects it.
271:   // ───────────────────────────────────────────────────────────────────────
272:   components: {
273:     button: {
274:       base: {
275:         borderRadius: 'var(--radius-full)',
276:         fontWeight: 'var(--font-weight-semibold)',
277:         // A public var from `astryx component Button` — no CSS-property
278:         // equivalent exists for it.
279:         '--button-focus-offset': '2px',
280:         // Interaction states live inside the same block.
281:         ':hover': {transform: 'translateY(-1px)'},
282:         ':active': {transform: 'translateY(0)'},
283:       },
284:       'variant:ghost': {borderWidth: '1px', borderStyle: 'solid'},
285:       'variant:destructive+size:sm': {letterSpacing: '0.02em'},
286:       // A value that is not built in becomes a NEW variant: `astryx theme
287:       // build` writes the module augmentation, so <Button variant="quiet" />
288:       // typechecks wherever this theme is active. Add one only where the
289:       // product will render it — an unused variant is invisible work.
290:       'variant:quiet': {
291:         backgroundColor: 'var(--color-background-muted)',
292:         color: 'var(--color-text-secondary)',
293:       },
294:     },
295:     // Container components take `padding` too; it expands to their layout tokens.
296:     card: {
297:       base: {
298:         borderRadius: 'var(--radius-container)',
299:         padding: 'var(--spacing-6)',
300:       },
301:     },
302:     // The same mechanism adds custom Text types: <Text type="hero" />.
303:     text: {'type:hero': {fontSize: 'var(--font-size-4xl)', lineHeight: '1.05'}},
304:   },
305: 
306:   // ───────────────────────────────────────────────────────────────────────
307:   // Everything below takes React values, so it needs a .tsx file or an
308:   // imported module. Commented out for that reason.
309:   // ───────────────────────────────────────────────────────────────────────
310: 
311:   /**
312:    * Swap the artwork behind semantic icon names — every component that asks
313:    * for `check`, `close`, `chevron-down` gets yours.
314:    * Reference: `astryx docs icons` lists the names.
315:    */
316:   // icons: {check: <MyCheck />, close: <MyClose />},
317: 
318:   /**
319:    * Replace the small components that DRAW control state — the checkbox box,
320:    * the radio dot, the mark on a chosen option — by indicator name rather than
321:    * per call site. Replacing `check` re-skins every single-selection mark in
322:    * the app at once.
323:    * Reference: `astryx component Indicator`.
324:    */
325:   // indicators: {check: RadioIndicator},
326: 
327:   /**
328:    * Code highlighting: sets the --color-syntax-* tokens. Presets live in
329:    * `@astryxdesign/core/theme/syntax`.
330:    */
331:   // syntax: dracula,
332: 
333:   /**
334:    * Content sitting on an inverted surface — a dark toast in light mode, a
335:    * light popover in dark mode. Same shape as the theme itself (tokens and
336:    * components). Sensible values are generated if you say nothing, so override
337:    * only where your palette needs it.
338:    * Reference: `astryx component MediaTheme`, which reads these.
339:    */
340:   // onDark: {tokens: {'--color-accent': '#90CAF9'}, components: {button: {'variant:ghost': {borderWidth: '1px'}}}},
341:   // onLight: {tokens: {'--color-accent': '#0B5FCC'}},
342: 
343:   // ───────────────────────────────────────────────────────────────────────
344:   // Theme adaptations
345:   // ───────────────────────────────────────────────────────────────────────
346: 
347:   /**
348:    * Opt-in values for reviewed environmental conditions. Width points use the
349:    * fixed names `sm`, `md`, `lg`, `xl`, and `2xl`; overriding the map alone
350:    * emits no CSS. Fields inside `when` are ANDed, and matching rules cascade in
351:    * authored order so later writes win.
352:    *
353:    * `from` includes its point; `below` excludes it. The other supported axes
354:    * are primary-pointer precision, contrast preference, and motion preference.
355:    * Component writes in a rule are validated exactly like root `components`.
356:    * The one addition: a custom value that is valid only because a theme
357:    * enrolls it must be declared at the root first, since generated type
358:    * augmentation is unconditional; a rule may then restyle it.
359:    */
360:   // Adaptations are opt-in. Uncomment and edit the example below when the
361:   // theme needs environmental values.
362:   // adaptations: {
363:   //   widthBreakpoints: {
364:   //     sm: 640,
365:   //     md: 768,
