 498:   function updateTravel(t: number): void {
 499:     if (!travel) return;
 500:     const p = Math.min(1, (t - travel.start) / travel.dur);
 501:     const e = easeSignature(p);
 502:     const ge = easePlain(p);
 503:     for (let i = 0; i < LAYOUT_ORDER.length; i++) {
 504:       weights[i] = travelFromW[i] + (travelToW[i] - travelFromW[i]) * e;
 505:       groundWeights[i] = travelFromW[i] + (travelToW[i] - travelFromW[i]) * ge;
 506:     }
 507:     lerpPoseInto(travelFromPose, travelToPose, e, basePose);
 508:     // W4 params interpolate with the signature curve, same as weights.
 509:     // The ring and silhouette fields are not lerped: applyRing owns
 510:     // them after the final camera write (polish round).
 511:     paramsCurrent = lerpParams(paramsFrom, paramsTo, e);
 512:     // Light mode crossfades instead of switching at the midpoint.
 513:     lightModeFrom = lightModeIndex(paramsFrom.lightMode);
 514:     lightMix = e;
 515:     // Camera bow: a lateral arc on the camera's own curve, zero at
 516:     // both ends (seeded, keyed by the destination layout).
 517:     bow.now = bow.amount * Math.sin(Math.PI * e);
 518:     if (morphTravelDone(travel.startMs, t * SEC_TO_MS, T.motion.ms.travel)) {
 519:       finishTravel();
 520:     }
 521:   }
