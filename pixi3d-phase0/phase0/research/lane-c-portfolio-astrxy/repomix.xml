  1: // T-S04-1 to T-S04-7 (S04 section 11) plus axe on all routes, against
  2: // the real App on the Vite dev server (no harness). The world starts
  3: // on idle behind the chrome; no test waits for it.
  4: //
  5: // Note on T-S04-1 at 320/360px: the literal criteria (keymap height
  6: // equals token height, all five items share one top) hold at every
  7: // width, but the row overflows the viewport at 320px and 360px (see
  8: // qa/chrome/S04-RECEIPTS.md for the measured widths and the math).
  9: // Five labels at the 13px floor already total ~301px before gaps and
 10: // gutters, so no spec-compliant sizing fits 320px. That overflow is
 11: // recorded as an open spec question for the coordinator, not hidden
 12: // by the test: T-S04-1 asserts the written criteria, and the
 13: // containment measurement is reported alongside.
 14: import { expect, test, type Page } from '@playwright/test';
 15: import AxeBuilder from '@axe-core/playwright';
 16: 
 17: const DEV = 'http://localhost:5173';
 18: 
 19: const ROUTES = ['/', '/leaflink', '/sidequests', '/nope'];
 20: 
 21: // All chrome tests run with ?world=0: the real engine on SwiftShader
 22: // renders multi-second frames (B2 measured 6.6s p50), which starves
 23: // Playwright's locator polling so clicks never resolve. ?world=0 is
 24: // the supported S02 no-world path (createLanefield returns null);
 25: // chrome behavior is identical without the world, and no T-S04 test
 26: // depends on lane morphing.
 27: async function gotoRoute(page: Page, route: string): Promise<void> {
 28:   await page.goto(DEV + route + '?world=0', {
 29:     waitUntil: 'domcontentloaded',
