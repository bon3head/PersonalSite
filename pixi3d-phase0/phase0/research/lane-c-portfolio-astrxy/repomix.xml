325:     ctx.drawImage(bmp, 0, 0);
326:     const data = ctx.getImageData(0, 0, bmp.width, bmp.height).data;
327:     // sRGB -> linear -> OKLab, chroma = sqrt(a^2 + b^2).
328:     const toLin = (c: number): number => {
329:       const s = c / 255;
