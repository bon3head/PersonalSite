425:   function onFrame(_tSec: number, dtSec: number): void {
426:     if (disposed) return;
427:     const now = field.now();
428:     if (fadeStartSec !== null) {
429:       const k = (now - fadeStartSec) / FAST_SEC;
430:       if (k >= 1) {
431:         clearWords();
432:         fadeStartSec = null;
433:       } else {
434:         cameraAxes();
435:         for (const w of actives) poseWord(w, w.t, 1 - k);
436:         writeLanes();
437:       }
438:       return;
439:     }
440:     if (reduced) return;
441:     if (!paused && !hidden) {
442:       accSec += dtSec;
443:       if (accSec >= CADENCE_SEC) {
444:         accSec -= CADENCE_SEC;
445:         spawnWord();
446:       }
447:     }
448:     if (actives.length === 0) return;
449:     cameraAxes();
450:     for (let i = actives.length - 1; i >= 0; i--) {
451:       const w = actives[i];
452:       const t = (now - w.startSec) / DURATION_SEC;
453:       if (t >= 1) {
454:         for (const g of w.glyphs) g.mesh.visible = false;
455:         lanes?.words.setTint(w.slot, tmpRgb, 0);
456:         actives.splice(i, 1);
457:         continue;
458:       }
459:       poseWord(w, t, 1);
460:     }
461:     writeLanes();
462:   }
