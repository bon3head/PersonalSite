 1: // Readout (S04 section 6): one component, three variants, plus the
 2: // 404 which reuses the server variant placement. Content comes from
 3: // S09 by ID; the variant decides placement and container. The section
 4: // element itself is what travel manipulates (hidden, opacity,
 5: // transform), so it keeps a stable DOM identity across scene swaps:
 6: // App renders one Readout and changes its scene prop, never unmounts
 7: // it mid-travel.
 8: //
 9: // Variant geometry values that exist only as TS tokens (no CSS var)
10: // are passed as --jp-ro-* custom properties via inline style; the
11: // stylesheet in chrome.css consumes them.
12: import type { CSSProperties, JSX, RefObject } from 'react';
13: import { Link } from '@astryxdesign/core/Link';
14: import { C } from '../copy';
15: import { T } from '../tokens.generated';
16: import type { SceneId } from '../router';
17: import LeaflinkReadout from '../scenes/leaflink';
18: import { useTitleFit } from './titleFit';
19: 
20: export type ReadoutVariant = 'server' | 'leaflink' | 'sidequests' | 'notfound';
21: 
22: const VARIANT: Record<SceneId, ReadoutVariant> = {
23:   server: 'server',
24:   leaflink: 'leaflink',
25:   sidequests: 'sidequests',
26:   notfound: 'notfound',
27: };
28: 
29: const H1_ID: Record<SceneId, string> = {
30:   server: 'h-server',
31:   leaflink: 'h-leaflink',
32:   sidequests: 'h-sidequests',
33:   notfound: 'h-notfound',
34: };
35: 
36: export interface ReadoutProps {
37:   scene: SceneId;
38:   sectionRef: RefObject<HTMLElement | null>;
39: }
40: 
41: export default function Readout(props: ReadoutProps): JSX.Element {
42:   const { scene } = props;
43:   const variant = VARIANT[scene];
44:   useTitleFit(props.sectionRef, scene);
45:   const style = {
46:     '--jp-name-pad': `${T.zone.name.padPx}px`,
47:     '--jp-ro-width':
48:       variant === 'server' || variant === 'notfound'
49:         ? T.chrome.serverReadoutWidth
50:         : variant === 'leaflink'
51:           ? `${T.chrome.legendWidthPx}px`
52:           : `${T.chrome.trailheadWidthPx}px`,
53:     '--jp-ro-bottom-gap': T.chrome.serverReadoutBottomGap,
54:     '--jp-ro-top-extra':
55:       variant === 'sidequests'
56:         ? `${T.chrome.trailheadTopExtraPx}px`
57:         : `${T.chrome.readoutTopExtraPx}px`,
58:     '--jp-ro-max-height': T.chrome.coarseReadoutMaxHeight,
59:   } as CSSProperties;
60: 
61:   return (
62:     <section
63:       ref={props.sectionRef}
64:       className={`jp-readout jp-readout--${variant}`}
65:       aria-labelledby={H1_ID[scene]}
66:       style={style}
67:     >
68:       {scene === 'server' && (
69:         <>
70:           <h1 id={H1_ID.server}>{C['C-SRV-H1']}</h1>
71:           <p>{C['C-SRV-P1']}</p>
72:           <p>{C['C-SRV-P2']}</p>
73:         </>
74:       )}
75:       {scene === 'leaflink' && (
76:         <LeaflinkReadout />
77:       )}
78:       {scene === 'sidequests' && (
79:         <div className="jp-readout-slip">
80:           <h1 id={H1_ID.sidequests}>{C['C-SQ-H1']}</h1>
81:           <p>{C['C-SQ-P1']}</p>
82:           <p className="jp-readout-supporting">{C['C-SQ-FACTS']}</p>
83:           <p className="jp-readout-supporting">{C['C-SQ-VENUE']}</p>
84:           <div className="jp-readout-links">
85:             <Link href={C['C-SQ-CODE'].href} isExternalLink>
86:               {C['C-SQ-CODE'].label}
87:             </Link>
88:           </div>
89:         </div>
90:       )}
91:       {scene === 'notfound' && (
92:         <>
93:           <h1 id={H1_ID.notfound}>{C['C-404-H1']}</h1>
94:           <p>{C['C-404-P1']}</p>
95:         </>
96:       )}
97:     </section>
98:   );
99: }
