 1: // P-LF-4b silhouette pull: pure geometry, shared by the vertex shader
 2: // (GLSL mirror in lane.vert.glsl) and the unit test. The logo alpha
 3: // mask is sampled in the shader; this module holds only the math that
 4: // does not need the texture: which mask a route uses, how a world
 5: // point maps to mask UV, how the ring envelope scales the pull, and
 6: // how one point moves along the alpha gradient.
 7: //
 8: // Pull rule: a lane point moves along the alpha gradient, which points
 9: // toward increasing alpha, that is, into the mark. The move size is
10: // strength times (1 - alpha), so a point already deep inside the mark
11: // (alpha 1) does not move, and a point just outside the contour
12: // (alpha near 0) moves the full strength toward the contour. The
13: // gradient is zero away from the contour, so only lanes near the
14: // contour move at all. There are no per-lane start delays: every lane
15: // reads the same silhouette uniforms at the same frame.
16: //
17: // Mask UV mapping: the ring disc maps to the mask square. u grows with
18: // world x, v grows with world z, and the texture is uploaded with
19: // flipY false, so the mapping is one line W6 can flip if the mounted
20: // hero shows the bunching mirrored. Center and radius track the ring
21: // until W6 registers hero descriptors, at which point a descriptor
22: // override through setParams replaces them without a shader change.
23: import type { LayoutId, SilhouetteMaskKind } from './types';
24: 
25: // Edge of the small mask texture, in texels. The engine downsamples
26: // the logo image to this square (letterboxed, aspect preserved) so one
27: // texel spans a visible band around the contour instead of a single
28: // source pixel.
29: export const SILHOUETTE_MASK_SIZE = 128; // lit-ok: small mask texture edge in texels
30: 
31: export function maskKindForLayout(layout: LayoutId): SilhouetteMaskKind {
32:   if (layout === 'sidequests') return 'sidequests';
33:   if (layout === 'leaflink') return 'leaflink';
34:   return 'none';
35: }
36: 
37: export function maskUv(
38:   x: number,
39:   z: number,
40:   centerX: number,
41:   centerZ: number,
42:   radius: number,
43: ): [number, number] {
44:   return [(x - centerX) / (2 * radius) + 0.5, (z - centerZ) / (2 * radius) + 0.5];
45: }
46: 
47: // Ring-envelope scaling for the pull, mirroring the ring in
48: // updateTravel: zero before Gather, full at the Gather peak, zero
49: // again once Reveal completes. pull is the token
50: // morph.silhouettePull, in world units of peak displacement.
51: export function silhouetteEnvelopeStrength(gather: number, reveal: number, pull: number): number {
52:   return pull * gather * (1 - reveal);
53: }
54: 
55: export function silhouettePullPoint(
56:   x: number,
57:   z: number,
58:   alpha: number,
59:   gradX: number,
60:   gradZ: number,
61:   strength: number,
62: ): [number, number] {
63:   if (strength === 0) return [x, z];
64:   const g = Math.sqrt(gradX * gradX + gradZ * gradZ);
65:   if (g < 1e-9) return [x, z]; // lit-ok: zero-gradient threshold
66:   const a = Math.max(0, Math.min(1, alpha));
67:   const mag = strength * (1 - a);
68:   if (mag === 0) return [x, z];
69:   return [x + (gradX / g) * mag, z + (gradZ / g) * mag];
70: }
</file>

