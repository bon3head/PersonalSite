365:           const v = m[1].split(',').map(Number);
366:           return {
367:             scale: Math.sqrt(v[0] * v[0] + v[1] * v[1]),
368:             dx: v[4],
369:             dy: v[5],
370:           };
371:         });
372:         if (route === '/leaflink') {
373:           expect(motion.scale).toBeLessThanOrEqual(T.hero.beatScale + 0.001);
374:         } else {
375:           expect(Math.hypot(motion.dx, motion.dy)).toBeLessThanOrEqual(10.5);
376:         }
377:         await page.waitForTimeout(gapMs);
