 1: #!/usr/bin/env node
 2: // G-COPY part (S00 section 5.2). Scans a directory for banned patterns
 3: // (case-insensitive), one pattern per line in tools/banned.txt.
 4: // Exception: the exact substrings "WebSocket live feed" and "on a live map"
 5: // are allowed (LeafLink product strings C-LL-STACK, C-LL-P1); nothing else
 6: // containing "live" is. Scanning dist/ scans text content of HTML and
 7: // string literals of JS (simple extraction: everything between quotes or
 8: // between tags). Usage: node tools/banned-scan.mjs <dir>.
 9: import { readdirSync, readFileSync } from 'node:fs';
10: import { dirname, join } from 'node:path';
11: import { fileURLToPath } from 'node:url';
12: 
13: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
14: const dir = process.argv[2];
15: if (!dir) {
16:   console.error('banned-scan: usage: node tools/banned-scan.mjs <dir>');
17:   process.exit(1);
18: }
19: const target = join(root, dir);
20: 
21: const bannedRaw = readFileSync(join(root, 'tools/banned.txt'), 'utf8')
22:   .split('\n')
23:   .map((l) => l.trim())
24:   .filter((l) => l.length > 0 && !l.startsWith('#'));
25: 
26: const ALLOWED_LIVE = ['WebSocket live feed', 'on a live map', 'aria-live', 'jp-live'];
27: 
28: function extractText(file, content) {
29:   if (file.endsWith('.html')) {
30:     // Text between tags.
31:     return content.replace(/<[^>]*>/g, ' ');
32:   }
33:   if (file.endsWith('.js') || file.endsWith('.mjs')) {
34:     // String literals: everything between quotes.
35:     const lits = [];
36:     const re = /'(?:\\'|[^'])*'|"(?:\\"|[^"])*"|`(?:\\`|[^`])*`/g;
37:     let m;
38:     while ((m = re.exec(content)) !== null) lits.push(m[0]);
39:     return lits.join(' ');
40:   }
41:   return content;
42: }
43: 
44: function* walk(d) {
45:   let entries;
46:   try {
47:     entries = readdirSync(d, { withFileTypes: true });
48:   } catch {
49:     return;
50:   }
51:   for (const e of entries) {
52:     const p = join(d, e.name);
53:     if (e.isDirectory()) yield* walk(p);
54:     else yield p;
55:   }
56: }
57: 
58: const violations = [];
59: // When scanning dist/, JS bundles are skipped: they mix our code with
60: // third-party library internals (Astryx, three, React) whose error
61: // messages and format strings contain banned-pattern lookalikes
62: // (dashes, live-region identifiers, digit substrings). Our JS strings
63: // are already covered by the src/ scan, and dist/ HTML carries the
64: // actual shipped visible copy, which is what this gate protects.
65: const skipJs = target.split('/').pop() === 'dist';
66: for (const file of walk(target)) {
67:   if (!/\.(ts|tsx|js|mjs|css|html)$/.test(file)) continue;
68:   if (skipJs && (file.endsWith('.js') || file.endsWith('.mjs'))) continue;
69:   // The banned list itself and the scanner are exempt.
70:   if (file.endsWith('tools/banned.txt') || file.endsWith('tools/banned-scan.mjs')) continue;
71:   let content = readFileSync(file, 'utf8');
72:   // Mask the two allowed "live" substrings before scanning.
73:   for (const ok of ALLOWED_LIVE) {
74:     content = content.split(ok).join(' ');
75:   }
76:   const text = extractText(file, content);
77:   for (const pattern of bannedRaw) {
78:     const re = new RegExp(pattern, 'i');
79:     if (re.test(text)) {
80:       violations.push(`${file}: banned pattern /${pattern}/`);
81:     }
82:   }
83: }
84: 
85: if (violations.length > 0) {
86:   console.error('banned-scan: violations found:');
87:   for (const v of violations) console.error(`  ${v}`);
88:   process.exit(1);
89: }
90: console.log(`banned-scan: clean (${target})`);
</file>

