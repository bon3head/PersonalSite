<file path="src/scenes/sidequests.tsx">
 1: // SideQuests marker controls (S07 section 3.3, polish round).
 2: //
 3: // Fine pointers: three Astryx ghost icon-only buttons positioned over
 4: // each marker's projected head every frame (transform only), 44 by 44
 5: // CSS px, transparent; the visual is the 3D marker, the button is the
 6: // target and the focus ring. aria-pressed reflects claimed.
 7: //
 8: // Coarse (phones): device run 3 cut the trailhead row, so the Twins
 9: // are the accessible set on coarse too (device-run-2 measured all
10: // three marker heads under the readout or off-screen at 390x658;
11: // the camera pan on walk brings the walked marker into view).
12: // One accessible set per variant, never two.
13: import { useEffect, useRef, useState, type CSSProperties, type JSX } from 'react';
14: import { Button } from '@astryxdesign/core/Button';
15: import { C } from '../copy';
16: import { T } from '../tokens.generated';
17: import type { Lanefield } from '../world/types';
18: import type { SideQuestsController } from '../world/sidequests';
19: 
20: export const MARKER_LABELS = C['C-SQ-MARKER'].split(',').map((s) =>
21:   s.replace(/`/g, '').trim(),
22: );
23: 
24: // Claimed state per trail, following controller state changes.
25: export function useTrailClaims(controller: SideQuestsController | null): boolean[] {
26:   const [claimed, setClaimed] = useState<boolean[]>(() =>
27:     MARKER_LABELS.map((_, i) => (controller ? controller.claimed(i) : false)),
28:   );
29:   useEffect(() => {
30:     if (!controller) return;
31:     setClaimed(MARKER_LABELS.map((_, i) => controller.claimed(i)));
32:     return controller.onStateChange(() => {
33:       setClaimed(MARKER_LABELS.map((_, i) => controller.claimed(i)));
34:     });
35:   }, [controller]);
36:   return claimed;
37: }
38: 
39: export default function SideQuestsTwins(props: {
40:   controller: SideQuestsController;
41:   lanefield: Lanefield;
42: }): JSX.Element {
43:   const { controller, lanefield } = props;
44:   const claimed = useTrailClaims(controller);
45:   const btnRefs = useRef<Array<HTMLButtonElement | null>>([]);
46:   const size = T.world.sidequests.marker.hitRadiusPx * 2;
47: 
48:   useEffect(() => {
49:     const offFrame = lanefield.onFrame(() => {
50:       for (let i = 0; i < MARKER_LABELS.length; i++) {
51:         const el = btnRefs.current[i];
52:         if (!el) continue;
53:         const [x, y] = controller.headScreen(i);
54:         el.style.transform = `translate(${x - size / 2}px, ${y - size / 2}px)`;
55:       }
56:     });
57:     return offFrame;
58:     // eslint-disable-next-line react-hooks/exhaustive-deps
59:   }, []);
60: 
61:   // transition none (polish round): the Astryx Button transitions
62:   // transform over the fast duration for press feedback. The twin is
63:   // moved by transform every frame, so that transition made every hit
64:   // target trail its marker by 150ms (measured: transitionProperty
65:   // includes transform, duration 0.15s), and a tap on a moving marker
66:   // could land beside its button. Position must track the frame.
67:   const style: CSSProperties = {
68:     position: 'fixed',
69:     left: 0,
70:     top: 0,
71:     width: size,
72:     height: size,
73:     background: 'transparent',
74:     transition: 'none',
75:   };
76: 
77:   return (
78:     <>
79:       {MARKER_LABELS.map((label, i) => (
80:         <Button
81:           key={label}
82:           ref={(el: HTMLButtonElement | null) => {
83:             btnRefs.current[i] = el;
84:           }}
85:           variant="ghost"
86:           isIconOnly
87:           label={label}
88:           data-twin={i}
89:           aria-pressed={claimed[i]}
90:           onClick={() => controller.walk(i)}
91:           onMouseEnter={() => controller.setHover(i)}
92:           onMouseLeave={() => controller.setHover(null)}
93:           style={style}
94:         />
95:       ))}
96:     </>
97:   );
98: }
