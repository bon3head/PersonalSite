 51: test('T-LL-1: exactly 6144 lanes, connected graph', async ({ page }) => {
 52:   await blockHmr(page);
 53:   await page.goto(`${DEV}/?world=0`);
 54:   const res = await page.evaluate(async () => {
 55:     const layout = await import('/src/world/layouts/leaflink.ts');
 56:     const { T } = await import('/src/tokens.generated.ts');
 57:     const out = new Float32Array(
 58:       T.world.laneCount * T.world.pointsPerLane * T.world.layouts.length * 4,
 59:     );
 60:     const side = layout.generate(T.world.seed, out, 1);
 61:     // Lane total from edge lane counts.
 62:     let total = 0;
 63:     for (const e of side.edges) total += e.laneCount;
 64:     // Connectivity via union-find over edges.
 65:     const n = side.nodes.length / 2;
 66:     const parent = new Int32Array(n);
 67:     for (let i = 0; i < n; i++) parent[i] = i;
 68:     const find = (v: number): number => {
 69:       let r = v;
 70:       while (parent[r] !== r) r = parent[r];
 71:       while (parent[v] !== r) {
 72:         const nx = parent[v];
 73:         parent[v] = r;
 74:         v = nx;
 75:       }
 76:       return r;
 77:     };
 78:     for (const e of side.edges) {
 79:       const ra = find(e.a);
 80:       const rb = find(e.b);
 81:       if (ra !== rb) parent[ra] = rb;
 82:     }
 83:     const root = find(0);
 84:     let connected = 0;
 85:     for (let v = 0; v < n; v++) if (find(v) === root) connected++;
 86:     return { total, nodes: n, connected, edges: side.edges.length };
 87:   });
 88:   expect(res.total).toBe(6144);
 89:   expect(res.connected).toBe(res.nodes);
 90:   expect(res.nodes).toBe(1089);
 91: });
