<file path="src/chrome/glitterbox.ts">
 1: // GLITTERBOX (polish item 6, DESIGN section 6.13): press and hold
 2: // anywhere on the lane field (or hold the g key) and the 6,144 lanes
 3: // come apart into glitter around the touch, swirling with a seeded
 4: // direction; let go and they re-form the scene. No tab, no page, no
 5: // copy, no new asset: it is a mode of the one material the site is
 6: // made of, available on every scene, and it never changes the route.
 7: //
 8: // Input rules, chosen so nothing existing changes meaning:
 9: // - Hold threshold is glitter.holdMs (equal to the LeafLink tap
10: //   limit), so a LeafLink tap (under that time) still drops an offer
11: //   and a hold never does.
12: // - Moving more than the tap move limit before the hold elapses
13: //   cancels it (that gesture is not a hold).
14: // - Once active, moving stirs: the ring follows the pointer.
15: // - Disabled under reduced motion, while a sheet is open, and during
16: //   travel (the engine refuses then as well).
17: // - The g key is ignored with modifiers, on repeat, and when focus is
18: //   in an editable field.
19: import { useEffect } from 'react';
20: import { T } from '../tokens.generated';
21: import type { Lanefield } from '../world/types';
22: import { prefersReducedMotion } from '../lib/reducedMotion';
23: 
24: export function useGlitterbox(field: Lanefield | null, blocked: boolean): void {
25:   useEffect(() => {
26:     if (!field || blocked) return;
27:     const mount = document.getElementById('world');
28:     let timer: ReturnType<typeof setTimeout> | null = null;
29:     let active = false;
30:     let start: [number, number] | null = null;
31:     let keyHeld = false;
32:     const stop = (): void => {
33:       if (timer !== null) clearTimeout(timer);
34:       timer = null;
35:       start = null;
36:       if (active) field.setGlitter(false);
37:       active = false;
38:     };
39:     const onDown = (e: PointerEvent): void => {
40:       if (prefersReducedMotion()) return;
41:       start = [e.clientX, e.clientY];
42:       timer = setTimeout(() => {
43:         timer = null;
44:         if (!start) return;
45:         active = true;
46:         field.setGlitter(true, start);
47:       }, T.glitter.holdMs);
48:     };
49:     const onMove = (e: PointerEvent): void => {
50:       if (active) {
51:         field.setGlitter(true, [e.clientX, e.clientY]);
52:       } else if (start && Math.hypot(e.clientX - start[0], e.clientY - start[1]) >= T.world.leaflink.tapMaxMovePx) {
53:         stop();
54:       }
55:     };
56:     const editable = (el: Element | null): boolean =>
57:       !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || (el as HTMLElement).isContentEditable);
58:     const onKeyDown = (e: KeyboardEvent): void => {
59:       if (e.key !== 'g' || e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
60:       if (editable(document.activeElement) || prefersReducedMotion()) return;
61:       keyHeld = true;
62:       field.setGlitter(true, [window.innerWidth / 2, window.innerHeight / 2]);
63:     };
64:     const onKeyUp = (e: KeyboardEvent): void => {
65:       if (e.key !== 'g' || !keyHeld) return;
66:       keyHeld = false;
67:       field.setGlitter(false);
68:     };
69:     const onBlur = (): void => {
70:       // Blur must end a keyboard hold too: the keyup may fire outside
71:       // the page and never arrive, which would otherwise leave scatter
72:       // mode active indefinitely after returning (DESIGN 6.13).
73:       stop();
74:       if (keyHeld) {
75:         keyHeld = false;
76:         field.setGlitter(false);
77:       }
78:     };
79:     mount?.addEventListener('pointerdown', onDown);
80:     window.addEventListener('pointermove', onMove);
81:     window.addEventListener('pointerup', stop);
82:     window.addEventListener('pointercancel', stop);
83:     window.addEventListener('keydown', onKeyDown);
84:     window.addEventListener('keyup', onKeyUp);
85:     window.addEventListener('blur', onBlur);
86:     return () => {
87:       stop();
88:       if (keyHeld) field.setGlitter(false);
89:       mount?.removeEventListener('pointerdown', onDown);
90:       window.removeEventListener('pointermove', onMove);
91:       window.removeEventListener('pointerup', stop);
92:       window.removeEventListener('pointercancel', stop);
93:       window.removeEventListener('keydown', onKeyDown);
94:       window.removeEventListener('keyup', onKeyUp);
95:       window.removeEventListener('blur', onBlur);
96:     };
97:   }, [field, blocked]);
98: }
</file>

<file path="src/chrome/titleFit.ts">
 1: // Title fit sizing (S04 section 5, DESIGN section 5): a scene
 2: // title renders at the smaller of its token size and the width its
 3: // container allows divided by characters times the Commit Mono
 4: // advance, measured from the loaded font. The server variant is
 5: // skipped: its H1 is the name itself, and the wordmark is hidden
 6: // on server, so it cannot intersect a visible name box; shrinking
 7: // it would change the server hero for no zone benefit.
 8: import { useLayoutEffect, type RefObject } from 'react';
 9: import type { SceneId } from '../router';
10: 
11: const MIN_PX = 13;
12: 
13: function fitTitle(section: HTMLElement): void {
14:   if (section.className.includes('jp-readout--server')) return;
15:   const h1 = section.querySelector('h1') as HTMLElement | null;
16:   if (h1 === null) return;
17:   h1.style.fontSize = '';
18:   const computed = getComputedStyle(h1);
19:   const tokenSize = parseFloat(computed.fontSize);
20:   const available = h1.clientWidth;
21:   const text = h1.textContent ?? '';
22:   const chars = [...text].length;
23:   if (
24:     Number.isNaN(tokenSize) ||
25:     tokenSize <= 0 ||
26:     available <= 0 ||
27:     chars === 0
28:   ) {
29:     return;
30:   }
31:   const canvas = document.createElement('canvas');
32:   const ctx = canvas.getContext('2d');
33:   if (ctx === null) return;
34:   ctx.font = `${computed.fontWeight} 100px ${computed.fontFamily}`;
35:   const advance = ctx.measureText('0').width / 100;
36:   if (advance <= 0) return;
37:   const fit = available / (chars * advance);
38:   if (fit < tokenSize) {
39:     h1.style.fontSize = `${Math.max(fit, MIN_PX)}px`;
40:   }
41: }
42: 
43: export function useTitleFit(
44:   sectionRef: RefObject<HTMLElement | null>,
45:   scene: SceneId,
46: ): void {
47:   // Layout effect (polish round): the title settles in the same commit
48:   // as the readout swap, before the hero (a later sibling) measures the
49:   // readout rect, so the hero never places against a pre-fit title.
50:   useLayoutEffect(() => {
51:     const section = sectionRef.current;
52:     if (section === null) return;
53:     const compute = (): void => fitTitle(section);
54:     compute();
55:     if (typeof document.fonts !== 'undefined') {
56:       void document.fonts.ready.then(() => compute());
57:     }
58:     const observer = new ResizeObserver(() => compute());
59:     observer.observe(section);
60:     return () => observer.disconnect();
61:   }, [sectionRef, scene]);
62: }
</file>

