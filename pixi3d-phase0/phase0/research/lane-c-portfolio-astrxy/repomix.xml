 39: export interface TravelDeps {
 40:   lanefield: Lanefield | null;
 41:   dom: TravelDom;
 42:   isReducedMotion: () => boolean;
 43:   controllers?: Map<SceneId, SceneController>;
 44:   onSwap?: (scene: SceneId) => void;
