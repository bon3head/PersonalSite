115: async function decodeWithTimeout(img: HTMLImageElement, timeoutMs: number): Promise<void> {
116:   let timer: ReturnType<typeof setTimeout> | undefined;
117:   try {
118:     await Promise.race([
119:       img.decode(),
120:       new Promise<void>((_, reject) => {
121:         timer = setTimeout(() => reject(new Error('decode timeout')), timeoutMs);
122:       }),
123:     ]);
124:   } finally {
125:     if (timer !== undefined) clearTimeout(timer);
126:   }
127: }
