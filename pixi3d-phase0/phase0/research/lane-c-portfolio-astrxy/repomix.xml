116: function intersects(a: Rect, b: Rect): boolean {
117:   return a[0] < b[2] && a[2] > b[0] && a[1] < b[3] && a[3] > b[1];
118: }
119: 
120: function checkBand(samples: Sample[]): {
121:   min: number | null;
122:   max: number | null;
123:   firstOutside: Sample | null;
124:   morphPMin: number | null;
125:   morphPMax: number | null;
126:   callsMin: number | null;
127:   callsMax: number | null;
128: } {
129:   let min: number | null = null;
130:   let max: number | null = null;
131:   let firstOutside: Sample | null = null;
132:   let morphPMin: number | null = null;
133:   let morphPMax: number | null = null;
134:   let callsMin: number | null = null;
135:   let callsMax: number | null = null;
136:   for (const s of samples) {
137:     if (min === null || s.pitch < min) min = s.pitch;
138:     if (max === null || s.pitch > max) max = s.pitch;
139:     if (callsMin === null || s.calls < callsMin) callsMin = s.calls;
140:     if (callsMax === null || s.calls > callsMax) callsMax = s.calls;
141:     if (s.morphP !== null) {
142:       if (morphPMin === null || s.morphP < morphPMin) morphPMin = s.morphP;
143:       if (morphPMax === null || s.morphP > morphPMax) morphPMax = s.morphP;
144:     }
145:     if (firstOutside === null) {
146:       // Band edges carry a 1e-6 float epsilon, the same tolerance
147:       // W4 used for the clamp: the clamped edge reads -75.0000000000041
148:       // through the matrix getter, 4e-12 below the token edge.
149:       if (s.pitch < MIN - 1e-6 || s.pitch > MAX + 1e-6 || s.laneCount !== 6144) {
150:         firstOutside = s;
151:       }
152:     }
153:   }
154:   return { min, max, firstOutside, morphPMin, morphPMax, callsMin, callsMax };
155: }
