 942:     rippleMesh.geo.instanceCount = r;
 943:     rippleMesh.center.needsUpdate = true;
 944:     rippleMesh.scale.needsUpdate = true;
 945:     rippleMesh.opacity.needsUpdate = true;
 946:   }
