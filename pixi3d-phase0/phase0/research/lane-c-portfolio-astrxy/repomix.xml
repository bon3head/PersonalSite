245:   // (the clock still advances in 16ms steps, so frames are identical).
246:   test.setTimeout(1800000);
247:   async function script(seed: number): Promise<number[]> {
248:     const { ctx, page } = await open(browser, `/?seed=${seed}`);
249:     const trace: number[] = [];
250:     for (const key of ['2', '3']) {
251:       await page.keyboard.press(key);
