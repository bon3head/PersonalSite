<file path="tests/layouts/scatter.test.ts">
  1: // Layout tests for the S08 scatter generator (B5d card).
  2: // Covers the layout-level claims behind T-404-1: 6,144 lanes of 8 points,
  3: // class 9, sphere radius, segment length range, determinism, speed,
  4: // and isolation (no other layout's texels touched).
  5: // Bulk checks aggregate into counts first: one expect per texel would
  6: // block the worker event loop for minutes (Playwright expect overhead).
  7: import { test, expect } from '@playwright/test';
  8: import { generate } from '../../src/world/layouts/scatter';
  9: import { T } from '../../src/tokens.generated';
 10: 
 11: const LANE_COUNT = T.world.laneCount;
 12: const POINTS = T.world.pointsPerLane;
 13: const LAYOUT_COUNT = T.world.layouts.length;
 14: const LANE_STRIDE = POINTS * LAYOUT_COUNT;
 15: const FLOATS_PER_TEXEL = 4;
 16: const SCATTER_LAYOUT = 3;
 17: const BUF_LEN = T.world.layoutTexture.width * T.world.layoutTexture.height * FLOATS_PER_TEXEL;
 18: const EPS = 1e-4;
 19: 
 20: function texelBase(lane: number, k: number): number {
 21:   return (lane * LANE_STRIDE + SCATTER_LAYOUT * POINTS + k) * FLOATS_PER_TEXEL;
 22: }
 23: 
 24: test('scatter writes 6144 lanes of 8 points, all class 9', () => {
 25:   const out = new Float32Array(BUF_LEN);
 26:   const side = generate(T.world.seed, out, SCATTER_LAYOUT);
 27:   expect(side).toEqual({});
 28:   let classed = 0;
 29:   for (let lane = 0; lane < LANE_COUNT; lane++) {
 30:     for (let k = 0; k < POINTS; k++) {
 31:       if (out[texelBase(lane, k) + 3] === 9) classed++;
 32:     }
 33:   }
 34:   expect(classed).toBe(LANE_COUNT * POINTS);
 35: });
 36: 
 37: test('scatter geometry: centers in sphere, lengths in range, points evenly spaced', () => {
 38:   const out = new Float32Array(BUF_LEN);
 39:   generate(T.world.seed, out, SCATTER_LAYOUT);
 40:   const radius = T.world.scatter.radius;
 41:   const segMin = T.world.scatter.segLength[0];
 42:   const segMax = T.world.scatter.segLength[1];
 43:   let sphereBad = 0;
 44:   let lenBad = 0;
 45:   let stepBad = 0;
 46:   for (let lane = 0; lane < LANE_COUNT; lane++) {
 47:     const p0 = texelBase(lane, 0);
 48:     const p7 = texelBase(lane, POINTS - 1);
 49:     const mx = (out[p0] + out[p7]) / 2;
 50:     const my = (out[p0 + 1] + out[p7 + 1]) / 2;
 51:     const mz = (out[p0 + 2] + out[p7 + 2]) / 2;
 52:     if (Math.sqrt(mx * mx + my * my + mz * mz) > radius + EPS) sphereBad++;
 53:     const len = Math.sqrt(
 54:       (out[p7] - out[p0]) ** 2 + (out[p7 + 1] - out[p0 + 1]) ** 2 + (out[p7 + 2] - out[p0 + 2]) ** 2,
 55:     );
 56:     if (len < segMin - EPS || len > segMax + EPS) lenBad++;
 57:     const step = len / (POINTS - 1);
 58:     for (let k = 0; k < POINTS - 1; k++) {
 59:       const a = texelBase(lane, k);
 60:       const b = texelBase(lane, k + 1);
 61:       const d = Math.sqrt(
 62:         (out[b] - out[a]) ** 2 + (out[b + 1] - out[a + 1]) ** 2 + (out[b + 2] - out[a + 2]) ** 2,
 63:       );
 64:       if (Math.abs(d - step) >= EPS) stepBad++;
 65:     }
 66:   }
 67:   expect(sphereBad).toBe(0);
 68:   expect(lenBad).toBe(0);
 69:   expect(stepBad).toBe(0);
 70: });
 71: 
 72: test('scatter is deterministic across runs', () => {
 73:   const a = new Float32Array(BUF_LEN);
 74:   const b = new Float32Array(BUF_LEN);
 75:   generate(T.world.seed, a, SCATTER_LAYOUT);
 76:   generate(T.world.seed, b, SCATTER_LAYOUT);
 77:   expect(a).toEqual(b);
 78: });
 79: 
 80: test('scatter generation is under 150ms', () => {
 81:   const out = new Float32Array(BUF_LEN);
 82:   const start = performance.now();
 83:   generate(T.world.seed, out, SCATTER_LAYOUT);
 84:   const ms = performance.now() - start;
 85:   expect(ms).toBeLessThan(150);
 86: });
 87: 
 88: test('scatter touches only its own layout texels', () => {
 89:   const sentinel = -777;
 90:   const out = new Float32Array(BUF_LEN).fill(sentinel);
 91:   generate(T.world.seed, out, SCATTER_LAYOUT);
 92:   let touched = 0;
 93:   for (let lane = 0; lane < LANE_COUNT; lane++) {
 94:     for (let lay = 0; lay < LAYOUT_COUNT; lay++) {
 95:       if (lay === SCATTER_LAYOUT) continue;
 96:       for (let k = 0; k < POINTS; k++) {
 97:         const base = (lane * LANE_STRIDE + lay * POINTS + k) * FLOATS_PER_TEXEL;
 98:         if (out[base] !== sentinel || out[base + 3] !== sentinel) touched++;
 99:       }
100:     }
101:   }
102:   expect(touched).toBe(0);
103: });
</file>

