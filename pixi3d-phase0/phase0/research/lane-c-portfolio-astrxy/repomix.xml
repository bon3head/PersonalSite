  1: // Camera rig (S02 camera chapter): pose selection, principal-point shift,
  2: // idle yaw, leaflink drift, and pointer parallax.
  3: // travel-ready pose lerp, idle yaw / leaflink drift, pointer parallax,
  4: // and screen/ground projection using the shifted matrices.
  5: import * as THREE from 'three';
  6: import { T } from '../tokens.generated';
  7: import type { LayoutId } from './types';
  8: import { damp } from './tween';
  9: 
 10: export interface Pose {
 11:   pos: [number, number, number];
 12:   target: [number, number, number];
 13:   fov: number;
 14:   shift: [number, number];
 15: }
 16: 
 17: const DEG_TO_RAD = Math.PI / 180; // lit-ok: degree to radian conversion
 18: const IDLE_YAW_LAYOUTS = ['server', 'sidequests', 'scatter'] as const;
 19: 
 20: // Variant: coarse when narrow, or when a coarse pointer is on a
 21: // below-desktop viewport. Re-evaluated on resize and orientation change.
 22: export function isCoarseVariant(): boolean {
 23:   if (window.innerWidth < T.breakpoints.coarseOrNarrowBelowPx) return true;
 24:   if (window.matchMedia('(pointer: coarse)').matches && window.innerWidth < T.breakpoints.desktopFromPx) {
 25:     return true;
 26:   }
 27:   return false;
 28: }
 29: 
 30: export function currentVariant(): 'coarse' | 'fine' {
 31:   return isCoarseVariant() ? 'coarse' : 'fine';
 32: }
 33: 
 34: export function poseFor(layout: LayoutId, variant: 'coarse' | 'fine' = currentVariant()): Pose {
 35:   const p = T.world.camera[layout][variant];
 36:   return {
 37:     pos: [...p.pos] as [number, number, number],
 38:     target: [...p.target] as [number, number, number],
 39:     fov: p.fovDeg,
 40:     shift: [...p.shiftNdc] as [number, number],
 41:   };
 42: }
 43: 
 44: export function lerpPose(a: Pose, b: Pose, t: number): Pose {
 45:   const mix = (x: number, y: number) => x + (y - x) * t;
 46:   return {
 47:     pos: [mix(a.pos[0], b.pos[0]), mix(a.pos[1], b.pos[1]), mix(a.pos[2], b.pos[2])],
 48:     target: [mix(a.target[0], b.target[0]), mix(a.target[1], b.target[1]), mix(a.target[2], b.target[2])],
 49:     fov: mix(a.fov, b.fov),
 50:     shift: [mix(a.shift[0], b.shift[0]), mix(a.shift[1], b.shift[1])],
 51:   };
 52: }
 53: 
 54: // Lerp into a preallocated pose (no allocation; for the per-frame path).
 55: export function lerpPoseInto(a: Pose, b: Pose, t: number, out: Pose): void {
 56:   const mix = (x: number, y: number) => x + (y - x) * t;
 57:   out.pos[0] = mix(a.pos[0], b.pos[0]);
 58:   out.pos[1] = mix(a.pos[1], b.pos[1]);
 59:   out.pos[2] = mix(a.pos[2], b.pos[2]);
 60:   out.target[0] = mix(a.target[0], b.target[0]);
 61:   out.target[1] = mix(a.target[1], b.target[1]);
 62:   out.target[2] = mix(a.target[2], b.target[2]);
 63:   out.fov = mix(a.fov, b.fov);
 64:   out.shift[0] = mix(a.shift[0], b.shift[0]);
 65:   out.shift[1] = mix(a.shift[1], b.shift[1]);
 66: }
 67: 
 68: // ITEM 6 camera clamp (W4). The single clamp on the SideQuests camera // lit-ok:
 69: // path: it runs in the lanefield frame loop after rig interpolation,
 70: // walk lean, and pointer parallax have combined, and it is the last
 71: // camera write before render. Pitch is the elevation of the camera
 72: // forward vector above horizontal in degrees: negative looks down,
 73: // flat top-down is -90. The band is pitch only, from // lit-ok:
 74: // world.sidequests.camera.pitchMin to pitchMax; yaw gets no band.
 75: // Clamping rotates the forward vector about the camera right axis by
 76: // exactly the overshoot, so the position and the walk target are
 77: // untouched and a walk in progress still finishes its trail. Returns
 78: // true when it moved the camera.
 79: export function clampSideQuestsPitch(camera: THREE.PerspectiveCamera): boolean {
 80:   const min = T.world.sidequests.camera.pitchMin;
 81:   const max = T.world.sidequests.camera.pitchMax;
 82:   camera.updateMatrixWorld();
 83:   const e = camera.matrixWorld.elements;
 84:   const forward = new THREE.Vector3(-e[8], -e[9], -e[10]).normalize(); // lit-ok: matrix third column negated to forward
 85:   const pitch = Math.asin(Math.max(-1, Math.min(1, forward.y))) * 180 / Math.PI; // lit-ok: radians to degrees conversion
 86:   if (pitch >= min && pitch <= max) return false;
 87:   const target = Math.max(min, Math.min(max, pitch));
 88:   const delta = (target - pitch) * DEG_TO_RAD;
 89:   const right = new THREE.Vector3().crossVectors(forward, UP);
 90:   if (right.lengthSq() < 1e-8) right.set(1, 0, 0); // lit-ok: degenerate vertical forward fallback axis
 91:   right.normalize();
 92:   forward.applyAxisAngle(right, delta);
 93:   const pos = camera.position;
 94:   camera.lookAt(pos.x + forward.x, pos.y + forward.y, pos.z + forward.z);
 95:   camera.updateMatrixWorld();
 96:   return true;
 97: }
 98: 
 99: const UP = new THREE.Vector3(0, 1, 0);
100: 
101: export class CameraRig {
102:   private camera: THREE.PerspectiveCamera;
103:   private pos = new THREE.Vector3();
104:   private target = new THREE.Vector3();
105:   private offset = new THREE.Vector3();
106:   private forward = new THREE.Vector3();
107:   private right = new THREE.Vector3();
108:   private tmp = new THREE.Vector3();
109:   private applied: Pose;
110:   private composed: Pose;
111:   private smoothX = 0;
112:   private smoothY = 0;
113:   private scratch = new THREE.PerspectiveCamera();
114: 
115:   constructor(camera: THREE.PerspectiveCamera) {
116:     this.camera = camera;
117:     this.applied = poseFor('server');
118:     this.composed = poseFor('server');
119:   }
120: 
121:   // Apply a pose to the camera, including the principal-point shift.
122:   // Positive shift[0] moves the image right in NDC.
123:   // Writes the applied pose in place (no allocation on the frame path).
124:   applyPose(pose: Pose): void {
125:     const cam = this.camera;
126:     cam.position.set(pose.pos[0], pose.pos[1], pose.pos[2]);
127:     cam.lookAt(pose.target[0], pose.target[1], pose.target[2]);
128:     cam.fov = pose.fov;
129:     cam.updateProjectionMatrix();
130:     cam.projectionMatrix.elements[8] = -pose.shift[0];
131:     cam.projectionMatrix.elements[9] = -pose.shift[1];
132:     cam.projectionMatrixInverse.copy(cam.projectionMatrix).invert();
133:     this.applied.pos[0] = pose.pos[0];
134:     this.applied.pos[1] = pose.pos[1];
135:     this.applied.pos[2] = pose.pos[2];
136:     this.applied.target[0] = pose.target[0];
137:     this.applied.target[1] = pose.target[1];
138:     this.applied.target[2] = pose.target[2];
139:     this.applied.fov = pose.fov;
140:     this.applied.shift[0] = pose.shift[0];
141:     this.applied.shift[1] = pose.shift[1];
142:   }
143: 
144:   // Compose one frame's camera from a base pose: idle yaw (weights blend
145:   // the amplitude during travel), leaflink drift, pointer parallax.
146:   // All three are off under reduced motion.
147:   // offset is a ground-plane translation [x, z] applied to position
148:   // and target together (polish round: focus pan plus morph bow). A
149:   // pure translation never changes pitch, so the SideQuests camera
150:   // band is unaffected by it.
151:   update(
152:     base: Pose,
153:     tSec: number,
154:     weights: readonly number[],
155:     pointer: { x: number; y: number },
156:     dtMs: number,
157:     reduced: boolean,
158:     finePointer: boolean,
159:     offset: readonly [number, number] = [0, 0],
160:   ): void {
161:     this.pos.set(base.pos[0] + offset[0], base.pos[1], base.pos[2] + offset[1]);
162:     this.target.set(base.target[0] + offset[0], base.target[1], base.target[2] + offset[1]);
163:     if (!reduced) {
164:       let yaw = 0;
165:       for (const name of IDLE_YAW_LAYOUTS) {
166:         const idx = T.world.layouts.indexOf(name);
167:         const deg = T.world.camera.idleYawDeg[name];
168:         const period = T.world.camera.idleYawPeriodSec[name];
169:         yaw += weights[idx] * deg * DEG_TO_RAD * Math.sin((2 * Math.PI * tSec) / period);
170:       }
171:       if (yaw !== 0) {
172:         this.offset.copy(this.pos).sub(this.target);
173:         this.offset.applyAxisAngle(UP, yaw);
174:         this.pos.copy(this.target).add(this.offset);
175:       }
176:       const wLeaf = weights[T.world.layouts.indexOf('leaflink')];
177:       if (wLeaf !== 0) {
178:         const amp = T.world.camera.leaflinkDrift.amp;
179:         const period = T.world.camera.leaflinkDrift.periodSec;
180:         const dx = wLeaf * amp[0] * Math.sin((2 * Math.PI * tSec) / period);
181:         const dz = wLeaf * amp[1] * Math.sin((2 * Math.PI * tSec) / period * 0.7); // lit-ok: S02 drift factor
182:         this.pos.x += dx;
183:         this.pos.z += dz;
184:         this.target.x += dx;
185:         this.target.z += dz;
186:       }
187:       if (finePointer) {
188:         const halfLife = T.world.camera.parallaxDampHalfLifeMs;
189:         this.smoothX = damp(this.smoothX, pointer.x, halfLife, dtMs);
190:         this.smoothY = damp(this.smoothY, pointer.y, halfLife, dtMs);
191:         const deg = T.world.camera.parallaxDeg * DEG_TO_RAD;
192:         const yawOff = this.smoothX * deg;
193:         const pitchOff = -this.smoothY * deg;
194:         if (yawOff !== 0) {
195:           this.offset.copy(this.pos).sub(this.target);
196:           this.offset.applyAxisAngle(UP, yawOff);
197:           this.pos.copy(this.target).add(this.offset);
198:         }
199:         if (pitchOff !== 0) {
200:           this.forward.copy(this.target).sub(this.pos).normalize();
201:           this.right.crossVectors(this.forward, UP).normalize();
202:           this.offset.copy(this.pos).sub(this.target);
203:           this.offset.applyAxisAngle(this.right, pitchOff);
204:           this.pos.copy(this.target).add(this.offset);
205:         }
206:       }
207:     }
208:     this.composed.pos[0] = this.pos.x;
209:     this.composed.pos[1] = this.pos.y;
210:     this.composed.pos[2] = this.pos.z;
211:     this.composed.target[0] = this.target.x;
212:     this.composed.target[1] = this.target.y;
213:     this.composed.target[2] = this.target.z;
214:     this.composed.fov = base.fov;
215:     this.composed.shift[0] = base.shift[0];
216:     this.composed.shift[1] = base.shift[1];
217:     this.applyPose(this.composed);
218:   }
219: 
220:   currentPose(): Pose {
221:     return {
222:       pos: [...this.applied.pos],
223:       target: [...this.applied.target],
224:       fov: this.applied.fov,
225:       shift: [...this.applied.shift],
226:     };
227:   }
228: 
229:   // Ray from CSS px through the (shifted) camera to the plane y = 0.
230:   screenToGround(xCss: number, yCss: number, cssW: number, cssH: number): [number, number] | null {
231:     this.camera.updateMatrixWorld();
232:     const ndcX = (xCss / cssW) * 2 - 1;
233:     const ndcY = -(yCss / cssH) * 2 + 1;
234:     this.tmp.set(ndcX, ndcY, 0.5).unproject(this.camera);
235:     const dir = this.tmp.sub(this.camera.position).normalize();
236:     if (dir.y >= 0) return null;
237:     const dist = -this.camera.position.y / dir.y;
238:     const px = this.camera.position.x + dir.x * dist;
239:     const pz = this.camera.position.z + dir.z * dist;
240:     return [px, pz];
241:   }
242: 
243:   // Project a world point through a resting pose (no yaw, drift,
244:   // parallax, lean, or pan) on a scratch camera, so geometry that must
245:   // not follow the camera (hero placement against marker rest
246:   // positions) reads one stable answer. The real camera is untouched.
247:   projectAtPose(pose: Pose, p: [number, number, number], cssW: number, cssH: number): [number, number] {
248:     const cam = this.scratch;
249:     cam.near = this.camera.near;
250:     cam.far = this.camera.far;
251:     cam.aspect = cssW / cssH;
252:     cam.position.set(pose.pos[0], pose.pos[1], pose.pos[2]);
253:     cam.lookAt(pose.target[0], pose.target[1], pose.target[2]);
254:     cam.fov = pose.fov;
255:     cam.updateProjectionMatrix();
256:     cam.projectionMatrix.elements[8] = -pose.shift[0];
257:     cam.projectionMatrix.elements[9] = -pose.shift[1];
258:     cam.projectionMatrixInverse.copy(cam.projectionMatrix).invert();
259:     cam.updateMatrixWorld();
260:     this.tmp.set(p[0], p[1], p[2]).project(cam);
261:     return [(this.tmp.x + 1) / 2 * cssW, (1 - this.tmp.y) / 2 * cssH];
262:   }
263: 
264:   // Project a world point to CSS px through the shifted matrix.
265:   worldToScreen(p: [number, number, number], cssW: number, cssH: number): [number, number] {
266:     this.camera.updateMatrixWorld();
267:     this.tmp.set(p[0], p[1], p[2]).project(this.camera);
268:     return [(this.tmp.x + 1) / 2 * cssW, (1 - this.tmp.y) / 2 * cssH];
269:   }
270: }
</file>

