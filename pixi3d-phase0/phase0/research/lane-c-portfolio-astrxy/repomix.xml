108:   if (uW.x > 0.0) {                              // server pulses, weighted out in other layouts // lit-ok: shader constant
109:     float t = uFrozen > 0.5 ? 0.0 : uTime; // lit-ok: shader constant
110:     float f = fire(vLane, vU, t) * uW.x;
111:     col = mix(col, uHot, f);
