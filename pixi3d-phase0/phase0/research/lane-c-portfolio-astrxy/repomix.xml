 31: // ---- T-LF-9: pull displacement, pinned on the pure function.
 32: test('T-LF-9: silhouette pull moves lanes near the contour toward it', () => {
 33:   // Gradient toward +x, outside the mark (alpha 0), full strength.
 34:   expect(silhouettePullPoint(3, 0, 0, 1, 0, 0.35)).toEqual([3.35, 0]);
 35:   // Half inside the contour (alpha 0.5) moves half the strength.
 36:   expect(silhouettePullPoint(3, 0, 0.5, 1, 0, 0.35)).toEqual([3.175, 0]);
 37:   // Deep inside the mark (alpha 1) does not move, even with a gradient.
 38:   expect(silhouettePullPoint(3, 0, 1, 1, 0, 0.35)).toEqual([3, 0]);
 39:   // Inactive pull does not move anything: zero strength, zero gradient.
 40:   expect(silhouettePullPoint(3, 0, 0, 1, 0, 0)).toEqual([3, 0]);
 41:   expect(silhouettePullPoint(3, 0, 0, 0, 0, 0.35)).toEqual([3, 0]);
 42:   // Diagonal gradient normalizes: a (3, 4) gradient at strength 0.5
 43:   // moves (0.3, 0.4), the unit direction times the strength.
 44:   const [dx, dz] = silhouettePullPoint(0, 0, 0, 3, 4, 0.5);
 45:   expect(dx).toBeCloseTo(0.3, 10);
 46:   expect(dz).toBeCloseTo(0.4, 10);
 47:   // Alpha clamps: above 1 behaves as inside, below 0 as outside.
 48:   expect(silhouettePullPoint(0, 0, 2, 1, 0, 0.35)).toEqual([0, 0]);
 49:   expect(silhouettePullPoint(0, 0, -1, 1, 0, 0.35)).toEqual([0.35, 0]);
 50: });
 51: 
 52: // ---- T-LF-9 (mask mapping and envelope): the route mechanism.
 53: test('T-LF-9: mask kind, UV mapping, and envelope follow the route', () => {
 54:   expect(maskKindForLayout('sidequests')).toBe('sidequests');
 55:   expect(maskKindForLayout('leaflink')).toBe('leaflink');
 56:   expect(maskKindForLayout('server')).toBe('none');
 57:   expect(maskKindForLayout('scatter')).toBe('none');
 58:   // The ring disc maps to the mask square: center to center, ring
 59:   // edge to square edge.
 60:   expect(maskUv(0, 0, 0, 0, 6)).toEqual([0.5, 0.5]);
 61:   expect(maskUv(6, 0, 0, 0, 6)).toEqual([1, 0.5]);
 62:   expect(maskUv(0, 6, 0, 0, 6)).toEqual([0.5, 1]);
 63:   expect(maskUv(-6, -6, 0, 0, 6)).toEqual([0, 0]);
 64:   // Envelope: zero before Gather, zero after Reveal, token peak at
 65:   // full Gather with no Reveal.
 66:   expect(silhouetteEnvelopeStrength(0, 0, T.morph.silhouettePull)).toBe(0);
 67:   expect(silhouetteEnvelopeStrength(1, 1, T.morph.silhouettePull)).toBe(0);
 68:   expect(silhouetteEnvelopeStrength(1, 0, T.morph.silhouettePull)).toBe(
 69:     T.morph.silhouettePull,
 70:   );
 71:   expect(T.morph.silhouettePull).toBe(0.35);
 72:   // Params: mask kind is per route, strength is zero at rest, and the
 73:   // kind switches at the lerp midpoint like light mode.
 74:   const side = paramsForLayout('sidequests');
 75:   expect(side.silhouetteMask).toBe('sidequests');
 76:   expect(side.silhouetteStrength).toBe(0);
 77:   expect(side.silhouetteRadius).toBe(0);
 78:   expect(paramsForLayout('leaflink').silhouetteMask).toBe('leaflink');
 79:   expect(paramsForLayout('server').silhouetteMask).toBe('none');
 80:   const server = paramsForLayout('server');
 81:   expect(lerpParams(server, side, 0.49).silhouetteMask).toBe('none');
 82:   expect(lerpParams(server, side, 0.5).silhouetteMask).toBe('sidequests');
 83:   // The small mask texture edge is a fixed size, shared by the engine.
 84:   expect(SILHOUETTE_MASK_SIZE).toBe(128);
 85: });
 86: 
 87: // ---- T-LF-9 (shader mirror): the vertex shader samples the mask and
 88: // pulls after the ring deflection.
 89: test('T-LF-9: vertex shader mirrors the pull after the ring', () => {
 90:   const vert = readFileSync(join(ROOT, 'src', 'world', 'shaders', 'lane.vert.glsl'), 'utf8');
 91:   expect(vert).toContain('uSilhouetteMask');
 92:   expect(vert).toContain('uSilhouetteCenter');
 93:   expect(vert).toContain('uSilhouetteRadius');
 94:   expect(vert).toContain('uSilhouetteStrength');
 95:   expect(vert).toContain('texture(uSilhouetteMask');
 96:   expect(vert).toContain('1.0 - clamp(a, 0.0, 1.0)');
 97:   // Pull applies to both endpoints, after the ring deflection.
 98:   expect(vert.indexOf('deflectXZ(p0.xz)')).toBeLessThan(vert.indexOf('pullXZ(p0.xz)'));
 99:   expect(vert.indexOf('deflectXZ(p1.xz)')).toBeLessThan(vert.indexOf('pullXZ(p1.xz)'));
100:   // One lane draw call by construction: the shader has no second
101:   // mesh path, and the mask is a sampler uniform, not a draw.
102:   expect(vert).not.toContain('gl_DrawID');
103: });
