115:   if (vKind > 0 && uTime >= vAct.r) {            // routes (1) and lit trails (2) // lit-ok: shader constant
116:     float rate = vAct.a;
117:     float travelled = (uTime - vAct.r) * abs(rate);
118:     float along = rate >= 0.0 ? vU : 1.0 - vU; // lit-ok: shader constant
119:     float shown = step(along, travelled);
120:     float fade = vAct.g > 0.0 ? 1.0 - clamp((uTime - vAct.g) / uFadeSec, 0.0, 1.0) : 1.0; // lit-ok: shader constant
121:     float on = (vKind == 1 ? uW.y : uW.z) * shown * fade; // lit-ok: shader constant
