129: // A short eased transition between two values (stage recede and loom).
130: interface Ramp {
131:   from: number;
132:   to: number;
133:   startMs: number;
134:   durMs: number;
135: }
136: 
137: function rampAt(r: Ramp, nowMs: number): number {
138:   const k = r.durMs <= 0 ? 1 : Math.min(1, Math.max(0, (nowMs - r.startMs) / r.durMs));
139:   return r.from + (r.to - r.from) * easeSignature(k);
140: }
