  1: // Layout tests for the real server generator (S05 section 3.1, T-SRV-1).
  2: // Pure function tests: no browser needed, Playwright runs these in Node.
  3: import { test, expect } from '@playwright/test';
  4: import { generate } from '../src/world/layouts/server';
  5: import { T } from '../src/tokens.generated';
  6: 
  7: const POINTS = T.world.pointsPerLane;
  8: const LAYOUT_COUNT = T.world.layouts.length;
  9: const LANE_STRIDE = POINTS * LAYOUT_COUNT;
 10: const SEED = T.world.seed;
 11: const SERVER_LAYOUT = 0;
 12: 
 13: function fullBuffer(): Float32Array {
 14:   return new Float32Array(T.world.layoutTexture.width * T.world.layoutTexture.height * 4);
 15: }
 16: 
 17: function point(buf: Float32Array, lane: number, lay: number, k: number): [number, number, number, number] {
 18:   const base = (lane * LANE_STRIDE + lay * POINTS + k) * 4;
 19:   return [buf[base], buf[base + 1], buf[base + 2], buf[base + 3]];
 20: }
 21: 
 22: function close(actual: number, expected: number) {
 23:   expect(Math.abs(actual - expected)).toBeLessThan(1e-4);
 24: }
 25: 
 26: test('T-SRV-1: lanes 0, 127, 128, 6143 at k=0 match hand values', () => {
 27:   const buf = fullBuffer();
 28:   generate(SEED, buf, SERVER_LAYOUT);
 29:   const expected: Record<number, [number, number, number]> = {
 30:     0: [-3.565, -2.315, -24],
 31:     127: [-3.085, -1.935, -24],
 32:     128: [-2.615, -2.315, -24],
 33:     6143: [3.565, 2.315, -24],
 34:   };
 35:   for (const [lane, [x, y, z]] of Object.entries(expected)) {
 36:     const [ax, ay, az, cls] = point(buf, Number(lane), SERVER_LAYOUT, 0);
 37:     close(ax, x);
 38:     close(ay, y);
 39:     close(az, z);
 40:     expect(cls).toBe(0);
 41:   }
 42: });
 43: 
 44: test('T-SRV-1: converge points k=6, k=7 for lane 0 mix toward focus', () => {
 45:   const buf = fullBuffer();
 46:   generate(SEED, buf, SERVER_LAYOUT);
 47:   const [x6, y6, z6, c6] = point(buf, 0, SERVER_LAYOUT, 6);
 48:   close(x6, -1.7825);
 49:   close(y6, -1.1575);
 50:   close(z6, 0.4);
 51:   expect(c6).toBe(0);
 52:   const [x7, y7, z7, c7] = point(buf, 0, SERVER_LAYOUT, 7);
 53:   close(x7, -0.2852);
 54:   close(y7, -0.1852);
 55:   close(z7, 2.2);
 56:   expect(c7).toBe(0);
 57: });
 58: 
 59: test('server layout: exactly 6144 lanes of 8 points, all finite, all class 0', () => {
 60:   const buf = fullBuffer();
 61:   generate(SEED, buf, SERVER_LAYOUT);
 62:   let written = 0;
 63:   let bad = 0;
 64:   for (let lane = 0; lane < T.world.laneCount; lane++) {
 65:     for (let k = 0; k < POINTS; k++) {
 66:       const [x, y, z, cls] = point(buf, lane, SERVER_LAYOUT, k);
 67:       if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(z) || cls !== 0) bad++;
 68:       written++;
 69:     }
 70:   }
 71:   expect(bad).toBe(0);
 72:   expect(written).toBe(T.world.laneCount * POINTS);
 73:   // Straight points run z from -24 to -2; the two converge points sit at 0.4 and 2.2.
 74:   const [, , z0] = point(buf, 0, SERVER_LAYOUT, 0);
 75:   const [, , z5] = point(buf, 0, SERVER_LAYOUT, 5);
 76:   close(z0, -24);
 77:   close(z5, -2);
 78: });
 79: 
 80: test('server layout: deterministic across runs and seeds (pure grid arithmetic)', () => {
 81:   const a = fullBuffer();
 82:   const b = fullBuffer();
 83:   generate(SEED, a, SERVER_LAYOUT);
 84:   generate(SEED, b, SERVER_LAYOUT);
 85:   expect(a).toEqual(b);
 86:   const c = fullBuffer();
 87:   generate(SEED + 1, c, SERVER_LAYOUT);
 88:   expect(c).toEqual(a);
 89: });
 90: 
 91: test('server layout: generation under 150ms in Node', () => {
 92:   const buf = fullBuffer();
 93:   const t0 = performance.now();
 94:   generate(SEED, buf, SERVER_LAYOUT);
 95:   const ms = performance.now() - t0;
 96:   expect(ms).toBeLessThan(150);
 97: });
 98: 
 99: test('server layout: writes only its own layout slice', () => {
100:   const buf = fullBuffer();
101:   generate(SEED, buf, SERVER_LAYOUT);
102:   const other = fullBuffer();
103:   generate(SEED, other, 1);
104:   // Same geometry in a different slice: values equal, positions differ.
105:   const [x0] = point(buf, 0, SERVER_LAYOUT, 0);
106:   const [x1] = point(other, 0, 1, 0);
107:   close(x0, x1);
108:   const [otherSlice] = point(buf, 0, 1, 0);
109:   expect(otherSlice).toBe(0);
110: });
