 45: // ---- T-SRV-3: lockstep. JS port of the S02 fire() GLSL: the phase,
 46: // period, and head all hash on warp (lane >> 5) and sm (lane >> 7),
 47: // never on the lane within a warp, so every lane of a warp fires
 48: // identically at the same u and t. Also verifies the shipped shader
 49: // source hashes on warp, not on lane.
 50: function hash11(p: number): number {
 51:   p = (p * 0.1031) % 1;
 52:   p *= p + 33.33;
 53:   p *= p + p;
 54:   return p - Math.floor(p);
 55: }
 56: function fire(lane: number, u: number, t: number): number {
 57:   const warp = Math.floor(lane / 32);
 58:   const sm = Math.floor(lane / 128);
 59:   const h = hash11(warp * 17 + 3);
 60:   const period =
 61:     T.world.server.fire.periodSec[0] +
 62:     (T.world.server.fire.periodSec[1] - T.world.server.fire.periodSec[0]) * h;
 63:   const phase = (t / period + h) % 1;
 64:   const occ = phase < T.world.server.fire.dutyCycle ? 1 : 0;
 65:   const sweep =
 66:     0.5 +
 67:     0.5 * Math.sin(6.2831853 * (t / T.world.server.fire.sweepPeriodSec - (sm % 8) / 8));
 68:   const head = (t * T.world.server.fire.speedLengthsPerSec + hash11(warp + 101)) % 1;
 69:   let dd = u - head;
 70:   dd -= Math.floor(dd + 0.5);
 71:   const pulse = Math.exp(-(dd * dd) / (T.world.server.fire.sigma * T.world.server.fire.sigma));
 72:   return occ * pulse * (0.55 + 0.45 * sweep);
 73: }
