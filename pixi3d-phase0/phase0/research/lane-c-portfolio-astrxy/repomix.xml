 1: // T-ASSET-5 (feedback round W3, P-ASSET-3): no brand asset request
 2: // before the server route first lane-field frame (network log
 3: // check). Runs against the vite dev server with the real lane
 4: // field (no world=0 flag).
 5: import { test, expect } from '@playwright/test';
 6: 
 7: const DEV = process.env.ASSET_DEV_BASE || 'http://localhost:5173';
 8: 
 9: test('T-ASSET-5: no brand request before the first field frame', async ({
10:   page,
11: }) => {
12:   // Timeout alignment, not a threshold change: this test's own design
13:   // already allows up to 180s for the first frame (waitForFunction
14:   // below) plus a 120s poll for the prefetch. The Playwright default
15:   // of 30s killed the test mid poll under full gate load even though
16:   // the prefetch completes inside its own 120s deadline (diagnosed
17:   // 2026-11-01, qa/diag-asset5-result.json: 4th brand request at
18:   // 34.9s wall in an instrumented run, inside the 120s poll). Every
19:   // assertion below is unchanged. 180s covers the observed ~15s to
20:   // first frame plus the full 120s poll plus margin.
21:   test.setTimeout(180000);
22:   await page.addInitScript(() => {
23:     (window as any).__brandFirstFrameAt = null;
24:     window.addEventListener(
25:       'lanefield-ready',
26:       (ev: Event) => {
27:         const lf = (ev as CustomEvent).detail as {
28:           onFrame: (cb: () => void) => () => void;
29:         };
30:         if (!lf || typeof lf.onFrame !== 'function') return;
31:         const off = lf.onFrame(() => {
32:           (window as any).__brandFirstFrameAt = Date.now();
33:           off();
34:         });
35:       },
36:       { once: true },
37:     );
38:   });
39:   const requests: Array<{ url: string; at: number }> = [];
40:   page.on('request', (req) => {
41:     requests.push({ url: req.url(), at: Date.now() });
42:   });
43:   await page.goto(DEV + '/', { waitUntil: 'domcontentloaded' });
44:   await page.waitForFunction(
45:     () => (window as any).__brandFirstFrameAt !== null,
46:     null,
47:     { timeout: 180000 },
48:   );
49:   const firstFrameAt = await page.evaluate(
50:     () => (window as any).__brandFirstFrameAt as number,
51:   );
52:   // Poll the test-side request log until the prefetch has fired: the
53:   // manifest plus all three hero files, all after the first frame.
54:   const deadline = Date.now() + 120000;
55:   while (
56:     requests.filter((r) => r.url.includes('/brand/')).length < 4 &&
57:     Date.now() < deadline
58:   ) {
59:     await page.waitForTimeout(1000);
60:   }
61:   const brand = requests.filter((r) => r.url.includes('/brand/'));
62:   // The prefetch itself records what it fetched for this check.
63:   const prefetched: string[] = await page.evaluate(
64:     () => (window as any).__brandPrefetched ?? [],
65:   );
66:   expect(brand.length).toBeGreaterThan(0);
67:   for (const r of brand) {
68:     expect(
69:       r.at,
70:       `brand request ${r.url} must not precede the first field frame`,
71:     ).toBeGreaterThanOrEqual(firstFrameAt);
72:   }
73:   // No preload link for brand assets on the server route.
74:   const preloads = await page.evaluate(() =>
75:     [...document.querySelectorAll('link[rel="preload"]')].map((el) =>
76:       el.getAttribute('href'),
77:     ),
78:   );
79:   expect(preloads.filter((h) => h && h.includes('/brand/'))).toEqual([]);
80:   // The hero files themselves must be among the prefetched set.
81:   expect(prefetched.join(' ')).toContain('.gif');
82:   expect(prefetched.join(' ')).toContain('.png');
83:   expect(prefetched.length).toBeGreaterThanOrEqual(3);
84: });
