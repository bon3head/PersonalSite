<file path="tests/scenes/sidequests.spec.ts">
  1: // SideQuests scene receipts (S07): T-SQ-2, T-SQ-3, T-SQ-4, T-SQ-5,
  2: // T-SQ-6, plus a reduced-motion extra. Runs against the vite dev server
  3: // on port 5173 (playwright config webServer) and the scene harness page.
  4: // Chromium only; SwiftShader frames take seconds, so per-test timeout is
  5: // 180s and claim waits are generous. Twins bob continuously, so clicks
  6: // go through clickTwin: a live bounding-box read plus a coordinate
  7: // mouse click, the same trusted input without locator.click's
  8: // stability wait, which a perpetually moving target can never satisfy.
  9: import { test, expect, type Page } from '@playwright/test';
 10: import { inflateSync } from 'node:zlib';
 11: 
 12: test.setTimeout(180000);
 13: 
 14: declare global {
 15:   interface Window {
 16:     __sqtestReady?: Promise<boolean>;
 17:     __sqtest?: {
 18:       field: { now: () => number };
 19:       controller: {
 20:         resume: () => void;
 21:         walk: (i: number) => void;
 22:         claimed: (i: number) => boolean;
 23:         trailLength: (i: number) => number;
 24:         headRestY: (i: number) => number;
 25:         headY: (i: number) => number;
 26:         headBobY: (i: number) => number;
 27:       };
 28:       side: {
 29:         trails: { laneIds: number[]; arcStarts: number[]; arcLengths: number[] }[];
 30:       };
 31:       setActivityCalls: {
 32:         kind: number;
 33:         lanes: ArrayLike<number>;
 34:         starts: ArrayLike<number>;
 35:         uper: ArrayLike<number>;
 36:       }[];
 37:       drive: (t: number, dt: number) => void;
 38:     };
 39:   }
 40: }
 41: 
 42: const BASE = 'http://localhost:5173';
 43: const HARNESS = `${BASE}/tests/scenes/sidequests-harness.html`;
 44: 
 45: // ---- PNG decode (dependency-free): Chromium screenshots are 8-bit,
 46: // non-interlaced, color type 2 (RGB) or 6 (RGBA). ----
 47: function decodePng(buf: Buffer): { width: number; height: number; data: Buffer } {
 48:   if (buf.subarray(0, 8).toString('hex') !== '89504e470d0a1a0a') {
 49:     throw new Error('not a PNG');
 50:   }
 51:   let off = 8;
 52:   let width = 0;
 53:   let height = 0;
 54:   let bitDepth = 0;
 55:   let colorType = 0;
 56:   let interlace = 0;
 57:   const idats: Buffer[] = [];
 58:   while (off < buf.length) {
 59:     const len = buf.readUInt32BE(off);
 60:     const type = buf.subarray(off + 4, off + 8).toString('ascii');
 61:     const data = buf.subarray(off + 8, off + 8 + len);
 62:     if (type === 'IHDR') {
 63:       width = data.readUInt32BE(0);
 64:       height = data.readUInt32BE(4);
 65:       bitDepth = data[8];
 66:       colorType = data[9];
 67:       interlace = data[12];
 68:     } else if (type === 'IDAT') {
 69:       idats.push(Buffer.from(data));
 70:     } else if (type === 'IEND') {
 71:       break;
 72:     }
 73:     off += 12 + len;
 74:   }
 75:   if (bitDepth !== 8 || interlace !== 0 || (colorType !== 2 && colorType !== 6)) {
 76:     throw new Error(`unsupported PNG: depth ${bitDepth} type ${colorType} interlace ${interlace}`);
 77:   }
 78:   const channels = colorType === 6 ? 4 : 3;
 79:   const raw = inflateSync(Buffer.concat(idats));
 80:   const stride = width * channels;
 81:   const out = Buffer.alloc(width * height * 4);
 82:   let src = 0;
 83:   let prevRow: Buffer | null = null;
 84:   for (let y = 0; y < height; y++) {
 85:     const filter = raw[src++];
 86:     const row = raw.subarray(src, src + stride);
 87:     src += stride;
 88:     const recon = Buffer.alloc(stride);
 89:     for (let i = 0; i < stride; i++) {
 90:       const a = i >= channels ? recon[i - channels] : 0;
 91:       const b = prevRow ? prevRow[i] : 0;
 92:       const c = i >= channels && prevRow ? prevRow[i - channels] : 0;
 93:       let v = row[i];
 94:       if (filter === 1) v = (v + a) & 0xff;
 95:       else if (filter === 2) v = (v + b) & 0xff;
 96:       else if (filter === 3) v = (v + Math.floor((a + b) / 2)) & 0xff;
 97:       else if (filter === 4) {
 98:         const p = a + b - c;
 99:         const pa = Math.abs(p - a);
100:         const pb = Math.abs(p - b);
101:         const pc = Math.abs(p - c);
102:         const pr = pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
103:         v = (v + pr) & 0xff;
104:       }
105:       recon[i] = v;
106:     }
107:     prevRow = recon;
108:     for (let px = 0; px < width; px++) {
109:       const dst = (y * width + px) * 4;
110:       const srcPx = px * channels;
111:       out[dst] = recon[srcPx];
112:       out[dst + 1] = recon[srcPx + 1];
113:       out[dst + 2] = recon[srcPx + 2];
114:       out[dst + 3] = channels === 4 ? recon[srcPx + 3] : 255;
115:     }
116:   }
117:   return { width, height, data: out };
118: }
119: 
120: // ---- Color helpers ----
121: function srgbToLinear(c: number): number {
122:   const s = c / 255;
123:   return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
124: }
125: 
126: function rgbToOklab(r: number, g: number, b: number): [number, number, number] {
127:   const R = srgbToLinear(r);
128:   const G = srgbToLinear(g);
129:   const B = srgbToLinear(b);
130:   const l = 0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B;
131:   const m = 0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B;
132:   const s = 0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B;
133:   const l_ = Math.cbrt(l);
134:   const m_ = Math.cbrt(m);
135:   const s_ = Math.cbrt(s);
136:   return [
137:     0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
138:     1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
139:     0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_,
140:   ];
141: }
142: 
143: function hexToRgb(hex: string): [number, number, number] {
144:   return [
145:     parseInt(hex.slice(1, 3), 16),
146:     parseInt(hex.slice(3, 5), 16),
147:     parseInt(hex.slice(5, 7), 16),
148:   ];
149: }
150: 
151: function relativeLuminance(r: number, g: number, b: number): number {
152:   const R = srgbToLinear(r);
153:   const G = srgbToLinear(g);
154:   const B = srgbToLinear(b);
155:   return 0.2126 * R + 0.7152 * G + 0.0722 * B;
156: }
157: 
158: function parseRgb(css: string): [number, number, number] {
159:   const m = css.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
160:   if (!m) throw new Error(`unparsed color ${css}`);
161:   return [parseInt(m[1], 10), parseInt(m[2], 10), parseInt(m[3], 10)];
162: }
