<file path="tests/feedback-round/theme.spec.ts">
  1: // W6 theme tests: T-THEME-1 gradient parameters match tokens,
  2: // T-THEME-2 per-route colorfulness and edge density inside one band.
  3: import { test, expect } from '@playwright/test';
  4: import { readFileSync } from 'node:fs';
  5: import { join, dirname } from 'node:path';
  6: import { fileURLToPath } from 'node:url';
  7: import { T } from '../../src/tokens.generated';
  8: import { paramsForLayout } from '../../src/world/laneParams';
  9: import { descriptorForLayout } from '../../src/motion/hero-descriptors';
 10: 
 11: const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
 12: 
 13: // ---- T-THEME-1: per-route gradient parameters match tokens.
 14: test('T-THEME-1: per-route gradient parameters match tokens', () => {
 15:   for (const route of ['server', 'leaflink', 'sidequests'] as const) {
 16:     const params = paramsForLayout(route);
 17:     const token = T.scene[route].gradient as {
 18:       leadOklab: number[];
 19:       tailOklab: number[];
 20:       signalOklab: number[];
 21:       tailLength: number;
 22:       light: { mode: string; radius: number; gain: number };
 23:     };
 24:     expect(params.leadOklab).toEqual(token.leadOklab);
 25:     expect(params.tailOklab).toEqual(token.tailOklab);
 26:     expect(params.signalOklab).toEqual(token.signalOklab);
 27:     expect(params.tailLength).toBe(token.tailLength);
 28:     expect(params.lightMode).toBe(token.light.mode);
 29:     expect(params.lightRadius).toBe(token.light.radius);
 30:     expect(params.lightGain).toBe(token.light.gain);
 31:     const desc = descriptorForLayout(route);
 32:     if (route === 'server') {
 33:       expect(desc.kind).toBe('field');
 34:       expect(desc.ringRadius).toBe(0);
 35:       expect(desc.maskKind).toBe('none');
 36:     } else {
 37:       expect(desc.kind).toBe('mark');
 38:       expect(desc.ringRadius).toBe(token.light.radius);
 39:       expect(desc.silhouetteRadius).toBe(token.light.radius);
 40:     }
 41:     expect(desc.heroSizePx).toBe(T.hero.sizePx);
 42:   }
 43:   // Gradient stops stay in the signal, ink, field family: lead and
 44:   // tail are token stops, never a new hue introduced by W6.
 45:   expect(T.color.signal).toBe('#7BB5F8');
 46:   expect(T.color.ink).toBe('#0E3565');
 47:   expect(T.color.field.ground).toBe('#10294E');
 48: });
 49: 
 50: // ---- T-THEME-2: per-route colorfulness and edge density inside
 51: // one band. Colorfulness is mean OKLab chroma over opaque pixels;
 52: // edge density is edge pixels (opaque with a transparent
 53: // 4-neighbour) over opaque pixels. The band is a single absolute
 54: // band both marks sit inside, stated here rather than fitted per
 55: // route: colorfulness [0.08, 0.20], edge density [0, 0.06].
 56: // Measured values (printed by the test): SideQuests colorfulness
 57: // about 0.152, edge density about 0.049; LeafLink colorfulness
 58: // about 0.109, edge density about 0.013. Both inside both bands.
 59: test('T-THEME-2: per-route colorfulness and edge density inside one band', async () => {
 60:   const { execFileSync } = await import('node:child_process');
 61:   const manifest = JSON.parse(
 62:     readFileSync(join(ROOT, 'public', 'brand', 'manifest.json'), 'utf8'),
 63:   ) as {
 64:     heroes: {
 65:       sidequests: { frame0: { file: string } };
 66:       leaflink: { png: { file: string } };
 67:     };
 68:   };
 69:   const script = `
 70: import sys, json
 71: import numpy as np
 72: from PIL import Image
 73: def chroma(rgb):
 74:     def lin(c):
 75:         v = c / 255.0
 76:         return np.where(v <= 0.04045, v / 12.92, ((v + 0.055) / 1.055) ** 2.4)
 77:     r = lin(rgb[:, :, 0].astype(np.float64))
 78:     g = lin(rgb[:, :, 1].astype(np.float64))
 79:     b = lin(rgb[:, :, 2].astype(np.float64))
 80:     l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
 81:     m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
 82:     s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
 83:     l3 = np.cbrt(l); m3 = np.cbrt(m); s3 = np.cbrt(s)
 84:     a = 1.9779984951 * l3 - 2.4285922050 * m3 + 0.4505937099 * s3
 85:     bb = 0.0259040371 * l3 + 0.7827717662 * m3 - 0.8086757660 * s3
 86:     return np.sqrt(a * a + bb * bb)
 87: out = {}
 88: for path in sys.argv[1:]:
 89:     a = np.asarray(Image.open(path).convert("RGBA"))
 90:     alpha = a[:, :, 3] > 0
 91:     trans = a[:, :, 3] == 0
 92:     neigh = np.zeros_like(trans)
 93:     neigh[1:, :] |= trans[:-1, :]
 94:     neigh[:-1, :] |= trans[1:, :]
 95:     neigh[:, 1:] |= trans[:, :-1]
 96:     neigh[:, :-1] |= trans[:, 1:]
 97:     edge = int((alpha & neigh).sum())
 98:     out[path] = {
 99:         "colorfulness": float(chroma(a[:, :, :3])[alpha].mean()),
100:         "edgeDensity": edge / int(alpha.sum()),
101:     }
102: print(json.dumps(out))
103: `;
104:   const paths = [
105:     join(ROOT, 'public', 'brand', manifest.heroes.sidequests.frame0.file),
106:     join(ROOT, 'public', 'brand', manifest.heroes.leaflink.png.file),
107:   ];
108:   const scores = JSON.parse(
109:     execFileSync('python3', ['-c', script, ...paths], {
110:       encoding: 'utf8',
111:       timeout: 300000,
112:     }),
113:   ) as Record<string, { colorfulness: number; edgeDensity: number }>;
114:   for (const path of paths) {
115:     const s = scores[path];
116:     console.log(`T-THEME-2 ${path}: colorfulness=${s.colorfulness.toFixed(4)} edgeDensity=${s.edgeDensity.toFixed(4)}`);
117:     expect(s.colorfulness).toBeGreaterThanOrEqual(0.08);
118:     expect(s.colorfulness).toBeLessThanOrEqual(0.2);
119:     expect(s.edgeDensity).toBeGreaterThanOrEqual(0);
120:     expect(s.edgeDensity).toBeLessThanOrEqual(0.06);
121:   }
122: });
