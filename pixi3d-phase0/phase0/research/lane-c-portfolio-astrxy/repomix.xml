1064:   // Worker: generate layouts off the main thread.
1065:   let resolveReady!: () => void;
1066:   let rejectReady!: (err: Error) => void;
1067:   const ready = new Promise<void>((resolve, reject) => {
1068:     resolveReady = resolve;
1069:     rejectReady = reject;
1070:   });
1071:   let worker: Worker | null = null;
1072:   try {
1073:     worker = new Worker(new URL('./worker.ts', import.meta.url), { type: 'module' });
1074:   } catch (err) {
1075:     failed = true;
1076:     console.error('[lanefield] layout failed', err);
1077:     rejectReady(err instanceof Error ? err : new Error(String(err)));
1078:   }
1079:   if (worker) {
1080:     worker.onmessage = (e: MessageEvent) => {
1081:       const data = e.data as { layouts?: Float32Array; side?: unknown; error?: string };
1082:       if (data.error || !data.layouts) {
1083:         failed = true;
1084:         console.error('[lanefield] layout failed', data.error ?? 'no layouts');
1085:         rejectReady(new Error(data.error ?? 'no layouts'));
1086:         return;
1087:       }
1088:       const received = data.layouts;
1089:       const expected = texSpec.width * texSpec.height * TEXEL_FLOATS;
1090:       if (received.length !== expected) {
1091:         failed = true;
1092:         console.error('[lanefield] layout failed', `length ${received.length} expected ${expected}`);
1093:         rejectReady(new Error('layout length mismatch'));
1094:         return;
1095:       }
1096:       (layoutTex.image as { data: Float32Array }).data = received;
1097:       layoutTex.needsUpdate = true;
1098:       void (async () => {
1099:         const digest = await crypto.subtle.digest('SHA-256', received as BufferSource);
1100:         const bytes = new Uint8Array(digest);
1101:         let hex = '';
1102:         for (const b of bytes) hex += b.toString(16).padStart(2, '0'); // lit-ok: hex radix
1103:         layoutHash = hex;
1104:         debugHandle.setLayoutHash(hex);
1105:         await renderer.compileAsync(scene, camera);
1106:         renderOnce();
1107:         debugHandle.setReady(true);
1108:         resolveReady();
1109:         startLoop();
1110:       })();
1111:     };
1112:     worker.onerror = (e: ErrorEvent) => {
1113:       failed = true;
1114:       console.error('[lanefield] layout failed', e.message);
1115:       rejectReady(new Error(e.message));
1116:     };
1117:     worker.postMessage({ seed: opts.seed });
1118:   }
