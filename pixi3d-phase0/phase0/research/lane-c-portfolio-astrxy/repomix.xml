144: const clamp01 = (x: number): number => Math.min(1, Math.max(0, x));
145: const windowRaw = (p: number, w: readonly [number, number]): number =>
146:   clamp01((p - w[0]) / (w[1] - w[0]));
147: const windowEased = (p: number, w: readonly [number, number]): number =>
148:   easeSignature(windowRaw(p, w));
149: const trackEase = cubicBezier(...T.curve.track);
150: const mix = (a: number, b: number, t: number): number => a + (b - a) * t;
151: 
152: function restSnapshot(layout: LayoutId): MorphSnapshot {
153:   const d = descriptorForLayout(layout);
154:   return {
155:     center: [...d.anchor],
156:     silhouetteCenter: [...d.silhouetteCenter],
157:     ringRadius: 0,
158:     ringStrength: 0,
159:     silhouetteRadius: 0,
160:     silhouetteStrength: 0,
161:   };
162: }
