 97: interface GbDebug {
 98:   phase: string;
 99:   dolly: number;
100:   signSeed: number | null;
101:   letters: { lane: number }[];
102: }
103: 
104: async function engineFlow(page: Page): Promise<{ rest: number; open: number; settled: number; letters: number; dbg: GbDebug }> {
105:   await page.goto(PREVIEW + '/', { waitUntil: 'domcontentloaded' });
106:   await page.waitForFunction(() => window.__lanefield?.ready, null, { timeout: 120000 });
107:   // Camera to well distance, read after two more frames have rendered
108:   // (SwiftShader frames take seconds; the engine applies the camera on
109:   // the next frame).
110:   const dist = async (): Promise<number> => {
111:     // Reduced motion runs no loop: the engine renders once per change.
112:     const still = await page.evaluate(() => matchMedia('(prefers-reduced-motion: reduce)').matches);
113:     if (still) {
114:       await page.waitForTimeout(1000);
115:     } else {
116:       const n0 = await page.evaluate(() => window.__lanefield!.frameStats().count);
117:       await page.waitForFunction((n) => window.__lanefield!.frameStats().count >= n + 2, n0, { timeout: 120000 });
118:     }
119:     return page.evaluate(() => {
120:       const p = window.__lanefield!.cameraPose().pos;
121:       const g = (window as unknown as { __guestbook?: { well: number[] | null } }).__guestbook;
122:       const w = g?.well ?? window.__lanefield!.cameraPose().target;
123:       return Math.hypot(p[0] - w[0], p[1] - w[1], p[2] - w[2]);
124:     });
125:   };
126:   const rest = await dist();
127:   await openFromContact(page);
128:   await page.waitForFunction(() => (window as unknown as { __guestbook?: GbDebug }).__guestbook?.phase === 'open', null, { timeout: 60000 });
129:   await page.waitForTimeout(1000);
130:   const open = await dist();
131:   await page.keyboard.type('Ada L');
132:   await page.waitForTimeout(3000);
133:   const letters = await page.evaluate(
134:     () => (window as unknown as { __guestbook: GbDebug }).__guestbook.letters.filter((l) => l.lane >= 0).length,
135:   );
136:   await page.keyboard.press('Enter');
137:   await page.keyboard.press('Enter');
138:   await page.waitForSelector('.jp-gb-done', { timeout: 60000 });
139:   const settled = await dist();
