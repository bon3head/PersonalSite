  43: // GLSL hash11 port (lane.vert.glsl), for the lane length scale.
  44: function hash11(p: number): number {
  45:   let q = p * 0.1031; // lit-ok: shader hash constant
  46:   q -= Math.floor(q);
  47:   q *= q + 33.33; // lit-ok: shader hash constant
  48:   q *= q + q;
  49:   return q - Math.floor(q);
  50: }
