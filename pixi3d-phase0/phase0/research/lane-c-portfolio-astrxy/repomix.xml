 41: const MS = 'ms';
 42: 
 43: function percentile(sorted: number[], q: number): number {
 44:   if (sorted.length === 0) return 0;
 45:   const idx = Math.min(sorted.length - 1, Math.floor(q * sorted.length));
 46:   return sorted[idx];
 47: }
 48: 
 49: function fmt(n: number, digits: number): string {
 50:   return n.toFixed(digits);
 51: }
 52: 
 53: export function mountDevHud(): void {
 54:   if (document.getElementById('jp-dev-hud')) return;
 55:   const el = document.createElement('div');
 56:   el.id = 'jp-dev-hud';
 57:   el.setAttribute('data-dev-hud', '1');
 58:   el.style.position = 'fixed';
 59:   el.style.top = '0';
 60:   el.style.right = '0';
 61:   el.style.zIndex = '9999';
 62:   el.style.fontFamily = 'Commit Mono, monospace';
 63:   el.style.fontSize = '12px';
 64:   el.style.color = T.color.chalk;
 65:   el.style.background = T.color.void.ground;
 66:   el.style.padding = '4px 8px';
 67:   el.style.whiteSpace = 'pre';
 68:   el.style.textAlign = 'left';
 69:   document.body.appendChild(el);
 70: 
 71:   const ring = new Float64Array(RING_SIZE);
 72:   let ringCount = 0;
 73:   let ringHead = 0;
 74:   let lastMs: number | null = null;
 75: 
 76:   const frame = (nowMs: number): void => {
 77:     if (lastMs !== null) {
 78:       const dt = nowMs - lastMs;
 79:       ring[ringHead] = dt;
 80:       ringHead = (ringHead + 1) % RING_SIZE;
 81:       if (ringCount < RING_SIZE) ringCount += 1;
 82:     }
 83:     lastMs = nowMs;
 84:     const sorted = Array.from(ring.slice(0, ringCount)).sort((a, b) => a - b);
 85:     const hudP95 = percentile(sorted, 0.95);
 86:     const hudP99 = percentile(sorted, 0.99);
 87: 
 88:     const lf = window.__lanefield;
 89:     const morph = window.__morph;
 90:     if (!lf) {
 91:       el.textContent = 'jp-dev-hud\nwaiting for lanefield';
 92:       requestAnimationFrame(frame);
 93:       return;
 94:     }
 95:     const cam = lf.camera;
 96:     const info = lf.info();
 97:     const stats = lf.frameStats();
 98:     const sample = morph ? morph.sample : null;
 99:     let morphLine = 'morph: none';
100:     let heroLine = 'hero: none';
101:     if (sample) {
102:       const phase = sample.done
103:         ? 'rest'
104:         : sample.gather >= 1
105:           ? 'Reveal'
106:           : sample.gather > 0
107:             ? 'Gather'
108:             : 'Release';
109:       morphLine =
110:         'morph: ' + sample.from + ' -> ' + sample.to +
111:         ' p=' + fmt(sample.p, 2) +
112:         ' phase=' + phase +
113:         ' done=' + String(sample.done) +
114:         ' release=' + fmt(sample.release, 2) +
115:         ' gather=' + fmt(sample.gather, 2) +
116:         ' reveal=' + fmt(sample.reveal, 2);
117:       const desc = descriptorForLayout(sample.to);
118:       heroLine =
119:         'hero: ' + desc.layout + ' ' + desc.kind +
120:         ' anchor=[' + fmt(desc.anchor[0], 2) + ',' + fmt(desc.anchor[1], 2) + ']' +
121:         ' ring=' + fmt(desc.ringRadius, 2);
122:     } else if (morph) {
123:       // At rest no sample exists yet: the morph hook still carries
124:       // the current route in from/to, so report rest plus that
125:       // route descriptor instead of an empty panel.
126:       morphLine = 'morph: ' + morph.from + ' -> ' + morph.to + ' p=1.00 phase=rest done=true';
127:       const desc = descriptorForLayout(morph.to);
128:       heroLine =
129:         'hero: ' + desc.layout + ' ' + desc.kind +
130:         ' anchor=[' + fmt(desc.anchor[0], 2) + ',' + fmt(desc.anchor[1], 2) + ']' +
131:         ' ring=' + fmt(desc.ringRadius, 2);
132:     }
133:     const deg = morph ? morph.degradeState() : null;
134:     const degLine = deg
135:       ? 'degrade: ' + String(deg.degraded) +
136:         ' over=' + String(deg.consecutiveOverBudget) +
137:         ' longTask=' + String(deg.longTaskFrames) +
138:         ' max=' + fmt(deg.maxFrameMs, 1) + MS
139:       : 'degrade: unknown';
140:     el.textContent =
141:       'jp-dev-hud\n' +
142:       'laneCount: ' + String(lf.laneCount) + '\n' +
143:       'calls: ' + String(info.calls) + '\n' +
144:       'pitchDeg: ' + fmt(cam.pitchDeg, 2) + '\n' +
145:       'yawDeg: ' + fmt(cam.yawDeg, 2) + '\n' +
146:       'distance: ' + (cam.distance === null ? 'null' : fmt(cam.distance, 2)) + '\n' +
147:       morphLine + '\n' +
148:       heroLine + '\n' +
149:       'frameP95gov: ' + fmt(stats.p95, 1) + MS +
150:       ' frameP95hud: ' + fmt(hudP95, 1) + MS +
151:       ' frameP99hud: ' + fmt(hudP99, 1) + MS +
152:       ' frames: ' + String(stats.count) + '\n' +
153:       degLine;
154:     requestAnimationFrame(frame);
155:   };
156:   requestAnimationFrame(frame);
157: }
</file>

<file path="src/hero/brandGates.ts">
 1: // P-HERO-2 gate helpers: the brand-mark exclusion, the fingerprint
 2: // check, and the area cap, as pure functions the gate tests import.
 3: // They do not lower any existing gate: the hue budget thresholds
 4: // (hueBudgetPct) are unchanged, and the exclusion removes the mark
 5: // rectangle from both the numerator and the denominator of a hue
 6: // fraction, so the budget over the rest of the page is exactly the
 7: // budget that ran before heroes existed.
 8: //
 9: // Fingerprint check (DESIGN section 3.5): every non-transparent
10: // pixel color of a mark must sit within brand.fingerprintDeltaE of
11: // a color in that asset's manifest fingerprint. DeltaE here is the
12: // CIE76 distance in CIE Lab. The shipped marks measure DeltaE 0:
13: // every unique pixel color of both marks is exactly a fingerprint
14: // color (verified in the W6 gate run), so the token 3 has full
15: // headroom and the check is not tuned to pass.
16: export interface GateRect {
17:   left: number;
18:   top: number;
19:   right: number;
20:   bottom: number;
21: }
22: 
23: export function pixelInRect(x: number, y: number, rect: GateRect): boolean {
24:   return x >= rect.left && x < rect.right && y >= rect.top && y < rect.bottom;
25: }
26: 
27: // sRGB channel to CIE Lab, via linear sRGB and XYZ (D65).
28: export function rgbToLab(r: number, g: number, b: number): [number, number, number] {
29:   const lin = (c: number): number => {
30:     const v = c / 255;
31:     return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
32:   };
33:   const R = lin(r);
34:   const G = lin(g);
35:   const B = lin(b);
36:   const x = (0.4124 * R + 0.3576 * G + 0.1805 * B) / 0.95047;
37:   const y = (0.2126 * R + 0.7152 * G + 0.0722 * B) / 1.0;
38:   const z = (0.0193 * R + 0.1192 * G + 0.9505 * B) / 1.08883;
39:   const f = (t: number): number =>
40:     t > 0.008856 ? Math.cbrt(t) : 7.787 * t + 16 / 116;
41:   const fx = f(x);
42:   const fy = f(y);
43:   const fz = f(z);
44:   return [116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)];
45: }
46: 
47: export function deltaE76(a: [number, number, number], b: [number, number, number]): number {
48:   return Math.sqrt((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2);
49: }
50: 
51: export function hexToRgb(hex: string): [number, number, number] {
52:   return [
53:     parseInt(hex.slice(1, 3), 16),
54:     parseInt(hex.slice(3, 5), 16),
55:     parseInt(hex.slice(5, 7), 16),
56:   ];
57: }
58: 
59: // Largest DeltaE from any unique pixel color to its nearest
60: // fingerprint color. Callers pass unique colors only: the shipped
61: // marks have at most a few hundred, so this stays cheap.
62: export function fingerprintMaxDeltaE(
63:   uniqueRgb: Array<[number, number, number]>,
64:   fingerprintHex: string[],
65: ): number {
66:   const fpLab = fingerprintHex.map((h) => rgbToLab(...hexToRgb(h)));
67:   let worst = 0;
68:   for (const rgb of uniqueRgb) {
69:     const lab = rgbToLab(...rgb);
70:     let best = Infinity;
71:     for (const f of fpLab) {
72:       const d = deltaE76(lab, f);
73:       if (d < best) best = d;
74:     }
75:     if (best > worst) worst = best;
76:   }
77:   return worst;
78: }
79: 
80: // Area cap: the displayed rectangle may cover at most
81: // brand.areaCap of the viewport.
82: export function areaRatio(rect: { width: number; height: number }, vw: number, vh: number): number {
83:   return (rect.width * rect.height) / (vw * vh);
84: }
</file>

