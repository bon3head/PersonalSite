1425:         gbCam = c ? { ...c, center: [...c.center], shift: [...c.shift] } : null;
1426:       },
1427:       setPart(p: GuestbookPart | null): void {
1428:         if (!p) {
1429:           (uniforms.uGbRadius.value as number) = 0;
1430:           (uniforms.uGbPart.value as THREE.Vector3).set(0, 0, 0);
1431:           return;
1432:         }
1433:         (uniforms.uGbCenter.value as THREE.Vector2).set(p.center[0], p.center[1]);
1434:         (uniforms.uGbRadius.value as number) = p.radius;
1435:         (uniforms.uGbPush.value as number) = p.push;
1436:         (uniforms.uGbDepth.value as number) = p.depth;
1437:         (uniforms.uGbSeed.value as number) = p.seedUnit * SEC_TO_MS;
1438:         (uniforms.uGbPart.value as THREE.Vector3).set(p.bands[0], p.bands[1], p.bands[2]);
1439:       },
1440:       writeLanes(lanes: readonly number[], offsets: Float32Array): void {
1441:         const keep = new Set(lanes);
1442:         for (const lane of gbWritten) {
1443:           if (keep.has(lane)) continue;
1444:           gbData.fill(0, lane * TEXEL_FLOATS, lane * TEXEL_FLOATS + TEXEL_FLOATS);
1445:         }
1446:         gbWritten.clear();
1447:         for (let j = 0; j < lanes.length; j++) {
1448:           wordWritten.delete(lanes[j]);
1449:           const base = lanes[j] * TEXEL_FLOATS;
1450:           gbData[base] = offsets[j * 3];
1451:           gbData[base + 1] = offsets[j * 3 + 1];
1452:           gbData[base + 2] = offsets[j * 3 + 2]; // lit-ok: z component
1453:           gbData[base + 3] = 1; // lit-ok: alpha channel index
1454:           gbWritten.add(lanes[j]);
1455:         }
1456:         gbTex.needsUpdate = true;
1457:       },
1458:       laneTip(lane: number, out: [number, number, number]): [number, number, number] {
1459:         const tipK = T.world.segmentsPerLane;
1460:         let sx = 0;
1461:         let sy = 0;
1462:         let sz = 0;
1463:         let tx = 0;
1464:         let ty = 0;
1465:         let tz = 0;
1466:         for (let l = 0; l < LAYOUT_ORDER.length; l++) {
1467:           const w = weights[l];
1468:           if (w <= 0) continue;
1469:           const s0 = (lane * LANE_STRIDE + l * POINTS_PER_LAYOUT) * TEXEL_FLOATS;
1470:           const s1 = s0 + tipK * TEXEL_FLOATS;
1471:           sx += w * layoutData[s0];
1472:           sy += w * layoutData[s0 + 1];
1473:           sz += w * layoutData[s0 + 2];
1474:           tx += w * layoutData[s1];
1475:           ty += w * layoutData[s1 + 1];
1476:           tz += w * layoutData[s1 + 2];
1477:         }
1478:         const len = 1 + (hash11(lane * 0.013 + 7) - 0.5) * 2 * variance.lengthVariance; // lit-ok: shader lenScale constants
1479:         out[0] = sx + (tx - sx) * len;
1480:         out[1] = sy + (ty - sy) * len;
1481:         out[2] = sz + (tz - sz) * len;
1482:         return out;
1483:       },
1484:       nearestLane(x: number, z: number, exclude: ReadonlySet<number>): number {
1485:         const tip: [number, number, number] = [0, 0, 0];
1486:         let best = -1;
1487:         let bestD = Infinity;
1488:         for (let lane = 0; lane < T.world.laneCount; lane++) {
1489:           if (exclude.has(lane)) continue;
1490:           field.guestbook.laneTip(lane, tip);
1491:           const d = (tip[0] - x) * (tip[0] - x) + (tip[2] - z) * (tip[2] - z);
1492:           if (d < bestD) {
1493:             bestD = d;
1494:             best = lane;
1495:           }
1496:         }
1497:         return best;
1498:       },
1499:       restFrame(): GuestbookFrame {
1500:         const p = basePose;
1501:         const dx = p.pos[0] - p.target[0];
1502:         const dy = p.pos[1] - p.target[1];
1503:         const dz = p.pos[2] - p.target[2];
1504:         const flat = Math.hypot(dx, dz) || 1;
1505:         return {
1506:           pos: [p.pos[0], p.pos[1], p.pos[2]],
1507:           target: [p.target[0], p.target[1], p.target[2]],
1508:           distance: Math.hypot(dx, dy, dz),
1509:           // Ground directions as seen from the camera.
1510:           forward: [-dx / flat, -dz / flat],
1511:           right: [dz / flat, -dx / flat],
1512:         };
1513:       },
1514:       setDim(box: [number, number, number, number] | null, amount: number): void {
1515:         if (!box || amount <= 0) {
1516:           (uniforms.uGbDim.value as number) = 0;
1517:           return;
1518:         }
1519:         const pad = T.guestbook.dim.padPx;
1520:         const d = currentDpr;
1521:         (uniforms.uGbDimBox.value as THREE.Vector4).set(
1522:           (box[0] - pad) * d,
1523:           (cssH - box[3] - pad) * d,
1524:           (box[2] + pad) * d,
1525:           (cssH - box[1] + pad) * d,
1526:         );
1527:         (uniforms.uGbDimFeather.value as number) = T.guestbook.dim.featherPx * d;
1528:         (uniforms.uGbDim.value as number) = Math.min(1, amount) * T.guestbook.dim.amount;
1529:       },
1530:       render(): void {
1531:         if (!loopRunning && !disposed && !failed) renderOnce();
1532:       },
1533:       reduced(): boolean {
1534:         return reduced;
1535:       },
1536:     },
1537:     words: {
1538:       writeLanes(lanes: readonly number[], offsets: Float32Array, slots: readonly number[]): void {
1539:         const keep = new Set(lanes);
1540:         for (const lane of wordWritten) {
1541:           if (keep.has(lane) || gbWritten.has(lane)) continue;
1542:           gbData.fill(0, lane * TEXEL_FLOATS, lane * TEXEL_FLOATS + TEXEL_FLOATS);
1543:         }
1544:         wordWritten.clear();
1545:         for (let j = 0; j < lanes.length; j++) {
1546:           if (gbWritten.has(lanes[j])) continue;
1547:           const base = lanes[j] * TEXEL_FLOATS;
1548:           gbData[base] = offsets[j * 3];
1549:           gbData[base + 1] = offsets[j * 3 + 1];
1550:           gbData[base + 2] = offsets[j * 3 + 2]; // lit-ok: z component
1551:           gbData[base + 3] = WORD_ALPHA_BASE + slots[j]; // lit-ok: alpha channel index
1552:           wordWritten.add(lanes[j]);
1553:         }
1554:         gbTex.needsUpdate = true;
1555:       },
1556:       setTint(slot: number, rgb: readonly [number, number, number], opacity: number): void {
1557:         const v = wordTint[slot];
1558:         if (!v) return;
1559:         v.set(rgb[0], rgb[1], rgb[2], opacity);
1560:       },
1561:       held(lane: number): boolean {
1562:         return gbWritten.has(lane);
1563:       },
1564:       texel(lane: number): [number, number, number, number] {
1565:         const b = lane * TEXEL_FLOATS;
1566:         return [gbData[b], gbData[b + 1], gbData[b + 2], gbData[b + 3]]; // lit-ok: texel channels
1567:       },
1568:     },
1569:     scene,
1570:     camera,
1571:     dispose(): void {
1572:       if (disposed) return;
1573:       disposed = true;
1574:       stopLoop();
1575:       window.removeEventListener('resize', onResize);
1576:       window.removeEventListener('pointermove', onPointerMove);
1577:       window.removeEventListener('pageshow', onPageShow);
1578:       document.removeEventListener('visibilitychange', onVisibility);
1579:       canvas.removeEventListener('webglcontextlost', onContextLost);
1580:       if (worker) worker.terminate();
1581:       geometry.dispose();
1582:       material.dispose();
1583:       layoutTex.dispose();
1584:       activityTex.dispose();
1585:       gbTex.dispose();
1586:       for (const tex of maskCache.values()) tex.dispose();
1587:       maskCache.clear();
1588:       placeholderTex.dispose();
1589:       renderer.dispose();
1590:       canvas.remove();
1591:       if (window.__lanefield === debugHandle.debug) delete window.__lanefield;
1592:     },
