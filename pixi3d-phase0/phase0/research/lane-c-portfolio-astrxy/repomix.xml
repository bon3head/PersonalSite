428:     if (readoutCb) {
429:       let hex: string;
430:       if (signSeed === null) {
431:         hex = reduced() ? hex8(openSeed) : hex8(hash32(openSeed, P.readout, step));
432:       } else {
433:         const final = hex8(signSeed);
434:         const roll = hex8(hash32(signSeed, P.readout, step));
435:         const k = reduced() ? 8 : Math.floor(Math.max(0, Math.min(1, (t - lockStart) / g.ms.lockIn)) * 8);
436:         hex = final.slice(0, k) + roll.slice(k);
