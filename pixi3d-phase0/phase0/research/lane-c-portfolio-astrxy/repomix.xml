<file path="tests/world-harness.html">
 1: <!doctype html>
 2: <html>
 3: <head><meta charset="utf-8"><title>B2 engine harness</title></head>
 4: <body>
 5: <div id="world"></div>
 6: <script type="module">
 7: import { createLanefield } from '/src/world/lanefield.ts';
 8: import { T } from '/src/tokens.generated.ts';
 9: 
10: // Longtask entries are recorded before the field is created so T-S02-8
11: // can check that no task during startup reached the 50ms longtask floor.
12: const longtasks = [];
13: try {
14:   const obs = new PerformanceObserver((list) => {
15:     for (const e of list.getEntries()) {
16:       longtasks.push({ name: e.name, duration: e.duration, startTime: e.startTime });
17:     }
18:   });
19:   obs.observe({ entryTypes: ['longtask'] });
20: } catch (e) {
21:   // Longtask observer unsupported in this browser; test notes it.
22: }
23: 
24: const weightSums = [];
25: const params = new URLSearchParams(window.location.search);
26: const field = createLanefield(document.getElementById('world'), {
27:   seed: T.world.seed,
28:   reducedMotion: params.get('reduced') === '1',
29:   initial: params.get('initial') || 'server',
30: });
31: if (field) {
32:   field.onFrame(() => {
33:     const w = window.__lanefield.weights();
34:     weightSums.push(w[0] + w[1] + w[2] + w[3]);
35:     if (weightSums.length > 20000) weightSums.splice(0, weightSums.length - 20000);
36:   });
37: }
38: window.__test = { field, longtasks, weightSums, T };
39: window.__testReady = field
40:   ? field.ready.then(() => true).catch((e) => {
41:       window.__testError = String(e);
42:       return false;
43:     })
44:   : Promise.resolve(false);
45: </script>
46: </body>
47: </html>
</file>

