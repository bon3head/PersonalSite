  1: // Debug view (S02 debug chapter) on window.__lanefield, plus the ?perf HUD
  2: // and perf dump frame JSON download (S02 governor chapter).
  3: import { T } from '../tokens.generated';
  4: import type { LanefieldDebug, SilhouetteMaskKind } from './types';
  5: import type { Pose } from './camera';
  6: 
  7: export interface DebugDeps {
  8:   laneCount: number;
  9:   getLayoutHash: () => string;
 10:   getWeights: () => number[];
 11:   getCameraPose: () => Pose;
 12:   // Rendered camera world matrix elements (column-major),
 13:   // refreshed from the rendered camera on every access.
 14:   getCameraMatrix: () => readonly number[];
 15:   getInfo: () => { calls: number; triangles: number; textures: number; geometries: number; programs: number };
 16:   getFrameStats: () => { p50: number; p90: number; p95: number; count: number };
 17:   getDpr: () => number;
 18:   getMemoryEstimate: () => number;
 19:   getRecentFrames: () => number[];
 20:   isRingFull: () => boolean;
 21:   getSilhouette?: () => { kind: SilhouetteMaskKind; loaded: SilhouetteMaskKind; width: number; height: number };
 22: }
 23: 
 24: export interface DebugHandle {
 25:   debug: LanefieldDebug;
 26:   setLayoutHash: (hash: string) => void;
 27:   setReady: (ready: boolean) => void;
 28:   updateHud: () => void;
 29: }
 30: 
 31: export function createDebugView(deps: DebugDeps): DebugHandle {
 32:   const debug: LanefieldDebug = {
 33:     laneCount: deps.laneCount,
 34:     layoutHash: '',
 35:     weights: () => [...deps.getWeights()],
 36:     cameraPose: () => {
 37:       const p = deps.getCameraPose();
 38:       return { pos: [...p.pos], target: [...p.target], fov: p.fov, shift: [...p.shift] };
 39:     },
 40:     // Read-only rendered-camera snapshot. Forward is the camera local -Z
 41:     // axis in world space: the negated third column of the world
 42:     // matrix. This sees the walk lean override, which writes the
 43:     // camera directly after the rig pose is applied.
 44:     get camera() {
 45:       const e = deps.getCameraMatrix();
 46:       const pos: [number, number, number] = [e[12], e[13], e[14]]; // lit-ok: matrixWorld translation column
 47:       const fx = -e[8]; // lit-ok: matrixWorld third column, negated to forward
 48:       const fy = -e[9]; // lit-ok: matrixWorld third column, negated to forward
 49:       const fz = -e[10]; // lit-ok: matrixWorld third column, negated to forward
 50:       const fl = Math.sqrt(fx * fx + fy * fy + fz * fz); // lit-ok: vector length
 51:       const forward: [number, number, number] = [fx / fl, fy / fl, fz / fl];
 52:       const radToDeg = 180 / Math.PI; // lit-ok: radians to degrees conversion
 53:       const pitchDeg = Math.asin(Math.max(-1, Math.min(1, forward[1]))) * radToDeg; // lit-ok: pitch clamp to asin domain
 54:       const yawDeg = Math.atan2(forward[0], forward[2]) * radToDeg; // lit-ok: yaw from forward x/z
 55:       let distance: number | null = null;
 56:       let groundTarget: [number, number] | null = null;
 57:       if (forward[1] < 0) {
 58:         distance = -pos[1] / forward[1];
 59:         groundTarget = [pos[0] + forward[0] * distance, pos[2] + forward[2] * distance];
 60:       }
 61:       return {
 62:         pos,
 63:         forward,
 64:         pitchDeg,
 65:         yawDeg,
 66:         distance,
 67:         groundTarget,
 68:         projection: 'perspective' as const,
 69:         fovDeg: deps.getCameraPose().fov,
 70:       };
 71:     },
 72:     info: () => deps.getInfo(),
 73:     ...(deps.getSilhouette ? { silhouette: deps.getSilhouette } : {}),
 74:     frameStats: () => deps.getFrameStats(),
 75:     dpr: () => deps.getDpr(),
 76:     memoryEstimate: () => deps.getMemoryEstimate(),
 77:     ready: false,
 78:   };
 79:   window.__lanefield = debug;
 80: 
 81:   const params = new URLSearchParams(window.location.search);
 82:   const perf = params.get('perf') === '1';
 83:   const dump = params.get('dump') === '1';
 84:   let hud: HTMLElement | null = null;
 85:   let dumped = false;
 86:   if (perf) {
 87:     hud = document.createElement('div');
 88:     hud.style.position = 'fixed';
 89:     hud.style.top = '0';
 90:     hud.style.right = '0';
 91:     hud.style.zIndex = '9999';
 92:     hud.style.fontFamily = 'monospace';
 93:     hud.style.fontSize = '12px';
 94:     hud.style.color = T.color.chalk;
 95:     hud.style.background = T.color.void.ground;
 96:     hud.style.padding = '4px 8px';
 97:     hud.style.whiteSpace = 'pre';
 98:     document.body.appendChild(hud);
 99:   }
100: 
101:   return {
102:     debug,
103:     setLayoutHash(hash: string) {
104:       debug.layoutHash = hash;
105:     },
106:     setReady(ready: boolean) {
107:       debug.ready = ready;
108:     },
109:     updateHud() {
110:       if (hud) {
111:         const s = deps.getFrameStats();
112:         const info = deps.getInfo();
113:         const fps = s.p50 > 0 ? 1000 / s.p50 : 0; // lit-ok: ms to fps
114:         hud.textContent =
115:           `fps ${fps.toFixed(0)} p90 ${s.p90.toFixed(1)}ms dpr ${deps.getDpr().toFixed(2)} calls ${info.calls}`;
116:       }
117:       if (dump && !dumped && deps.isRingFull()) {
118:         dumped = true;
119:         const blob = new Blob([JSON.stringify(deps.getRecentFrames())], { type: 'application/json' });
120:         const url = URL.createObjectURL(blob);
121:         const a = document.createElement('a');
122:         a.href = url;
123:         a.download = 'lanefield-frames.json';
124:         a.click();
125:         URL.revokeObjectURL(url);
126:       }
127:     },
128:   };
129: }
</file>

<file path="src/world/deflection.ts">
 1: // P-LF-4a deflection ring: pure geometry, shared by the vertex shader
 2: // (GLSL mirror below the same formula) and the unit test. A lane point
 3: // at distance d from the ring center, inside radius r, is pushed
 4: // radially outward by strength * (1 - (d / r)^2)^2. The falloff and its
 5: // first derivative are both zero at d = r, and both zero outside, so
 6: // the deflection is continuous with a continuous first derivative
 7: // across the ring boundary. There are no per-lane start delays: every
 8: // lane reads the same ring uniforms at the same frame.
 9: export function ringFalloff(d: number, radius: number): number {
10:   if (radius <= 0 || d >= radius) return 0;
11:   if (d <= 0) return 1;
12:   const x = d / radius;
13:   const f = 1 - x * x;
14:   return f * f;
15: }
16: 
17: // Analytic derivative of ringFalloff with respect to d. Inside the
18: // ring: -4 * d / r^2 * (1 - (d / r)^2). At d = r that is zero, matching // lit-ok:
19: // the zero derivative outside, which is the C1 continuity condition.
20: export function ringFalloffDerivative(d: number, radius: number): number {
21:   if (radius <= 0 || d >= radius || d <= 0) return 0;
22:   const x = d / radius;
23:   return (-4 * d) / (radius * radius) * (1 - x * x); // lit-ok:
24: }
25: 
26: // swirl (polish round, uRingSwirl in the shader) adds a tangential
27: // share on the same falloff, so the swirled push is still C1 across the
28: // boundary and zero outside the ring.
29: export function deflectPoint(
30:   x: number,
31:   z: number,
32:   centerX: number,
33:   centerZ: number,
34:   radius: number,
35:   strength: number,
36:   swirl = 0,
37: ): [number, number] {
38:   if (radius <= 0 || strength === 0) return [x, z];
39:   const dx = x - centerX;
40:   const dz = z - centerZ;
41:   const d = Math.sqrt(dx * dx + dz * dz);
42:   if (d < 1e-9 || d >= radius) return [x, z]; // lit-ok:
43:   const mag = strength * ringFalloff(d, radius);
44:   const ux = dx / d;
45:   const uz = dz / d;
46:   return [x + (ux - uz * swirl) * mag, z + (uz + ux * swirl) * mag];
47: }
</file>

<file path="src/world/laneParams.ts">
  1: // W4 lane parameters and variant B attributes (lanefield.variance).
  2: // Pure functions over the generated tokens: no DOM, no WebGL, so the
  3: // same code serves the engine, the stub, and the tests. The GLSL
  4: // shaders mirror hash11 and the length/phase formulas textually.
  5: import { T } from '../tokens.generated';
  6: import type { LaneAttributes, LaneParams, LayoutId } from './types';
  7: import { easeSignature } from './tween';
  8: import { maskKindForLayout } from './silhouette';
  9: 
 10: // GLSL hash11 mirror: fract(p * 0.1031); p *= p + 33.33; p *= p + p; // lit-ok:
 11: // fract(p). Double precision here; the shader uses float precision,
 12: // so values agree to float tolerance, not bit for bit.
 13: export function hash11(p: number): number {
 14:   let q = p * 0.1031; // lit-ok: GLSL hash11 constant
 15:   q -= Math.floor(q);
 16:   q *= q + 33.33; // lit-ok: GLSL hash11 constant
 17:   q *= q + q;
 18:   return q - Math.floor(q);
 19: }
 20: 
 21: type SceneGradient = {
 22:   leadOklab: readonly number[];
 23:   tailOklab: readonly number[];
 24:   signalOklab: readonly number[];
 25:   tailLength: number;
 26:   light: { mode: string; radius: number; gain: number };
 27: };
 28: 
 29: function gradientFor(layout: LayoutId): SceneGradient {
 30:   // Scatter has no scene gradient token; it reuses the server gradient.
 31:   const route = layout === 'scatter' ? 'server' : layout;
 32:   return T.scene[route].gradient as unknown as SceneGradient;
 33: }
 34: 
 35: export function paramsForLayout(layout: LayoutId): LaneParams {
 36:   const g = gradientFor(layout);
 37:   const mode = g.light.mode as LaneParams['lightMode'];
 38:   return {
 39:     leadOklab: [...g.leadOklab] as [number, number, number],
 40:     tailOklab: [...g.tailOklab] as [number, number, number],
 41:     signalOklab: [...g.signalOklab] as [number, number, number],
 42:     tailLength: g.tailLength,
 43:     lightMode: mode,
 44:     lightRadius: g.light.radius,
 45:     lightGain: g.light.gain,
 46:     ringCenter: [0, 0],
 47:     ringRadius: 0,
 48:     ringStrength: 0,
 49:     silhouetteMask: maskKindForLayout(layout),
 50:     silhouetteCenter: [0, 0],
 51:     silhouetteRadius: 0,
 52:     silhouetteStrength: 0,
 53:   };
 54: }
 55: 
 56: export function cloneParams(p: LaneParams): LaneParams {
 57:   return {
 58:     leadOklab: [...p.leadOklab],
 59:     tailOklab: [...p.tailOklab],
 60:     signalOklab: [...p.signalOklab],
 61:     tailLength: p.tailLength,
 62:     lightMode: p.lightMode,
 63:     lightRadius: p.lightRadius,
 64:     lightGain: p.lightGain,
 65:     ringCenter: [...p.ringCenter],
 66:     ringRadius: p.ringRadius,
 67:     ringStrength: p.ringStrength,
 68:     silhouetteMask: p.silhouetteMask,
 69:     silhouetteCenter: [...p.silhouetteCenter],
 70:     silhouetteRadius: p.silhouetteRadius,
 71:     silhouetteStrength: p.silhouetteStrength,
 72:   };
 73: }
 74: 
 75: const mix = (a: number, b: number, t: number): number => a + (b - a) * t;
 76: 
 77: // Interpolate two param sets. Light mode is categorical, so it switches
 78: // at the midpoint rather than blending; every numeric field lerps.
 79: export function lerpParams(a: LaneParams, b: LaneParams, t: number): LaneParams {
 80:   return {
 81:     leadOklab: [
 82:       mix(a.leadOklab[0], b.leadOklab[0], t),
 83:       mix(a.leadOklab[1], b.leadOklab[1], t),
 84:       mix(a.leadOklab[2], b.leadOklab[2], t),
 85:     ],
 86:     tailOklab: [
 87:       mix(a.tailOklab[0], b.tailOklab[0], t),
 88:       mix(a.tailOklab[1], b.tailOklab[1], t),
 89:       mix(a.tailOklab[2], b.tailOklab[2], t),
 90:     ],
 91:     signalOklab: [...b.signalOklab],
 92:     tailLength: mix(a.tailLength, b.tailLength, t),
 93:     lightMode: t < 0.5 ? a.lightMode : b.lightMode, // lit-ok: midpoint mode switch
 94:     lightRadius: mix(a.lightRadius, b.lightRadius, t),
 95:     lightGain: mix(a.lightGain, b.lightGain, t),
 96:     ringCenter: [mix(a.ringCenter[0], b.ringCenter[0], t), mix(a.ringCenter[1], b.ringCenter[1], t)],
 97:     ringRadius: mix(a.ringRadius, b.ringRadius, t),
 98:     ringStrength: mix(a.ringStrength, b.ringStrength, t),
 99:     // Mask kind is categorical like light mode: it switches at the
100:     // midpoint. The engine overwrites center, radius, and strength
101:     // from the ring envelope during travel, same as the ring.
102:     silhouetteMask: t < 0.5 ? a.silhouetteMask : b.silhouetteMask,
103:     silhouetteCenter: [
104:       mix(a.silhouetteCenter[0], b.silhouetteCenter[0], t),
105:       mix(a.silhouetteCenter[1], b.silhouetteCenter[1], t),
106:     ],
107:     silhouetteRadius: mix(a.silhouetteRadius, b.silhouetteRadius, t),
108:     silhouetteStrength: mix(a.silhouetteStrength, b.silhouetteStrength, t),
109:   };
110: }
111: 
112: // Light mode as the shader uniform index: band 0, radial 1, wander 2,
113: // static 3. The mapping is an encoding of the token string, not a token. // lit-ok:
114: export function lightModeIndex(mode: LaneParams['lightMode']): number {
115:   switch (mode) {
116:     case 'band':
117:       return 0; // lit-ok: light mode encoding
118:     case 'radial':
119:       return 1; // lit-ok: light mode encoding
120:     case 'wander':
121:       return 2; // lit-ok: light mode encoding
122:     case 'static':
123:       return 3; // lit-ok: light mode encoding
124:   }
125: }
126: 
127: // Morph ring envelope factors at travel fraction p (0 to 1). This is
128: // the exact envelope updateTravel applies: traveling to a project
129: // layout grows the ring over Gather and collapses it over Reveal, so
130: // it is zero at both ends; traveling away collapses an active ring over
131: // the 0.20 to 0.80 window. Pure, so the unit test checks the same // lit-ok:
132: // numbers the engine uses.
133: export function ringEnvelope(p: number, isProject: boolean): {
134:   gather: number;
135:   reveal: number;
136:   collapse: number;
137: } {
138:   const clamp01 = (x: number): number => Math.min(1, Math.max(0, x));
139:   const morph = T.motion.morph;
140:   return {
141:     gather: isProject
142:       ? easeSignature(clamp01((p - morph.gather[0]) / (morph.gather[1] - morph.gather[0])))
143:       : 0,
144:     reveal: isProject
145:       ? easeSignature(clamp01((p - morph.reveal[0]) / (morph.reveal[1] - morph.reveal[0])))
146:       : 0,
147:     collapse: isProject
148:       ? 0
149:       : easeSignature(clamp01((p - 0.2) / (0.8 - 0.2))), // lit-ok: ring collapse window from DESIGN 6.7
150:   };
151: }
152: 
153: // Variant B attributes for one lane. The shader uses the same seeds:
154: // length from hash11(lane * 0.013 + 7), phase from // lit-ok:
155: // hash11(lane * 0.37 + 11). Length scale spans 1 minus variance to // lit-ok:
156: // 1 plus variance. Phase jitter is the seed times (1 minus server
157: // weight), so Lockstep (server weight 1) zeroes it exactly.
158: export function laneAttributes(lane: number, serverWeight: number): LaneAttributes {
159:   const variance = T.lanefield.variance;
160:   const bands = variance.depthBands;
161:   const band = ((lane % bands) + bands) % bands;
162:   const lengthScale = 1 + (hash11(lane * 0.013 + 7) - 0.5) * 2 * variance.lengthVariance; // lit-ok: variant B seeds
163:   const phaseJitterSeed = hash11(lane * 0.37 + 11); // lit-ok: variant B seeds
164:   return {
165:     band,
166:     lengthScale,
167:     phaseJitter: phaseJitterSeed * (1 - serverWeight),
168:     phaseJitterSeed,
169:   };
170: }
</file>

