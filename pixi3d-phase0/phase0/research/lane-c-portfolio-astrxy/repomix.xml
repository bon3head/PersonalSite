 885:     (pinMesh.kind as THREE.InstancedBufferAttribute).needsUpdate = true;
 886:     pinMesh.scale.needsUpdate = true;
 887:     pinMesh.opacity.needsUpdate = true;
 888:     // Halos (matched pins from tEnd through fade).
 889:     let h = 0;
 890:     for (const p of pins) {
 891:       if (h >= MAX_INSTANCES) break;
 892:       if (p.state !== 'halo' && p.state !== 'fading') continue;
 893:       if (p.state === 'fading' && !matches.some((m) => m.req === p || m.off === p)) {
 894:         continue; // stale fade has no halo
 895:       }
 896:       haloMesh.center.setXYZ(h, nodeX(p.node), 0.01, nodeZ(p.node)); // lit-ok: halo plane height
 897:       let scale = P.haloScale;
 898:       let opacity = 1;
 899:       if (p.state === 'halo') {
 900:         const t = Math.min(
 901:           Math.max((now - p.haloBornAt) / (T.motion.ms.medium / 1000), 0), // lit-ok: ms to sec
 902:           1,
 903:         );
 904:         scale = P.haloScale * easeSignature(t);
 905:       } else {
