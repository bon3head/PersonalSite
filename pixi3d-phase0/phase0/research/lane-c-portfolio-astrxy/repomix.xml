175: export interface MorphController {
176:   readonly from: LayoutId;
177:   readonly to: LayoutId;
178:   navigate: (
179:     to: LayoutId,
180:     nowMs: number,
181:     snapshot?: MorphSnapshot,
182:     navOpts?: MorphNavigateOptions,
183:   ) => void;
184:   navigateReduced: (to: LayoutId, nowMs: number) => void;
185:   sample: (nowMs: number) => MorphSample;
186:   observeFrame: (dtMs: number, nowMs: number) => void;
187:   forceDegrade: () => void;
188:   degradeState: () => MorphDegradeState;
189:   descriptorFor: (layout: LayoutId) => HeroDescriptor;
190: }
