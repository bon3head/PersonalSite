 1: import { StrictMode } from 'react';
 2: import { createRoot, hydrateRoot } from 'react-dom/client';
 3: import App from './App';
 4: import { createLanefield } from './world/lanefield';
 5: import type { Lanefield } from './world/types';
 6: import { parsePath, SCENE_LAYOUT } from './router';
 7: import { initMotionPref } from './lib/reducedMotion';
 8: import { initBrandPrefetch } from './lib/brandPrefetch';
 9: import { T } from './tokens.generated';
10: import './styles/global.css';
11: 
12: initMotionPref();
13: initBrandPrefetch();
14: 
15: function startWorld(): void {
16:   const mount = document.getElementById('world');
17:   if (!mount) return;
18:   const lanefield = createLanefield(mount, {
19:     seed: T.world.seed,
20:     reducedMotion: document.documentElement.classList.contains('reduced-motion'),
21:     initial: SCENE_LAYOUT[parsePath(window.location.pathname)],
22:   });
23:   if (lanefield) {
24:     // WIRING-FIX: record the instance BEFORE dispatching. The event
25:     // is one-shot: on engines without requestIdleCallback (WebKit,
26:     // stock Safari) the setTimeout(0) fallback can fire before
27:     // createRoot's concurrent render runs App's effects, so no
28:     // listener exists yet and the event is lost. App reads this
29:     // holder on mount and wires immediately when it is already set,
30:     // so both orderings (event before mount, event after mount)
31:     // wire. This key is distinct from window.__lanefield, which
32:     // holds the debug handle, not the field instance.
33:     (window as unknown as { __lanefieldReady?: Lanefield }).__lanefieldReady =
34:       lanefield;
35:     window.dispatchEvent(
36:       new CustomEvent('lanefield-ready', { detail: lanefield }),
37:     );
38:   }
39: }
40: 
41: function startOnIdle(): void {
42:   const ric = (window as unknown as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
43:   if (ric) {
44:     ric(startWorld);
45:   } else {
46:     window.setTimeout(startWorld, 0);
47:   }
48: }
49: 
50: const rootEl = document.getElementById('root');
51: if (rootEl) {
52:   // S03 section 7: the client hydrates the prerendered markup. In dev
53:   // #root is empty (no prerender step), so fall back to a fresh root
54:   // there; in production #root always carries the prerendered app.
55:   const app = (
56:     <StrictMode>
57:       <App />
58:     </StrictMode>
59:   );
60:   const root = rootEl.hasChildNodes()
61:     ? hydrateRoot(rootEl, app)
62:     : createRoot(rootEl);
63:   if (!rootEl.hasChildNodes()) {
64:     root.render(app);
65:   }
66:   // Test hook: travel.spec.ts setupHarness replaces #root with its own
67:   // router/travel harness. Without unmounting first, the real App's
68:   // router and hotkeys survive (window listeners) and push duplicate
69:   // history entries, so goBack lands on a duplicate instead of the
70:   // previous scene. Unmounting runs App's cleanup (router.dispose,
71:   // travel.dispose, hotkeys) before the harness takes over.
72:   (window as unknown as Record<string, unknown>).__unmountApp = () => {
73:     root.unmount();
74:   };
75: }
76: startOnIdle();
</file>

