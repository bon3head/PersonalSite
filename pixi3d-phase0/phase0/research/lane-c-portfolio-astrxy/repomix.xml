201: // Shared morph completion predicate, single domain, no division.
202: // Both the controller sample and the lanefield travel check call
203: // this exact function with the same millisecond start, sample, and
204: // duration, so their done states cannot disagree in floating point.
205: // The old split used a seconds-domain ratio in lanefield and a
206: // millisecond ratio in the controller, which disagreed at
207: // representable timestamps. Elapsed comparison avoids the division
208: // rounding entirely.
209: export function morphTravelDone(startMs: number, nowMs: number, durationMs: number): boolean {
210:   return nowMs - startMs >= durationMs;
211: }
212: 
213: export function createMorphController(
214:   initial: LayoutId,
215:   opts: MorphOptions = {},
216: ): MorphController {
217:   let from: LayoutId = initial;
218:   let to: LayoutId = initial;
219:   let startMs = 0;
220:   let durationMs = T.motion.ms.travel;
221:   let snapshot: MorphSnapshot = restSnapshot(initial);
222:   let jumped = true;
223:   let lastSample: MorphSample | null = null;
224:   let degraded = false;
225:   let degradedLogged = false;
226:   let degradedAtMs: number | null = null;
227:   let consecutiveOverBudget = 0;
228:   let longTaskFrames = 0;
229:   let maxFrameMs = 0;
230:   let originPx: [number, number] | null = null;
231:   let entropy: MorphEntropy = NEUTRAL_ENTROPY;
232:   // Travel fraction at which the target anchor first resolved during
233:   // this morph; null until then. Reset on every navigate.
234:   let anchorSeenP: number | null = null;
235: 
236:   const resolve = (layout: LayoutId): MorphAnchor | null =>
237:     opts.anchorFor ? opts.anchorFor(layout) : descriptorAnchor(layout);
238: 
239:   function directionFor(a: LayoutId, b: LayoutId): 1 | 0 | -1 {
240:     const oa = KEYMAP_ORDER[a];
241:     const ob = KEYMAP_ORDER[b];
242:     if (oa === undefined || ob === undefined) return 0;
243:     return ob > oa ? 1 : ob < oa ? -1 : 0;
244:   }
245: 
246:   function sample(nowMs: number): MorphSample {
247:     const morph = T.motion.morph;
248:     const p = jumped ? 1 : clamp01((nowMs - startMs) / durationMs);
249:     const done = jumped || morphTravelDone(startMs, nowMs, durationMs);
250:     const release = windowEased(p, morph.release);
251:     const toDesc = descriptorForLayout(to);
252:     const fromDesc = descriptorForLayout(from);
253:     const toProject = toDesc.kind === 'mark';
254:     const fromProject = fromDesc.kind === 'mark';
255:     const toAnchor = toProject ? resolve(to) : null;
256:     if (toProject && toAnchor && anchorSeenP === null) anchorSeenP = p;
257:     const anchorReady = !toProject || toAnchor !== null;
258:     // Gather starts at the later of its token start and the first frame
259:     // the target anchor resolved, so a late anchor grows from zero.
260:     const gatherWin: [number, number] = [
261:       Math.min(Math.max(morph.gather[0], anchorSeenP ?? morph.gather[0]), morph.gather[1] - 0.05),
262:       morph.gather[1],
263:     ];
264:     const gather = anchorReady ? windowEased(p, gatherWin) : 0;
265:     const gatherRaw = anchorReady ? windowRaw(p, gatherWin) : 0;
266:     const reveal = windowEased(p, morph.reveal);
267:     const loom = windowEased(p, morph.loom);
268:     const collapse = windowEased(p, COLLAPSE_WINDOW);
269:     const blend = toProject ? gather : collapse;
270:     // Ring envelope per case (see the header note).
271:     let ringFactor: number;
272:     if (toProject && fromProject) {
273:       const breath =
274:         1 - (1 - T.morph.ringBreath) * Math.sin(Math.PI * gatherRaw);
275:       const handoff = windowEased(p, [morph.gather[1], 1]);
276:       ringFactor = anchorReady ? breath * (1 - handoff) : 0;
277:     } else if (toProject) {
278:       ringFactor = gather * (1 - reveal);
279:     } else if (fromProject) {
280:       ringFactor = 1 - collapse;
281:     } else {
282:       ringFactor = 0;
283:     }
284:     // Centers. Project to project moves between anchors on curve.track
285:     // from the snapshot center; field to project departs from the
286:     // origin (when given) and lands on the anchor over Gather; travel
287:     // to a field collapses in place at the snapshot center.
288:     const toCenter: [number, number] = toAnchor ? toAnchor.center : [...snapshot.center];
289:     const originGround = originPx && opts.groundAt ? opts.groundAt(originPx) : null;
290:     let ringCenter: [number, number];
291:     let silhouetteCenter: [number, number];
292:     if (toProject && fromProject) {
293:       const t = trackEase(p);
294:       ringCenter = [
295:         mix(snapshot.center[0], toCenter[0], t),
296:         mix(snapshot.center[1], toCenter[1], t),
297:       ];
298:       silhouetteCenter = [
299:         mix(snapshot.silhouetteCenter[0], toCenter[0], t),
300:         mix(snapshot.silhouetteCenter[1], toCenter[1], t),
301:       ];
302:     } else if (toProject) {
303:       const t = trackEase(gatherRaw);
304:       ringCenter = originGround
305:         ? [mix(originGround[0], toCenter[0], t), mix(originGround[1], toCenter[1], t)]
306:         : [...toCenter];
307:       silhouetteCenter = [...toCenter];
308:     } else {
309:       ringCenter = [...snapshot.center];
310:       silhouetteCenter = [...snapshot.silhouetteCenter];
311:     }
312:     const ringRadius = toProject
313:       ? (toAnchor ? toAnchor.ringRadius : 0)
314:       : snapshot.ringRadius * (1 - collapse);
315:     const silhouetteRadius = toProject
316:       ? (toAnchor ? toAnchor.silhouetteRadius : 0)
317:       : snapshot.silhouetteRadius * (1 - collapse);
318:     // Strength blends from the snapshot so a retarget never jumps:
319:     // at p 0 the blend weight is 0 and the sample equals the snapshot.
320:     // The project-to-project breath factor starts at 1, so its target
321:     // term is additionally gated by Gather: without that gate the
322:     // breath would jump the strength to full at the retarget instant
323:     // instead of growing from the snapshot.
324:     const targetFactor =
325:       toProject && fromProject ? ringFactor * gather : ringFactor;
326:     const ringStrength =
327:       snapshot.ringStrength * (1 - blend) +
328:       (toProject ? ringRadius * 0.5 * targetFactor : 0);
329:     const pullTarget = degraded ? 0 : T.morph.silhouettePull * entropy.pullScale;
330:     const silhouetteStrength =
331:       snapshot.silhouetteStrength * (1 - blend) +
332:       (toProject ? pullTarget * targetFactor : 0);
333:     // Hero loom (motion.morph.loom) and recede (motion.morph.recede).
334:     const heroOpacityIn = toProject ? loom : 0;
335:     const heroScaleIn = toProject
336:       ? mix(T.morph.loomFrom, 1, loom)
337:       : 1;
338:     const recede = windowEased(p, morph.recede);
339:     const heroOpacityOut = fromProject ? 1 - recede : 0;
340:     const heroScaleOut = fromProject ? mix(1, T.morph.recedeTo, recede) : 1;
341:     // Camera bow rides the camera's own curve: zero at both ends.
342:     const bowFactor = jumped ? 0 : Math.sin(Math.PI * easeSignature(p));
343:     const out: MorphSample = {
344:       p,
345:       from,
346:       to,
347:       direction: directionFor(from, to),
348:       done,
349:       release,
350:       gather,
351:       reveal,
352:       collapse,
353:       ringFactor,
354:       ringCenter,
355:       ringRadius,
356:       ringStrength,
357:       silhouetteCenter,
358:       silhouetteRadius,
359:       silhouetteStrength,
360:       heroOpacityIn,
361:       heroScaleIn,
362:       heroOpacityOut,
363:       heroScaleOut,
364:       bowFactor,
365:       bow: entropy.bow,
366:       ringSwirl: entropy.swirl,
367:       anchorReady,
368:       degraded,
369:     };
370:     lastSample = out;
371:     return out;
372:   }
373: 
374:   return {
375:     get from() {
376:       return from;
377:     },
378:     get to() {
379:       return to;
380:     },
381:     navigate(
382:       next: LayoutId,
383:       nowMs: number,
384:       snap?: MorphSnapshot,
385:       navOpts?: MorphNavigateOptions,
386:     ): void {
387:       const base =
388:         snap ?? (lastSample ? snapshotFromSample(lastSample) : restSnapshot(to));
389:       from = to;
390:       to = next;
391:       startMs = nowMs;
392:       durationMs = T.motion.ms.travel;
393:       snapshot = base;
394:       jumped = false;
395:       originPx = navOpts?.originPx ?? null;
396:       entropy = navOpts?.entropy ?? NEUTRAL_ENTROPY;
397:       // An anchor that already resolves at navigate time (a repeat
398:       // visit, or the descriptor fallback) is ready from p 0.
399:       anchorSeenP =
400:         descriptorForLayout(next).kind === 'mark' && resolve(next) !== null ? 0 : null;
401:     },
402:     navigateReduced(next: LayoutId, nowMs: number): void {
403:       from = to;
404:       to = next;
405:       startMs = nowMs;
406:       durationMs = T.motion.ms.travel;
407:       snapshot = restSnapshot(next);
408:       jumped = true;
409:       lastSample = null;
410:       originPx = null;
411:       entropy = NEUTRAL_ENTROPY;
412:       anchorSeenP = null;
413:     },
414:     sample,
415:     observeFrame(dtMs: number, nowMs: number): void {
416:       if (dtMs > maxFrameMs) maxFrameMs = dtMs;
417:       if (dtMs > T.perf.longTaskMs) longTaskFrames += 1;
418:       // Only frames inside a morph count toward the degrade latch.
419:       if (jumped || lastSample === null || lastSample.done) return;
420:       if (dtMs > T.perf.p95Ms) {
421:         consecutiveOverBudget += 1;
422:       } else {
423:         consecutiveOverBudget = 0;
424:       }
425:       if (!degraded && consecutiveOverBudget >= T.perf.degradeFrames) {
426:         degraded = true;
427:         degradedAtMs = nowMs;
428:         if (!degradedLogged) {
429:           degradedLogged = true;
430:           console.info(
431:             '[morph] degrade latched: silhouette pull 0 for session',
432:           );
433:         }
434:       }
435:     },
436:     forceDegrade(): void {
437:       if (degraded) return;
438:       degraded = true;
439:       degradedAtMs = null;
440:       if (!degradedLogged) {
441:         degradedLogged = true;
442:         console.info('[morph] degrade latched: silhouette pull 0 for session');
443:       }
444:     },
445:     degradeState(): MorphDegradeState {
446:       return {
447:         degraded,
448:         consecutiveOverBudget,
449:         longTaskFrames,
450:         maxFrameMs,
451:         degradedAtMs,
452:       };
453:     },
454:     descriptorFor(layout: LayoutId): HeroDescriptor {
455:       return descriptorForLayout(layout);
456:     },
457:   };
458: }
