 107: // sRGB hex to linear vec3 (lanes use linear colors; pins must match).
 108: function hexToLinear(hex: string): [number, number, number] {
 109:   const r = parseInt(hex.slice(1, 3), 16) / 255; // lit-ok: hex channel scale
 110:   const g = parseInt(hex.slice(3, 5), 16) / 255; // lit-ok: hex channel scale
 111:   const b = parseInt(hex.slice(5, 7), 16) / 255; // lit-ok: hex channel scale
 112:   const conv = (c: number): number =>
 113:     c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); // lit-ok: sRGB curve
 114:   return [conv(r), conv(g), conv(b)];
 115: }
 116: 
 117: const VERT = /* glsl */ `
 118: precision highp float;
 119: precision highp int;
 120: in vec3 aCenter;
 121: in float aKind;
 122: in float aScale;
 123: in float aOpacity;
 124: uniform vec2 uViewport;
 125: uniform float uRadiusPx;
 126: out vec2 vUv;
 127: out float vKind;
 128: out float vOpacity;
 129: void main() {
 130:   vUv = position.xy + 0.5; // lit-ok: shader constant
 131:   vKind = aKind;
 132:   vOpacity = aOpacity;
 133:   vec4 clip = projectionMatrix * modelViewMatrix * vec4(aCenter, 1.0); // lit-ok: shader constant
 134:   vec2 ndc = clip.xy / clip.w;
 135:   vec2 off = position.xy * 4.0 * uRadiusPx * aScale / uViewport; // lit-ok: shader constant
 136:   gl_Position = vec4((ndc + off) * clip.w, clip.z, clip.w);
 137: }
 138: `;
 139: 
 140: const FRAG = /* glsl */ `
 141: precision highp float;
 142: precision highp int;
 143: in vec2 vUv;
 144: in float vKind;
 145: in float vOpacity;
 146: uniform vec3 uColor;
 147: uniform vec3 uTint;
 148: uniform float uUseKind;
 149: uniform float uShape;
 150: uniform float uInner;
 151: out vec4 outColor;
 152: void main() {
 153:   vec2 c = vUv - 0.5; // lit-ok: shader constant
 154:   float d = length(c) * 2.0; // lit-ok: shader constant
 155:   float shape = uUseKind > 0.5 ? vKind : uShape; // lit-ok: shader constant
 156:   float a = 0.0; // lit-ok: shader constant
 157:   vec3 col = uColor;
 158:   if (shape < 0.5) {
 159:     a = smoothstep(uInner - 0.05, uInner + 0.05, d) * (1.0 - smoothstep(0.95, 1.0, d)); // lit-ok: shader constant
 160:   } else if (shape < 1.5) { // lit-ok: shader constant
 161:     a = 1.0 - smoothstep(0.95, 1.0, d); // lit-ok: shader constant
 162:   } else if (shape < 2.5) { // lit-ok: shader constant
 163:     col = uTint;
 164:     a = 1.0 - smoothstep(0.95, 1.0, d); // lit-ok: shader constant
 165:   } else {
 166:     a = smoothstep(uInner - 0.05, uInner + 0.05, d) * (1.0 - smoothstep(0.95, 1.0, d)); // lit-ok: shader constant
 167:   }
 168:   a *= vOpacity;
 169:   if (a < 0.003) discard; // lit-ok: shader constant
 170:   outColor = vec4(col * a, a);
 171: }
 172: `;
