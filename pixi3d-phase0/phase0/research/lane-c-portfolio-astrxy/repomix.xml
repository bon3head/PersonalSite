 99: function setKeymapAccent(
100:   dom: TravelDom,
101:   target: SceneId,
102: ): void {
103:   const keymap = dom.keymap();
104:   if (!keymap) return;
105:   for (const scene of SCENE_ORDER) {
106:     const item = dom.keymapItem(scene);
107:     if (!item) continue;
108:     if (scene === target) item.setAttribute('aria-current', 'page');
109:     else item.removeAttribute('aria-current');
110:   }
111:   if (target === 'notfound') {
112:     for (const scene of SCENE_ORDER) {
113:       dom.keymapItem(scene)?.removeAttribute('aria-current');
114:     }
115:   }
