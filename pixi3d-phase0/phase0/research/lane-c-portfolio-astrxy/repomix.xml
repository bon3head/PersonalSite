  1: // P-LF-4b silhouette pull tests: T-LF-8 (one lane draw call with a
  2: // mask texture bound) and T-LF-9 (the pull itself, pinned by the pure
  3: // functions the engine and shader mirror).
  4: //
  5: // Browser timing note, same as lanefield.spec.ts: on SwiftShader a
  6: // single frame takes 10 to 20 seconds, so T-LF-8 waits for the mask
  7: // load state through the debug readout instead of sampling a
  8: // mid-morph frame. Interpolation and displacement are covered by the
  9: // Node unit tests below, which check the exact functions the engine
 10: // calls.
 11: import { test, expect } from '@playwright/test';
 12: import { readFileSync, existsSync } from 'node:fs';
 13: import { join, dirname } from 'node:path';
 14: import { fileURLToPath } from 'node:url';
 15: import {
 16:   SILHOUETTE_MASK_SIZE,
 17:   maskKindForLayout,
 18:   maskUv,
 19:   silhouetteEnvelopeStrength,
 20:   silhouettePullPoint,
 21: } from '../../src/world/silhouette';
 22: import { paramsForLayout, lerpParams } from '../../src/world/laneParams';
 23: import { T } from '../../src/tokens.generated';
 24: 
 25: test.setTimeout(300000);
 26: 
 27: const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
 28: const DEV = process.env.W4_DEV ?? 'http://localhost:5173';
 29: const HARNESS = `${DEV}/tests/world-harness.html`;
