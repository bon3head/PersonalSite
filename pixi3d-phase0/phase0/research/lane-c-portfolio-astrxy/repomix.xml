387: 
388:   function placeReducedStatics(): void {
389:     // Three words at rest at reducedWordAt fractions of their drift path,
390:     // with color, opacity and lane bend at those points (S05 motion).
391:     // Placed at once even before the font is measured, so the statics
392:     // exist from the first still; the measure callback places them again
393:     // at the true advance.
394:     const at = S.reducedWordAt;
395:     for (let i = 0; i < at.length; i++) {
396:       const w = placeWord(WORDS[i % WORDS.length], i % 2 === 0 ? 1 : -1, at[i]);
397:       if (w) poseWord(w, at[i], 1);
398:     }
399:     writeLanes();
400:     f.guestbook?.render();
401:   }
402: 
403:   // Release every word: glyphs hidden, lanes back to zero, tints off.
404:   function clearWords(): void {
405:     for (const w of actives) {
406:       for (const g of w.glyphs) g.mesh.visible = false;
407:       lanes?.words.setTint(w.slot, tmpRgb, 0);
408:     }
409:     actives.length = 0;
410:     lanes?.words.writeLanes([], new Float32Array(0), []);
411:   }
412: 
413:   measure.sync(() => {
414:     if (disposed) return;
415:     const bb = (measure.textRenderInfo as { blockBounds?: number[] } | undefined)?.blockBounds;
416:     if (!bb) return;
417:     advance = bb[2] - bb[0];
418:     boxY = [bb[1], bb[3]]; // lit-ok: blockBounds y channels
419:     if (reduced && !hidden && !paused) {
420:       clearWords();
421:       placeReducedStatics();
422:     }
423:   });
