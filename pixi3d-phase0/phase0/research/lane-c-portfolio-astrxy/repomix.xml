  1: // Guestbook director (DESIGN 6.14). Drives the lane field while the
  2: // guestbook sheet is open: the camera dolly, the 3D part, one lane per
  3: // typed character bending toward the camera, the lock-in, and the
  4: // pull-back. Everything here is motion of the existing field through
  5: // field.guestbook (same mesh, same draw call, same WebGL context).
  6: //
  7: // Entropy: two fresh seeds per sign, both from freshSeed (entropy.ts,
  8: // crypto.getRandomValues, or hash32 of the session seed under ?seed).
  9: //   open seed: part heights (shader, uGbSeed), camera yaw and rise,
 10: //              baseline wobble, letter heights while typing, noise.
 11: //   sign seed: lock-in heights, settle offset and scale, pull-back
 12: //              drift, and the hex in the seed readout.
 13: // Each value is hash32(seed, PARAM, index), so a seed fully decides it.
 14: //
 15: // Curves: the two Lusion beziers only (T.guestbook.easeMain, easeSoft).
 16: import { T } from '../tokens.generated';
 17: import type { Lanefield } from '../world/types';
 18: import { cubicBezier } from '../world/tween';
 19: import { currentVariant } from '../world/camera';
 20: import { freshSeed, hash32 } from './entropy';
 21: 
 22: const easeMain = cubicBezier(...T.guestbook.easeMain);
 23: const easeSoft = cubicBezier(...T.guestbook.easeSoft);
 24: type Ease = (x: number) => number;
 25: 
 26: const UINT32 = 4294967296;
 27: const DEG = Math.PI / 180;
 28: const NOISE_GLYPHS = '0123456789ABCDEF';
 29: 
 30: // Parameter ids for hash32(seed, PARAM, index).
 31: const P = {
 32:   yaw: 1,
 33:   rise: 2,
 34:   wobblePhase: 3,
 35:   wobbleFreq: 4,
 36:   wobbleJitter: 5,
 37:   height: 6,
 38:   noise: 7,
 39:   scramble: 8,
 40:   settleAngle: 9,
 41:   settleRadius: 10,
 42:   settleScale: 11,
 43:   drift: 12,
 44:   partSeed: 13,
 45:   readout: 14,
 46: } as const;
 47: 
 48: function u(seed: number, param: number, index = 0): number {
 49:   return hash32(seed, param, index) / UINT32;
 50: }
 51: 
 52: function s(seed: number, param: number, index = 0): number {
 53:   return u(seed, param, index) * 2 - 1;
 54: }
 55: 
 56: function lerp(a: number, b: number, t: number): number {
 57:   return a + (b - a) * t;
 58: }
 59: 
 60: class Tween {
 61:   from = 0;
 62:   to = 0;
 63:   start = 0;
 64:   dur = 0;
 65:   ease: Ease = easeMain;
 66:   constructor(v = 0) {
 67:     this.from = v;
 68:     this.to = v;
 69:   }
 70:   value(t: number): number {
 71:     if (this.dur <= 0 || t >= this.start + this.dur) return this.to;
 72:     if (t <= this.start) return this.from;
 73:     return this.from + (this.to - this.from) * this.ease((t - this.start) / this.dur);
 74:   }
 75:   go(t: number, to: number, dur: number, ease: Ease, delay = 0): void {
 76:     this.from = this.value(t);
 77:     this.to = to;
 78:     this.start = t + delay;
 79:     this.dur = dur;
 80:     this.ease = ease;
 81:     if (dur <= 0 && delay <= 0) this.from = to;
 82:   }
 83:   done(t: number): boolean {
 84:     return this.dur <= 0 || t >= this.start + this.dur;
 85:   }
 86: }
 87: 
 88: interface Letter {
 89:   char: string;
 90:   index: number;
 91:   lane: number;
 92:   x: Tween;
 93:   z: Tween;
 94:   h: Tween;
 95:   rise: Tween;
 96:   dying: boolean;
 97:   resolveAt: number;
 98:   span: HTMLSpanElement | null;
 99: }
100: 
101: export type GuestbookPhase = 'closed' | 'open' | 'locking' | 'settled' | 'closing';
102: 
103: export interface GuestbookDebug {
104:   phase: GuestbookPhase;
105:   openSeed: number;
106:   signSeed: number | null;
107:   signs: number[];
108:   dolly: number;
109:   yawDeg: number;
110:   bands: [number, number, number];
111:   letters: { char: string; lane: number; h: number; x: number; z: number }[];
112:   well: [number, number, number] | null;
113:   dim: number;
114:   dimBox: [number, number, number, number] | null;
115: }
116: 
117: // Where the panel is, for the phone frame and the contrast dim
118: // (DESIGN 6.14, 1.6.0). lift is the keyboard lift in CSS px.
119: export interface GuestbookPanelSource {
120:   panel: HTMLElement;
121:   lift: () => number;
122: }
123: 
124: // The free region in layout CSS px: the visual viewport above the
125: // panel's resting top edge (no depth move, with the keyboard lift).
126: export function freeRegion(src: GuestbookPanelSource | null): { left: number; top: number; width: number; height: number } {
127:   const vv = window.visualViewport;
128:   const left = vv ? vv.offsetLeft : 0;
129:   const top = vv ? vv.offsetTop : 0;
130:   const width = vv ? vv.width : window.innerWidth;
131:   let bottom = top + (vv ? vv.height : window.innerHeight);
132:   if (src) bottom = Math.min(bottom, src.panel.offsetTop - src.lift());
133:   return { left, top, width, height: Math.max(1, bottom - top) };
134: }
135: 
136: export interface GuestbookDirector {
137:   open(): void;
138:   // The visual viewport or the panel moved: re-measure (renders once
139:   // under reduced motion, where no loop runs).
140:   reframe(): void;
141:   setText(name: string): void;
142:   lock(): Promise<number>;
143:   again(): void;
144:   close(): Promise<void>;
145:   // Seed readout: rolling hex before lock-in, the sign seed after.
146:   onReadout(cb: (hex: string) => void): void;
147:   dispose(): void;
148: }
149: 
150: function hex8(n: number): string {
151:   return (n >>> 0).toString(16).toUpperCase().padStart(8, '0');
152: }
153: 
154: export function createGuestbookDirector(
155:   field: Lanefield | null,
156:   glyphLayer: HTMLElement | null,
157:   panelSrc: GuestbookPanelSource | null = null,
158: ): GuestbookDirector {
159:   const g = T.guestbook;
160:   const gb = field?.guestbook ?? null;
161:   const reduced = (): boolean => gb?.reduced() ?? true;
162:   const dur = (ms: number): number => (reduced() ? 0 : ms);
163:   const nowMs = (): number => (field ? field.now() * 1000 : performance.now());
164: 
165:   let phase: GuestbookPhase = 'closed';
166:   let openSeed = 0;
167:   let signSeed: number | null = null;
168:   const signs: number[] = [];
169:   let letters: Letter[] = [];
170:   let text = '';
171:   let readoutCb: ((hex: string) => void) | null = null;
172:   let lastReadout = '';
173:   let unsubscribe: (() => void) | null = null;
174:   let lockStart = 0;
175:   let closeResolve: (() => void) | null = null;
176:   let closeAt = 0;
177: 
178:   // Geometry at open.
179:   let well: [number, number, number] = [0, 0, 0];
180:   let dist = 1;
181:   let right: [number, number] = [1, 0];
182:   let forward: [number, number] = [0, -1];
183:   let spacing = 1;
184:   let glyphWorld = 1;
185:   let pxPerUnitIn = 1;
186:   let targetPx: [number, number] = [0, 0];
187:   let baseWell: [number, number, number] = [0, 0, 0];
188:   let shiftTo: [number, number] = [0, 0];
189:   let regionW = window.innerWidth;
190:   let regionL = 0;
191:   let lastDimBox: [number, number, number, number] | null = null;
192: 
193:   const dolly = new Tween();
194:   const yaw = new Tween();
195:   const rise = new Tween();
196:   const bands = [new Tween(), new Tween(), new Tween()];
197:   const shiftX = new Tween();
198:   const shiftZ = new Tween();
199:   const scale = new Tween(1);
200:   const noise = new Tween();
201:   const shiftMix = new Tween();
202:   // The phone-frame shift eases when the free region changes.
203:   const frameX = new Tween();
204:   const frameY = new Tween();
205:   const dim = new Tween();
206: 
207:   const tip: [number, number, number] = [0, 0, 0];
208:   const glyphPos: [number, number, number] = [0, 0, 0];
209: 
210:   // Canvas NDC that puts the well at the free region's center offset by
211:   // shiftNdc in that region's NDC (DESIGN 6.14 phone frame).
212:   function frameShift(): [number, number] {
213:     const [sx, sy] = g.shiftNdc[currentVariant()];
214:     const r = freeRegion(panelSrc);
215:     regionW = r.width;
216:     regionL = r.left;
217:     if (!field) return [sx, sy];
218:     const [vw, vh] = field.viewportCss();
219:     const px = r.left + (r.width / 2) * (1 + sx);
220:     const py = r.top + (r.height / 2) * (1 - sy);
221:     return [(px / vw) * 2 - 1, 1 - (py / vh) * 2];
222:   }
223: 
224:   function updateFrame(t: number, snap: boolean): void {
225:     const [x, y] = frameShift();
226:     const eps = 1e-3; // lit-ok: NDC change below a pixel is ignored
227:     if (snap) {
228:       frameX.go(t, x, 0, easeMain);
229:       frameY.go(t, y, 0, easeMain);
230:     } else {
231:       if (Math.abs(x - frameX.to) > eps) frameX.go(t, x, dur(g.ms.panel), easeMain);
232:       if (Math.abs(y - frameY.to) > eps) frameY.go(t, y, dur(g.ms.panel), easeMain);
233:     }
234:     shiftTo = [frameX.value(t), frameY.value(t)];
235:   }
236: 
237:   function measureWell(): void {
238:     if (!field || !gb) return;
239:     updateFrame(nowMs(), true);
240:     const frame = gb.restFrame();
241:     well = [...frame.target];
242:     dist = Math.hypot(frame.pos[0] - well[0], frame.pos[1] - well[1], frame.pos[2] - well[2]) || 1;
243:     right = frame.right;
244:     forward = frame.forward;
245:     // Fit: the dollied-in mark spans at most fitWidthFrac of the width.
246:     const a = field.worldToScreen(well);
247:     const b = field.worldToScreen([well[0] + right[0], well[1], well[2] + right[1]]);
248:     const pxRest = Math.max(1, Math.hypot(b[0] - a[0], b[1] - a[1]));
249:     pxPerUnitIn = reduced() ? pxRest : pxRest / (1 - g.camera.dollyIn);
250:     targetPx = [a[0], a[1]];
251:     baseWell = [...well];
252:     fitSpacing(Array.from(text).length);
253:   }
254: 
255:   // Reduced motion: the camera does not move, so the scene's own
256:   // framing stands (on fine server the target sits right of center).
257:   // Slide the well along the target's screen row until n letters fit
258:   // inside the viewport; the mark stays in the field, at rest.
259:   function reframeStill(n: number): void {
260:     if (!field) return;
261:     const w = regionW;
262:     const half = (n * spacing * pxPerUnitIn) / 2;
263:     const margin = (w * (1 - g.fitWidthFrac)) / 2;
264:     const x = Math.max(regionL + margin + half, Math.min(targetPx[0], regionL + w - margin - half));
265:     const ground = x === targetPx[0] ? null : field.screenToGround(x, targetPx[1]);
266:     well = ground ? [ground[0], baseWell[1], ground[1]] : [...baseWell];
267:   }
268: 
269:   // Letter spacing: the token spacing, shrunk so n letters fit
270:   // fitWidthFrac of the viewport width at the dollied-in camera.
271:   function fitSpacing(n: number): void {
272:     const fitWorld = (regionW * g.fitWidthFrac) / pxPerUnitIn;
273:     spacing = Math.min(dist * g.mark.spacingFrac, fitWorld / Math.max(1, n));
274:     glyphWorld = Math.min(dist * g.mark.glyphFrac, spacing * 1.1);
275:   }
276: 
277:   function heightFor(seed: number, i: number): number {
278:     const [lo, hi] = g.mark.heightFrac;
279:     return dist * lerp(lo, hi, u(seed, P.height, i));
280:   }
281: 
282:   // Slot i of n on the baseline, ground coordinates, with seeded wobble.
283:   function slot(i: number, n: number): [number, number] {
284:     const along = (i - (n - 1) / 2) * spacing;
285:     const phase0 = u(openSeed, P.wobblePhase) * Math.PI * 2;
286:     const freq = lerp(0.35, 0.9, u(openSeed, P.wobbleFreq));
287:     const wob = dist * g.mark.wobbleFrac * (Math.sin(phase0 + i * freq) + 0.5 * s(openSeed, P.wobbleJitter, i));
288:     return [
289:       well[0] + right[0] * along + forward[0] * wob,
290:       well[2] + right[1] * along + forward[1] * wob,
291:     ];
292:   }
293: 
294:   function relayout(t: number): void {
295:     const all = letters.filter((l) => !l.dying);
296:     const n = all.length;
297:     all.forEach((l, i) => {
298:       const [x, z] = slot(i, n);
299:       l.x.go(t, x, dur(g.ms.letter), easeMain);
300:       l.z.go(t, z, dur(g.ms.letter), easeMain);
301:     });
302:   }
303: 
304:   function makeSpan(): HTMLSpanElement | null {
305:     if (!glyphLayer) return null;
306:     const span = document.createElement('span');
307:     span.className = 'jp-gb-glyph';
308:     glyphLayer.appendChild(span);
309:     return span;
310:   }
311: 
312:   function setText(next: string): void {
313:     if (phase !== 'open') {
314:       text = next;
315:       return;
316:     }
317:     const t = nowMs();
318:     const chars = Array.from(next.slice(0, g.nameMaxChars));
319:     const alive = letters.filter((l) => !l.dying);
320:     // Keep the common prefix; retire the rest; add new letters.
321:     let keep = 0;
322:     while (keep < alive.length && keep < chars.length && alive[keep].char === chars[keep]) keep++;
323:     for (let i = keep; i < alive.length; i++) {
324:       alive[i].dying = true;
325:       alive[i].rise.go(t, 0, dur(g.ms.letterOut), easeMain);
326:     }
327:     text = chars.join('');
328:     fitSpacing(chars.length);
329:     if (reduced()) reframeStill(chars.length);
330:     const used = new Set(letters.map((l) => l.lane));
331:     const n = chars.length;
332:     for (let i = keep; i < n; i++) {
333:       const [x, z] = slot(i, n);
334:       const lane = chars[i] === ' ' || !gb ? -1 : gb.nearestLane(x, z, used);
335:       if (lane >= 0) used.add(lane);
336:       const l: Letter = {
337:         char: chars[i],
338:         index: i,
339:         lane,
