 84:   const page = await context.newPage();
 85:   for (const route of ['/leaflink', '/sidequests']) {
 86:     await page.goto(`${DEV}${route}?world=0`, { waitUntil: 'domcontentloaded' });
 87:     await page.waitForSelector('.jp-keymap', { timeout: 30000 });
