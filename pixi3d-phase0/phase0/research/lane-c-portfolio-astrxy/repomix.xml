 485:   function updateClearColor(): void {
 486:     let r = 0;
 487:     let g = 0;
 488:     let b = 0;
 489:     for (let i = 0; i < LAYOUT_ORDER.length; i++) {
 490:       r += groundWeights[i] * GROUNDS[i][0];
 491:       g += groundWeights[i] * GROUNDS[i][1];
 492:       b += groundWeights[i] * GROUNDS[i][2];
