187: async function startSampler(page: Page): Promise<void> {
188:   await page.evaluate(() => {
189:     const w = window as unknown as Record<string, unknown>;
190:     w.__camSamples = [];
191:     w.__camStop = false;
192:     const tick = (): void => {
193:       if (w.__camStop === true) return;
194:       const lf = window.__lanefield;
195:       // Only rendered frames count: __lanefield exists before the
196:       // first render (calls 0, pose already at rest), and ready
197:       // flips only after that first render completes.
198:       if (lf && lf.ready === true) {
199:         const c = lf.camera;
200:         const morph = (window as unknown as Record<string, { sample?: { p?: number } | null }>).__morph;
201:         (w.__camSamples as Sample[]).push({
202:           pitch: c.pitchDeg,
203:           yaw: c.yawDeg,
204:           laneCount: lf.laneCount,
205:           calls: lf.info().calls,
206:           morphP: morph?.sample?.p ?? null,
207:         });
208:       }
209:       requestAnimationFrame(tick);
210:     };
211:     requestAnimationFrame(tick);
212:   });
213: }
