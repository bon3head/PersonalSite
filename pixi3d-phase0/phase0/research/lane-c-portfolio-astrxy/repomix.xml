393:     const step = Math.floor(t / g.ms.noiseStep);
394:     const amp = noise.value(t);
395:     const sc = scale.value(t);
396:     const sx = shiftX.value(t);
397:     const sz = shiftZ.value(t);
398:     const lanes: number[] = [];
399:     const offsets: number[] = [];
400:     for (const l of letters) {
401:       const r = l.rise.value(t);
402:       if (l.lane < 0) continue;
403:       gb.laneTip(l.lane, tip);
404:       const n1 = amp * s(openSeed, P.noise, step * 64 + l.index);
405:       const n2 = amp * 0.5 * s(openSeed, P.noise, step * 64 + l.index + 32);
406:       const ox = (l.x.value(t) + sx + right[0] * n2 - tip[0]) * r;
407:       const oz = (l.z.value(t) + sz + right[1] * n2 - tip[2]) * r;
408:       const oy = (l.h.value(t) * sc + n1) * r;
409:       if (r > 0) {
410:         lanes.push(l.lane);
411:         offsets.push(ox, oy, oz);
412:       }
413:       glyphPos[0] = tip[0] + ox;
414:       glyphPos[1] = tip[1] + oy;
415:       glyphPos[2] = tip[2] + oz;
416:       placeGlyph(l, glyphPos, r, step);
417:     }
418:     gb.writeLanes(lanes, new Float32Array(offsets));
