532:       }
533:     },
534:     dispose(): void {
535:       if (disposed) return;
536:       disposed = true;
537:       off();
538:       clearWords();
539:       for (const row of pool) {
540:         for (const m of row) {
541:           field.scene.remove(m);
542:           m.dispose();
543:         }
544:       }
545:       measure.dispose();
546:     },
547:     activeWords(): string[] {
548:       return actives.filter((w) => w.glyphs.some((g) => g.mesh.visible)).map((w) => w.text);
549:     },
550:     spawnedWords(): string[] {
551:       return [...spawned];
552:     },
553:     isPaused(): boolean {
554:       return paused;
