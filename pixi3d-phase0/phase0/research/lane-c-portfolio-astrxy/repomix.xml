204: async function analyzeScreenshot(
205:   page: import('@playwright/test').Page,
206:   groundHex: string | null,
207: ): Promise<{ lanePixels: number; inBand: number; darkColored: number; darkInBand: number }> {
208:   const shot = await page.screenshot();
209:   const b64 = shot.toString('base64');
210:   return page.evaluate(
211:     async ({ b64, groundHex }) => {
212:       const src = (window as unknown as { __oklabSrc: string }).__oklabSrc;
213:       const run = new Function(
214:         'b64',
215:         'groundHex',
216:         `${src}; return (async () => {
217:           const img = new Image();
218:           img.src = 'data:image/png;base64,' + b64;
219:           await img.decode();
220:           const cv = document.createElement('canvas');
221:           cv.width = img.width; cv.height = img.height;
222:           const ctx = cv.getContext('2d', { willReadFrequently: true });
223:           ctx.drawImage(img, 0, 0);
224:           const data = ctx.getImageData(0, 0, cv.width, cv.height).data;
225:           let gL = 0, ga = 0, gb2 = 0;
226:           if (groundHex) {
227:             const gr = parseInt(groundHex.slice(1, 3), 16);
228:             const gg = parseInt(groundHex.slice(3, 5), 16);
229:             const gb = parseInt(groundHex.slice(5, 7), 16);
230:             [gL, ga, gb2] = toOklab(gr, gg, gb);
231:           }
232:           let lanePixels = 0, inBand = 0, darkColored = 0, darkInBand = 0;
233:           for (let i = 0; i < data.length; i += 4) {
234:             const [L, a, b] = toOklab(data[i], data[i + 1], data[i + 2]);
235:             const d = Math.sqrt((L - gL) ** 2 + (a - ga) ** 2 + (b - gb2) ** 2);
236:             const chroma = Math.sqrt(a * a + b * b);
237:             const hue = hueDeg(a, b);
238:             if (groundHex && d > 0.05) {
239:               lanePixels++;
240:               if (chroma < 0.04 || (hue >= 230 && hue <= 285)) inBand++;
241:             }
242:             if (L < 0.35 && chroma > 0.04) {
243:               darkColored++;
244:               if (hue >= 230 && hue <= 285) darkInBand++;
245:             }
246:           }
247:           return { lanePixels, inBand, darkColored, darkInBand };
248:         })();`,
249:       );
250:       return run(b64, groundHex) as Promise<{
251:         lanePixels: number;
252:         inBand: number;
253:         darkColored: number;
254:         darkInBand: number;
255:       }>;
256:     },
257:     { b64, groundHex },
258:   );
259: }
