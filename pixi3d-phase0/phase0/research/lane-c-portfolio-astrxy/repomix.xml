100:   await page.goto(`${DEV}/?world=0`, { waitUntil: 'domcontentloaded' });
101:   await page.waitForSelector('.jp-keymap', { timeout: 30000 });
102:   await openSheet(page, 'w');
103:   expect((await markState(page)).count, 'server whoami open count').toBe(0);
104:   await closeSheet(page, 'w');
105:   expect((await markState(page)).count, 'server whoami closed count').toBe(0);
106:   await context.close();
107: });
