<file path="src/lib/coarse.ts">
 1: // The coarse variant as a React value (polish round). Same rule as the
 2: // camera variant (src/world/camera.ts isCoarseVariant): narrow, or a
 3: // coarse pointer below desktop width. Readout docking of the SideQuests
 4: // trail controls and the marker buttons both read this one hook, so
 5: // they always agree within a render. The server snapshot is false
 6: // (fine), and React re-renders after hydration on a phone.
 7: import { useSyncExternalStore } from 'react';
 8: import { T } from '../tokens.generated';
 9: 
10: const QUERY =
11:   `(max-width: ${T.breakpoints.coarseOrNarrowBelowPx - 1}px), ` +
12:   `(pointer: coarse) and (max-width: ${T.breakpoints.desktopFromPx - 1}px)`;
13: 
14: function subscribe(cb: () => void): () => void {
15:   const mq = window.matchMedia(QUERY);
16:   mq.addEventListener('change', cb);
17:   return () => mq.removeEventListener('change', cb);
18: }
19: 
20: function snapshot(): boolean {
21:   return window.matchMedia(QUERY).matches;
22: }
23: 
24: export function useCoarse(): boolean {
25:   return useSyncExternalStore(subscribe, snapshot, () => false);
26: }
</file>

<file path="src/motion/hero-descriptors.ts">
  1: // Hero descriptors (P-MORPH-1, DESIGN section 6.7 hero table, S03).
  2: // One descriptor per route: the hero kind, the ground anchor the
  3: // deflection ring and the silhouette disc center on, the ring radius,
  4: // and the silhouette center and radius overrides. W6 mounts BrandHero
  5: // from these descriptors; it needs no shader change, because the
  6: // engine already accepts silhouetteCenter and silhouetteRadius
  7: // overrides through setParams (P-LF-4b), and the morph controller
  8: // drives the same fields through the lane params during travel.
  9: //
 10: // Anchor source: the scene camera pose target (fine variant
 11: // canonical), ground-projected to [x, z]. That is the scene focal
 12: // point the ring already grew around in W4; the descriptor makes
 13: // that choice explicit and addressable instead of leaving it derived
 14: // inside the engine. The leaflink and sidequests pose targets are
 15: // identical across variants in the tokens, so the project anchors
 16: // are variant-stable where the ring and silhouette matter; field
 17: // routes carry ring 0, so their anchor variance is immaterial.
 18: // Ring radius is the scene light radius token for the route;
 19: // field routes have ring 0 and no mark.
 20: //
 21: // Mask UV orientation note for W6: the mask UV mapping in
 22: // src/world/silhouette.ts grows u with world x and v with world z,
 23: // and the mask texture is uploaded with flipY false. If the mounted
 24: // hero shows the silhouette bunching mirrored, flip v in that mapping;
 25: // do not change the descriptor values to compensate, since the disc
 26: // center and radius are world geometry, not texture orientation.
 27: import { T } from '../tokens.generated';
 28: import { poseFor } from '../world/camera';
 29: import type { LayoutId, SilhouetteMaskKind } from '../world/types';
 30: import type { LaneParams } from '../world/types';
 31: 
 32: export type HeroKind = 'field' | 'mark' | 'field-quiet';
 33: 
 34: export interface HeroDescriptor {
 35:   layout: LayoutId;
 36:   kind: HeroKind;
 37:   // Ground anchor [x, z] for the ring and the silhouette disc.
 38:   anchor: [number, number];
 39:   ringRadius: number;
 40:   silhouetteCenter: [number, number];
 41:   silhouetteRadius: number;
 42:   maskKind: SilhouetteMaskKind;
 43:   heroSizePx: number;
 44: }
 45: 
 46: function lightRadiusFor(layout: LayoutId): number {
 47:   const route = layout === 'scatter' ? 'server' : layout;
 48:   return (T.scene[route].gradient as { light: { radius: number } }).light.radius;
 49: }
 50: 
 51: export function descriptorForLayout(
 52:   layout: LayoutId,
 53:   variant: 'coarse' | 'fine' = 'fine',
 54: ): HeroDescriptor {
 55:   const pose = poseFor(layout, variant);
 56:   const anchor: [number, number] = [pose.target[0], pose.target[2]];
 57:   const heroSizePx = T.hero.sizePx;
 58:   if (layout === 'leaflink') {
 59:     const radius = lightRadiusFor(layout);
 60:     return {
 61:       layout,
 62:       kind: 'mark',
 63:       anchor,
 64:       ringRadius: radius,
 65:       silhouetteCenter: [...anchor],
 66:       silhouetteRadius: radius,
 67:       maskKind: 'leaflink',
 68:       heroSizePx,
 69:     };
 70:   }
 71:   if (layout === 'sidequests') {
 72:     const radius = lightRadiusFor(layout);
 73:     return {
 74:       layout,
 75:       kind: 'mark',
 76:       anchor,
 77:       ringRadius: radius,
 78:       silhouetteCenter: [...anchor],
 79:       silhouetteRadius: radius,
 80:       maskKind: 'sidequests',
 81:       heroSizePx,
 82:     };
 83:   }
 84:   return {
 85:     layout,
 86:     kind: 'field',
 87:     anchor,
 88:     ringRadius: 0,
 89:     silhouetteCenter: [...anchor],
 90:     silhouetteRadius: 0,
 91:     maskKind: 'none',
 92:     heroSizePx,
 93:   };
 94: }
 95: 
 96: // Apply a descriptor to a param set: the ring and silhouette fields
 97: // take the descriptor values, everything else is untouched. W6 calls
 98: // this when it mounts a hero; the morph controller applies the same
 99: // fields per frame during travel.
100: export function applyDescriptorToParams(
101:   params: LaneParams,
102:   descriptor: HeroDescriptor,
103: ): LaneParams {
104:   return {
105:     ...params,
106:     ringCenter: [...descriptor.anchor],
107:     ringRadius: descriptor.ringRadius,
108:     silhouetteCenter: [...descriptor.silhouetteCenter],
109:     silhouetteRadius: descriptor.silhouetteRadius,
110:     silhouetteMask: descriptor.maskKind,
111:   };
112: }
</file>

<file path="src/motion/stage.ts">
 1: // Stage events (polish item 3, DESIGN section 6.12): one interaction
 2: // grammar shared by both project pages.
 3: //
 4: //   subject  the page verb started (LeafLink visitor match routing,
 5: //            SideQuests trail walk). The hero recedes and the camera
 6: //            pans the subject's ground point into the hero's clear
 7: //            spot, so the thing the visitor caused is what they see.
 8: //   land     the subject finished (route reached the request, trail
 9: //            claimed). A ring pulse departs from the subject's screen
10: //            position and travels into the mark; the mark looms back
11: //            with one land beat. This is the image-to-message link:
12: //            what happened on the map lands in the project's mark.
13: //   beat     an ambient event on the page (any LeafLink match lands):
14: //            one small beat on the mark, never on a timer.
15: //   release  the story is over: the camera pan returns to rest.
16: //
17: // Controllers emit; BrandHero is the only listener that moves the
18: // camera or the mark, so there is exactly one owner for each.
19: import type { LayoutId } from '../world/types';
20: 
21: export type StageLayout = Extract<LayoutId, 'leaflink' | 'sidequests'>;
22: 
23: export type StageEvent =
24:   | { type: 'subject'; layout: StageLayout; ground: [number, number] }
25:   | { type: 'land'; layout: StageLayout; ground: [number, number] }
26:   | { type: 'beat'; layout: StageLayout }
27:   | { type: 'release'; layout: StageLayout };
28: 
29: type Listener = (e: StageEvent) => void;
30: 
31: const listeners = new Set<Listener>();
32: 
33: export function emitStage(e: StageEvent): void {
34:   for (const l of [...listeners]) l(e);
35: }
36: 
37: export function onStage(cb: Listener): () => void {
38:   listeners.add(cb);
39:   return () => {
40:     listeners.delete(cb);
41:   };
42: }
</file>

