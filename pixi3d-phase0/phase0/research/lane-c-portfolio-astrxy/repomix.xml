  1: // App (S04 section 3): the DOM layer that persists across scenes.
  2: // Page structure is exactly S04 section 3: wordmark, main with the
  3: // readout and the canvas-region description, keymap nav, announcement region,
  4: // sheets. One h1 per scene (the readout heading). No header, no
  5: // footer.
  6: //
  7: // Wiring:
  8: // - Theme mode follows data-regime (B1 integration contract): void and
  9: //   field are dark, paper is light. A MutationObserver keeps mode in
 10: //   sync when travel flips the regime.
 11: // - Router (S03) owns URL state; its onSceneChange runs travel, whose
 12: //   onSwap swaps the rendered readout while it is hidden. The readout
 13: //   section keeps one DOM identity across swaps (Readout renders one
 14: //   section whose content varies by scene), which is what travel
 15: //   manipulates.
 16: // - TravelHotkeys (S03 section 6) is mounted here.
 17: // - The travel controller takes a lanefield prop; main.tsx starts the
 18: //   world on idle but does not hand the instance to App yet, so the
 19: //   prop defaults to null (DOM travel only, reduced timing) until the
 20: //   coordinator wires the world instance through (see BUILD-STATE).
 21: import { lazy, Suspense, useEffect, useRef, useState, type JSX } from 'react';
 22: import { flushSync } from 'react-dom';
 23: import { Theme } from '@astryxdesign/core/theme';
 24: import { LayerProvider } from '@astryxdesign/core';
 25: // B1's laneTheme.mjs ships no declarations, and a sibling .d.ts would
 26: // sit in B1-owned themes/lane/. Suppress the implicit-any import here
 27: // instead; laneTheme is passed straight to Astryx Theme as-is.
 28: // @ts-ignore: untyped B1-owned module, no declarations shipped
 29: import { laneTheme } from '../themes/lane/laneTheme.mjs';
 30: import '../themes/lane/dist/lane.css';
 31: import './chrome/chrome.css';
 32: import {
 33:   createRouter,
 34:   parseHash,
 35:   parsePath,
 36:   stepScene,
 37:   TravelHotkeys,
 38:   REGIME_COLOR_SCHEME,
 39:   SCENE_REGIME,
 40:   type Router,
 41:   type SceneId,
 42:   type SheetId,
 43: } from './router';
 44: import {
 45:   applyRegime,
 46:   createTravelController,
 47:   type SceneController,
 48:   type TravelController,
 49: } from './travel';
 50: import { prefersReducedMotion } from './lib/reducedMotion';
 51: import type { Lanefield } from './world/types';
 52: import { createServerController, type ServerController } from './world/server';
 53: import {
 54:   createLeaflinkController,
 55:   type LeaflinkController,
 56: } from './world/leaflink';
 57: import {
 58:   createSideQuestsController,
 59:   type SideQuestsController,
 60: } from './world/sidequests';
 61: import { createNotfoundController } from './world/notfound';
 62: import SideQuestsTwins, { MARKER_LABELS, useTrailClaims } from './scenes/sidequests';
 63: import { useGlitterbox } from './chrome/glitterbox';
 64: import { T } from './tokens.generated';
 65: import type { Rect } from './hero/heroGeometry';
 66: import BrandHero from './hero/BrandHero';
 67: import { C } from './copy';
 68: import Keymap from './chrome/Keymap';
 69: import Wordmark from './chrome/Wordmark';
 70: import Readout from './chrome/Readout';
 71: // Sheets load on demand: the BottomSheet closure is the largest
 72: // astryx cost not needed for first paint, and both sheets start
 73: // closed. A mount effect preloads them on idle so the first open
 74: // is instant; Suspense fallback null matches a closed sheet.
 75: const WhoamiSheet = lazy(() => import('./chrome/WhoamiSheet'));
 76: const ContactSheet = lazy(() => import('./chrome/ContactSheet'));
 77: const GuestbookSheet = lazy(() => import('./chrome/GuestbookSheet'));
 78: import { entropySeed } from './motion/entropy';
 79: 
 80: // Polish item 5: read ?seed before the router's first pushState drops
 81: // the query (the first draw happens inside travel, after the push), so
 82: // a seeded URL replays. Browser only; prerender never draws.
 83: if (typeof window !== 'undefined') entropySeed();
 84: 
 85: export interface AppProps {
 86:   initialScene?: SceneId;
 87:   initialSheet?: SheetId;
 88:   lanefield?: Lanefield | null;
 89: }
 90: 
 91: function initialSceneFromLocation(): SceneId {
 92:   if (typeof window === 'undefined') return 'server';
 93:   return parsePath(window.location.pathname);
 94: }
 95: 
 96: function initialSheetFromLocation(): SheetId {
 97:   if (typeof window === 'undefined') return null;
 98:   return parseHash(window.location.hash);
 99: }
100: 
101: const SCENE_ALT: Record<SceneId, string | null> = {
102:   server: C['C-SRV-ALT'],
103:   leaflink: C['C-LL-ALT'],
104:   sidequests: C['C-SQ-ALT'],
105:   // No C-404-ALT exists in S09; the 404 canvas region has no
106:   // description string, so no role=img div renders on 404 rather than
107:   // inventing one.
108:   notfound: null,
109: };
110: 
111: export default function App(props: AppProps): JSX.Element {
112:   const initialScene = props.initialScene ?? initialSceneFromLocation();
113:   const initialSheet = props.initialSheet ?? initialSheetFromLocation();
114:   // Rendered scene: swaps at travel's hidden point (onSwap), not at
115:   // go(), so the readout content never changes while visible.
116:   const [scene, setScene] = useState<SceneId>(initialScene);
117:   const [sheet, setSheet] = useState<SheetId>(initialSheet);
118:   // Mounted flips true in a mount effect. The sheets are lazy and
119:   // must not render during hydration: a lazy component suspending
120:   // on the hydration pass throws React error 419 (measured: the
121:   // baseline is clean, the un-gated lazy sheets throw at ~400ms).
122:   // Both sheets start closed, so rendering them only after mount
123:   // is behavior-identical; the server and the hydration pass both
124:   // render no sheet content.
125:   const [mounted, setMounted] = useState(false);
126:   // The guestbook chunk loads on first request only (it shares the
127:   // engine chunk), and stays mounted after that so its close can move.
128:   const [gbRequested, setGbRequested] = useState(initialSheet === 'guestbook');
129:   useEffect(() => {
130:     if (sheet === 'guestbook') setGbRequested(true);
131:     // Warm the guestbook chunk while Contact (its one entry) is open,
132:     // so Leave a mark opens without a load gap.
133:     if (sheet === 'contact') void import('./chrome/GuestbookSheet');
134:   }, [sheet]);
135:   const [mode, setMode] = useState<'dark' | 'light'>(
136:     () => REGIME_COLOR_SCHEME[SCENE_REGIME[initialScene]],
137:   );
138: 
139:   const readoutRef = useRef<HTMLElement | null>(null);
140:   const liveRef = useRef<HTMLDivElement | null>(null);
141:   const mainRef = useRef<HTMLElement | null>(null);
142:   const whoamiButtonRef = useRef<HTMLButtonElement | null>(null);
143:   const contactButtonRef = useRef<HTMLButtonElement | null>(null);
144:   const routerRef = useRef<Router | null>(null);
145:   const travelRef = useRef<TravelController | null>(null);
146:   // Scene controllers, created when the world arrives (lanefield-ready).
147:   // The Map object is shared with the travel controller by reference,
148:   // so populating it later still drives pause/resume on travel.
149:   const controllersRef = useRef<Map<SceneId, SceneController>>(new Map());
150:   // Wired field + controllers for rendering (twins, OfferButton). Null
151:   // until the world arrives; the App shows lanes + readout only.
152:   const [wired, setWired] = useState<{
153:     field: Lanefield;
154:     leaflink: LeaflinkController;
155:     sidequests: SideQuestsController;
156:   } | null>(null);
157: 
158:   // Theme mode follows data-regime (B1 contract).
159:   useEffect(() => {
160:     const sync = (): void => {
161:       const regime = document.documentElement.getAttribute('data-regime');
162:       setMode(regime === 'paper' ? 'light' : 'dark');
163:     };
164:     sync();
165:     const observer = new MutationObserver(sync);
166:     observer.observe(document.documentElement, {
167:       attributes: true,
168:       attributeFilter: ['data-regime'],
169:     });
170:     return () => observer.disconnect();
171:   }, []);
172: 
173:   // Preload the sheet chunks on idle: the sheets are lazy (their
174:   // BottomSheet closure is not needed for first paint), but the
175:   // first open must feel instant, so warm the cache after mount.
176:   // requestIdleCallback with a setTimeout fallback, same shape as
177:   // main.tsx startOnIdle. Also flips mounted, which gates the
178:   // lazy sheets off the hydration pass (see the mounted state).
179:   useEffect(() => {
180:     setMounted(true);
181:     const preload = (): void => {
182:       void import('./chrome/WhoamiSheet');
183:       void import('./chrome/ContactSheet');
184:     };
185:     const ric = (
186:       window as unknown as {
187:         requestIdleCallback?: (cb: () => void) => void;
188:       }
189:     ).requestIdleCallback;
190:     if (ric) {
191:       ric(preload);
192:     } else {
193:       setTimeout(preload, 0);
194:     }
195:   }, []);
196: 
197:   // Router + travel, created once, disposed on unmount.
198:   useEffect(() => {
199:     // Create scene controllers for a field (or clear them). Called once
200:     // if the App mounts with a field, and on every lanefield-ready.
201:     const wireField = (field: Lanefield | null): void => {
202:       if (field) {
203:         const server = createServerController(field, {
204:           reducedMotion: prefersReducedMotion(),
205:         });
206:         const leaflink = createLeaflinkController(field, {
207:           target: document.getElementById('world'),
208:           reducedMotion: prefersReducedMotion(),
209:         });
210:         const sidequests = createSideQuestsController(field, {
211:           reducedMotion: prefersReducedMotion,
212:         });
213:         const notfound = createNotfoundController();
214:         controllersRef.current.set('server', server);
215:         controllersRef.current.set('leaflink', leaflink);
216:         controllersRef.current.set('sidequests', sidequests);
217:         controllersRef.current.set('notfound', notfound);
218:         // P-MORPH-1 sub-task 1: pause every non-active controller at
219:         // wire time. Controllers used to start unpaused and pause
220:         // only on travel away, so a direct load to an inactive
221:         // scene's route never paused the others and their ambient
222:         // sims rendered into the shared scene over the active scene.
223:         // The active route is the travel controller's current scene
224:         // (not the mount route: the visitor may have traveled before
225:         // the world arrived). Travel resumes the target controller
226:         // at morph end, so no controller stays paused after its
227:         // route is visited.
228:         const active = travelRef.current?.current ?? initialScene;
229:         for (const [id, controller] of controllersRef.current) {
230:           if (id !== active) controller.pause();
231:         }
232:         setWired({ field, leaflink, sidequests });
233:         // Test hook: scene tests pause controllers to measure lanes
234:         // without scene text (S05 T-SRV-2 excludes text pixels).
235:         (window as unknown as {
236:           __sceneControllers?: Map<SceneId, SceneController>;
237:         }).__sceneControllers = controllersRef.current;
238:       } else {
239:         controllersRef.current.clear();
240:         setWired(null);
241:         delete (window as unknown as {
242:           __sceneControllers?: Map<SceneId, SceneController>;
243:         }).__sceneControllers;
244:       }
245:     };
246:     const travel = createTravelController(initialScene, {
247:       lanefield: props.lanefield ?? null,
248:       controllers: controllersRef.current,
249:       dom: {
250:         readout: () => readoutRef.current,
251:         announce: () => liveRef.current,
252:         busy: () => mainRef.current,
253:         keymap: () => document.querySelector('.jp-keymap'),
254:         keymapItem: (s: SceneId) =>
255:           document.querySelector(`[data-scene="${s}"]`),
256:       },
257:       isReducedMotion: prefersReducedMotion,
258:       // Synchronous commit (polish round): the incoming readout and the
259:       // hero mount, lay out, and register the hero anchor inside the
260:       // swap callback, before the next frame samples the morph.
261:       onSwap: (next: SceneId) => flushSync(() => setScene(next)),
262:     });
263:     travelRef.current = travel;
264:     const router = createRouter(
265:       { scene: initialScene, sheet: initialSheet },
266:       {
267:         onSceneChange: (next: SceneId) => {
268:           void travel.travelTo(next);
269:         },
270:         onSheetChange: (next: SheetId) => setSheet(next),
271:       },
272:     );
273:     routerRef.current = router;
274:     applyRegime(initialScene);
275:     // The world starts on idle in main.tsx, after App mounts. When it
276:     // arrives, attach it so scene changes morph lanes, and create the
277:     // scene controllers so travel pause/resume drives words, sim, and
278:     // markers. wireField pauses every non-active controller, so only
279:     // the active route's controller simulates at mount.
280:     const onLanefield = (event: Event): void => {
281:       const detail = (event as CustomEvent).detail as Lanefield | null;
282:       travel.setLanefield(detail ?? null);
283:       wireField(detail);
284:     };
285:     window.addEventListener('lanefield-ready', onLanefield);
286:     // WIRING-FIX: the event is one-shot and may already have fired
287:     // before this effect ran (WebKit / stock Safari: no
288:     // requestIdleCallback, so main.tsx's setTimeout(0) fallback
289:     // dispatches before createRoot's concurrent render runs this
290:     // effect). If main.tsx already recorded the instance in
291:     // __lanefieldReady, wire it now instead of waiting for an event
292:     // that will never re-fire. The listener above still covers the
293:     // other ordering (field arriving after mount). The props path
294:     // is unchanged and takes precedence when both are present, so
295:     // the field is wired exactly once here.
296:     const alreadyReady = (window as unknown as {
297:       __lanefieldReady?: Lanefield;
298:     }).__lanefieldReady;
299:     const existing = props.lanefield ?? alreadyReady ?? null;
300:     if (existing) {
301:       travel.setLanefield(existing);
302:       wireField(existing);
303:     }
304:     return () => {
305:       window.removeEventListener('lanefield-ready', onLanefield);
306:       router.dispose();
307:       travel.dispose();
308:       for (const c of controllersRef.current.values()) {
309:         (c as { dispose?: () => void }).dispose?.();
310:       }
311:       controllersRef.current.clear();
312:       delete (window as unknown as {
313:         __sceneControllers?: Map<SceneId, SceneController>;
314:       }).__sceneControllers;
315:       routerRef.current = null;
316:       travelRef.current = null;
317:     };
318:     // eslint-disable-next-line react-hooks/exhaustive-deps
319:   }, []);
320: 
321:   // Guestbook open (DESIGN 6.14, S05 1.2.0): the server words step out
322:   // of the field so the mark has it to itself.
323:   useEffect(() => {
324:     const server = controllersRef.current.get('server') as ServerController | undefined;
325:     server?.setHidden?.(sheet === 'guestbook');
326:   }, [sheet, wired]);
327: 
328:   // Polish round wiring (DESIGN 6.12, 6.13).
329:   const claims = useTrailClaims(wired?.sidequests ?? null);
330:   const lastWalkRef = useRef<number>(-1);
331:   const walkTrail = wired
332:     ? (i: number): void => {
333:         lastWalkRef.current = i;
334:         wired.sidequests.walk(i);
335:       }
336:     : null;
337:   // SideQuests page verb from the mark: the first open trail, else the
338:   // next one after the last walked.
339:   const nextTrail = (): number => {
340:     const open = claims.findIndex((c) => !c);
341:     return open >= 0 ? open : (lastWalkRef.current + 1) % MARKER_LABELS.length;
342:   };
343:   // Marker tap targets at rest (resting projection, not the moving camera).
344:   const sqRestBlockers = wired
345:     ? (): Rect[] => {
346:         const r = T.world.sidequests.marker.hitRadiusPx;
347:         return MARKER_LABELS.map((_, i) => {
348:           const [x, y] = wired.field.projectAtRest('sidequests', wired.sidequests.restHead(i));
349:           return { left: x - r, top: y - r, right: x + r, bottom: y + r };
350:         });
351:       }
352:     : null;
353:   useGlitterbox(wired?.field ?? null, sheet !== null);
354: 
355:   function toggleSheet(target: Exclude<SheetId, null>): void {
356:     const router = routerRef.current;
357:     if (!router) return;
358:     router.setSheet(router.state.sheet === target ? null : target);
359:   }
360: 
361:   const alt = SCENE_ALT[scene];
362: 
363:   return (
364:     <Theme theme={laneTheme} mode={mode}>
365:       <LayerProvider>
366:         <div role="banner">
367:           <Wordmark scene={scene} />
368:         </div>
369:         <main id="scene" aria-busy="false" ref={mainRef}>
370:           <Readout
371:             scene={scene}
372:             sectionRef={readoutRef}
373:           />
374:           {scene === 'sidequests' && wired && (
375:             <SideQuestsTwins
376:               controller={wired.sidequests}
377:               lanefield={wired.field}
378:             />
379:           )}
380:           {/* P-HERO-1: exactly one brand mark per project route, none
381:               on server. Device run 4: the hero stays mounted when
382:               a sheet opens, so a whoami or contact sheet still
383:               shows the mark, and it renders before the field
384:               arrives (or with no field at all, the F3 path), so
385:               the mark never depends on WebGL. wired is null until
386:               lanefield-ready; the hero takes the field when it
387:               exists and null otherwise. */}
388:           {scene === 'leaflink' && (
389:             <BrandHero
390:               project="leaflink"
391:               lanefield={wired?.field ?? null}
392:               onVerb={wired ? () => wired.leaflink.dropOfferAtCenter() : null}
393:             />
394:           )}
395:           {scene === 'sidequests' && (
396:             <BrandHero
397:               project="sidequests"
398:               lanefield={wired?.field ?? null}
399:               onVerb={walkTrail ? () => walkTrail(nextTrail()) : null}
400:               restBlockers={sqRestBlockers}
401:             />
402:           )}
403:           {alt !== null && (
404:             <div role="img" aria-label={alt} />
405:           )}
406:         </main>
407:         <Keymap
408:           scene={scene}
409:           sheet={sheet}
410:           onToggleSheet={toggleSheet}
411:           whoamiButtonRef={whoamiButtonRef}
412:           contactButtonRef={contactButtonRef}
413:         />
414:         <div
415:           className="jp-live"
416:           aria-live="polite"
417:           aria-atomic="true"
418:           ref={liveRef}
419:         />
420:         {mounted && (
421:           <Suspense fallback={null}>
422:             <WhoamiSheet
423:               isOpen={sheet === 'whoami'}
424:               onOpenChange={(open) => {
425:                 if (!open) routerRef.current?.setSheet(null);
426:               }}
427:               finalFocusRef={whoamiButtonRef}
428:             />
429:             <ContactSheet
430:               isOpen={sheet === 'contact'}
431:               onOpenChange={(open) => {
432:                 if (!open) routerRef.current?.setSheet(null);
433:               }}
434:               finalFocusRef={contactButtonRef}
435:               onLeaveMark={() => routerRef.current?.setSheet('guestbook')}
436:             />
437:           </Suspense>
438:         )}
439:         {mounted && gbRequested && (
440:           <Suspense fallback={null}>
441:             <GuestbookSheet
442:               isOpen={sheet === 'guestbook'}
443:               onRequestClose={() => routerRef.current?.setSheet(null)}
444:               field={wired?.field ?? null}
445:               finalFocusRef={contactButtonRef}
446:             />
447:           </Suspense>
448:         )}
449:         <TravelHotkeys
450:           go={(next: SceneId) => routerRef.current?.go(next)}
451:           step={(dir: 1 | -1) => {
452:             const router = routerRef.current;
453:             if (router) router.go(stepScene(router.state.scene, dir));
454:           }}
455:           toggleSheet={toggleSheet}
456:           sheet={sheet}
457:         />
458:       </LayerProvider>
459:     </Theme>
460:   );
461: }
</file>

