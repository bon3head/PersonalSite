  1: // GuestbookSheet (DESIGN 6.14). A sheet in the router's sense (hash
  2: // #guestbook over the current scene), not a page and not a card: the
  3: // lane field is the surface. Two prompt lines with no labels above
  4: // them, a pill to lock in, and a seed readout. The 3D motion lives in
  5: // the field (src/motion/guestbook.ts); this panel moves in depth on
  6: // translateZ under perspective, never on opacity.
  7: //
  8: // Storage is browser-local only (Justin, 2026-11-10). storeSignature
  9: // (src/lib/guestbookStore) is the single hook, and the sheet says so.
 10: import type { FormEvent, JSX, KeyboardEvent as ReactKeyboardEvent, RefObject } from 'react';
 11: import { useEffect, useRef, useState } from 'react';
 12: import { C } from '../copy';
 13: import { T } from '../tokens.generated';
 14: import type { Lanefield } from '../world/types';
 15: import { createGuestbookDirector, type GuestbookDirector, type GuestbookPanelSource } from '../motion/guestbook';
 16: import { makeSignature, readSignatures, storeSignature, type Signature } from '../lib/guestbookStore';
 17: 
 18: export interface GuestbookSheetProps {
 19:   isOpen: boolean;
 20:   onRequestClose: () => void;
 21:   field: Lanefield | null;
 22:   finalFocusRef: RefObject<HTMLElement | null>;
 23: }
 24: 
 25: type Stage = 'write' | 'locking' | 'done';
 26: 
 27: export default function GuestbookSheet(props: GuestbookSheetProps): JSX.Element | null {
 28:   const { isOpen, field } = props;
 29:   // mounted: rendered at all (stays true through the exit move).
 30:   // shown: the panel sits at depth 0 (false is pushed back in depth).
 31:   const [mounted, setMounted] = useState(isOpen);
 32:   const [shown, setShown] = useState(false);
 33:   const [stage, setStage] = useState<Stage>('write');
 34:   const [name, setName] = useState('');
 35:   const [line, setLine] = useState('');
 36:   const [seedHex, setSeedHex] = useState('');
 37:   const [ledger, setLedger] = useState<Signature[]>([]);
 38:   const glyphRef = useRef<HTMLDivElement | null>(null);
 39:   const panelRef = useRef<HTMLFormElement | null>(null);
 40:   const nameRef = useRef<HTMLInputElement | null>(null);
 41:   const lineRef = useRef<HTMLInputElement | null>(null);
 42:   const doneRef = useRef<HTMLParagraphElement | null>(null);
 43:   const directorRef = useRef<GuestbookDirector | null>(null);
 44:   const directorFieldRef = useRef<Lanefield | null>(null);
 45:   const rootRef = useRef<HTMLDivElement | null>(null);
 46:   const liftRef = useRef(0);
 47:   const panelSrc = (): GuestbookPanelSource | null =>
 48:     panelRef.current ? { panel: panelRef.current, lift: () => liftRef.current } : null;
 49: 
 50:   // Keyboard (DESIGN 6.14, 1.6.0): the visual viewport tells how much of
 51:   // the layout viewport the keyboard covers; the panel lifts by exactly
 52:   // that on translateY, and the director re-frames the well above it.
 53:   useEffect(() => {
 54:     if (!mounted) return;
 55:     const vv = window.visualViewport;
 56:     const update = (): void => {
 57:       const root = rootRef.current;
 58:       if (!root) return;
 59:       const panel = panelRef.current;
 60:       const covered = vv ? root.clientHeight - (vv.offsetTop + vv.height) : 0;
 61:       // The panel's resting gap to the layout bottom (keymap plus gutter);
 62:       // over the keyboard it keeps one gutter (the panel's own inset).
 63:       const restGap = panel ? root.clientHeight - (panel.offsetTop + panel.offsetHeight) : 0;
 64:       const gutter = panel ? parseFloat(getComputedStyle(panel).left) || 0 : 0;
 65:       const lift = covered > 0 ? Math.max(0, Math.round(covered + gutter - restGap)) : 0;
 66:       if (lift !== liftRef.current) {
 67:         liftRef.current = lift;
 68:         root.style.setProperty('--jp-gb-lift', `${lift}px`);
 69:       }
 70:       directorRef.current?.reframe();
 71:     };
 72:     update();
 73:     vv?.addEventListener('resize', update);
 74:     vv?.addEventListener('scroll', update);
 75:     window.addEventListener('resize', update);
 76:     return () => {
 77:       vv?.removeEventListener('resize', update);
 78:       vv?.removeEventListener('scroll', update);
 79:       window.removeEventListener('resize', update);
 80:       // A remount starts from no lift, so its first update always writes.
 81:       liftRef.current = 0;
 82:     };
 83:   }, [mounted]);
 84: 
 85:   // Open and close. The director is created per open so it binds the
 86:   // field as it is now (the field may arrive after first paint).
 87:   useEffect(() => {
 88:     if (isOpen) {
 89:       setMounted(true);
 90:       return;
 91:     }
 92:     const director = directorRef.current;
 93:     if (!director) {
 94:       setMounted(false);
 95:       return;
 96:     }
 97:     setShown(false);
 98:     let alive = true;
 99:     void director.close().then(() => {
100:       document.documentElement.removeAttribute('data-gb');
101:       if (!alive) return;
102:       director.dispose();
103:       if (directorRef.current === director) directorRef.current = null;
104:       setMounted(false);
105:       props.finalFocusRef.current?.focus();
106:     });
107:     return () => {
108:       alive = false;
109:     };
110:     // eslint-disable-next-line react-hooks/exhaustive-deps
111:   }, [isOpen]);
112: 
113:   useEffect(() => {
114:     if (!mounted || !isOpen) return;
115:     const prev = directorRef.current;
116:     if (prev && directorFieldRef.current === field) return;
117:     if (prev) {
118:       // The field arrived while the sheet was open (deep link before
119:       // the engine started): rebind the director to it, keep the text.
120:       prev.dispose();
121:       const director = createGuestbookDirector(field, glyphRef.current, panelSrc());
122:       directorRef.current = director;
123:       directorFieldRef.current = field;
124:       director.onReadout(setSeedHex);
125:       director.open();
126:       if (stage === 'write') director.setText(name);
127:       if (!panelRef.current?.contains(document.activeElement)) nameRef.current?.focus();
128:       return;
129:     }
130:     const director = createGuestbookDirector(field, glyphRef.current, panelSrc());
131:     directorRef.current = director;
132:     directorFieldRef.current = field;
133:     director.onReadout(setSeedHex);
134:     setStage('write');
135:     setName('');
136:     setLine('');
137:     setLedger(readSignatures());
138:     document.documentElement.setAttribute('data-gb', 'open');
139:     director.open();
140: 
141:     // eslint-disable-next-line react-hooks/exhaustive-deps
142:   }, [mounted, isOpen, field]);
143: 
144:   // The panel's height changes with the stage, and it reaches its
145:   // resting box once shown: re-frame the well and the dim (reduced
146:   // motion has no loop, so this is its only render of the final box).
147:   useEffect(() => {
148:     directorRef.current?.reframe();
149:   }, [stage, ledger, shown]);
150: 
151:   // One frame after mount the panel moves from depth to 0.
152:   useEffect(() => {
153:     if (!mounted || !isOpen) return;
154:     const raf = requestAnimationFrame(() => setShown(true));
155:     return () => cancelAnimationFrame(raf);
156:   }, [mounted, isOpen]);
157: 
158:   // The panel is visibility hidden until shown; focus the prompt then.
159:   useEffect(() => {
160:     if (!shown || !isOpen) return;
161:     const root = panelRef.current;
162:     if (root && !root.contains(document.activeElement)) (nameRef.current ?? doneRef.current)?.focus();
163:   }, [shown, isOpen]);
164: 
165:   // Modal: focus that lands outside the sheet (the Contact sheet
166:   // returning its focus as it closes) comes back to the prompt.
167:   useEffect(() => {
168:     if (!mounted || !isOpen) return;
169:     const onFocusIn = (e: FocusEvent): void => {
170:       const root = panelRef.current?.closest('.jp-gb');
171:       if (root && e.target instanceof Node && !root.contains(e.target)) {
172:         (nameRef.current ?? doneRef.current)?.focus();
173:       }
174:     };
175:     // Escape closes from anywhere, focus inside the sheet or not.
176:     const onKey = (e: KeyboardEvent): void => {
177:       if (e.key !== 'Escape') return;
178:       e.preventDefault();
179:       props.onRequestClose();
180:     };
181:     document.addEventListener('focusin', onFocusIn);
182:     window.addEventListener('keydown', onKey);
183:     return () => {
184:       document.removeEventListener('focusin', onFocusIn);
185:       window.removeEventListener('keydown', onKey);
186:     };
187:     // eslint-disable-next-line react-hooks/exhaustive-deps
188:   }, [mounted, isOpen]);
189: 
190:   useEffect(
191:     () => () => {
192:       document.documentElement.removeAttribute('data-gb');
193:       directorRef.current?.dispose();
194:       directorRef.current = null;
195:     },
196:     [],
197:   );
198: 
199:   if (!mounted) return null;
200: 
201:   function onName(value: string): void {
202:     setName(value);
203:     directorRef.current?.setText(value);
204:   }
205: 
206:   async function lockIn(e: FormEvent): Promise<void> {
207:     e.preventDefault();
208:     const director = directorRef.current;
209:     if (!director || stage !== 'write') return;
210:     if (!name.trim()) {
211:       nameRef.current?.focus();
212:       return;
213:     }
214:     setStage('locking');
215:     const seed = await director.lock();
216:     await storeSignature(makeSignature(name, line, seed));
217:     setLedger(readSignatures());
218:     setStage('done');
219:     setTimeout(() => doneRef.current?.focus(), 0);
220:   }
221: 
222:   function again(): void {
223:     setName('');
224:     setLine('');
225:     setStage('write');
226:     directorRef.current?.again();
227:     setTimeout(() => nameRef.current?.focus(), 0);
228:   }
229: 
230:   // Tab stays inside the sheet (aria-modal).
231:   function onKeyDown(e: ReactKeyboardEvent<HTMLDivElement>): void {
232:     if (e.key !== 'Tab' || !panelRef.current) return;
233:     const items = Array.from(
234:       panelRef.current.querySelectorAll<HTMLElement>('input:not([readonly]), button:not([disabled]), [tabindex="-1"][data-gb-focus]'),
235:     ).filter((el) => el.tabIndex >= 0);
236:     if (items.length === 0) return;
237:     const first = items[0];
238:     const last = items[items.length - 1];
239:     if (e.shiftKey && document.activeElement === first) {
240:       e.preventDefault();
241:       last.focus();
242:     } else if (!e.shiftKey && document.activeElement === last) {
243:       e.preventDefault();
244:       first.focus();
245:     }
246:   }
247: 
248:   const locked = stage !== 'write';
249: 
250:   return (
251:     <div
252:       className="jp-gb"
253:       ref={rootRef}
254:       role="dialog"
255:       aria-modal="true"
256:       aria-label={C['C-GB-LABEL']}
257:       data-shown={shown ? 'true' : 'false'}
258:       onKeyDown={onKeyDown}
259:     >
260:       <div className="jp-gb-catch" aria-hidden="true" onClick={props.onRequestClose} />
261:       <div className="jp-gb-glyphs" aria-hidden="true" ref={glyphRef} />
262:       <form className="jp-gb-panel" ref={panelRef} onSubmit={(e) => void lockIn(e)} noValidate>
263:         {stage !== 'done' && (
264:           <>
265:             <div className="jp-gb-prompt jp-gb-prompt--name">
266:               <span className="jp-gb-caret" aria-hidden="true" />
267:               <input
268:                 ref={nameRef}
269:                 className="jp-gb-input jp-gb-input--name"
270:                 aria-label={C['C-GB-NAME']}
271:                 placeholder={C['C-GB-NAME']}
272:                 value={name}
273:                 maxLength={T.guestbook.nameMaxChars}
274:                 autoComplete="off"
275:                 autoCapitalize="words"
276:                 spellCheck={false}
277:                 enterKeyHint="next"
278:                 readOnly={locked}
279:                 onChange={(e) => onName(e.target.value)}
280:                 onKeyDown={(e) => {
281:                   if (e.key === 'Enter') {
282:                     e.preventDefault();
283:                     if (name.trim()) lineRef.current?.focus();
284:                   }
285:                 }}
286:               />
287:             </div>
288:             <div className="jp-gb-prompt jp-gb-prompt--line">
289:               <span className="jp-gb-caret" aria-hidden="true" />
290:               <input
291:                 ref={lineRef}
292:                 className="jp-gb-input jp-gb-input--line"
293:                 aria-label={C['C-GB-LINE']}
294:                 placeholder={C['C-GB-LINE']}
295:                 value={line}
296:                 maxLength={T.guestbook.lineMaxChars}
297:                 autoComplete="off"
298:                 enterKeyHint="done"
299:                 readOnly={locked}
300:                 onChange={(e) => setLine(e.target.value)}
301:               />
302:             </div>
303:             <div className="jp-gb-row">
304:               <button
305:                 type="submit"
306:                 className="jp-gb-pill jp-gb-pill--primary"
307:                 aria-disabled={!name.trim() || locked}
308:               >
309:                 <span className="jp-gb-dot" aria-hidden="true" />
310:                 <span>{C['C-GB-LOCK']}</span>
311:               </button>
312:               <span className="jp-gb-seed">
313:                 <span>{C['C-GB-SEED']}</span> <span className="jp-gb-seed-hex">{seedHex}</span>
314:               </span>
315:             </div>
316:           </>
317:         )}
318:         {stage === 'done' && (
319:           <>
320:             <p className="jp-gb-done" role="status" tabIndex={-1} data-gb-focus ref={doneRef}>
321:               {C['C-GB-DONE']}
322:             </p>
323:             <p className="jp-gb-note">{C['C-GB-LOCAL']}</p>
324:             <ul className="jp-gb-ledger" aria-label={C['C-GB-LEDGER']}>
325:               {ledger.map((sig) => (
326:                 <li key={`${sig.at}-${sig.seed}`}>
327:                   <span className="jp-gb-ledger-name">{sig.name}</span>
328:                   {sig.line && <span className="jp-gb-ledger-line">{sig.line}</span>}
329:                 </li>
330:               ))}
331:             </ul>
332:             <div className="jp-gb-row">
333:               <button type="button" className="jp-gb-pill jp-gb-pill--primary" onClick={again}>
334:                 <span className="jp-gb-dot" aria-hidden="true" />
335:                 <span>{C['C-GB-AGAIN']}</span>
336:               </button>
337:               <button type="button" className="jp-gb-pill" onClick={props.onRequestClose}>
338:                 <span>{C['C-GB-CLOSE']}</span>
339:               </button>
340:               <span className="jp-gb-seed">
341:                 <span>{C['C-GB-SEED']}</span> <span className="jp-gb-seed-hex">{seedHex}</span>
342:               </span>
343:             </div>
344:           </>
345:         )}
346:       </form>
347:     </div>
348:   );
349: }
</file>

