565:   :root.reduced-motion .jp-gb-panel,
566:   :root.reduced-motion .jp-gb[data-shown="true"] .jp-gb-panel {
567:     transition: none;
568:   }
569: 
570:   /* A prompt line: block caret, then the input. No label above. */
571:   .jp-gb-prompt {
572:     display: flex;
