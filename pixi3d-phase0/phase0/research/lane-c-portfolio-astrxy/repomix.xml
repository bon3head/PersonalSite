600:   const lanefieldSrc = readFileSync(join(ROOT, 'src', 'world', 'lanefield.ts'), 'utf8');
601:   expect(lanefieldSrc).toContain('tex.flipY = false');
602:   const vert = readFileSync(join(ROOT, 'src', 'world', 'shaders', 'lane.vert.glsl'), 'utf8');
