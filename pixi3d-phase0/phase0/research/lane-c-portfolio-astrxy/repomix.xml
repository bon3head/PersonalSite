106: function loadImage(src: string): Promise<HTMLImageElement> {
107:   return new Promise((resolve, reject) => {
108:     const img = new Image();
109:     img.onload = () => resolve(img);
110:     img.onerror = () => reject(new Error('image load failed'));
111:     img.src = src;
112:   });
113: }
