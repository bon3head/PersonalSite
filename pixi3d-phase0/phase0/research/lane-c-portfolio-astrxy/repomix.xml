 1: // Brand manifest cache (polish round). One fetch of
 2: // /brand/manifest.json per page, shared by the prefetch, the hero, and
 3: // the lane field mask preload. brandManifestSync() returns the parsed
 4: // manifest once it has arrived, so the hero can place itself
 5: // synchronously inside the readout swap commit (DESIGN 6.7) instead of
 6: // waiting a network turn and mounting at a provisional position.
 7: export interface BrandManifestEntry {
 8:   file: string;
 9:   width: number;
10:   height: number;
11:   bytes: number;
12:   alt: string;
13: }
14: 
15: export interface BrandManifest {
16:   heroes: {
17:     sidequests: { gif: BrandManifestEntry; frame0: BrandManifestEntry };
18:     leaflink: { png: BrandManifestEntry };
19:   };
20:   budgets?: { decodeTimeoutMs: number };
21:   prefetch?: string[];
22: }
23: 
24: let cached: BrandManifest | null = null;
25: let inflight: Promise<BrandManifest | null> | null = null;
26: 
27: export function brandManifestSync(): BrandManifest | null {
28:   return cached;
29: }
30: 
31: export function loadBrandManifest(): Promise<BrandManifest | null> {
32:   if (cached) return Promise.resolve(cached);
33:   if (inflight) return inflight;
34:   inflight = (async () => {
35:     try {
36:       const res = await fetch('/brand/manifest.json');
37:       if (!res.ok) return null;
38:       cached = (await res.json()) as BrandManifest;
39:       return cached;
40:     } catch {
41:       return null;
42:     } finally {
43:       inflight = null;
44:     }
45:   })();
46:   return inflight;
47: }
