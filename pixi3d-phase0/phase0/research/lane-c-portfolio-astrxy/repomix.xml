325:   // Pose one word at life t with an extra fade factor (pause, hide).
326:   function poseWord(w: ActiveWord, t: number, fade: number): void {
327:     const op = opacityAt(t) * fade;
328:     w.t = t;
329:     w.opacity = op;
330:     colorAt(t, tmpRgb);
331:     tmpColor.setRGB(tmpRgb[0], tmpRgb[1], tmpRgb[2], THREE.SRGBColorSpace);
332:     const hex = tmpColor.getHex();
333:     wordPoint(w, t, tmpPos);
334:     for (const g of w.glyphs) {
335:       charPoint(w, g, tmpPos, tmpPoint);
336:       if (g.lane >= 0) {
337:         // The glyph rides the bent tip: rest + bend x (point - rest).
338:         tmpPoint.set(
339:           g.rest[0] + (tmpPoint.x - g.rest[0]) * op,
340:           g.rest[1] + (tmpPoint.y - g.rest[1]) * op,
341:           g.rest[2] + (tmpPoint.z - g.rest[2]) * op, // lit-ok: z component
342:         );
343:       }
344:       g.mesh.position.copy(tmpPoint);
345:       g.mesh.quaternion.copy(field.camera.quaternion);
346:       g.mesh.color = hex;
347:       g.mesh.fillOpacity = op;
348:       g.mesh.visible = true;
349:     }
350:     lanes?.words.setTint(w.slot, tmpRgb, op);
351:   }
352: 
353:   // One texture write per frame for every lit word lane.
354:   function writeLanes(): void {
355:     if (!lanes) return;
356:     const ids = scratchIds;
357:     const slots = scratchSlots;
358:     const offsets = scratchOffsets;
359:     ids.length = 0;
360:     slots.length = 0;
361:     for (const w of actives) {
362:       for (const g of w.glyphs) {
363:         if (g.lane < 0) continue;
364:         const j = ids.length;
365:         ids.push(g.lane);
366:         slots.push(w.slot);
367:         offsets[j * 3] = g.mesh.position.x - g.rest[0];
368:         offsets[j * 3 + 1] = g.mesh.position.y - g.rest[1];
369:         offsets[j * 3 + 2] = g.mesh.position.z - g.rest[2]; // lit-ok: z component
370:       }
371:     }
372:     lanes.words.writeLanes(ids, offsets, slots); // reads ids.length lanes, so the whole scratch is safe
373:   }
374: 
375:   function spawnWord(): void {
376:     if (paused || hidden || reduced || disposed || advance <= 0) return;
377:     const text = WORDS[nextWord % WORDS.length];
378:     const ySign = spawnCount % 2 === 0 ? 1 : -1;
379:     const w = placeWord(text, ySign, 0);
380:     if (!w) return;
381:     nextWord += 1;
382:     spawnCount += 1;
383:     spawned.push(text);
384:     poseWord(w, 0, 1);
385:     writeLanes();
