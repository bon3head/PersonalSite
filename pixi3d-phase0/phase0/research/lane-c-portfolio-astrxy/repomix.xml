 203: function makeInstancedMesh(
 204:   mat: THREE.ShaderMaterial,
 205:   max: number,
 206:   withKind: boolean,
 207: ): {
 208:   mesh: THREE.Mesh;
 209:   geo: THREE.InstancedBufferGeometry;
 210:   center: THREE.InstancedBufferAttribute;
 211:   kind: THREE.InstancedBufferAttribute | null;
 212:   scale: THREE.InstancedBufferAttribute;
 213:   opacity: THREE.InstancedBufferAttribute;
 214: } {
 215:   const plane = new THREE.PlaneGeometry(1, 1);
 216:   const geo = new THREE.InstancedBufferGeometry();
 217:   const index = plane.getIndex();
 218:   if (index) geo.setIndex(index);
 219:   geo.setAttribute('position', plane.getAttribute('position'));
 220:   geo.setAttribute('uv', plane.getAttribute('uv'));
 221:   const center = new THREE.InstancedBufferAttribute(new Float32Array(max * 3), 3); // lit-ok: xyz
 222:   geo.setAttribute('aCenter', center);
 223:   let kind: THREE.InstancedBufferAttribute | null = null;
 224:   if (withKind) {
 225:     kind = new THREE.InstancedBufferAttribute(new Float32Array(max), 1);
 226:     geo.setAttribute('aKind', kind);
 227:   } else {
 228:     // Shader still declares aKind; feed a constant zero column.
 229:     kind = new THREE.InstancedBufferAttribute(new Float32Array(max), 1);
 230:     geo.setAttribute('aKind', kind);
 231:   }
 232:   const scale = new THREE.InstancedBufferAttribute(new Float32Array(max), 1);
 233:   geo.setAttribute('aScale', scale);
 234:   const opacity = new THREE.InstancedBufferAttribute(new Float32Array(max), 1);
 235:   geo.setAttribute('aOpacity', opacity);
 236:   geo.instanceCount = 0;
