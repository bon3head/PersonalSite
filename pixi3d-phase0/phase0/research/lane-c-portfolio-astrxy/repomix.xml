263: async function finishTrigger(
264:   testName: string,
265:   browser: Browser,
266:   page: Page,
267:   extra: Record<string, unknown>,
268: ): Promise<Sample[]> {
269:   const samples = await stopSampler(page);
270:   const band = checkBand(samples);
271:   const verdict =
272:     samples.length > 0 && band.firstOutside === null ? 'pass' : 'fail';
273:   record({
274:     test: testName,
275:     browser: projectOf(browser),
276:     verdict,
277:     samples: samples.length,
278:     minPitch: band.min,
279:     maxPitch: band.max,
280:     firstOutside: band.firstOutside,
281:     extra: { ...extra, morphPMin: band.morphPMin, morphPMax: band.morphPMax, callsMin: band.callsMin, callsMax: band.callsMax },
282:   });
283:   expect(samples.length, `${testName}: sampler collected no frames`).toBeGreaterThan(0);
284:   expect(
285:     band.firstOutside,
286:     `${testName}: first outside-band frame ${JSON.stringify(band.firstOutside)}`,
287:   ).toBeNull();
288:   return samples;
289: }
