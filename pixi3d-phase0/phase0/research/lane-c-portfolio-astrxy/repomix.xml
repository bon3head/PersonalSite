 523:   // Unconditional travel completion: clears travel, publishes the
 524:   // destination rest state, and drains pending promises, without
 525:   // going through any floating point completion predicate. Called
 526:   // from updateTravel when the shared predicate reports done, and
 527:   // from setReducedMotion when a morph must complete before the
 528:   // freeze regardless of timestamp rounding.
 529:   function finishTravel(): void {
 530:     if (!travel) return;
 531:     travel = null;
 532:     bow.now = 0;
 533:     lightMix = 1;
 534:     oneHot(current, weights);
 535:     for (let i = 0; i < LAYOUT_ORDER.length; i++) groundWeights[i] = weights[i];
 536:     paramsCurrent = cloneParams(paramsTo);
 537:     // Rest invariant: no ring or pull survives a morph. A strength
 538:     // carried into the target params (the pre-polish registration
 539:     // path) would otherwise persist as a permanent bulge.
 540:     paramsCurrent.ringStrength = 0;
 541:     paramsCurrent.silhouetteStrength = 0;
 542:     const pose = poseFor(current, variant);
 543:     basePose.pos[0] = pose.pos[0];
 544:     basePose.pos[1] = pose.pos[1];
 545:     basePose.pos[2] = pose.pos[2];
 546:     basePose.target[0] = pose.target[0];
 547:     basePose.target[1] = pose.target[1];
 548:     basePose.target[2] = pose.target[2];
 549:     basePose.fov = pose.fov;
 550:     basePose.shift[0] = pose.shift[0];
 551:     basePose.shift[1] = pose.shift[1];
 552:     const resolves = pendingResolves;
 553:     pendingResolves = [];
 554:     for (const resolve of resolves) resolve();
 555:   }
