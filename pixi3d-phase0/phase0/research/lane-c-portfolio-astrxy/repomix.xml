605: async function analyzeShot(
606:   page: Page,
607:   shot: Buffer,
608:   region: { x: number; y: number; w: number; h: number },
609: ): Promise<{ maxDelta: number; total: number }> {
610:   const b64 = shot.toString('base64');
611:   return page.evaluate(
612:     async ({ b64, region, ground }) => {
613:       const srgbToLinear = (c: number): number => {
614:         const v = c / 255;
615:         return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
616:       };
617:       const toOklab = (r: number, g: number, b: number): [number, number, number] => {
618:         const R = srgbToLinear(r);
619:         const G = srgbToLinear(g);
620:         const B = srgbToLinear(b);
621:         const l = 0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B;
622:         const m = 0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B;
623:         const s = 0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B;
624:         const lc = Math.cbrt(l);
625:         const mc = Math.cbrt(m);
626:         const sc = Math.cbrt(s);
627:         return [
628:           0.2104542553 * lc + 0.7936177850 * mc - 0.0040720468 * sc,
629:           1.9779984951 * lc - 2.4285922050 * mc + 0.4505937099 * sc,
630:           0.0259040371 * lc + 0.7827717662 * mc - 0.8086757660 * sc,
631:         ];
632:       };
633:       const img = new Image();
634:       await new Promise<void>((res, rej) => {
635:         img.onload = () => res();
636:         img.onerror = () => rej(new Error('img load failed'));
637:         img.src = 'data:image/png;base64,' + b64;
638:       });
639:       const canvas = document.createElement('canvas');
640:       canvas.width = img.width;
641:       canvas.height = img.height;
642:       const ctx = canvas.getContext('2d', { willReadFrequently: true });
643:       if (!ctx) throw new Error('no 2d context');
644:       ctx.drawImage(img, 0, 0);
645:       const data = ctx.getImageData(region.x, region.y, region.w, region.h).data;
646:       const [gL, gA, gB] = toOklab(ground[0], ground[1], ground[2]);
647:       let maxDelta = 0;
648:       let total = 0;
649:       for (let i = 0; i < data.length; i += 4) {
650:         const [L, A, B] = toOklab(data[i], data[i + 1], data[i + 2]);
651:         total += 1;
652:         const d = Math.sqrt((L - gL) ** 2 + (A - gA) ** 2 + (B - gB) ** 2);
653:         if (d > maxDelta) maxDelta = d;
654:       }
655:       return { maxDelta, total };
656:     },
657:     { b64, region, ground: [10, 12, 15] },
658:   );
659: }
