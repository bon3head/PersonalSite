202: test('T-S03-1: no reload across 20 random go calls', async ({ page }) => {
203:   // K-S03-1 intent: no route change causes a document load. The spec's
204:   // parenthetical suggests page.on('framenavigated'), but Playwright
205:   // 1.64 fires framenavigated for history.pushState too (verified: a
206:   // bare pushState emits it), so that detector false-fails correct
207:   // code. The correct detectors are 'load' events (document loads
208:   // only) and a window marker surviving (a reload wipes JS state).
209:   // Flagged in BUILD-STATE for a coordinator spec fix to K-S03-1.
210:   const loads: string[] = [];
211:   page.on('load', () => loads.push(page.url()));
212:   await page.goto(`${DEV}/?world=0`);
