<file path="tools/extract-copy.mjs">
 1: #!/usr/bin/env node
 2: // S09 section 4 table -> src/copy.ts exporting C keyed by ID.
 3: // Links become {label, href}. Fails (exit 1) on duplicate IDs.
 4: import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
 5: import { dirname, join } from 'node:path';
 6: import { fileURLToPath } from 'node:url';
 7: 
 8: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 9: const s09 = readFileSync(join(root, 'spec/astryx/specs/S09-copy-deck.md'), 'utf8');
10: 
11: // Section 4 runs from "## 4. The table" to the next "## " heading.
12: const section = s09.split('## 4. The table')[1];
13: if (!section) {
14:   console.error('extract-copy: section 4 not found in S09-copy-deck.md');
15:   process.exit(1);
16: }
17: const table = section.split('\n## ')[0];
18: const rows = table.split('\n').filter((l) => l.startsWith('| ') && !l.includes('| ID |') && !l.includes('---'));
19: 
20: const entries = [];
21: const seen = new Set();
22: for (const row of rows) {
23:   // Split on pipes; cells may contain backticked code with no pipes inside.
24:   const cells = row.split('|').slice(1, -1).map((c) => c.trim());
25:   if (cells.length < 3) continue;
26:   const [id, , raw] = cells;
27:   if (seen.has(id)) {
28:     console.error(`extract-copy: duplicate ID ${id}`);
29:     process.exit(1);
30:   }
31:   seen.add(id);
32:   entries.push([id, raw]);
33: }
34: 
35: // Link rows: label `X`, href `URL` pattern, or "href as <other id>".
36: const out = [];
37: for (const [id, str] of entries) {
38:   const linkMatch = str.match(/^label `([^`]+)`, href `([^`]+)`$/);
39:   const aliasMatch = str.match(/^label `([^`]+)`, href as (\S+)$/);
40:   if (linkMatch) {
41:     out.push(`  '${id}': { label: ${JSON.stringify(linkMatch[1])}, href: ${JSON.stringify(linkMatch[2])} },`);
42:   } else if (aliasMatch) {
43:     // Resolve alias at generation time: the aliased entry must itself be a link.
44:     const target = entries.find(([eid]) => eid === aliasMatch[2]);
45:     if (!target) {
46:       console.error(`extract-copy: ${id} aliases unknown ID ${aliasMatch[2]}`);
47:       process.exit(1);
48:     }
49:     const tLink = target[1].match(/^label `([^`]+)`, href `([^`]+)`$/);
50:     if (!tLink) {
51:       console.error(`extract-copy: ${id} aliases non-link ID ${aliasMatch[2]}`);
52:       process.exit(1);
53:     }
54:     out.push(`  '${id}': { label: ${JSON.stringify(aliasMatch[1])}, href: ${JSON.stringify(tLink[2])} },`);
55:   } else if (str.startsWith('key `') && str.includes('`, label `')) {
56:     const km = str.match(/^key `([^`]+)`, label `([^`]+)`$/);
57:     if (!km) {
58:       console.error(`extract-copy: unparsable key row ${id}: ${str}`);
59:       process.exit(1);
60:     }
61:     out.push(`  '${id}': { key: ${JSON.stringify(km[1])}, label: ${JSON.stringify(km[2])} },`);
62:   } else if (/`[^`]+` \(coarse pointer\) \/ `[^`]+` \(fine pointer\)/.test(str)) {
63:     const hm = str.match(/^`([^`]+)` \(coarse pointer\) \/ `([^`]+)` \(fine pointer\)$/);
64:     if (!hm) {
65:       console.error(`extract-copy: unparsable hint row ${id}: ${str}`);
66:       process.exit(1);
67:     }
68:     out.push(`  '${id}': { coarse: ${JSON.stringify(hm[1])}, fine: ${JSON.stringify(hm[2])} },`);
69:   } else {
70:     // Plain string: unwrap if the whole cell is backtick-quoted.
71:     const wrapped = str.match(/^`([^`]*)`$/);
72:     out.push(`  '${id}': ${JSON.stringify(wrapped ? wrapped[1] : str)},`);
73:   }
74: }
75: 
76: mkdirSync(join(root, 'src'), { recursive: true });
77: const header = '// GENERATED from spec/astryx/specs/S09-copy-deck.md section 4. Do not edit.\n';
78: writeFileSync(
79:   join(root, 'src/copy.ts'),
80:   `${header}export const C = {\n${out.join('\n')}\n} as const;\n\nexport type CopyId = keyof typeof C;\n`,
81: );
82: console.log(`extract-copy: wrote ${entries.length} entries to src/copy.ts`);
</file>

