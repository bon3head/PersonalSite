 1: // Scatter layout generator (S08). Pure function: writes the scatter
 2: // layout into `out` at the S02 texel indices and returns no side data.
 3: // The coordinator registers this in src/world/worker.ts, replacing B2's
 4: // inline genScatter. Output is byte-identical to B2's genScatter by
 5: // construction: same seed stream, same RNG call order, same arithmetic.
 6: import { T } from '../../tokens.generated';
 7: 
 8: // mulberry32, verbatim (S02 worker chapter). The only RNG in src/world.
 9: export function rng(seed: number) {
10:   let a = seed >>> 0;
11:   return () => {
12:     a = (a + 0x6D2B79F5) >>> 0; // lit-ok: mulberry32 increment
13:     let t = a;
14:     t = Math.imul(t ^ (t >>> 15), t | 1); // lit-ok: mulberry32 scramble
15:     t ^= t + Math.imul(t ^ (t >>> 7), t | 61); // lit-ok: mulberry32 scramble
16:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296; // lit-ok: mulberry32 output scale
17:   };
18: }
19: 
20: // Scatter carries no side data (no graph, no markers, no trail lane lists).
21: export interface SideData {
22:   // intentionally empty
23: }
24: 
25: const POINTS = T.world.pointsPerLane;
26: const LAYOUT_COUNT = T.world.layouts.length;
27: const LANE_STRIDE = POINTS * LAYOUT_COUNT; // texels per lane across all layouts
28: const FLOATS_PER_TEXEL = 4; // lit-ok: RGBA channels
29: const SCATTER_CLASS = 9; // lit-ok: S02 class 9 scatter.lane
30: 
31: export function generate(seed: number, out: Float32Array, layoutIndex: number): SideData {
32:   const rand = rng(seed + layoutIndex * 1000003); // lit-ok: S02 layout stream offset
33:   const radius = T.world.scatter.radius;
34:   const segMin = T.world.scatter.segLength[0];
35:   const segSpan = T.world.scatter.segLength[1] - T.world.scatter.segLength[0];
36:   for (let lane = 0; lane < T.world.laneCount; lane++) {
37:     let cx = 0;
38:     let cy = 0;
39:     let cz = 0;
40:     for (;;) {
41:       cx = (rand() * 2 - 1) * radius;
42:       cy = (rand() * 2 - 1) * radius;
43:       cz = (rand() * 2 - 1) * radius;
44:       if (cx * cx + cy * cy + cz * cz <= radius * radius) break;
45:     }
46:     const z = rand() * 2 - 1;
47:     const phi = rand() * 2 * Math.PI;
48:     const r = Math.sqrt(1 - z * z);
49:     const dx = r * Math.cos(phi);
50:     const dy = r * Math.sin(phi);
51:     const dz = z;
52:     const len = segMin + rand() * segSpan;
53:     for (let k = 0; k < POINTS; k++) {
54:       const f = k / (POINTS - 1) - 0.5;
55:       const base = (lane * LANE_STRIDE + layoutIndex * POINTS + k) * FLOATS_PER_TEXEL;
56:       out[base] = cx + dx * f * len;
57:       out[base + 1] = cy + dy * f * len;
58:       out[base + 2] = cz + dz * f * len;
59:       out[base + 3] = SCATTER_CLASS;
60:     }
61:   }
62:   return {};
63: }
</file>

<file path="src/world/layouts/server.ts">
 1: // Server layout generator (S05 layout chapter). Runs in the worker.
 2: // Pure function: no DOM, no three imports. Writes every lane of the field
 3: // with its full point set into the layout texture buffer at the slice for
 4: // layoutIndex. Texel index for a lane, layout, and point follows the worker
 5: // chapter formula (lane stride times lane, plus layout times points per
 6: // lane, plus point). RGB is the world position, A is the class id. Every
 7: // point carries class 0 (server.lane); class 1 (server.converge) is reserved
 8: // and unused in v1.
 9: // The layout is pure grid arithmetic: it consumes no randomness, so the
10: // seed exists only for interface compatibility with the worker contract
11: // (S02 worker chapter: each layout gets its own seeded stream; the server
12: // layout draws nothing from it).
13: import { T } from '../../tokens.generated';
14: 
15: const POINTS = T.world.pointsPerLane;
16: const LAYOUT_COUNT = T.world.layouts.length;
17: const LANE_STRIDE = POINTS * LAYOUT_COUNT; // texels per lane across all layouts
18: const FLOATS_PER_TEXEL = 4; // lit-ok: RGBA channels
19: 
20: export function generate(seed: number, out: Float32Array, layoutIndex: number): void {
21:   void seed; // no randomness consumed: grid arithmetic only, see header
22:   const sm = T.world.server.sm;
23:   const part = T.world.server.partition;
24:   const ln = T.world.server.lane;
25:   const zStraight = T.world.server.zStraight;
26:   const convergeZ = T.world.server.convergeZ;
27:   const convergeMix = T.world.server.convergeMix;
28:   const focus = T.world.server.focus;
29:   const smColCenter = (sm.cols - 1) / 2;
30:   const smRowCenter = (sm.rows - 1) / 2;
31:   const partColCenter = (part.cols - 1) / 2;
32:   const partRowCenter = (part.rows - 1) / 2;
33:   const laneColCenter = (ln.cols - 1) / 2;
34:   const laneRowCenter = (ln.rows - 1) / 2;
35:   const lanesPerSm = part.perSm * ln.perPartition;
36:   const straightPoints = POINTS - 2; // the last two points are converge points
37:   const zSpan = zStraight[1] - zStraight[0];
38:   const zStep = zSpan / (straightPoints - 1);
39:   for (let i = 0; i < T.world.laneCount; i++) {
40:     const smIndex = Math.floor(i / lanesPerSm);
41:     const partIndex = Math.floor((i % lanesPerSm) / ln.perPartition);
42:     const laneIndex = i % ln.perPartition;
43:     const smCol = smIndex % sm.cols;
44:     const smRow = Math.floor(smIndex / sm.cols);
45:     const partCol = partIndex % part.cols;
46:     const partRow = Math.floor(partIndex / part.cols);
47:     const laneCol = laneIndex % ln.cols;
48:     const laneRow = Math.floor(laneIndex / ln.cols);
49:     const x =
50:       (smCol - smColCenter) * sm.pitch[0] +
51:       (partCol - partColCenter) * part.pitch[0] +
52:       (laneCol - laneColCenter) * ln.pitch[0];
53:     const y =
54:       (smRow - smRowCenter) * sm.pitch[1] +
55:       (partRow - partRowCenter) * part.pitch[1] +
56:       (laneRow - laneRowCenter) * ln.pitch[1];
57:     const laneBase = (i * LANE_STRIDE + layoutIndex * POINTS) * FLOATS_PER_TEXEL;
58:     for (let k = 0; k < straightPoints; k++) {
59:       const base = laneBase + k * FLOATS_PER_TEXEL;
60:       out[base] = x;
61:       out[base + 1] = y;
62:       out[base + 2] = zStraight[0] + k * zStep;
63:       out[base + 3] = 0; // lit-ok: S02 class 0 server.lane
64:     }
65:     const convergeX0 = x + (focus[0] - x) * convergeMix[0];
66:     const convergeY0 = y + (focus[1] - y) * convergeMix[0];
67:     const base6 = laneBase + straightPoints * FLOATS_PER_TEXEL;
68:     out[base6] = convergeX0;
69:     out[base6 + 1] = convergeY0;
70:     out[base6 + 2] = convergeZ[0];
71:     out[base6 + 3] = 0; // lit-ok: S02 class 0 server.lane
72:     const convergeX1 = x + (focus[0] - x) * convergeMix[1];
73:     const convergeY1 = y + (focus[1] - y) * convergeMix[1];
74:     const base7 = laneBase + (straightPoints + 1) * FLOATS_PER_TEXEL;
75:     out[base7] = convergeX1;
76:     out[base7 + 1] = convergeY1;
77:     out[base7 + 2] = convergeZ[1];
78:     out[base7 + 3] = 0; // lit-ok: S02 class 0 server.lane
79:   }
80: }
</file>

<file path="src/world/layouts/sidequests.ts">
   1: // SideQuests plan generator: the chalk campus plan layout.
   2: // Pure function. No DOM, no three imports. Writes texels for one layout
   3: // into the shared layout texture array and returns the scene side data.
   4: import { T } from '../../tokens.generated';
   5: 
   6: type Vec = [number, number];
   7: 
   8: export interface SideQuestsTrailSideData {
   9:   laneIds: number[];
  10:   arcStarts: number[];
  11:   arcLengths: number[];
  12: }
  13: 
  14: export interface SideQuestsSideData {
  15:   markers: Vec[];
  16:   trails: SideQuestsTrailSideData[];
  17:   footprints: Vec[][];
  18: }
  19: 
  20: interface Footprint {
  21:   polygon: Vec[];
  22:   rect: [number, number, number, number];
  23: }
  24: 
  25: interface Curve {
  26:   pointAt: (s: number) => Vec;
  27:   length: number;
  28: }
  29: 
  30: // Class ids from the engine spec layout section.
  31: const CLS_GRID = 4; // lit-ok: grid class id
  32: const CLS_OUTLINE = 5; // lit-ok: outline class id
  33: const CLS_HATCH = 6; // lit-ok: hatch class id
  34: const CLS_WALKWAY = 7; // lit-ok: walkway class id
  35: const CLS_TRAIL = 8; // lit-ok: trail class id
  36: 
  37: // mulberry32, verbatim from the engine spec. The only RNG in this file.
  38: export function rng(seed: number) {
  39:   let a = seed >>> 0;
  40:   return () => {
  41:     a = (a + 0x6D2B79F5) >>> 0;
  42:     let t = a;
  43:     t = Math.imul(t ^ (t >>> 15), t | 1); // lit-ok: mulberry32 mixing constants
  44:     t ^= t + Math.imul(t ^ (t >>> 7), t | 61); // lit-ok: mulberry32 mixing constants
  45:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296; // lit-ok: mulberry32 output scale
  46:   };
  47: }
  48: 
  49: function lerp(a: number, b: number, t: number): number {
  50:   return a + (b - a) * t;
  51: }
  52: 
  53: function lerp2(a: Vec, b: Vec, t: number): Vec {
  54:   return [lerp(a[0], b[0], t), lerp(a[1], b[1], t)];
  55: }
  56: 
  57: function cross2(a: Vec, b: Vec): number {
  58:   return a[0] * b[1] - a[1] * b[0];
  59: }
  60: 
  61: function straightLane(
  62:   out: Float32Array,
  63:   layoutIndex: number,
  64:   laneId: number,
  65:   a: Vec,
  66:   b: Vec,
  67:   cls: number,
  68: ): void {
  69:   const laneBase =
  70:     (laneId * (T.world.layouts.length * T.world.pointsPerLane) +
  71:       layoutIndex * T.world.pointsPerLane) *
  72:     4; // lit-ok: RGBA texel component count
  73:   const n = T.world.pointsPerLane;
  74:   const seg = T.world.segmentsPerLane;
  75:   for (let k = 0; k < n; k++) {
  76:     const t = k / seg;
  77:     const base = laneBase + k * 4; // lit-ok: RGBA texel component count
  78:     out[base] = a[0] + (b[0] - a[0]) * t;
  79:     out[base + 1] = 0;
  80:     out[base + 2] = a[1] + (b[1] - a[1]) * t;
  81:     out[base + 3] = cls;
  82:   }
  83: }
  84: 
  85: function curveLane(
  86:   out: Float32Array,
  87:   layoutIndex: number,
  88:   laneId: number,
  89:   pointAt: (s: number) => Vec,
  90:   a: number,
  91:   b: number,
  92:   cls: number,
  93: ): void {
  94:   const laneBase =
  95:     (laneId * (T.world.layouts.length * T.world.pointsPerLane) +
  96:       layoutIndex * T.world.pointsPerLane) *
  97:     4; // lit-ok: RGBA texel component count
  98:   const n = T.world.pointsPerLane;
  99:   const seg = T.world.segmentsPerLane;
 100:   for (let k = 0; k < n; k++) {
 101:     const s = a + ((b - a) * k) / seg;
 102:     const p = pointAt(s);
 103:     const base = laneBase + k * 4; // lit-ok: RGBA texel component count
 104:     out[base] = p[0];
 105:     out[base + 1] = 0;
 106:     out[base + 2] = p[1];
 107:     out[base + 3] = cls;
 108:   }
 109: }
 110: 
 111: // Centripetal Catmull-Rom segment evaluator, Barry-Goldman form.
 112: // Knot distances are computed once per segment, not per sample.
 113: function makeSegmentEvaluator(p0: Vec, p1: Vec, p2: Vec, p3: Vec): (t: number) => Vec {
 114:   const eps = 1e-6; // lit-ok: degenerate segment guard
 115:   const t0 = 0;
 116:   const t1 = t0 + Math.max(Math.sqrt(Math.hypot(p1[0] - p0[0], p1[1] - p0[1])), eps);
 117:   const t2 = t1 + Math.max(Math.sqrt(Math.hypot(p2[0] - p1[0], p2[1] - p1[1])), eps);
 118:   const t3 = t2 + Math.max(Math.sqrt(Math.hypot(p3[0] - p2[0], p3[1] - p2[1])), eps);
 119:   return (t: number): Vec => {
 120:     const u = t1 + t * (t2 - t1);
 121:     const u0 = (u - t0) / (t1 - t0);
 122:     const u1 = (u - t1) / (t2 - t1);
 123:     const u2 = (u - t2) / (t3 - t2);
 124:     const a1x = p0[0] + (p1[0] - p0[0]) * u0;
 125:     const a1z = p0[1] + (p1[1] - p0[1]) * u0;
 126:     const a2x = p1[0] + (p2[0] - p1[0]) * u1;
 127:     const a2z = p1[1] + (p2[1] - p1[1]) * u1;
 128:     const a3x = p2[0] + (p3[0] - p2[0]) * u2;
 129:     const a3z = p2[1] + (p3[1] - p2[1]) * u2;
 130:     const v0 = (u - t0) / (t2 - t0);
 131:     const v1 = (u - t1) / (t3 - t1);
 132:     const b1x = a1x + (a2x - a1x) * v0;
 133:     const b1z = a1z + (a2z - a1z) * v0;
 134:     const b2x = a2x + (a3x - a2x) * v1;
 135:     const b2z = a2z + (a3z - a2z) * v1;
 136:     const w = (u - t1) / (t2 - t1);
 137:     return [b1x + (b2x - b1x) * w, b1z + (b2z - b1z) * w];
 138:   };
 139: }
 140: 
 141: // Arc-length table over the control polygon, for even lane sampling.
 142: function makeCurve(ctrl: Vec[]): Curve {
 143:   const samples: Vec[] = [];
 144:   const cum: number[] = [];
 145:   const push = (p: Vec): void => {
 146:     if (samples.length > 0) {
 147:       const prev = samples[samples.length - 1];
 148:       cum.push(cum[cum.length - 1] + Math.hypot(p[0] - prev[0], p[1] - prev[1]));
 149:     } else {
 150:       cum.push(0);
 151:     }
 152:     samples.push(p);
 153:   };
 154:   const perSeg = 64; // lit-ok: arc table density
 155:   for (let i = 0; i < ctrl.length - 1; i++) {
 156:     const p0 = ctrl[Math.max(0, i - 1)];
 157:     const p1 = ctrl[i];
 158:     const p2 = ctrl[i + 1];
 159:     const p3 = ctrl[Math.min(ctrl.length - 1, i + 2)];
 160:     const evalSeg = makeSegmentEvaluator(p0, p1, p2, p3);
 161:     const startS = i === 0 ? 0 : 1;
 162:     for (let s = startS; s < perSeg; s++) {
 163:       push(evalSeg(s / perSeg));
 164:     }
 165:   }
 166:   push(ctrl[ctrl.length - 1]);
 167:   const length = cum[cum.length - 1];
 168:   const pointAt = (s: number): Vec => {
 169:     if (s <= 0) return samples[0];
 170:     if (s >= length) return samples[samples.length - 1];
 171:     let lo = 0;
 172:     let hi = cum.length - 1;
 173:     while (hi - lo > 1) {
 174:       const mid = Math.floor((lo + hi) / 2);
 175:       if (cum[mid] <= s) lo = mid;
 176:       else hi = mid;
 177:     }
 178:     const segLen = cum[hi] - cum[lo];
 179:     const t = segLen === 0 ? 0 : (s - cum[lo]) / segLen;
 180:     return lerp2(samples[lo], samples[hi], t);
 181:   };
 182:   return { pointAt, length };
 183: }
 184: 
 185: function makeStraightCurve(a: Vec, b: Vec): Curve {
 186:   const length = Math.hypot(b[0] - a[0], b[1] - a[1]);
 187:   return {
 188:     length,
 189:     pointAt: (s: number): Vec => {
 190:       const t = length === 0 ? 0 : s / length;
 191:       return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
 192:     },
 193:   };
 194: }
 195: 
 196: function pointInPolygon(p: Vec, poly: Vec[]): boolean {
 197:   let inside = false;
 198:   for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
 199:     const xi = poly[i][0];
 200:     const zi = poly[i][1];
 201:     const xj = poly[j][0];
 202:     const zj = poly[j][1];
 203:     if (zi > p[1] !== zj > p[1] && p[0] < ((xj - xi) * (p[1] - zi)) / (zj - zi) + xi) {
 204:       inside = !inside;
 205:     }
 206:   }
 207:   return inside;
 208: }
 209: 
 210: function distToSegment(p: Vec, a: Vec, b: Vec): number {
 211:   const dx = b[0] - a[0];
 212:   const dz = b[1] - a[1];
 213:   const lenSq = dx * dx + dz * dz;
 214:   let t = lenSq === 0 ? 0 : ((p[0] - a[0]) * dx + (p[1] - a[1]) * dz) / lenSq;
 215:   t = Math.max(0, Math.min(1, t));
 216:   return Math.hypot(p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dz));
 217: }
 218: 
 219: function distToPolygon(p: Vec, poly: Vec[]): number {
 220:   if (pointInPolygon(p, poly)) return 0;
 221:   let best = Infinity;
 222:   for (let i = 0; i < poly.length; i++) {
 223:     const d = distToSegment(p, poly[i], poly[(i + 1) % poly.length]);
 224:     if (d < best) best = d;
 225:   }
 226:   return best;
 227: }
 228: 
 229: // Ray from origin along direction against one segment. Null when parallel.
 230: function raySegment(o: Vec, dir: Vec, a: Vec, b: Vec): number | null {
 231:   const e: Vec = [b[0] - a[0], b[1] - a[1]];
 232:   const ao: Vec = [a[0] - o[0], a[1] - o[1]];
 233:   const denom = cross2(dir, e);
 234:   if (Math.abs(denom) < 1e-9) return null; // lit-ok: parallel epsilon
 235:   const t = cross2(ao, e) / denom;
 236:   const u = cross2(ao, dir) / denom;
 237:   if (t <= 0 || u < 0 || u > 1) return null;
 238:   return t;
 239: }
 240: 
 241: function rayBoxExit(o: Vec, dir: Vec, rx0: number, rz0: number, rx1: number, rz1: number): number {
 242:   let tExit = Infinity;
 243:   if (Math.abs(dir[0]) >= 1e-9) { // lit-ok: parallel epsilon
 244:     const ta = (rx0 - o[0]) / dir[0];
 245:     const tb = (rx1 - o[0]) / dir[0];
 246:     tExit = Math.min(tExit, Math.max(ta, tb));
 247:   }
 248:   if (Math.abs(dir[1]) >= 1e-9) { // lit-ok: parallel epsilon
 249:     const ta = (rz0 - o[1]) / dir[1];
 250:     const tb = (rz1 - o[1]) / dir[1];
 251:     tExit = Math.min(tExit, Math.max(ta, tb));
 252:   }
 253:   return tExit;
 254: }
 255: 
 256: // Distance along the ray to the nearest other footprint, else to the region edge.
 257: function rayClearance(
 258:   o: Vec,
 259:   dir: Vec,
 260:   others: Footprint[],
 261:   region: [number, number, number, number],
 262: ): number {
 263:   let best = Infinity;
 264:   for (const fp of others) {
 265:     const poly = fp.polygon;
 266:     for (let i = 0; i < poly.length; i++) {
 267:       const t = raySegment(o, dir, poly[i], poly[(i + 1) % poly.length]);
 268:       if (t !== null && t < best) best = t;
 269:     }
 270:   }
 271:   if (best !== Infinity) return best;
 272:   const exit = rayBoxExit(o, dir, region[0], region[1], region[2], region[3]);
 273:   if (exit !== Infinity) return exit;
 274:   return Math.hypot(region[2] - region[0], region[3] - region[1]);
 275: }
 276: 
 277: // Entrance at the midpoint of the edge facing the most open space.
 278: function entranceFor(fp: Footprint, others: Footprint[]): Vec {
 279:   const poly = fp.polygon;
 280:   let cx = 0;
 281:   let cz = 0;
 282:   for (const v of poly) {
 283:     cx += v[0];
 284:     cz += v[1];
 285:   }
 286:   cx /= poly.length;
 287:   cz /= poly.length;
 288:   const b = T.world.sidequests.buildings;
 289:   const [rx0, rx1] = b.region[0];
 290:   const [rz0, rz1] = b.region[1];
 291:   let best: Vec | null = null;
 292:   let bestD = -1;
 293:   for (let i = 0; i < poly.length; i++) {
 294:     const a = poly[i];
 295:     const c = poly[(i + 1) % poly.length];
 296:     const mx = (a[0] + c[0]) / 2;
 297:     const mz = (a[1] + c[1]) / 2;
 298:     const dx = c[0] - a[0];
 299:     const dz = c[1] - a[1];
 300:     let nx = dz;
 301:     let nz = -dx;
 302:     if (nx * (mx - cx) + nz * (mz - cz) < 0) {
 303:       nx = -nx;
 304:       nz = -nz;
 305:     }
 306:     const len = Math.hypot(nx, nz);
 307:     if (len === 0) continue;
 308:     nx /= len;
 309:     nz /= len;
 310:     const d = rayClearance([mx, mz], [nx, nz], others, [rx0, rz0, rx1, rz1]);
 311:     if (d > bestD) {
 312:       bestD = d;
 313:       best = [mx, mz];
 314:     }
 315:   }
 316:   if (best === null) throw new Error('sidequests: no entrance edge');
 317:   return best;
 318: }
 319: 
 320: // Rectangle with one corner cut out, vertices in boundary order.
 321: function lPolygon(
 322:   x0: number,
 323:   z0: number,
 324:   x1: number,
 325:   z1: number,
 326:   corner: number,
 327:   cx: number,
 328:   cz: number,
 329: ): Vec[] {
 330:   switch (corner) {
 331:     case 0:
 332:       return [
 333:         [x0 + cx, z0],
 334:         [x1, z0],
 335:         [x1, z1],
 336:         [x0, z1],
 337:         [x0, z0 + cz],
 338:         [x0 + cx, z0 + cz],
 339:       ];
 340:     case 1:
 341:       return [
 342:         [x0, z0],
 343:         [x1 - cx, z0],
 344:         [x1 - cx, z0 + cz],
 345:         [x1, z0 + cz],
 346:         [x1, z1],
 347:         [x0, z1],
 348:       ];
 349:     case 2:
 350:       return [
 351:         [x0, z0],
 352:         [x1, z0],
 353:         [x1, z1 - cz],
 354:         [x1 - cx, z1 - cz],
 355:         [x1 - cx, z1],
 356:         [x0, z1],
 357:       ];
 358:     default:
 359:       return [
 360:         [x0, z0],
 361:         [x1, z0],
 362:         [x1, z1],
 363:         [x0 + cx, z1],
 364:         [x0 + cx, z1 - cz],
 365:         [x0, z1 - cz],
 366:       ];
 367:   }
 368: }
 369: 
 370: function sampleBuilding(r: () => number): Footprint {
 371:   const b = T.world.sidequests.buildings;
 372:   const w = b.minSide + r() * (b.maxSide - b.minSide);
 373:   const d = b.minSide + r() * (b.maxSide - b.minSide);
 374:   const [rx0, rx1] = b.region[0];
 375:   const [rz0, rz1] = b.region[1];
 376:   const x0 = rx0 + r() * (rx1 - rx0 - w);
 377:   const z0 = rz0 + r() * (rz1 - rz0 - d);
 378:   const x1 = x0 + w;
 379:   const z1 = z0 + d;
 380:   if (r() < b.lShapeFraction) {
 381:     const corner = Math.floor(r() * 4); // lit-ok: corner count
 382:     const cutX = w * (b.lShapeCut[0] + r() * (b.lShapeCut[1] - b.lShapeCut[0]));
 383:     const cutZ = d * (b.lShapeCut[0] + r() * (b.lShapeCut[1] - b.lShapeCut[0]));
 384:     return { polygon: lPolygon(x0, z0, x1, z1, corner, cutX, cutZ), rect: [x0, z0, x1, z1] };
 385:   }
 386:   return { polygon: [[x0, z0], [x1, z0], [x1, z1], [x0, z1]], rect: [x0, z0, x1, z1] };
 387: }
 388: 
 389: function fits(cand: Footprint, placed: Footprint[]): boolean {
 390:   const g = T.world.sidequests.buildings.minGap / 2;
 391:   const [cx0, cz0, cx1, cz1] = cand.rect;
 392:   for (const p of placed) {
 393:     const [px0, pz0, px1, pz1] = p.rect;
 394:     const overlapX = cx0 - g < px1 + g && px0 - g < cx1 + g;
 395:     const overlapZ = cz0 - g < pz1 + g && pz0 - g < cz1 + g;
 396:     if (overlapX && overlapZ) return false;
 397:   }
 398:   return true;
 399: }
 400: 
 401: // Rejection-sampled footprints; restarts on a fresh stream when the count misses.
 402: // Footprints intersecting the readout clear zone are rejected (kill criterion:
 403: // outlines and hatch sit inside footprints, so keeping footprints out
 404: // keeps their lanes out too).
 405: function placeBuildings(mainR: () => number, base: number, zone: Zone): Footprint[] {
 406:   const b = T.world.sidequests.buildings;
 407:   let attempt = 0;
 408:   for (;;) {
 409:     attempt++;
 410:     const r = attempt === 1 ? mainR : rng(base + attempt);
 411:     const placed: Footprint[] = [];
 412:     for (let t = 0; t < b.maxAttempts && placed.length < b.count; t++) {
 413:       const cand = sampleBuilding(r);
 414:       if (rectHitsZone(cand.rect, zone)) continue;
 415:       if (fits(cand, placed)) placed.push(cand);
 416:     }
 417:     if (placed.length === b.count) return placed;
 418:     if (attempt > 100) throw new Error('sidequests: building placement failed'); // lit-ok: restart cap
 419:   }
 420: }
 421: 
 422: function curveHitsFootprint(curve: Curve, footprints: Footprint[]): boolean {
 423:   const checks = 40; // lit-ok: inside-footprint sampling density
 424:   for (let i = 1; i < checks; i++) {
 425:     const p = curve.pointAt((curve.length * i) / checks);
 426:     for (const fp of footprints) {
 427:       const [rx0, rz0, rx1, rz1] = fp.rect;
 428:       if (p[0] < rx0 || p[0] > rx1 || p[1] < rz0 || p[1] > rz1) continue;
 429:       if (pointInPolygon(p, fp.polygon)) return true;
 430:     }
 431:   }
 432:   return false;
 433: }
 434: 
 435: // True when the point is at least the margin clear of one footprint.
 436: // The expanded bounding box rejects most pairs before any edge math.
 437: function clearOfFootprint(p: Vec, fp: Footprint, margin: number): boolean {
 438:   const [rx0, rz0, rx1, rz1] = fp.rect;
 439:   if (p[0] < rx0 - margin || p[0] > rx1 + margin || p[1] < rz0 - margin || p[1] > rz1 + margin) {
 440:     return true;
 441:   }
 442:   if (pointInPolygon(p, fp.polygon)) return false;
 443:   const poly = fp.polygon;
 444:   for (let i = 0; i < poly.length; i++) {
 445:     if (distToSegment(p, poly[i], poly[(i + 1) % poly.length]) < margin) return false;
 446:   }
 447:   return true;
 448: }
 449: 
 450: // Push a point out of a polygon along the centroid ray until clear by the margin.
 451: function nudgeOut(p: Vec, poly: Vec[], margin: number): Vec {
 452:   let cx = 0;
 453:   let cz = 0;
 454:   for (const v of poly) {
 455:     cx += v[0];
 456:     cz += v[1];
 457:   }
 458:   cx /= poly.length;
 459:   cz /= poly.length;
 460:   let dx = p[0] - cx;
 461:   let dz = p[1] - cz;
 462:   let len = Math.hypot(dx, dz);
 463:   if (len === 0) {
 464:     dx = 1;
 465:     dz = 0;
 466:     len = 1;
 467:   }
 468:   dx /= len;
 469:   dz /= len;
 470:   let q: Vec = [p[0], p[1]];
 471:   for (let i = 0; i < 400; i++) { // lit-ok: nudge step cap
 472:     if (!pointInPolygon(q, poly) && distToPolygon(q, poly) >= margin) return q;
 473:     q = [q[0] + dx * 0.1, q[1] + dz * 0.1]; // lit-ok: nudge step size
 474:   }
 475:   return q;
 476: }
 477: 
 478: // ---- Fine-camera model for the readout clear zone (S07 readability rule) ----
 479: // Pure math, no three import: the generator runs in a worker. Verified
 480: // against THREE's PerspectiveCamera worldToScreen/screenToGround for the
 481: // spec fine pose (agreement within rounding; B6c-fix receipts).
 482: // The readout box is the measured DOM box at 1440x900 (B4 S04
 483: // section 6 placement): x 1012..1392, y 88..508. // lit-ok: measured box
 484: // The zone is that box projected to y=0 through the fine camera, as an
 485: // AABB expanded by a 1-unit margin (about 40px on screen, far above lane
 486: // width + antialiasing). Only grid lanes may fall inside it (kill criterion).
 487: 
 488: type Vec3 = [number, number, number];
 489: 
 490: function norm3(v: Vec3): Vec3 {
 491:   const len = Math.hypot(v[0], v[1], v[2]);
 492:   return [v[0] / len, v[1] / len, v[2] / len];
 493: }
 494: 
 495: function cross3(a: Vec3, b: Vec3): Vec3 {
 496:   return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
 497: }
 498: 
 499: interface FineCam {
 500:   pos: Vec3;
 501:   forward: Vec3;
 502:   right: Vec3;
 503:   camUp: Vec3;
 504:   p0: number;
 505:   p5: number;
 506:   p8: number;
 507:   p9: number;
 508: }
 509: 
 510: function fineCamera(): FineCam {
 511:   const cam = T.world.camera.sidequests.fine;
 512:   const pos: Vec3 = [cam.pos[0], cam.pos[1], cam.pos[2]];
 513:   const tgt: Vec3 = [cam.target[0], cam.target[1], cam.target[2]];
 514:   const f = 1 / Math.tan(((cam.fovDeg * Math.PI) / 180) / 2); // lit-ok: degrees to radians
 515:   const aspect = 1440 / 900; // lit-ok: T-SQ-3 reference viewport
 516:   const forward = norm3([tgt[0] - pos[0], tgt[1] - pos[1], tgt[2] - pos[2]]);
 517:   let right = cross3(forward, [0, 1, 0]);
 518:   if (Math.hypot(right[0], right[1], right[2]) < 1e-6) right = [1, 0, 0]; // lit-ok: degenerate-view guard
 519:   right = norm3(right);
 520:   const camUp = cross3(right, forward);
 521:   return {
 522:     pos,
 523:     forward,
 524:     right,
 525:     camUp,
 526:     p0: f / aspect,
 527:     p5: f,
 528:     p8: -cam.shiftNdc[0],
 529:     p9: -cam.shiftNdc[1],
 530:   };
 531: }
 532: 
 533: // Project a world point to CSS px at the 1440x900 fine reference viewport.
 534: export function projectToFineScreen(x: number, y: number, z: number): [number, number] {
 535:   const cam = fineCamera();
 536:   const rx = x - cam.pos[0];
 537:   const ry = y - cam.pos[1];
 538:   const rz = z - cam.pos[2];
 539:   const xr = rx * cam.right[0] + ry * cam.right[1] + rz * cam.right[2];
 540:   const yu = rx * cam.camUp[0] + ry * cam.camUp[1] + rz * cam.camUp[2];
 541:   const zv = -(rx * cam.forward[0] + ry * cam.forward[1] + rz * cam.forward[2]);
 542:   const nx = (cam.p0 * xr + cam.p8 * zv) / -zv;
 543:   const ny = (cam.p5 * yu + cam.p9 * zv) / -zv;
 544:   return [((nx + 1) / 2) * 1440, ((1 - ny) / 2) * 900]; // lit-ok: T-SQ-3 reference viewport
 545: }
 546: 
 547: // Unproject a fine-viewport screen point to the ground plane y=0.
 548: function screenToGroundFine(cam: FineCam, sx: number, sy: number): [number, number] | null {
 549:   const nx = (sx / 1440) * 2 - 1; // lit-ok: T-SQ-3 reference viewport
 550:   const ny = -(sy / 900) * 2 + 1; // lit-ok: T-SQ-3 reference viewport
 551:   const xv = (nx + cam.p8) / cam.p0;
 552:   const yv = (ny + cam.p9) / cam.p5;
 553:   const dx = cam.right[0] * xv + cam.camUp[0] * yv + cam.forward[0];
 554:   const dy = cam.right[1] * xv + cam.camUp[1] * yv + cam.forward[1];
 555:   const dz = cam.right[2] * xv + cam.camUp[2] * yv + cam.forward[2];
 556:   const len = Math.hypot(dx, dy, dz);
 557:   const uy = dy / len;
 558:   if (uy >= 0) return null;
 559:   const t = -cam.pos[1] / uy;
 560:   return [cam.pos[0] + (dx / len) * t, cam.pos[2] + (dz / len) * t];
 561: }
 562: 
 563: // The readout clear zone as a world AABB [x0, z0, x1, z1].
 564: export function readoutClearZone(): [number, number, number, number] {
 565:   const cam = fineCamera();
 566:   const xs = [1012, 1392]; // lit-ok: measured readout box at 1440x900
 567:   const ys = [88, 508]; // lit-ok: measured readout box at 1440x900
 568:   const corners: Array<[number, number]> = [];
 569:   for (const sx of xs) {
 570:     for (const sy of ys) {
 571:       const g = screenToGroundFine(cam, sx, sy);
 572:       if (g !== null) corners.push(g);
 573:     }
 574:   }
 575:   if (corners.length !== 4) throw new Error('sidequests: readout box does not hit the ground'); // lit-ok: corner count
 576:   let x0 = Infinity;
 577:   let z0 = Infinity;
 578:   let x1 = -Infinity;
 579:   let z1 = -Infinity;
 580:   for (const [x, z] of corners) {
 581:     if (x < x0) x0 = x;
 582:     if (z < z0) z0 = z;
 583:     if (x > x1) x1 = x;
 584:     if (z > z1) z1 = z;
 585:   }
 586:   const m = 1; // lit-ok: clear-zone margin in world units
 587:   return [x0 - m, z0 - m, x1 + m, z1 + m];
 588: }
 589: 
 590: type Zone = [number, number, number, number];
 591: 
 592: function inZone(p: Vec, zone: Zone): boolean {
 593:   return p[0] >= zone[0] && p[0] <= zone[2] && p[1] >= zone[1] && p[1] <= zone[3];
 594: }
 595: 
 596: function rectHitsZone(rect: [number, number, number, number], zone: Zone): boolean {
 597:   return rect[0] <= zone[2] && rect[2] >= zone[0] && rect[1] <= zone[3] && rect[3] >= zone[1];
 598: }
 599: 
 600: // Dense sample so no dash-length incursion is missed.
 601: function curveHitsZone(curve: Curve, zone: Zone): boolean {
 602:   const steps = Math.max(200, Math.ceil(curve.length / 0.1)); // lit-ok: zone sampling density
 603:   for (let i = 0; i <= steps; i++) {
 604:     const p = curve.pointAt((curve.length * i) / steps);
 605:     if (inZone(p, zone)) return true;
 606:   }
 607:   return false;
 608: }
 609: 
 610: // Push a point inside the zone to the nearest face plus the margin.
 611: function pushOutOfZone(p: Vec, zone: Zone, margin: number): Vec {
 612:   const [zx0, zz0, zx1, zz1] = zone;
 613:   const dx0 = p[0] - zx0;
 614:   const dx1 = zx1 - p[0];
 615:   const dz0 = p[1] - zz0;
 616:   const dz1 = zz1 - p[1];
 617:   const m = Math.min(dx0, dx1, dz0, dz1);
 618:   if (m === dx0) return [zx0 - margin, p[1]];
 619:   if (m === dx1) return [zx1 + margin, p[1]];
 620:   if (m === dz0) return [p[0], zz0 - margin];
 621:   return [p[0], zz1 + margin];
 622: }
 623: 
 624: // Detour a walkway around the zone: try each side, first curve that clears
 625: // the zone wins; among those prefer one that also clears footprints
 626: // (footprint crossing is the spec's straight-line fallback, zone crossing
 627: // is never allowed per the kill criterion).
 628: function detourWalkway(A: Vec, B: Vec, zone: Zone, footprints: Footprint[]): Curve {
 629:   const [zx0, zz0, zx1, zz1] = zone;
 630:   const m = 1; // lit-ok: detour clearance beyond the zone edge
 631:   const ex = T.world.sidequests.extent[0] / 2;
 632:   const ez = T.world.sidequests.extent[1] / 2;
 633:   const sides: Vec[][] = [
 634:     [[A[0], zz0 - m], [B[0], zz0 - m]],
 635:     [[A[0], zz1 + m], [B[0], zz1 + m]],
 636:     [[zx0 - m, A[1]], [zx0 - m, B[1]]],
 637:     [[zx1 + m, A[1]], [zx1 + m, B[1]]],
 638:   ];
 639:   let fallback: Curve | null = null;
 640:   for (const [d1, d2] of sides) {
 641:     if (d1[0] < -ex || d1[0] > ex || d1[1] < -ez || d1[1] > ez) continue;
 642:     if (d2[0] < -ex || d2[0] > ex || d2[1] < -ez || d2[1] > ez) continue;
 643:     const c = makeCurve([A, d1, d2, B]);
 644:     if (curveHitsZone(c, zone)) continue;
 645:     if (fallback === null) fallback = c;
 646:     if (!curveHitsFootprint(c, footprints)) return c;
 647:   }
 648:   if (fallback !== null) return fallback;
 649:   throw new Error('sidequests: no walkway detour around the readout zone');
 650: }
 651: 
 652: // Diagonal hatch segments clipped to every footprint polygon.
 653: function hatchSegments(footprints: Footprint[], spacing: number): Array<[Vec, Vec]> {
 654:   const segs: Array<[Vec, Vec]> = [];
 655:   const angle = (T.world.sidequests.hatchAngleDeg * Math.PI) / 180; // lit-ok: degrees to radians
 656:   const dx = Math.cos(angle);
 657:   const dz = Math.sin(angle);
 658:   const nx = -dz;
 659:   const nz = dx;
 660:   for (const fp of footprints) {
 661:     const poly = fp.polygon;
 662:     let cMin = Infinity;
 663:     let cMax = -Infinity;
 664:     for (const v of poly) {
 665:       const c = v[0] * nx + v[1] * nz;
 666:       if (c < cMin) cMin = c;
 667:       if (c > cMax) cMax = c;
 668:     }
 669:     const first = Math.ceil(cMin / spacing) * spacing;
 670:     for (let c = first; c <= cMax; c += spacing) {
 671:       const hits: number[] = [];
 672:       for (let i = 0; i < poly.length; i++) {
 673:         const a = poly[i];
 674:         const b = poly[(i + 1) % poly.length];
 675:         const da = a[0] * nx + a[1] * nz - c;
 676:         const db = b[0] * nx + b[1] * nz - c;
 677:         if ((da < 0 && db >= 0) || (da >= 0 && db < 0)) {
 678:           const t = da / (da - db);
 679:           const px = a[0] + (b[0] - a[0]) * t;
 680:           const pz = a[1] + (b[1] - a[1]) * t;
 681:           hits.push(px * dx + pz * dz);
 682:         }
 683:       }
 684:       hits.sort((a, b) => a - b);
 685:       for (let h = 0; h + 1 < hits.length; h += 2) {
 686:         const s0 = hits[h];
 687:         const s1 = hits[h + 1];
 688:         if (s1 - s0 <= 0) continue;
 689:         const a: Vec = [nx * c + dx * s0, nz * c + dz * s0];
 690:         const b: Vec = [nx * c + dx * s1, nz * c + dz * s1];
 691:         segs.push([a, b]);
 692:       }
 693:     }
 694:   }
 695:   return segs;
 696: }
 697: 
 698: export function generate(
 699:   seed: number,
 700:   out: Float32Array,
 701:   layoutIndex: number,
 702: ): SideQuestsSideData {
 703:   const sq = T.world.sidequests;
 704:   const texW = T.world.layoutTexture.width;
 705:   const texH = T.world.layoutTexture.height;
 706:   const expected = texW * texH * 4; // lit-ok: RGBA component count
 707:   if (out.length < expected) throw new Error('sidequests: layout array too small');
 708:   const base = seed + layoutIndex * 1000003; // lit-ok: layout stream stride
 709:   const r = rng(base);
 710: 
 711:   let lane = 0;
 712: 
 713:   // Grid: vertical lines then horizontal lines, unit lanes.
 714:   const extX = sq.extent[0];
 715:   const extZ = sq.extent[1];
 716:   const pitch = sq.gridPitch;
 717:   const xMin = -extX / 2;
 718:   const zMin = -extZ / 2;
 719:   const vLines = Math.round(extX / pitch) + 1;
 720:   const hLines = Math.round(extZ / pitch) + 1;
 721:   const vPerLine = Math.round(extZ / pitch);
 722:   const hPerLine = Math.round(extX / pitch);
 723:   for (let i = 0; i < vLines; i++) {
 724:     const x = xMin + i * pitch;
 725:     for (let j = 0; j < vPerLine; j++) {
 726:       const z0 = zMin + j * pitch;
 727:       straightLane(out, layoutIndex, lane, [x, z0], [x, z0 + pitch], CLS_GRID);
 728:       lane++;
 729:     }
 730:   }
 731:   for (let j = 0; j < hLines; j++) {
 732:     const z = zMin + j * pitch;
 733:     for (let i = 0; i < hPerLine; i++) {
 734:       const x0 = xMin + i * pitch;
 735:       straightLane(out, layoutIndex, lane, [x0, z], [x0 + pitch, z], CLS_GRID);
 736:       lane++;
 737:     }
 738:   }
 739:   if (lane !== sq.allocation.grid) throw new Error('sidequests: grid lane count mismatch');
 740: 
 741:   // Readout clear zone (S07 readability rule / kill criterion): no non-grid
 742:   // lane may fall inside it. Computed from the fine camera + measured readout box.
 743:   const zone = readoutClearZone();
 744: 
 745:   // Buildings, entrances, outlines.
 746:   const footprints = placeBuildings(r, base, zone);
 747:   const entrances: Vec[] = [];
 748:   for (let i = 0; i < footprints.length; i++) {
 749:     const others = footprints.filter((_, j) => j !== i);
 750:     entrances.push(entranceFor(footprints[i], others));
 751:   }
 752:   const outlineLen = sq.outlineLaneLength;
 753:   for (const fp of footprints) {
 754:     const poly = fp.polygon;
 755:     for (let i = 0; i < poly.length; i++) {
 756:       const a = poly[i];
 757:       const c = poly[(i + 1) % poly.length];
 758:       const len = Math.hypot(c[0] - a[0], c[1] - a[1]);
 759:       const count = Math.max(1, Math.round(len / outlineLen));
 760:       for (let s = 0; s < count; s++) {
 761:         straightLane(out, layoutIndex, lane, lerp2(a, c, s / count), lerp2(a, c, (s + 1) / count), CLS_OUTLINE);
 762:         lane++;
 763:       }
 764:     }
 765:   }
 766: 
 767:   // Walkways: shortest edges of the entrance spanning tree, curved.
 768:   const n = entrances.length;
 769:   const inTree = new Array<boolean>(n).fill(false);
 770:   const minDist = new Array<number>(n).fill(Infinity);
 771:   const parent = new Array<number>(n).fill(-1);
 772:   minDist[0] = 0;
 773:   const mstEdges: Array<[number, number, number]> = [];
 774:   for (let iter = 0; iter < n; iter++) {
 775:     let u = -1;
 776:     for (let i = 0; i < n; i++) {
 777:       if (!inTree[i] && (u === -1 || minDist[i] < minDist[u])) u = i;
 778:     }
 779:     inTree[u] = true;
 780:     if (parent[u] !== -1) mstEdges.push([parent[u], u, minDist[u]]);
 781:     for (let v = 0; v < n; v++) {
 782:       if (!inTree[v]) {
 783:         const d = Math.hypot(entrances[v][0] - entrances[u][0], entrances[v][1] - entrances[u][1]);
 784:         if (d < minDist[v]) {
 785:           minDist[v] = d;
 786:           parent[v] = u;
 787:         }
 788:       }
 789:     }
 790:   }
 791:   mstEdges.sort((a, b) => a[2] - b[2]);
 792:   const walkwayEdges = mstEdges.slice(0, sq.walkways);
 793:   const [offMin, offMax] = sq.walkwayOffset;
 794:   for (const [ai, bi] of walkwayEdges) {
 795:     const A = entrances[ai];
 796:     const B = entrances[bi];
 797:     const abx = B[0] - A[0];
 798:     const abz = B[1] - A[1];
 799:     const abLen = Math.hypot(abx, abz);
 800:     const nx = -abz / abLen;
 801:     const nz = abx / abLen;
 802:     const o1 = (offMin + r() * (offMax - offMin)) * abLen * (r() < 0.5 ? -1 : 1);
 803:     const o2 = (offMin + r() * (offMax - offMin)) * abLen * (r() < 0.5 ? -1 : 1);
 804:     const c1: Vec = [A[0] + abx * 0.33 + nx * o1, A[1] + abz * 0.33 + nz * o1]; // lit-ok: walkway control fractions
 805:     const c2: Vec = [A[0] + abx * 0.66 + nx * o2, A[1] + abz * 0.66 + nz * o2]; // lit-ok: walkway control fractions
 806:     let curve = makeCurve([A, c1, c2, B]);
 807:     if (curveHitsFootprint(curve, footprints) || curveHitsZone(curve, zone)) {
 808:       const f1: Vec = [A[0] + abx * 0.33 - nx * o1, A[1] + abz * 0.33 - nz * o1]; // lit-ok: walkway control fractions
 809:       const f2: Vec = [A[0] + abx * 0.66 - nx * o2, A[1] + abz * 0.66 - nz * o2]; // lit-ok: walkway control fractions
 810:       curve = makeCurve([A, f1, f2, B]);
 811:       if (curveHitsFootprint(curve, footprints) || curveHitsZone(curve, zone)) {
 812:         curve = makeStraightCurve(A, B);
 813:         // Straight through a footprint is the spec fallback, but straight
 814:         // through the readout zone is never allowed (kill criterion): detour.
 815:         if (curveHitsZone(curve, zone)) {
 816:           curve = detourWalkway(A, B, zone, footprints);
 817:         }
 818:       }
 819:     }
 820:     const count = Math.max(1, Math.round(curve.length / sq.walkwayLaneLength));
 821:     for (let s = 0; s < count; s++) {
 822:       const a = (curve.length * s) / count;
 823:       const b = (curve.length * (s + 1)) / count;
 824:       curveLane(out, layoutIndex, lane, curve.pointAt, a, b, CLS_WALKWAY);
 825:       lane++;
 826:     }
 827:   }
 828: 
 829:   // Markers: integer points clear of footprints and the trailhead, far apart,
 830:   // outside the readout clear zone, and visible at the fine pose (head
 831:   // projection inside the viewport with a 50px margin, so the 44px twin
 832:   // is fully on screen and clickable by pointer).
 833:   const start: Vec = [sq.trails.start[0], sq.trails.start[2]];
 834:   const bld = sq.buildings;
 835:   const [rx0, rx1] = bld.region[0];
 836:   const [rz0, rz1] = bld.region[1];
 837:   const headY = sq.marker.poleHeight + sq.marker.radius * sq.marker.squashY;
 838:   const candidates: Vec[] = [];
 839:   for (let gx = Math.ceil(rx0); gx <= Math.floor(rx1); gx++) {
 840:     for (let gz = Math.ceil(rz0); gz <= Math.floor(rz1); gz++) {
 841:       const p: Vec = [gx, gz];
 842:       if (Math.hypot(p[0] - start[0], p[1] - start[1]) < sq.markerMinFromStart) continue;
 843:       if (inZone(p, zone)) continue;
 844:       const [sx, sy] = projectToFineScreen(p[0], headY, p[1]);
 845:       if (sx < 50 || sx > 1390 || sy < 50 || sy > 850) continue; // lit-ok: 50px visibility margin at 1440x900
 846:       let clear = true;
 847:       for (const fp of footprints) {
 848:         if (!clearOfFootprint(p, fp, sq.footprintMargin)) {
 849:           clear = false;
 850:           break;
 851:         }
 852:       }
 853:       if (clear) candidates.push(p);
 854:     }
 855:   }
 856:   if (candidates.length < sq.trails.count) throw new Error('sidequests: too few marker candidates');
 857:   const markers: Vec[] = [candidates[Math.floor(r() * candidates.length)]];
 858:   while (markers.length < sq.trails.count) {
 859:     let best: Vec | null = null;
 860:     let bestD = -1;
 861:     for (const c of candidates) {
 862:       if (markers.includes(c)) continue;
 863:       let minD = Infinity;
 864:       for (const m of markers) {
 865:         minD = Math.min(minD, Math.hypot(c[0] - m[0], c[1] - m[1]));
 866:       }
 867:       if (minD >= sq.markerMinApart && minD > bestD) {
 868:         bestD = minD;
 869:         best = c;
 870:       }
 871:     }
 872:     if (best === null) throw new Error('sidequests: no marker candidate far enough apart');
 873:     markers.push(best);
 874:   }
 875: 
 876:   // Trails: dashed curves from the trailhead to each marker.
 877:   const trailsSide: SideQuestsTrailSideData[] = [];
 878:   for (const marker of markers) {
 879:     const dx = marker[0] - start[0];
 880:     const dz = marker[1] - start[1];
 881:     const len = Math.hypot(dx, dz);
 882:     const px = -dz / len;
 883:     const pz = dx / len;
 884:     const wps: Vec[] = [];
 885:     for (const f of sq.waypointFractions) {
 886:       const off = (r() * 2 - 1) * sq.waypointOffset;
 887:       let wp: Vec = [start[0] + dx * f + px * off, start[1] + dz * f + pz * off];
 888:       for (let guard = 0; guard < 10; guard++) { // lit-ok: nudge re-check cap
 889:         let moved = false;
 890:         for (const fp of footprints) {
 891:           if (pointInPolygon(wp, fp.polygon)) {
 892:             wp = nudgeOut(wp, fp.polygon, sq.footprintMargin);
 893:             moved = true;
 894:           }
 895:         }
 896:         if (inZone(wp, zone)) {
 897:           wp = pushOutOfZone(wp, zone, sq.footprintMargin);
 898:           moved = true;
 899:         }
 900:         if (!moved) break;
 901:       }
 902:       wps.push(wp);
 903:     }
 904:     let curve = makeCurve([start, ...wps, marker]);
 905:     // The curve can still bulge into the zone between control points:
 906:     // push the nearest waypoint away from the zone center and rebuild.
 907:     for (let iter = 0; iter < 20; iter++) { // lit-ok: trail zone-avoidance iterations
 908:       if (!curveHitsZone(curve, zone)) break;
 909:       const cx = (zone[0] + zone[2]) / 2;
 910:       const cz = (zone[1] + zone[3]) / 2;
 911:       let best = -1;
 912:       let bestD = Infinity;
 913:       for (let i = 0; i < wps.length; i++) {
 914:         const d = Math.hypot(wps[i][0] - cx, wps[i][1] - cz);
 915:         if (d < bestD) {
 916:           bestD = d;
 917:           best = i;
 918:         }
 919:       }
 920:       const wp = wps[best];
 921:       let vx = wp[0] - cx;
 922:       let vz = wp[1] - cz;
 923:       const vlen = Math.hypot(vx, vz) || 1;
 924:       vx /= vlen;
 925:       vz /= vlen;
 926:       wps[best] = [wp[0] + vx * 1, wp[1] + vz * 1]; // lit-ok: trail re-route step
 927:       curve = makeCurve([start, ...wps, marker]);
 928:     }
 929:     if (curveHitsZone(curve, zone)) throw new Error('sidequests: trail cannot avoid the readout zone');
 930:     const dash = sq.trails.dashLength;
 931:     const gap = sq.trails.gapLength;
 932:     const laneIds: number[] = [];
 933:     const arcStarts: number[] = [];
 934:     const arcLengths: number[] = [];
 935:     let s = 0;
 936:     while (s < curve.length) {
 937:       const e = Math.min(s + dash, curve.length);
 938:       curveLane(out, layoutIndex, lane, curve.pointAt, s, e, CLS_TRAIL);
 939:       laneIds.push(lane);
 940:       arcStarts.push(s);
 941:       arcLengths.push(e - s);
 942:       lane++;
 943:       s += dash + gap;
 944:     }
 945:     trailsSide.push({ laneIds, arcStarts, arcLengths });
 946:   }
 947: 
 948:   // Hatch: the remainder, allocated across clipped diagonal segments by length.
 949:   const hatchN = T.world.laneCount - lane;
 950:   if (hatchN <= 0) throw new Error('sidequests: no lanes left for hatch');
 951:   let spacing = sq.hatchSpacing;
 952:   let segments: Array<[Vec, Vec]> = [];
 953:   for (let attempt = 0; attempt < 100; attempt++) { // lit-ok: spacing growth cap
 954:     segments = hatchSegments(footprints, spacing);
 955:     if (segments.length <= hatchN) break;
 956:     spacing *= sq.hatchSpacingGrow;
 957:   }
 958:   if (segments.length > hatchN) throw new Error('sidequests: hatch segments exceed remainder');
 959:   if (segments.length === 0) throw new Error('sidequests: no hatch segments');
 960:   const segLens = segments.map(([a, b]) => Math.hypot(b[0] - a[0], b[1] - a[1]));
 961:   const segTotal = segLens.reduce((sum, l) => sum + l, 0);
 962:   const quotas = segLens.map((l) => (hatchN * l) / segTotal);
 963:   const counts = quotas.map((q) => Math.max(1, Math.floor(q)));
 964:   let sum = counts.reduce((s, c) => s + c, 0);
 965:   if (sum < hatchN) {
 966:     const order = quotas.map((_, i) => i).sort((a, b) => {
 967:       const fa = quotas[a] - Math.floor(quotas[a]);
 968:       const fb = quotas[b] - Math.floor(quotas[b]);
 969:       return fb - fa;
 970:     });
 971:     let oi = 0;
 972:     while (sum < hatchN) {
 973:       counts[order[oi % order.length]]++;
 974:       sum++;
 975:       oi++;
 976:     }
 977:   }
 978:   if (sum > hatchN) {
 979:     while (sum > hatchN) {
 980:       let bestIdx = -1;
 981:       for (let i = 0; i < counts.length; i++) {
 982:         if (counts[i] > 1 && (bestIdx === -1 || counts[i] > counts[bestIdx])) bestIdx = i;
 983:       }
 984:       if (bestIdx === -1) throw new Error('sidequests: hatch trim failed');
 985:       counts[bestIdx]--;
 986:       sum--;
 987:     }
 988:   }
 989:   for (let e = 0; e < segments.length; e++) {
 990:     const [a, b] = segments[e];
 991:     const k = counts[e];
 992:     for (let s = 0; s < k; s++) {
 993:       straightLane(out, layoutIndex, lane, lerp2(a, b, s / k), lerp2(a, b, (s + 1) / k), CLS_HATCH);
 994:       lane++;
 995:     }
 996:   }
 997: 
 998:   if (lane !== T.world.laneCount) throw new Error('sidequests: lane total mismatch');
 999:   return {
1000:     markers,
1001:     trails: trailsSide,
1002:     footprints: footprints.map((fp) => fp.polygon),
1003:   };
1004: }
