  1: #!/usr/bin/env node
  2: // G-TOKENS (S00 section 5.1 + section 6 unlayered-CSS rule).
  3: // Scans src/**/*.{ts,tsx,css,glsl} excluding *.generated.*. Exit 1 on any
  4: // violation, listing file:line for each.
  5: import { readdirSync, readFileSync, statSync } from 'node:fs';
  6: import { dirname, join, relative } from 'node:path';
  7: import { fileURLToPath } from 'node:url';
  8: 
  9: const root = join(dirname(fileURLToPath(import.meta.url)), '..');
 10: const srcDir = join(root, 'src');
 11: const violations = [];
 12: 
 13: function* walk(dir) {
 14:   for (const e of readdirSync(dir, { withFileTypes: true })) {
 15:     const p = join(dir, e.name);
 16:     if (e.isDirectory()) yield* walk(p);
 17:     else if (/\.(ts|tsx|css|glsl)$/.test(e.name) && !/\.generated\./.test(e.name)) yield p;
 18:   }
 19: }
 20: 
 21: function stripBlockComments(text) {
 22:   return text.replace(/\/\*[\s\S]*?\*\//g, '');
 23: }
 24: 
 25: function stripLineComments(text) {
 26:   return text.replace(/\/\/[^\n]*/g, '');
 27: }
 28: 
 29: // Remove @layer blocks (balanced braces) from CSS, returning the remainder.
 30: function stripLayerBlocks(css) {
 31:   let out = '';
 32:   let i = 0;
 33:   while (i < css.length) {
 34:     const at = css.indexOf('@layer', i);
 35:     if (at === -1) {
 36:       out += css.slice(i);
 37:       break;
 38:     }
 39:     out += css.slice(i, at);
 40:     // Find the opening brace of the layer block (may be "@layer name {"
 41:     // or "@layer name, other;"). If it ends with ';' there is no block.
 42:     const semi = css.indexOf(';', at);
 43:     const brace = css.indexOf('{', at);
 44:     if (brace === -1 || (semi !== -1 && semi < brace)) {
 45:       i = semi === -1 ? css.length : semi + 1;
 46:       continue;
 47:     }
 48:     let depth = 0;
 49:     let j = brace;
 50:     while (j < css.length) {
 51:       if (css[j] === '{') depth++;
 52:       else if (css[j] === '}') {
 53:         depth--;
 54:         if (depth === 0) break;
 55:       }
 56:       j++;
 57:     }
 58:     i = j + 1;
 59:   }
 60:   return out;
 61: }
 62: 
 63: for (const file of walk(srcDir)) {
 64:   const rel = relative(root, file);
 65:   const raw = readFileSync(file, 'utf8');
 66:   const isCss = file.endsWith('.css');
 67:   const isWorld = rel.startsWith('src/world/');
 68:   const lines = raw.split('\n');
 69:   lines.forEach((line, idx) => {
 70:     const n = idx + 1;
 71:     const fail = (rule) => violations.push(`${rel}:${n}: ${rule}: ${line.trim().slice(0, 100)}`);
 72:     if (/#[0-9a-fA-F]{3,8}\b/.test(line)) fail('hex color literal');
 73:     if (isCss && /\b\d+(\.\d+)?m?s\b/.test(line)) fail('duration literal in CSS');
 74:     if (!isCss && /['"`][^'"`]*\b\d+(\.\d+)?m?s\b[^'"`]*['"`]/.test(line)) fail('duration literal in TS string');
 75:     if (/cubic-bezier\(/.test(line)) fail('cubic-bezier outside generated file');
 76:     if (/--duration-medium-max/.test(line)) fail('--duration-medium-max');
 77:     if (/box-shadow\s*:[^;]*\b(?!inset\b)\w/.test(line) && !/box-shadow\s*:\s*inset/.test(line)) fail('box-shadow with non-inset value');
 78:     if (/backdrop-filter/.test(line)) fail('backdrop-filter');
 79:     if (/filter\s*:\s*blur/.test(line)) fail('filter: blur');
 80:     if (/linear-gradient|radial-gradient/.test(line)) fail('gradient');
 81:     if (/text-transform\s*:\s*uppercase/.test(line)) fail('text-transform: uppercase');
 82:     if (isWorld && !line.includes('// lit-ok:')) {
 83:       // Standalone numeric literals only: digits inside identifiers
 84:       // (Int32Array, p50) are not literals. Other than 0, 1, 2, 0.5, -1
 85:       // outside array indexes need // lit-ok:.
 86:       const noStrings = line.replace(/(['"`])(?:\\\1|.)*?\1/g, '');
 87:       const nums = noStrings.match(/(?<![A-Za-z0-9_$])-?\d+(?:\.\d+)?(?![A-Za-z0-9_$])/g) || [];
 88:       const allowed = new Set(['0', '1', '2', '0.5', '-1']);
 89:       const bad = nums.filter((x) => !allowed.has(x));
 90:       // Heuristic: numbers inside [..] (array index) or for-loop bounds
 91:       // are exempt; if the line is only such a use, skip. We approximate
 92:       // by exempting lines whose bad numbers all sit inside brackets.
 93:       if (bad.length > 0) {
 94:         const bracketed = (noStrings.match(/\[[^\]]*\]/g) || []).join(' ');
 95:         const outside = bad.filter((x) => {
 96:           const inBracket = new RegExp(`\\[[^\\]]*\\b${x.replace('.', '\\.')}\\b[^\\]]*\\]`).test(bracketed);
 97:           return !inBracket;
 98:         });
 99:         if (outside.length > 0) fail(`numeric literal in src/world (${outside.join(', ')}) without // lit-ok:`);
100:       }
101:     }
102:   });
103:   if (isCss) {
104:     const noComments = stripBlockComments(raw);
105:     let rest = stripLayerBlocks(noComments);
106:     // Allow @import lines and @font-face blocks outside layers.
107:     rest = rest.replace(/@import[^;]+;/g, '');
108:     rest = rest.replace(/@font-face\s*\{[^}]*\}/g, '');
109:     rest = rest.replace(/@charset[^;]+;/g, '');
110:     if (/[^\s{};][^{};]*\{/.test(rest)) {
111:       violations.push(`${rel}: unlayered CSS rule outside @layer blocks`);
112:     }
113:   }
114: }
115: 
116: if (violations.length > 0) {
117:   console.error('lint-tokens: violations found:');
118:   for (const v of violations) console.error(`  ${v}`);
119:   process.exit(1);
120: }
121: console.log('lint-tokens: clean');
</file>

