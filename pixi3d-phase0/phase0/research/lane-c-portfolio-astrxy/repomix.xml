  1: /* Chrome styles (S04). All rules sit in the jp-chrome layer per S00
  2:  * section 6. Values come from tokens: Astryx --spacing/--text/--color
  3:  * tokens, --jp-* custom properties from tokens.generated.css, and
  4:  * --jp-ro-* properties set inline from T by Readout (TS-only tokens
  5:  * such as serverReadoutWidth have no CSS var). No hex, no duration
  6:  * literal, no cubic-bezier, no non-inset shadow, no gradient, no blur,
  7:  * no uppercase transform anywhere in this file. */
  8: @layer jp-chrome {
  9:   :root {
 10:     /* S04 section 4: keymap height by pointer; gutter by breakpoint.
 11:      * Token vars: --jp-keymap-h-fine/coarse, --jp-gutter-base/640/1280. */
 12:     --jp-keymap-h: var(--jp-keymap-h-fine);
 13:     --jp-gutter: var(--jp-gutter-base);
 14:   }
 15: 
 16:   @media (pointer: coarse) {
 17:     :root {
 18:       --jp-keymap-h: var(--jp-keymap-h-coarse);
 19:     }
 20:   }
 21: 
 22:   @media (min-width: 640px) {
 23:     :root {
 24:       --jp-gutter: var(--jp-gutter-640);
 25:     }
 26:   }
 27: 
 28:   @media (min-width: 1280px) {
 29:     :root {
 30:       --jp-gutter: var(--jp-gutter-1280);
 31:     }
 32:   }
 33: 
 34:   /* S04 section 6: the page itself never scrolls. */
 35:   html,
 36:   body {
 37:     height: 100%;
 38:     overflow: hidden;
 39:   }
 40: 
 41:   /* Scrim: regime ground at 60% (S04 section 7). Astryx dialog
 42:    * ::backdrop reads --color-overlay; color-mix keeps the value in
 43:    * tokens (no hex literal). S04 section 7 also says never a blur:
 44:    * BottomSheet's backdrop has no blur filter (verified: the blur
 45:    * backdrop class belongs to Dialog/Lightbox/MobileNav, not
 46:    * BottomSheet). */
 47:   :root[data-regime="void"] {
 48:     --color-overlay: color-mix(in srgb, var(--jp-void-ground) 60%, transparent);
 49:   }
 50: 
 51:   :root[data-regime="paper"] {
 52:     --color-overlay: color-mix(in srgb, var(--jp-paper-ground) 60%, transparent);
 53:   }
 54: 
 55:   :root[data-regime="field"] {
 56:     --color-overlay: color-mix(in srgb, var(--jp-field-ground) 60%, transparent);
 57:   }
 58: 
 59:   /* Wordmark (S04 section 5): top-left at the gutter, label size,
 60:    * weight 700, primary text color. Hidden on Server via the hidden
 61:    * attribute, not opacity. */
 62:   .jp-wordmark {
 63:     position: fixed;
 64:     top: var(--jp-gutter);
 65:     left: var(--jp-gutter);
 66:     z-index: 2;
 67:     font-size: var(--text-label-size);
 68:     font-weight: 700;
 69:     line-height: var(--text-label-leading);
 70:     color: var(--color-text-primary);
 71:     text-decoration: none;
 72:   }
 73: 
 74:   .jp-wordmark:hover {
 75:     color: var(--color-text-primary);
 76:     text-decoration: underline;
 77:   }
 78: 
 79:   /* Keymap (S04 section 4): fixed to the bottom edge, full width,
 80:    * opaque ground so it reads over any lane, 1px top hairline.
 81:    * Height is keymap-h plus safe-area room: border-box (Astryx reset)
 82:    * would otherwise crush the content area by the safe-area inset on
 83:    * notched phones, so the height calc keeps the content area exactly
 84:    * keymap-h. In tests safe-area is 0, so the measured height equals
 85:    * the token height. */
 86:   .jp-keymap {
 87:     position: fixed;
 88:     left: 0;
 89:     right: 0;
 90:     bottom: 0;
 91:     z-index: 2;
 92:     /* will-change forces the keymap into its own compositor layer.
 93:        Without it, Chromium's compositor leaves the top keymap-height
 94:        rows of the WebGL canvas black (T-SRV-2 phone background failure:
 95:        a 36px black band at the viewport top at every viewport, present
 96:        only while the keymap is a plain fixed element, gone the moment
 97:        the keymap gets its own layer). No visual or layout change. */
 98:     will-change: transform;
 99:     height: calc(var(--jp-keymap-h) + env(safe-area-inset-bottom));
100:     padding-bottom: env(safe-area-inset-bottom);
101:     padding-left: var(--jp-gutter);
102:     padding-right: var(--jp-gutter);
103:     display: flex;
104:     align-items: center;
105:     gap: var(--spacing-6);
106:     background: var(--jp-ground);
107:     box-shadow: inset 0 1px 0 0 var(--jp-hairline);
108:     white-space: nowrap;
109:   }
110: 
111:   /* T.chrome.keymapNarrowBelowPx: under 360px, reduce the gap, never
112:    * shrink text below 13px, never truncate. */
113:   @media (max-width: 359px) {
114:     .jp-keymap {
115:       gap: var(--spacing-3);
116:     }
117:   }
118: 
119:   .jp-keymap-item {
120:     display: flex;
121:     align-items: center;
122:     gap: var(--spacing-2);
123:     height: 100%;
124:     color: var(--color-text-secondary);
125:     text-decoration: none;
126:     background: transparent;
127:     border: 0;
128:     padding: 0;
129:     font-family: inherit;
130:     font-size: var(--text-label-size);
131:     line-height: var(--text-label-leading);
132:     cursor: pointer;
133:     transition: color var(--jp-duration-fast) var(--jp-ease-standard);
134:   }
135: 
136:   /* Coarse targets: at least 44px wide (T.size.coarseMinTargetPx).
137:    * Labels already exceed this at 13px mono, but the floor holds for
138:    * any shorter future label. */
139:   @media (pointer: coarse) {
140:     .jp-keymap-item {
141:       min-width: 44px;
142:     }
143:   }
144: 
145:   .jp-keymap-item:hover,
146:   .jp-keymap-item:focus-visible {
147:     color: var(--color-text-primary);
148:   }
149: 
150:   /* Polish item 6: two groups on one line. Scenes sit left, panels
151:    * (whoami, contact) sit right, so the five words read as places
152:    * and drawers instead of one undifferentiated row. */
153:   .jp-keymap-item[data-route] + .jp-keymap-item[aria-haspopup] {
154:     margin-left: auto;
155:   }
156: 
157:   /* GLITTERBOX hold: no long-press callout or text selection on the
158:    * lane field, so a hold reaches the page. */
159:   #world canvas {
160:     -webkit-touch-callout: none;
161:     -webkit-user-select: none;
162:     user-select: none;
163:   }
164: 
165:   .jp-keymap-item[aria-current="page"],
166:   .jp-keymap-item[aria-expanded="true"] {
167:     color: var(--color-accent);
168:   }
169: 
170:   .jp-keymap-item .astryx-kbd {
171:     transition: box-shadow var(--jp-duration-fast) var(--jp-ease-standard);
172:   }
173: 
174:   .jp-keymap-item:hover .astryx-kbd,
175:   .jp-keymap-item:focus-visible .astryx-kbd {
176:     box-shadow: inset 0 0 0 1px var(--color-text-secondary);
177:   }
178: 
179:   .jp-keymap-item[aria-current="page"] .astryx-kbd,
180:   .jp-keymap-item[aria-expanded="true"] .astryx-kbd {
181:     box-shadow: inset 0 0 0 1px var(--color-accent);
182:   }
183: 
184:   /* Coarse pointers: the Kbd is hidden (display none, not just
185:    * transparent) and the label is the full target. */
186:   @media (pointer: coarse) {
187:     .jp-keymap-item .astryx-kbd {
188:       display: none;
189:     }
190:   }
191: 
192:   /* Focus: 2px accent, 3px offset (T.focus), :focus-visible only. */
193:   .jp-keymap-item:focus-visible,
194:   .jp-wordmark:focus-visible {
195:     outline: 2px solid var(--color-accent);
196:     outline-offset: 3px;
197:   }
198: 
199:   /* Readout (S04 section 6). Base styles are the coarse/narrow
200:    * placement; the fine media query (width at least
201:    * T.breakpoints.desktopFromPx with a fine pointer) overrides to the
202:    * fine placement. Variant geometry values arrive as --jp-ro-*
203:    * custom properties set inline from T by Readout. */
204:   .jp-readout {
205:     position: fixed;
206:     z-index: 1;
207:     max-width: var(--jp-readout-max-width);
208:     overflow-y: auto;
209:     overscroll-behavior: contain;
210:     color: var(--color-text-primary);
211:   }
212: 
213:   .jp-readout h1 {
214:     margin: 0;
215:   }
216: 
217:   .jp-readout--server h1,
218:   .jp-readout--notfound h1 {
219:     font-size: var(--jp-text-display-0-size);
220:     font-weight: var(--jp-text-display-0-weight);
221:     line-height: var(--jp-text-display-0-leading);
222:     letter-spacing: var(--jp-text-display-0-tracking);
223:   }
224: 
225:   .jp-readout--leaflink h1,
226:   .jp-readout--sidequests h1 {
227:     font-size: var(--jp-text-display-1-size);
228:     font-weight: var(--jp-text-display-1-weight);
229:     line-height: var(--jp-text-display-1-leading);
230:     letter-spacing: var(--jp-text-display-1-tracking);
231:   }
232: 
233:   /* S08 section 3: the 404 reuses the server variant placement but its
234:    * H1 is display-1, not display-0. */
235:   .jp-readout--notfound h1 {
236:     font-size: var(--jp-text-display-1-size);
237:     font-weight: var(--jp-text-display-1-weight);
238:     line-height: var(--jp-text-display-1-leading);
239:     letter-spacing: var(--jp-text-display-1-tracking);
240:   }
241: 
242:   .jp-readout p {
243:     font-size: var(--text-body-size);
244:     font-weight: var(--text-body-weight);
245:     line-height: var(--text-body-leading);
246:     margin: 0;
247:   }
248: 
249:   .jp-readout .jp-readout-supporting {
250:     font-size: var(--text-supporting-size);
251:     font-weight: var(--text-supporting-weight);
252:     line-height: var(--text-supporting-leading);
253:     color: var(--color-text-secondary);
254:   }
255: 
256:   .jp-readout .jp-readout-caption {
257:     font-size: var(--text-supporting-size);
258:     font-weight: var(--text-supporting-weight);
259:     line-height: var(--text-supporting-leading);
260:     color: var(--color-text-secondary);
261:   }
262: 
263:   /* Spacing (S04 section 6): H1 to first paragraph spacing-6,
264:    * paragraph to paragraph spacing-4, prose to supporting spacing-6,
265:    * supporting lines spacing-2 apart, links row spacing-6 above,
266:    * links spacing-6 apart. */
267:   .jp-readout h1 + p,
268:   .jp-readout h1 + .jp-readout-supporting,
269:   .jp-readout h1 + .jp-readout-caption {
270:     margin-top: var(--spacing-6);
271:   }
272: 
273:   .jp-readout p + p {
274:     margin-top: var(--spacing-4);
275:   }
276: 
277:   .jp-readout p + .jp-readout-supporting,
278:   .jp-readout p + .jp-readout-caption,
279:   .jp-readout .jp-readout-supporting + .jp-readout-caption,
280:   .jp-readout .jp-readout-caption + .jp-readout-supporting {
281:     margin-top: var(--spacing-6);
282:   }
283: 
284:   .jp-readout .jp-readout-supporting + .jp-readout-supporting {
285:     margin-top: var(--spacing-2);
286:   }
287: 
288:   .jp-readout-links {
289:     display: flex;
290:     gap: var(--spacing-6);
291:     margin-top: var(--spacing-6);
292:   }
293: 
294:   /* Server variant, coarse/narrow: top, full width minus gutters. */
295:   .jp-readout--server,
296:   .jp-readout--notfound {
297:     top: calc(var(--jp-gutter) + var(--jp-ro-top-extra));
298:     left: var(--jp-gutter);
299:     right: var(--jp-gutter);
300:     max-width: none;
301:   }
302: 
303:   /* Name clear zone (S04 section 5, DESIGN section 5): the
304:    * wordmark sits at the gutter with label height, so the clear
305:    * box bottom is gutter plus label height plus zone pad. The
306:    * 404 readout on coarse/narrow starts below that bottom; the
307:    * server variant keeps its own top because its wordmark is
308:    * hidden. The fine rule below still bottom-anchors both. */
309:   .jp-readout--notfound {
310:     top: calc(
311:       var(--jp-gutter) + var(--text-label-size) *
312:         var(--text-label-leading) + var(--jp-name-pad)
313:     );
314:   }
315: 
316:   /* Server variant, fine: left column, bottom sits
317:    * serverReadoutBottomGap above the keymap, width serverReadoutWidth. */
318:   @media (min-width: 1024px) and (pointer: fine) {
319:     .jp-readout--server,
320:     .jp-readout--notfound {
321:       top: auto;
322:       left: var(--jp-gutter);
323:       right: auto;
324:       bottom: calc(var(--jp-keymap-h) + var(--jp-ro-bottom-gap));
325:       width: var(--jp-ro-width);
326:       max-width: var(--jp-readout-max-width);
327:     }
328:   }
329: 
330:   /* LeafLink variant, coarse/narrow: slip above the keymap, full width
331:    * minus gutters, max height 46dvh, scrolls internally. */
332:   .jp-readout--leaflink {
333:     left: var(--jp-gutter);
334:     right: var(--jp-gutter);
335:     bottom: calc(var(--jp-keymap-h) + var(--jp-gutter));
336:     max-width: none;
337:     max-height: var(--jp-ro-max-height);
338:   }
339: 
340:   /* LeafLink variant, fine: bottom-left legend slip. */
341:   @media (min-width: 1024px) and (pointer: fine) {
342:     .jp-readout--leaflink {
343:       right: auto;
344:       width: var(--jp-ro-width);
345:       max-width: var(--jp-readout-max-width);
346:       max-height: none;
347:     }
348:   }
349: 
350:   /* LeafLink container: raised fill, 0 radius, hairline ring.
351:    * Bound to the paper token directly, not the ambient regime var:
352:    * a LeafLink slip is paper by definition, and the ambient var
353:    * resolves to void if the page mounts after a manual slip render
354:    * sets the regime (T-LL-5 on WebKit: App's initial applyRegime
355:    * clobbers a pre-mount paper setting back to void). */
356:   .jp-readout--leaflink .jp-readout-slip {
357:     background: var(--jp-paper-raised);
358:     box-shadow: inset 0 0 0 1px var(--jp-hairline);
359:     border-radius: 0;
360:     padding: var(--spacing-4);
361:   }
362: 
363:   /* SideQuests variant, coarse/narrow: top below the name clear
364:    * zone, full width minus gutters. Same clear box bottom as the
365:    * 404 rule above: gutter plus label height plus zone pad. */
366:   .jp-readout--sidequests {
367:     top: calc(
368:       var(--jp-gutter) + var(--text-label-size) *
369:         var(--text-label-leading) + var(--jp-name-pad)
370:     );
371:     left: var(--jp-gutter);
372:     right: var(--jp-gutter);
373:     max-width: none;
374:   }
375: 
376:   /* SideQuests variant, fine: top-right trailhead. */
377:   @media (min-width: 1024px) and (pointer: fine) {
378:     .jp-readout--sidequests {
379:       left: auto;
380:       right: var(--jp-gutter);
381:       top: calc(var(--jp-gutter) + var(--jp-ro-top-extra));
382:       width: var(--jp-ro-width);
383:       max-width: var(--jp-readout-max-width);
384:     }
385:   }
386: 
387:   /* SideQuests container (polish item 4): the trailhead sign is a
388:    * plate cut from the plan. field.raised fill, so no lane ever runs
389:    * through a letter (device run 2: dashed trails and building
390:    * outlines crossed the copy), 0 radius like the LeafLink paper slip
391:    * (one anatomy, each page in its own material), and the 1px dashed
392:    * chalk edge kept from S07 as the plate's cut line, now flush on
393:    * the plate instead of floating 12px outside bare text. Contrast:
394:    * chalk on field.raised 10.70, chalk.2 on field.raised 6.91. */
395:   .jp-readout--sidequests .jp-readout-slip {
396:     background: var(--jp-field-raised);
397:     outline: 1px dashed var(--jp-chalk-2);
398:     outline-offset: 0;
399:     border-radius: 0;
400:     padding: var(--spacing-4);
401:   }
402: 
403:   /* Project slips, coarse rhythm (polish items 3 and 4): on a phone
404:    * the slip must show the page verb without scrolling and leave the
405:    * open band for the mark and the tracked subject. Tighter steps
406:    * than the server readout, all on the Astryx spacing scale. Device
407:    * run 3 cut the offer button and trail row; the tight rhythm keeps
408:    * the remaining slip inside the 46dvh cap. */
409:   @media (max-width: 767px), (pointer: coarse) and (max-width: 1023px) {
410:     .jp-readout--sidequests h1 + p,
411:     .jp-readout--leaflink h1 + p {
412:       margin-top: var(--spacing-3);
413:     }
414: 
415:     .jp-readout--sidequests p + .jp-readout-supporting,
416:     .jp-readout--leaflink p + .jp-readout-supporting {
417:       margin-top: var(--spacing-3);
418:     }
419: 
420:     .jp-readout--sidequests .jp-readout-links,
421:     .jp-readout--leaflink .jp-readout-links {
422:       margin-top: var(--spacing-3);
423:     }
424:   }
425: 
426:   /* Sheets (S04 section 7): on fine pointers the inner content is
427:    * constrained to sheetMaxWidthPx and left-aligned with the keymap
428:    * gutter, a pane rising above the keymap, not centered. */
429:   .jp-sheet-inner {
430:     display: flex;
431:     flex-direction: column;
432:     gap: var(--spacing-4);
433:   }
434: 
435:   .jp-sheet-inner h2 {
436:     margin: 0;
437:   }
438: 
439:   .jp-sheet-inner p {
440:     margin: 0;
441:   }
442: 
443:   .jp-sheet-inner ul {
444:     list-style: none;
445:     margin: 0;
446:     padding: 0;
447:     display: flex;
448:     flex-direction: column;
449:     gap: var(--spacing-2);
450:   }
451: 
452:   .jp-sheet-links {
453:     display: flex;
454:     gap: var(--spacing-6);
455:   }
456: 
457:   .jp-sheet-actions {
458:     display: flex;
459:     gap: var(--spacing-4);
460:     flex-wrap: wrap;
461:   }
462: 
463:   .jp-contact-email {
464:     font-size: var(--text-large-size);
465:     font-weight: 700;
466:     line-height: var(--text-large-leading);
467:     user-select: all;
468:   }
469: 
470:   @media (pointer: fine) {
471:     .jp-sheet-inner {
472:       max-width: var(--jp-sheet-max);
473:       margin-left: var(--jp-gutter);
474:     }
475:   }
476: 
477:   /* Announcement region (S04 section 8): visually hidden, standard clip
478:    * pattern. S03 writes the new scene H1 into it after travel. */
479:   .jp-live {
480:     position: absolute;
481:     width: 1px;
482:     height: 1px;
483:     margin: -1px;
484:     padding: 0;
485:     overflow: hidden;
486:     clip: rect(0, 0, 0, 0);
487:     white-space: nowrap;
488:     border: 0;
489:   }
490: 
491:   /* Guestbook (DESIGN 6.14). No card, no white surface: the lane field
492:    * is the sheet. The panel moves in depth (translateZ under
493:    * perspective) on the Lusion main curve; it never fades. While open,
494:    * the scene readout and hero step out of the way (visibility, no
495:    * opacity), so the mark has the field to itself. */
496:   :root[data-gb="open"] #scene {
497:     visibility: hidden;
498:   }
499: 
500:   .jp-gb {
501:     position: fixed;
502:     inset: 0;
503:     z-index: 3;
504:     perspective: var(--jp-gb-perspective);
505:     pointer-events: none;
506:     color: var(--jp-text);
507:     font-family: var(--jp-font-family);
508:   }
509: 
510:   .jp-gb-catch {
511:     position: absolute;
512:     inset: 0 0 var(--jp-keymap-h) 0;
513:     pointer-events: auto;
514:   }
515: 
516:   .jp-gb-glyphs {
517:     position: absolute;
518:     inset: 0;
519:     overflow: hidden;
520:     pointer-events: none;
521:   }
522: 
523:   /* One glyph per letter lane, riding the lane tip. Font size is the
524:    * token maximum; the director scales it down by perspective. */
525:   .jp-gb-glyph {
526:     position: absolute;
527:     left: 0;
528:     top: 0;
529:     font-size: var(--jp-gb-glyph-max);
530:     font-weight: 700;
531:     line-height: 1;
532:     color: var(--jp-accent);
533:     transform-origin: 50% 100%;
534:     white-space: pre;
535:     will-change: transform;
536:   }
537: 
538:   .jp-gb-panel {
539:     position: absolute;
540:     left: var(--jp-gutter);
541:     right: var(--jp-gutter);
542:     bottom: calc(var(--jp-keymap-h) + var(--jp-gutter));
543:     max-width: var(--jp-sheet-max-width);
544:     display: flex;
545:     flex-direction: column;
546:     gap: var(--spacing-3);
547:     margin: 0;
548:     pointer-events: auto;
549:     transform: translate3d(0, calc(-1 * var(--jp-gb-lift, 0px)), calc(-1 * var(--jp-gb-panel-depth)));
550:     transform-origin: 0 100%;
551:     visibility: hidden;
552:     transition:
553:       transform var(--jp-duration-gb-panel) var(--jp-ease-gb-main),
554:       visibility var(--jp-duration-gb-panel) step-end;
555:   }
556: 
557:   .jp-gb[data-shown="true"] .jp-gb-panel {
