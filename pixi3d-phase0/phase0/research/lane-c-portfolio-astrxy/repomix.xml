176: // ---- Pixel helpers: decode a screenshot in the page and classify
177: // pixels in OKLab. Ground hexes come from the tokens.
178: function oklabJs(): string {
179:   return `
180:     const srgbToLinear = (c) => {
181:       const v = c / 255;
182:       return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
183:     };
184:     const toOklab = (r, g, b) => {
185:       const R = srgbToLinear(r), G = srgbToLinear(g), B = srgbToLinear(b);
186:       const l = 0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B;
187:       const m = 0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B;
188:       const s = 0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B;
189:       const l3 = Math.cbrt(l), m3 = Math.cbrt(m), s3 = Math.cbrt(s);
190:       return [
191:         0.2104542553 * l3 + 0.7936177850 * m3 - 0.0040720468 * s3,
192:         1.9779984951 * l3 - 2.4285922050 * m3 + 0.4505937099 * s3,
193:         0.0259040371 * l3 + 0.7827717662 * m3 - 0.8086757660 * s3,
194:       ];
195:     };
196:     const hueDeg = (a, b) => {
197:       let h = (Math.atan2(b, a) * 180) / Math.PI;
198:       if (h < 0) h += 360;
199:       return h;
200:     };
201:   `;
202: }
