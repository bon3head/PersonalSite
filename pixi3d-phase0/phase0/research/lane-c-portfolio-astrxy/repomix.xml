215: async function stopSampler(page: Page): Promise<Sample[]> {
216:   return page.evaluate(() => {
217:     const w = window as unknown as Record<string, unknown>;
218:     w.__camStop = true;
219:     const s = w.__camSamples as Sample[];
220:     w.__camSamples = [];
221:     return s;
222:   });
223: }
