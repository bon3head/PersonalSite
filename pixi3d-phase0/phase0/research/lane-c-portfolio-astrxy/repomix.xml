<file path="src/world/layouts/leaflink.ts">
  1: // LeafLink street layout generator (S06 layout section, S02 worker chapter).
  2: // Pure function: no DOM, no three imports, no IO. All randomness comes from
  3: // one mulberry32 stream, drawn in a fixed order, so the same seed always
  4: // produces the same bytes.
  5: //
  6: // Contract:
  7: //   generate(seed, out, layoutIndex) -> LeaflinkSideData
  8: //   - seed: base seed. The stream is rng(seed + layoutIndex * streamOffset),
  9: //     which matches the S06 stream for the leaflink layout (index one).
 10: //   - out: the full layout texture buffer. Only the layoutIndex slice is
 11: //     written. Texel for lane i, point k:
 12: //     offset = (lane * LANE_STRIDE + layoutIndex * POINTS + k) * FLOATS,
 13: //     RGB = world position, A = class id (local or arterial, per S02).
 14: //   - returns the LeafLink graph: node positions, per-edge records, and
 15: //     adjacency lists (per node, the incident edge indices in edge order).
 16: //     The worker posts this side data with the layout; the scene controller
 17: //     uses it for Dijkstra routing, tap-to-node snapping, and lane lists.
 18: //
 19: // Draw order (fixed; changing it changes the output):
 20: //   - Node jitter: nodes in index order (j rows outer, i cols inner),
 21: //     x draw then z draw per node.
 22: //   - Edge drops: non-arterial edges in edge order, one draw each.
 23: //   - Restore shuffle: Fisher-Yates over the dropped list.
 24: //   - Diagonals: cells in order (j outer, i inner), one draw per cell,
 25: //     plus a second draw for direction when a diagonal is added.
 26: //
 27: // Node index: j * N + i, where i is the x column and j the z row.
 28: // Base position: x = (i - (N-1)/2) * pitch, z = (j - (N-1)/2) * pitch, y = 0.
 29: // Edge order: horizontals first (j outer, i inner), then verticals
 30: // (j outer, i inner), then diagonals in cell order. Lanes of an edge are
 31: // contiguous ids in the order a to b; lane s of an edge with k lanes covers
 32: // t in [s/k, (s+1)/k], with points evenly spaced on that interval.
 33: 
 34: import { T } from '../../tokens.generated';
 35: 
 36: export interface LeaflinkEdgeData {
 37:   a: number;
 38:   b: number;
 39:   length: number;
 40:   laneStart: number;
 41:   laneCount: number;
 42:   arterial: boolean;
 43: }
 44: 
 45: export interface LeaflinkSideData {
 46:   nodes: Float32Array;
 47:   edges: LeaflinkEdgeData[];
 48:   adjacency: number[][];
 49: }
 50: 
 51: // mulberry32, verbatim (S02 worker chapter). The only RNG in src/world.
 52: export function rng(seed: number) {
 53:   let a = seed >>> 0;
 54:   return () => {
 55:     a = (a + 0x6D2B79F5) >>> 0; // lit-ok: mulberry32 increment
 56:     let t = a;
 57:     t = Math.imul(t ^ (t >>> 15), t | 1); // lit-ok: mulberry32 scramble
 58:     t ^= t + Math.imul(t ^ (t >>> 7), t | 61); // lit-ok: mulberry32 scramble
 59:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296; // lit-ok: mulberry32 output scale
 60:   };
 61: }
 62: 
 63: const LANE_COUNT = T.world.laneCount;
 64: const POINTS = T.world.pointsPerLane;
 65: const LAYOUT_COUNT = T.world.layouts.length;
 66: const LANE_STRIDE = POINTS * LAYOUT_COUNT;
 67: const FLOATS_PER_TEXEL = 4; // lit-ok: RGBA channels
 68: const CLASS_LOCAL = 2;
 69: const CLASS_ARTERIAL = 3; // lit-ok: S02 class 3 leaflink.arterial
 70: 
 71: const N = T.world.leaflink.lattice.nodes;
 72: const PITCH = T.world.leaflink.lattice.pitch;
 73: const JITTER = T.world.leaflink.lattice.jitter;
 74: const ARTERIAL_EVERY = T.world.leaflink.arterialEvery;
 75: const ARTERIAL_JITTER_SCALE = T.world.leaflink.arterialJitterScale;
 76: const EDGE_DROP = T.world.leaflink.edgeDropFraction;
 77: const DIAG_ADD = T.world.leaflink.diagonalAddFraction;
 78: 
 79: interface RawEdge {
 80:   a: number;
 81:   b: number;
 82:   arterial: boolean;
 83: }
 84: 
 85: export function generate(
 86:   seed: number,
 87:   out: Float32Array,
 88:   layoutIndex: number,
 89: ): LeaflinkSideData {
 90:   if (out.length < LANE_COUNT * LANE_STRIDE * FLOATS_PER_TEXEL) {
 91:     throw new Error(
 92:       `leaflink layout buffer too small: ${out.length}, need ${LANE_COUNT * LANE_STRIDE * FLOATS_PER_TEXEL}`,
 93:     );
 94:   }
 95:   const rand = rng(seed + layoutIndex * 1000003); // lit-ok: S02 layout stream offset
 96: 
 97:   // Nodes.
 98:   const nodeCount = N * N;
 99:   const half = (N - 1) / 2;
100:   const nx = new Float32Array(nodeCount);
101:   const nz = new Float32Array(nodeCount);
102:   for (let j = 0; j < N; j++) {
103:     for (let i = 0; i < N; i++) {
104:       const idx = j * N + i;
105:       let jx = (rand() * 2 - 1) * JITTER;
106:       let jz = (rand() * 2 - 1) * JITTER;
107:       if (i % ARTERIAL_EVERY === 0) jx *= ARTERIAL_JITTER_SCALE;
108:       if (j % ARTERIAL_EVERY === 0) jz *= ARTERIAL_JITTER_SCALE;
109:       nx[idx] = (i - half) * PITCH + jx;
110:       nz[idx] = (j - half) * PITCH + jz;
111:     }
112:   }
113: 
114:   // Grid edges: horizontals, then verticals.
115:   const edges: RawEdge[] = [];
116:   for (let j = 0; j < N; j++) {
117:     for (let i = 0; i < N - 1; i++) {
118:       edges.push({ a: j * N + i, b: j * N + i + 1, arterial: j % ARTERIAL_EVERY === 0 });
119:     }
120:   }
121:   for (let j = 0; j < N - 1; j++) {
122:     for (let i = 0; i < N; i++) {
123:       edges.push({ a: j * N + i, b: (j + 1) * N + i, arterial: i % ARTERIAL_EVERY === 0 });
124:     }
125:   }
126: 
127:   // Drop non-arterial edges, then restore in shuffled order any dropped
128:   // edge whose endpoints are in different components or whose endpoint
129:   // would have degree 0. The final graph is connected.
130:   const kept = new Uint8Array(edges.length).fill(1);
131:   const dropped: number[] = [];
132:   for (let e = 0; e < edges.length; e++) {
133:     if (!edges[e].arterial && rand() < EDGE_DROP) {
134:       kept[e] = 0;
135:       dropped.push(e);
136:     }
137:   }
138:   const parent = new Int32Array(nodeCount);
139:   for (let v = 0; v < nodeCount; v++) parent[v] = v;
140:   const find = (v: number): number => {
141:     let r = v;
142:     while (parent[r] !== r) r = parent[r];
143:     while (parent[v] !== r) {
144:       const next = parent[v];
145:       parent[v] = r;
146:       v = next;
147:     }
148:     return r;
149:   };
150:   const degree = new Int32Array(nodeCount);
151:   for (let e = 0; e < edges.length; e++) {
152:     if (!kept[e]) continue;
153:     const ra = find(edges[e].a);
154:     const rb = find(edges[e].b);
155:     if (ra !== rb) parent[ra] = rb;
156:     degree[edges[e].a]++;
157:     degree[edges[e].b]++;
158:   }
159:   for (let i = dropped.length - 1; i > 0; i--) {
160:     const swap = Math.floor(rand() * (i + 1));
161:     const tmp = dropped[i];
162:     dropped[i] = dropped[swap];
163:     dropped[swap] = tmp;
164:   }
165:   for (const e of dropped) {
166:     const a = edges[e].a;
167:     const b = edges[e].b;
168:     if (find(a) !== find(b) || degree[a] === 0 || degree[b] === 0) {
169:       kept[e] = 1;
170:       const ra = find(a);
171:       const rb = find(b);
172:       if (ra !== rb) parent[ra] = rb;
173:       degree[a]++;
174:       degree[b]++;
175:     }
176:   }
177:   const root = find(0);
178:   for (let v = 0; v < nodeCount; v++) {
179:     if (find(v) !== root) throw new Error(`leaflink graph disconnected at node ${v}`);
180:     if (degree[v] === 0) throw new Error(`leaflink graph has isolated node ${v}`);
181:   }
182: 
183:   // Diagonals, local, appended after the grid edges.
184:   const finalEdges: RawEdge[] = [];
185:   for (let e = 0; e < edges.length; e++) {
186:     if (kept[e]) finalEdges.push(edges[e]);
187:   }
188:   for (let j = 0; j < N - 1; j++) {
189:     for (let i = 0; i < N - 1; i++) {
190:       if (rand() < DIAG_ADD) {
191:         if (rand() < 0.5) {
192:           finalEdges.push({ a: j * N + i, b: (j + 1) * N + i + 1, arterial: false });
193:         } else {
194:           finalEdges.push({ a: j * N + i + 1, b: (j + 1) * N + i, arterial: false });
195:         }
196:       }
197:     }
198:   }
199: 
200:   // Allocate exactly LANE_COUNT lanes by edge length.
201:   const lengths: number[] = [];
202:   let total = 0;
203:   for (const e of finalEdges) {
204:     const dx = nx[e.b] - nx[e.a];
205:     const dz = nz[e.b] - nz[e.a];
206:     const len = Math.sqrt(dx * dx + dz * dz);
207:     lengths.push(len);
208:     total += len;
209:   }
210:   const quota: number[] = [];
211:   const counts: number[] = [];
212:   let sum = 0;
213:   for (let e = 0; e < finalEdges.length; e++) {
214:     const q = (LANE_COUNT * lengths[e]) / total;
215:     quota.push(q);
216:     const k = Math.max(1, Math.floor(q));
217:     counts.push(k);
218:     sum += k;
219:   }
220:   if (sum < LANE_COUNT) {
221:     const order = finalEdges
222:       .map((_, e) => e)
223:       .sort((p, q) => {
224:         const fp = quota[p] - Math.floor(quota[p]);
225:         const fq = quota[q] - Math.floor(quota[q]);
226:         if (fq !== fp) return fq - fp;
227:         return p - q;
228:       });
229:     let at = 0;
230:     while (sum < LANE_COUNT) {
231:       counts[order[at % order.length]]++;
232:       sum++;
233:       at++;
234:     }
235:   } else if (sum > LANE_COUNT) {
236:     while (sum > LANE_COUNT) {
237:       let best = -1;
238:       for (let e = 0; e < finalEdges.length; e++) {
239:         if (counts[e] <= 1) continue;
240:         if (best === -1 || counts[e] > counts[best]) best = e;
241:       }
242:       if (best === -1) throw new Error('leaflink allocation cannot reach lane total');
243:       counts[best]--;
244:       sum--;
245:     }
246:   }
247:   if (sum !== LANE_COUNT) throw new Error(`leaflink lane total ${sum}, expected ${LANE_COUNT}`);
248: 
249:   // Emit lanes and side data.
250:   const nodes = new Float32Array(nodeCount * 2);
251:   for (let v = 0; v < nodeCount; v++) {
252:     nodes[v * 2] = nx[v];
253:     nodes[v * 2 + 1] = nz[v];
254:   }
255:   const sideEdges: LeaflinkEdgeData[] = [];
256:   const adjacency: number[][] = [];
257:   for (let v = 0; v < nodeCount; v++) adjacency.push([]);
258:   let lane = 0;
259:   for (let e = 0; e < finalEdges.length; e++) {
260:     const edge = finalEdges[e];
261:     const kCount = counts[e];
262:     const cls = edge.arterial ? CLASS_ARTERIAL : CLASS_LOCAL;
263:     sideEdges.push({
264:       a: edge.a,
265:       b: edge.b,
266:       length: lengths[e],
267:       laneStart: lane,
268:       laneCount: kCount,
269:       arterial: edge.arterial,
270:     });
271:     adjacency[edge.a].push(e);
272:     adjacency[edge.b].push(e);
273:     for (let s = 0; s < kCount; s++) {
274:       for (let k = 0; k < POINTS; k++) {
275:         const t = (s + k / (POINTS - 1)) / kCount;
276:         const x = nx[edge.a] + t * (nx[edge.b] - nx[edge.a]);
277:         const z = nz[edge.a] + t * (nz[edge.b] - nz[edge.a]);
278:         const base = (lane * LANE_STRIDE + layoutIndex * POINTS + k) * FLOATS_PER_TEXEL;
279:         out[base] = x;
280:         out[base + 1] = 0;
281:         out[base + 2] = z;
282:         out[base + 3] = cls;
283:       }
284:       lane++;
285:     }
286:   }
287:   if (lane !== LANE_COUNT) throw new Error(`leaflink emitted ${lane} lanes, expected ${LANE_COUNT}`);
288: 
289:   return { nodes, edges: sideEdges, adjacency };
290: }
</file>

